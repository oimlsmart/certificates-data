\n      {\"model_id\": \"Slack Conveyor Max=300g e>=0.1g\"},\n      {\"model_id\": \"Slack Conveyor Max=300g e>=0.2g\"},\n      {\"model_id\": \"Slack Conveyor Max=300g e>=0.5g\"},\n      {\"model_id\": \"Slack Conveyor Max=600g\"},\n      {\"model_id\": \"Slack Conveyor Max=1500g\"}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"load cell (main constructions)\",\n      \"type_designations\": [\"Tedea Huntleigh 1042 C3\", \"Tedea Huntleigh 1250 C3\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"capacity\": \"according to maximum capacity table\",\n        \"reference_tested_load_cell\": \"Tedea Huntleigh 1042 C3, capacity 10 kg\",\n        \"conditions\": \"R60 OIML Certificate of Conformity required; not a load cell with digital output; nlc, Y, Z same or better than tested load cell; same design and material; no oil damper; NH marking allowed only if humidity tested to R76\"\n      }\n    },\n    {\n      \"role\": \"load cell (Slack Conveyor alternative)\",\n      \"type_designations\": [\"Vishay Celtron LPS\"],\n      \"characteristics\": {\n        \"capacity\": \"according to Slack Conveyor capacity table\",\n        \"reference_tested_load_cell\": \"Vishay Celtron LPS, capacity 2 kg\",\n        \"conditions\": \"R60 OIML Certificate of Conformity required; not a load cell with digital output; nlc, Y, Z same or better than tested load cell; same design and material; no oil damper; NH marking allowed only if humidity tested to R76\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"maximum_number_of_scale_intervals_n\": {\"value\": 2400, \"unit_symbol\": null, \"unit_id\": null},\n      \"tare\": {\"value\": \"-500 e (single-range instruments); -500 e1 (multi-range instruments)\", \"unit_symbol\": null, \"unit_id\": null},\n      \"belt_speed\": {\"value\": 1.2, \"unit_symbol\": \"m/s\", \"unit_id\": null},\n      \"temperature_range\": {\"value\": {\"min\": 0, \"max\": 40}, \"unit_symbol\"