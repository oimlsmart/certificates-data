      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R51/2006-GB1-09.04\",\n    \"page_total\": 7\n  },\n  \"recommendation\": {\n    \"id\": \"R51\",\n    \"edition\": 2006,\n    \"accuracy_classes\": [\"XIII\"]\n  },\n  \"certified_type\": {\n    \"category\": \"Checkweigher\",\n    \"type_designations\": [\"VersaWeigh\", \"Versa GP\", \"Versa RxC\", \"Versa RxM\", \"Versa Chain\", \"Teorema\"],\n    \"module_designation\": null,\n    \"description\": \"Automatic catchweighing instruments (checkweighers). Versa constructions (VersaWeigh, Versa GP, Versa Rx) constructed in stainless steel as part of an integrated self-carrying cabinet on adjustable feet with a see-through door; Versa RxC uses the standard weighing system, Versa RxM and Versa Chain use the Slack Conveyor weighing system. Teorema has a conveyor supported by a floor-standing steel frame and a weigh unit on a steel block, connected to a remote electrical cabinet. Remote cabinets permitted for VersaWeigh and Versa GP provided the load cell is connected via metal conduit.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"Versa Max=3000g\", \"label\": \"Versa family (VersaWeigh, Versa GP, Versa Rx), 3000 g variant\", \"attributes\": {\"family\": \"Versa\"}},\n      {\"model_id\": \"Versa Max=6000g\", \"label\": \"Versa family (VersaWeigh, Versa GP, Versa Rx), 6000 g variant\", \"attributes\": {\"family\": \"Versa\"}},\n      {\"model_id\": \"Versa Max=15000g\", \"label\": \"Versa family (VersaWeigh, Versa GP, Versa Rx), 15000 g variant\", \"attributes\": {\"family\": \"Versa\"}},\n      {\"model_id\": \"Teorema Max=800g\", \"label\": \"Teorema, 800 g variant\", \"attributes\": {\"family\": \"Teorema\"}},\n      {\"model_id\": \"Teorema Max=1600g\", \"label\": \"Teorema, 1600 g variant\", \"attributes\": {\"family\": \"Teorema\"}},\n      {\"model_id\": \"Teorema Max=3200g\", \"label\": \"Teorema, 3200 g variant\", \"attributes\": {\"family\": \"Teorema\"}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"load_cell\",\n      \"type_designations\": [\"Tedea Huntleigh 1130 C3\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"tested_capacity\": {\"value\": 30, \"unit_symbol\": \"kg\", \"unit_id\": null},\n        \"compatibility_conditions\": [\n          \"Must have a respective OIML R60 Certificate of Conformity containing the load cell types and necessary load cell data required for the manufacturer's declaration of compatibility of modules and any particular installation requirements\",\n          \"A load cell marked NH is allowed only if humidity testing to R76 has been conducted on this load cell\",\n          \"Not a load cell with digital output\",\n          \"Characteristics such as nlc, Y, Z must be the same or better than the dynamically tested load cell (Tedea Huntleigh 1130 C3, capacity 30 kg)\",\n          \"Design and material must be the same\",\n          \"No oil damper is used\"\n        ]\n      }\n    },\n    {\n      \"role\": \"legally_relevant_software\",\n      \"type_designations\": [\"V312 Version 2.0\"],\n      \"characteristics\": {\n        \"standard_version\": \"V312 2.0 (37.00.02.xx)\",\n        \"standard_version_options\": [\n          \"Multi-Lane applications\",\n          \"Intermittent Checkweigher (Static-Weigh) applications (static weighing, restricted to Slack Conveyor weighing systems and maximum capacities <= 1500 g)\",\n          \"Data Matrix applications\",\n          \"OEM applications\",\n          \"Teorema applications\"\n        ],\n        \"dedicated_versions\": [\n          {\"application\": \"Tare/Gross applications\", \"version_code\": \"39.00.01.xx\"},\n          {\"application\": \"Multiproduct applications\", \"version_code\": \"41.00.01.xx\"},\n          {\"application\": \"Twin application\", \"version_code\": \"42.00.01.xx\"}\n        ],\n        \"version_display\": \"Version number is displayed in the Weigh menu 'Run Screen'\",\n        \"storage\": \"Held in the Weigh Engine and partially on the HMI; can only be changed at factory level via Ethernet\"\n      }\n    },\n    {\n      \"role\": \"remote_control_cabinet\",\n      \"characteristics\": {\n        \"note\": \"VersaWeigh and Versa GP instruments may be fitted with remote cabinets provided the load cell is connected to the cabinet using a metal conduit; houses the electrical hardware including the control and display unit (HMI)\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"electromagnetic_environment\": {\"value\": \"E1 and E2\", \"unit_symbol\": null, \"unit_id\": null},\n      \"climatic_environment_humidity\": {\"value\": \"Non-condensing (closed)\", \"unit_symbol\": null, \"unit_id\": null},\n      \"power_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null},\n      \"power_supply_type\": {\"value\": \"AC\", \"unit_symbol\": null, \"unit_id\": null},\n      \"accuracy_class\": {\"value\": \"XIII\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": [\"1)\"]}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"maximum_capacity\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"Versa Max=3000g\", \"value\": 3000},\n          {\"model\": \"Versa Max=6000g\", \"value\": 6000},\n          {\"model\": \"Versa Max=15000g\", \"value\": 15000},\n          {\"model\": \"Teorema Max=800g\", \"value\": 800},\n          {\"model\": \"Teorema Max=1600g\", \"value\": 1600},\n          {\"model\": \"Teorema Max=3200g\", \"value\": 3200}\n        ]\n      },\n      {\n        \"attribute\": \"minimum_capacity\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"Versa Max=3000g\", \"value\": 100},\n          {\"model\": \"Versa Max=6000g\", \"value\": 200},\n          {\"model\": \"Versa Max=15000g\", \"value\": 500},\n          {\"model\": \"Teorema Max=800g\", \"value\": 42},\n          {\"model\": \"Teorema Max=1600g\", \"value\": 84},\n          {\"model\": \"Teorema Max=3200g\", \"value\": 168}\n        ]\n      },\n      {\n        \"attribute\": \"scale_interval\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"Versa Max=3000g\", \"value\": {\"min\": 1, \"max\": null}},\n          {\"model\": \"Versa Max=6000g\", \"value\": {\"min\": 2, \"max\": null}},\n          {\"model\": \"Versa Max=15000g\", \"value\": {\"min\": 5, \"max\": null}},\n          {\"model\": \"Teorema Max=800g\", \"value\": \">= 0.5 g (42 to 125 g); >= 1 g (125 to 250 g); >= 2 g (250 to 800 g)\", \"unit_symbol\": null},\n          {\"model\": \"Teorema Max=1600g\", \"value\": \">= 1 g (84 to 250 g); >= 2 g (250 to 500 g); >= 5 g (500 to 1600 g)\", \"unit_symbol\": null},\n          {\"model\": \"Teorema Max=3200g\", \"value\": \">= 2 g (168 to 500 g); >= 5 g (500 to 1000 g); >= 10 g (1000 to 3200 g)\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"load_cell_emax\",\n        \"unit_symbol\": \"kg\",\n        \"values\": [\n          {\"model\": \"Versa Max=3000g\", \"value\": 20},\n          {\"model\": \"Versa Max=6000g\", \"value\": 35},\n          {\"model\": \"Versa Max=15000g\", \"value\": 100},\n          {\"model\": \"Teorema Max=800g\", \"value\": 30},\n          {\"model\": \"Teorema Max=1600g\", \"value\": 50},\n          {\"model\": \"Teorema Max=3200g\", \"value\": 100}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"max_scale_intervals_n\",\n        \"axis\": \"instrument family\",\n        \"values\": [\n          {\"condition\": \"Versa (VersaWeigh, Versa GP, Versa Rx, Versa Chain)\", \"value\": 3000, \"unit_symbol\": null},\n          {\"condition\": \"Teorema\", \"value\": 1600, \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"tare\",\n        \"axis\": \"instrument family\",\n        \"values\": [\n          {\"condition\": \"Versa (VersaWeigh, Versa GP, Versa Rx, Versa Chain)\", \"value\": \"T <= 30% Gross for Gross <= 500e; T <= 50% Gross for 500e < Gross <= 3000e for speed <= 1.8 m/s; T <= 15% Gross for 500e < Gross <= 2000e for speed >= 1.8 m/s; T <= 50% Gross for 2000e < Gross <= 3000e (with e1 replacing e for multi-range instruments)\", \"unit_symbol\": null},\n          {\"condition\": \"Teorema\", \"value\": \"T <= 30% Gross\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_range\",\n        \"axis\": \"instrument family\",\n        \"values\": [\n          {\"condition\": \"Versa (VersaWeigh, Versa GP, Versa Rx, Versa Chain)\", \"value\": {\"min\": 0, \"max\": 40}, \"unit_symbol\": \"°C\"},\n          {\"condition\": \"Teorema\", \"value\": {\"min\": 5, \"max\": 40}, \"unit_symbol\": \"°C\"}\n        ]\n      },\n      {\n        \"attribute\": \"power_supply_voltage\",\n        \"axis\": \"instrument family\",\n        \"values\": [\n          {\"condition\": \"Versa (VersaWeigh, Versa GP, Versa Rx, Versa Chain)\", \"value\": {\"min\": 115, \"max\": 230}, \"unit_symbol\": \"V\"},\n          {\"condition\": \"Teorema\", \"value\": 230, \"unit_symbol\": \"V\"}\n        ]\n      },\n      {\n        \"attribute\": \"load_cell_alternative_min_sensitivity\",\n        \"axis\": \"instrument family\",\n        \"values\": [\n          {\"condition\": \"Versa (other Emax values may be chosen)\", \"value\": {\"min\": 1, \"max\": null}, \"unit_symbol\": \"µV/e\"},\n          {\"condition\": \"Teorema (other Emax values may be chosen)\", \"value\": {\"min\": 0.33, \"max\": null}, \"unit_symbol\": \"µV/div\"}\n        ]\n      },\n      {\n        \"attribute\": \"automatic_zero_setting_frequency\",\n        \"axis\": \"instrument family\",\n        \"values\": [\n          {\"condition\": \"Teorema\", \"value\": \"7 min 25 s\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"maximum_conveyor_speed\",\n        \"axis\": \"number of scale intervals (Versa)\",\n        \"values\": [\n          {\"condition\": \"Min - 100\", \"value\": 1.6, \"unit_symbol\": \"m/s\"},\n          {\"condition\": \"100 - 2000\", \"value\": 2.0, \"unit_symbol\": \"m/s\"},\n          {\"condition\": \"2000 - 3000\", \"value\": 1.6, \"unit_symbol\": \"m/s\"}\n        ]\n      },\n      {\n        \"attribute\": \"maximum_conveyor_speed\",\n        \"axis\": \"weighing range (Teorema)\",\n        \"values\": [\n          {\"condition\": \"W1\", \"value\": 1.6, \"unit_symbol\": \"m/s\"},\n          {\"condition\": \"W2\", \"value\": 2.6, \"unit_symbol\": \"m/s\"},\n          {\"condition\": \"W3\", \"value\": 2.6, \"unit_symbol\": \"m/s\"}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Maximum conveyor speed by number of scale intervals (Versa)\",\n      \"columns\": [\"number_of_scale_intervals\", \"maximum_conveyor_speed\"],\n      \"column_units\": [null, \"m/s\"],\n      \"rows\": [\n        {\"number_of_scale_intervals\": \"Min - 100\", \"maximum_conveyor_speed\": 1.6},\n        {\"number_of_scale_intervals\": \"100 - 2000\", \"maximum_conveyor_speed\": 2.0},\n        {\"number_of_scale_intervals\": \"2000 - 3000\", \"maximum_conveyor_speed\": 1.6}\n      ],\n      \"description\": null,\n      \"footnotes\": []\n    },\n    {\n      \"name\": \"Maximum conveyor speed by weighing range (Teorema)\",\n      \"columns\": [\"weighing_range\", \"maximum_conveyor_speed\"],\n      \"column_units\": [null, \"m/s\"],\n      \"rows\": [\n        {\"weighing_range\": \"W1\", \"maximum_conveyor_speed\": 1.6},\n        {\"weighing_range\": \"W2\", \"maximum_conveyor_speed\": 2.6},\n        {\"weighing_range\": \"W3\", \"maximum_conveyor_speed\": 2.6}\n      ],\n      \"description\": null,\n      \"footnotes\": []\n    },\n    {\n      \"name\": \"Legally relevant software modules in the HMI\",\n      \"columns\": [\"designation\", \"version_number\", \"checksum\"],\n      \"column_units\": [null, null, null],\n      \"rows\": [\n        {\"designation\": \"MIDModule.dll\", \"version_number\": \"100.0.2.0\", \"checksum\": \"4000DE8A\"},\n        {\"designation\": \"DataProcessing.dll\", \"version_number\": \"32.0.2.0\", \"checksum\": \"4000DE8A\"},\n        {\"designation\": \"VW_Controls.dll\", \"version_number\": \"35.0.2.0\", \"checksum\": \"4000DE8A\"}\n      ],\n      \"description\": \"The legally relevant part in the HMI is identified in three software modules.\",\n      \"footnotes\": []\n    }\n  ],\n  \"revision_history\": [\n    {\n      \"revision\": \"0\",\n      \"date\": \"2009-07-22\",\n      \"changes\": \"Certificate first issued.\"\n    },\n    {\n      \"revision\": \"1\",\n      \"date\": \"2012-01-25\",\n      \"changes\": \"Versa GP, Versa RxC and Versa RxM models added. Software options added.\"\n    },\n    {\n      \"revision\": \"2\",\n      \"date\": \"2014-07-28\",\n      \"changes\": \"Software section added, software options section replaced by Alternative software section. Teorema instrument and Derived alternative sections added. Remote cabinets section added. Certificate history added.\"\n    }\n  ]\n}"
    }
  ],
