      "text": "{\n  \"certificate\": {\n    \"number\": \"R51/2006-DE1-07.05\",\n    \"page_total\": 4,\n    \"member_state\": \"Germany\",\n    \"date_issued\": \"2007-11-12\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Physikalisch-Technische Bundesanstalt\",\n    \"address_lines\": [\"Bundesallee 100\", \"38116 Braunschweig\"],\n    \"person_responsible\": \"Dr. Panagiotis Zervos\",\n    \"person_title\": \"Direktor und Professor\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Bizerba GmbH & Co. KG\",\n      \"address_lines\": [\"Wilhelm-Kraut-Str. 65\", \"72336 Balingen\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Bizerba GmbH & Co. KG\",\n      \"address_lines\": [\"Wilhelm-Kraut-Str. 65\", \"72336 Balingen\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Checkweigher\",\n    \"type_designations\": [\"CWM ...\", \"WS10CW\", \"WS20CW\", \"WS20VB\", \"WS6H\", \"WS10H\", \"WS10VK1\", \"WS10VK2\", \"WS10VK5\", \"WS20VK\", \"EM ...\"],\n    \"description\": \"Automatic electromechanical weighing instrument designed as automatic catchweighing instrument, checkweigher, weigh labeller or weigh-price labeller; equipped with external lever work (only weighing module series WS6H and WS10H) or without external lever work; with electromagnetic force compensation load cell (only weighing module series EM ...) or with strain gauge load cells; performed as single or multi interval instrument or single or multiple range instrument.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"CWM\",\n    \"models\": [\n      {\"model_id\": \"WS10CW\", \"label\": \"weighing module\", \"attributes\": {}},\n      {\"model_id\": \"WS20CW\", \"label\": \"weighing module\", \"attributes\": {}},\n      {\"model_id\": \"WS20VB\", \"label\": \"weighing module\", \"attributes\": {}},\n      {\"model_id\": \"WS6H\", \"label\": \"weighing module with external lever work\", \"attributes\": {}},\n      {\"model_id\": \"WS10H\", \"label\": \"weighing module with external lever work\", \"attributes\": {}},\n      {\"model_id\": \"WS10VK1\", \"label\": \"weighing module\", \"attributes\": {}},\n      {\"model_id\": \"WS10VK2\", \"label\": \"weighing module\", \"attributes\": {}},\n      {\"model_id\": \"WS10VK5\", \"label\": \"weighing module\", \"attributes\": {}},\n      {\"model_id\": \"WS20VK\", \"label\": \"weighing module\", \"attributes\": {}},\n      {\"model_id\": \"EM ...\", \"label\": \"weighing module series with electromagnetic force compensation load cell\", \"attributes\": {}}\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"mode_of_operation\": {\"value\": \"Start-Stop operation or operation in motion\", \"unit_symbol\": null, \"unit_id\": null},\n      \"maximum_belt_speed\": {\"value\": {\"min\": null, \"max\": 1.47}, \"unit_symbol\": \"m/s\", \"unit_id\": null},\n      \"maximum_capacity\": {\"value\": {\"min\": null, \"max\": 60}, \"unit_symbol\": \"kg\", \"unit_id\": null},\n      \"verification_scale_interval\": {\"value\": {\"min\": 0.1, \"max\": null}, \"unit_symbol\": \"g\", \"unit_id\": null},\n      \"number_of_verification_scale_intervals\": {\"value\": {\"min\": null, \"max\": 7500}, \"unit_symbol\": null, \"unit_id\": null},\n      \"power_supply_voltage\": {\"value\": 230, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"power_supply_type\": {\"value\": \"AC\", \"unit_symbol\": null, \"unit_id\": null},\n      \"power_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null},\n      \"accuracy_category\": {\"value\": \"XIII(1); XIIIH(x ≥ 2)\", \"unit_symbol\": null, \"unit_id\": null},\n      \"number_of_ranges_intervals\": {\"value\": 2, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": [\"2)\", \"3)\"]},\n      \"ratio_between_verification_scale_intervals\": {\"value\": {\"min\": null, \"max\": 3}, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": [\"1)\", \"2)\"]},\n      \"temperatu