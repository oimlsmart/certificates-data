      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R76/2006-GB1-12.10\",\n    \"page_total\": 3,\n    \"date_issued\": \"2012-10-02\"\n  },\n  \"certified_type\": {\n    \"category\": \"Indicator\",\n    \"type_designations\": [\"AFS\", \"AFM\", \"ABM\", \"ATM\", \"APS\", \"VFS\", \"VFM\", \"VBM\", \"VTM\", \"VPS\"],\n    \"description\": \"Family of instruments using A-Series and V-Series digital indicators connected to a weighing platform forming a Class III or IIII, mains or battery-powered, self-indicating, single interval or dual interval/range, non-automatic weighing instrument; may be used for direct sales to the public. Devices: initial and semi-automatic zero setting, zero tracking, semi-automatic subtractive tare balancing, determination of stability of equilibrium, zero indicator, net indicator, memory and totalisation, printing. Load cells must have an OIML R60 Certificate of Conformity; load cells marked NH are allowed only if humidity testing to R76 was conducted on them. Legally relevant parameters protected by a jumper on the main board; enclosures and load cell connection sealed using a wire-and-seal method.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"A-Series and V-Series digital indicators\",\n    \"models\": [\n      {\"model_id\": \"AFS\"},\n      {\"model_id\": \"AFM\"},\n      {\"model_id\": \"ABM\"},\n      {\"model_id\": \"ATM\"},\n      {\"model_id\": \"APS\"},\n      {\"model_id\": \"VFS\"},\n      {\"model_id\": \"VFM\"},\n      {\"model_id\": \"VBM\"},\n      {\"model_id\": \"VTM\"},\n      {\"model_id\": \"VPS\"}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"A/D conversion module\",\n      \"type_designations\": [],\n      \"alternatives\": null,\n      \"characteristics\": {}\n    },\n    {\n      \"role\": \"Main board with processor\",\n      \"type_designations\": [],\n      \"alternatives\": null,\n      \"characteristics\": {}\n    },\n    {\n      \"role\": \"Serial interface\",\n      \"type_designations\": [\"RS232C\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"connector\": {\"value\": \"D-SUB 9\", \"unit_symbol\": null, \"unit_id\": null}\n      }\n    },\n    {\n      \"role\": \"Parallel printer port\",\n      \"type_designations\": [\"Centronic\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"connector\": {\"value\": \"D-SUB 25\", \"unit_symbol\": null, \"unit_id\": null}\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"power_supply_voltage\": {\"value\": {\"min\": 9, \"max\": 12}, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"power_supply_type\": {\"value\": \"DC\", \"unit_symbol\": null, \"unit_id\": null},\n      \"mains_adaptor_output_voltage\": {\"value\": 9, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"mains_adaptor_output_current\": {\"value\": 500, \"unit_symbol\": \"mA\", \"unit_id\": null},\n      \"battery_voltage\": {\"value\": 6, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"battery_capacity\": {\"value\": 4, \"unit_symbol\": \"Ah\", \"unit_id\": null},\n      \"load_cell_excitation_voltage\": {\"value\": 5, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"load_cell_impedance\": {\"value\": {\"min\": 85, \"max\": 1100}, \"unit_symbol\": \"Ω\", \"unit_id\": null},\n      \"min_input_voltage_per_scale_interval\": {\"value\": 1, \"unit_symbol\": \"µV\", \"unit_id\": null},\n      \"signal_voltage_measuring_range\": {\"value\": {\"min\": -9.7, \"max\": 19.5}, \"unit_symbol\": \"mV\", \"unit_id\": null},\n      \"dead_load_signal_voltage\": {\"value\": {\"min\": 0, \"max\": 10}, \"unit_symbol\": \"mV\", \"unit_id\": null},\n      \"indicator_fraction_of_max_permissible_error\": {\"value\": 0.5, \"unit_symbol\": null, \"unit_id\": null},\n      \"operating_temperature\": {\"value\": {\"min\": -10, \"max\": 40}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n      \"max_load_cell_cable_length_6_wire\": {\"value\": 30, \"unit_symbol\": \"m\", \"unit_id\": null},\n      \"maximum_tare\": {\"value\": \"-1/3 Max\", \"unit_symbol\": null, \"unit_id\": null},\n      \"load_cell_connection\": {\"value\": \"4-wire or 6-wire shielded\", \"unit_symbol\": null, \"unit_id\": null},\n      \"software_version\": {\"value\": \"V1.2\", \"unit_symbol\": null, \"unit_id\": null}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"series\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"AFS\", \"value\": \"A\"},\n          {\"model\": \"AFM\", \"value\": \"A\"},\n          {\"model\": \"ABM\", \"value\": \"A\"},\n          {\"model\": \"ATM\", \"value\": \"A\"},\n          {\"model\": \"APS\", \"value\": \"A\"},\n          {\"model\": \"VFS\", \"value\": \"V\"},\n          {\"model\": \"VFM\", \"value\": \"V\"},\n          {\"model\": \"VBM\", \"value\": \"V\"},\n          {\"model\": \"VTM\", \"value\": \"V\"},\n          {\"model\": \"VPS\", \"value\": \"V\"}\n        ]\n      },\n      {\n        \"attribute\": \"enclosure_material\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"AFS\", \"value\": \"stainless steel\"},\n          {\"model\": \"AFM\", \"value\": \"plastic\"},\n          {\"model\": \"ABM\", \"value\": \"plastic\"},\n          {\"model\": \"ATM\", \"value\": \"plastic\"},\n          {\"model\": \"APS\", \"value\": \"stainless steel\"},\n          {\"model\": \"VFS\", \"value\": \"stainless steel\"},\n          {\"model\": \"VFM\", \"value\": \"plastic\"},\n          {\"model\": \"VBM\", \"value\": \"plastic\"},\n          {\"model\": \"VTM\", \"value\": \"plastic\"},\n          {\"model\": \"VPS\", \"value\": \"stainless steel\"}\n        ]\n      },\n      {\n        \"attribute\": \"lcd_display_size\",\n        \"unit_symbol\": \"in\",\n        \"values\": [\n          {\"model\": \"AFS\", \"value\": 2.0},\n          {\"model\": \"AFM\", \"value\": 2.0},\n          {\"model\": \"ABM\", \"value\": 2.0},\n          {\"model\": \"ATM\", \"value\": 2.0},\n          {\"model\": \"APS\", \"value\": 1.0},\n          {\"model\": \"VFS\", \"value\": 2.0},\n          {\"model\": \"VFM\", \"value\": 2.0},\n          {\"model\": \"VBM\", \"value\": 2.0},\n          {\"model\": \"VTM\", \"value\": 2.0},\n          {\"model\": \"VPS\", \"value\": 1.0}\n        ]\n      },\n      {\n        \"attribute\": \"load_cell_connection_wiring\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"AFS\", \"value\": \"4-wire\"},\n          {\"model\": \"AFM\", \"value\": \"4-wire\"},\n          {\"model\": \"ABM\", \"value\": \"4-wire\"},\n          {\"model\": \"ATM\", \"value\": \"4-wire\"},\n          {\"model\": \"APS\", \"value\": \"4-wire\"},\n          {\"model\": \"VFS\", \"value\": \"6-wire\"},\n          {\"model\": \"VFM\", \"value\": \"6-wire\"},\n          {\"model\": \"VBM\", \"value\": \"6-wire\"},\n          {\"model\": \"VTM\", \"value\": \"6-wire\"},\n          {\"model\": \"VPS\", \"value\": \"6-wire\"}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"max_scale_intervals\",\n        \"axis\": \"accuracy_class\",\n        \"values\": [\n          {\"condition\": \"Class III\", \"value\": 10000, \"unit_symbol\": null, \"unit_id\": null},\n          {\"condition\": \"Class IIII\", \"value\": 1000, \"unit_symbol\": null, \"unit_id\": null}\n        ]\n      }\n    ]\n  },\n  \"recommendation\": {\n    \"id\": \"R76\",\n    \"edition\": 2006,\n    \"accuracy_classes\": [\"III\", \"IIII\"]\n  },\n  \"test_reports\": [\n    {\n      \"id\": \"P00917\",\n      \"pages\": 13,\n      \"role\": \"type_evaluation_report\"\n    }\n  ]\n}"
