      "message": {
        "role": "assistant",
        "content": "{\"certificate\":{\"number\":\"R76/2006-GB1-12.10\",\"page_total\":3,\"date_issued\":\"2012-10-02\"},\"certified_type\":{\"category\":\"Indicator\",\"type_designations\":[\"AFS\",\"AFM\",\"ABM\",\"ATM\",\"APS\",\"VFS\",\"VFM\",\"VBM\",\"VTM\",\"VPS\"],\"description\":\"Family of instruments using A-Series and V-Series digital indicators connected to a weighing platform forming a Class III or IIII, mains or battery-powered, self-indicating, single interval or dual interval/range, non-automatic weighing instrument; may be used for direct sales to the public. Devices: initial and semi-automatic zero setting, zero tracking, semi-automatic subtractive tare balancing, determination of stability of equilibrium, zero indicator, net indicator, memory and totalisation, printing. Load cells must have an OIML R60 Certificate of Conformity; load cells marked NH are allowed only if humidity testing to R76 was conducted on them. Legally relevant parameters protected by a jumper on the main board; enclosures and load cell connection sealed using a wire-and-seal method.\"},\"model_family\":{\"family_name\":\"A-Series and V-Series digital indicators\",\"models\":[{\"model_id\":\"AFS\"},{\"model_id\":\"AFM\"},{\"model_id\":\"ABM\"},{\"model_id\":\"ATM\"},{\"model_id\":\"APS\"},{\"model_id\":\"VFS\"},{\"model_id\":\"VFM\"},{\"model_id\":\"VBM\"},{\"model_id\":\"VTM\"},{\"model_id\":\"VPS\"}]},\"components\":[{\"role\":\"A/D conversion module\",\"type_designations\":[],\"alternatives\":null,\"characteristics\":{}},{\"role\":\"Main board with processor\",\"type_designations\":[],\"alternatives\":null,\"characteristics\":{}},{\"role\":\"Serial interface\",\"type_designations\":[\"RS232C\"],\"alternatives\":null,\"characteristics\":{\"connector\":{\"value\":\"D-SUB 9\",\"unit_symbol\":null,\"unit_id\":null}}},{\"role\":\"Parallel printer port\",\"type_designations\":[\"Centronic\"],\"alternatives\":null,\"characteristics\":{\"connector\":{\"value\":\"D-SUB 25\",\"unit_symbol\":null,\"unit_id\":null}}}],\"characteristics\":{\"type_level\":{\"power_supply_voltage\":{\"value\":{\"min\":9,\"max\":12},\"unit_symbol\":\"V\",\"unit_id\":null},\"power_supply_type\":{\"value\":\"DC\",\"unit_symbol\":null,\"unit_id\":null},\"mains_adaptor_output_voltage\":{\"value\":9,\"unit_symbol\":\"V\",\"unit_id\":null},\"mains_adaptor_output_current\":{\"value\":500,\"unit_symbol\":\"mA\",\"unit_id\":null},\"battery_voltage\":{\"value\":6,\"unit_symbol\":\"V\",\"unit_id\":null},\"battery_capacity\":{\"value\":4,\"unit_symbol\":\"Ah\",\"unit_id\":null},\"load_cell_excitation_voltage\":{\"value\":5,\"unit_symbol\":\"V\",\"unit_id\":null},\"load_cell_impedance\":{\"value\":{\"min\":85,\"max\":1100},\"unit_symbol\":\"Ω\",\"unit_id\":null},\"min_input_voltage_per_scale_interval\":{\"value\":1,\"unit_symbol\":\"µV\",\"unit_id\":null},\"signal_voltage_measuring_range\":{\"value\":{\"min\":-9.7,\"max\":19.5},\"unit_symbol\":\"mV\",\"unit_id\":null},\"dead_load_signal_voltage\":{\"value\":{\"min\":0,\"max\":10},\"unit_symbol\":\"mV\",\"unit_id\":null},\"indicator_fraction_of_max_permissible_error\":{\"value\":0.5,\"unit_symbol\":null,\"unit_id\":null},\"operating_temperature\":{\"value\":{\"min\":-10,\"max\":40},\"unit_symbol\":\"°C\",\"unit_id\":null},\"max_load_cell_cable_length_6_wire\":{\"value\":30,\"unit_symbol\":\"m\",\"unit_id\":null},\"maximum_tare\":{\"value\":\"-1/3 Max\",\"unit_symbol\":null,\"unit_id\":null},\"load_cell_connection\":{\"value\":\"4-wire or 6-wire shielded\",\"unit_symbol\":null,\"unit_id\":null},\"software_version\":{\"value\":\"V1.2\",\"unit_symbol\":null,\"unit_id\":null}},\"model_level\":[{\"attribute\":\"series\",\"unit_symbol\":null,\"values\":[{\"model\":\"AFS\",\"value\":\"A\"},{\"model\":\"AFM\",\"value\":\"A\"},{\"model\":\"ABM\",\"value\":\"A\"},{\"model\":\"ATM\",\"value\":\"A\"},{\"model\":\"APS\",\"value\":\"A\"},{\"model\":\"VFS\",\"value\":\"V\"},{\"model\":\"VFM\",\"value\":\"V\"},{\"model\":\"VBM\",\"value\":\"V\"},