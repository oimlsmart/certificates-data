      "text": "{\n  \"certificate\": {\n    \"number\": \"R76/2006-A-DK2-2023.07\",\n    \"scheme\": \"A\",\n    \"page_total\": 3,\n    \"member_state\": \"Denmark\",\n    \"date_issued\": \"2023-10-24\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"FORCE Certification A/S\",\n    \"person_responsible\": \"Jens Hovgård Jensen\",\n    \"person_title\": \"Certification Manager\",\n    \"oiml_issuer_id\": null\n  },\n  \"certified_type\": {\n    \"category\": \"Indicator\",\n    \"type_designations\": [\"ADW-E\", \"ADW-C\", \"AXM\", \"AGS\", \"VGS\"],\n    \"module_designation\": null,\n    \"description\": \"Weighing modules/indicators for non-automatic weighing instruments, for single-interval, multi-interval or multi-range applications. Permitted devices: initial zero setting (≤20% Max), semi-automatic zero setting (≤4% Max), zero tracking (≤4% Max), semi-automatic and automatic subtractive tare devices, printing and totalization devices, unit toggling devices (g and kg only), sealed gravity compensation device; stable equilibrium, zero and net indicators. RS232 interface (does not have to be secured).\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"ADW-E\", \"label\": \"ADW-E\", \"attributes\": {\"software_identification\": \"CE031, CE032\"}},\n      {\"model_id\": \"ADW-C\", \"label\": \"ADW-C\", \"attributes\": {\"software_identification\": \"CE033\"}},\n      {\"model_id\": \"AXM\", \"label\": \"AXM\", \"attributes\": {\"software_identification\": \"CE033\"}},\n      {\"model_id\": \"AGS\", \"label\": \"AGS\", \"attributes\": {\"software_identification\": \"CE034\"}},\n      {\"model_id\": \"VGS\", \"label\": \"VGS\", \"attributes\": {\"software_identification\": \"CE034\"}}\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"accuracy_class\": {\"value\": \"III and IIII\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"weighing_range_types\": {\"value\": \"single-interval, multi-interval or multi-range\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_capacity\": {\"value\": {\"min\": 0.3, \"max\": 30}, \"unit_symbol\": \"kg\", \"unit_id\": null, \"footnote_markers\": []},\n      \"minimum_capacity\": {\"value\": \"20 × e\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"verification_scale_interval\": {\"value\": {\"min\": 0.05, \"max\": null}, \"unit_symbol\": \"g\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_tare_effect\": {\"value\": \"-Max\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"operating_temperature_range\": {\"value\": {\"min\": -10, \"max\": 40}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"initial_zero_setting_range\": {\"value\": {\"min\": null, \"max\": 20}, \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []},\n      \"semi_automatic_zero_setting_range\": {\"value\": {\"min\": null, \"max\": 4}, \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []},\n      \"zero_tracking_range\": {\"value\": {\"min\": null, \"max\": 4}, \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []},\n      \"external_power_supply_voltage\": {\"value\": 12, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"mains_power_supply_voltage\": {\"value\": {\"min\": 100, \"max\": 240}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"mains_power_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null, \"footnote_markers\": []},\n      \"battery_supply_voltage\": {\"value\": 6, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"interface_types\": {\"value\": \"RS232\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"software_identification\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"ADW-E\", \"value\": \"CE031, CE032\"},\n          {\"model\": \"ADW-C\", \"value\": \"CE033\"},\n          {\"model\": \"AXM\", \"value\": \"CE033\"},\n          {\"model\": \"AGS\", \"value\": \"CE034\"},\n          {\"model\": \"VGS\", \"value\": \"CE034\"}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"max_verification_scale_intervals\",\n        \"axis\": \"weighing range type\",\n        \"values\": [\n          {\"condition\": \"single interval\", \"value\": {\"min\": null, \"max\": 6000}, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n          {\"condition\": \"multi-interval or multi-range\", \"value\": \"2 × 5000\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n        ]\n      }\n    ]\n  },\n  \"recommendation\": {\n    \"id\": \"R76\",\n    \"edition\": 2006,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [\"III\", \"IIII\"]\n  },\n  \"test_reports\": [\n    {\"id\": \"122-29322.10\", \"date\": \"2023-03-30\", \"pages\": 119, \"role\": \"test_report\"},\n    {\"id\": \"122-29322.90.20\", \"date\": \"2023-09-04\", \"pages\": 27, \"role\": \"type_evaluation_report\"},\n    {\"id\": \"122-29322\", \"date\": null, \"pages\": null, \"role\": \"documentation_file\"}\n  ],\n  \"revision_history\": [\n    {\"revision\": \"Initial version\", \"date\": \"2023-10-24\"}\n  ]\n}"
