": \"°C\", \"unit_id\": \"u:degree_Celsius\"},\n      \"common_software_version\": {\"value\": \"1.02xx\", \"unit_symbol\": null, \"unit_id\": null},\n      \"common_software_version_suffix_range\": {\"value\": {\"min\": 0, \"max\": 99}, \"unit_symbol\": null, \"unit_id\": null}\n    },\n    \"config_level\": [\n      {\n        \"attribute\": \"maximum_number_of_scale_intervals\",\n        \"axis\": \"weighing range configuration\",\n        \"values\": [\n          {\"condition\": \"single-interval\", \"value\": {\"min\": null, \"max\": 6000}, \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"dual-range (per range)\", \"value\": {\"min\": null, \"max\": 3000}, \"unit_symbol\": null, \"footnote_markers\": []}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Approved software identification by model\",\n      \"columns\": [\"model_name\", \"application\", \"software_identification\"],\n      \"column_units\": [null, null, null],\n      \"rows\": [\n        {\"model_name\": \"VGM\", \"application\": \"WEIGHING\", \"software_identification\": \"CE020\"},\n        {\"model_name\": \"VGW\", \"application\": \"CHECKWEIGHING\", \"software_identification\": \"CE004\"},\n        {\"model_name\": \"NGP\", \"application\": \"PRICE COMPUTING\", \"software_identification\": \"CE005\"},\n        {\"model_name\": \"VGC\", \"application\": \"PARTS COUNTING\", \"software_identification\": \"CE006\"},\n        {\"model_name\": \"VDM\", \"application\": \"WEIGHING\", \"software_identification\": \"CE011\"},\n        {\"model_name\": \"VDW\", \"application\": \"CHECKWEIGHING\", \"software_identification\": \"CE012\"},\n        {\"model_name\": \"VDP\", \"application\": \"PRICE COMPUTING\", \"software_identification\": \"CE013\"},\n        {\"model_name\": \"VDC\", \"application\": \"PARTS COUNTING\", \"software_identification\": \"CE014\"},\n        {\"model_name\": \"VOM\", \"application\": \"WEIGHING\", \"software_identi