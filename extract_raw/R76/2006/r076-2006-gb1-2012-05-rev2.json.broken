      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R76/2006-GB1-12.05\",\n    \"scheme\": \"B\",\n    \"project_number\": \"TS1201/0041\",\n    \"page_total\": 5,\n    \"member_state\": \"United Kingdom of Great Britain and Northern Ireland\",\n    \"date_issued\": \"2014-08-22\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"National Measurement Office\",\n    \"address_lines\": [\"Stanton Avenue\", \"Teddington\", \"TW11 0JZ\", \"United Kingdom\"],\n    \"person_responsible\": \"Paul Dixon\",\n    \"person_title\": \"Director, Certification Services\",\n    \"phone\": \"+44 (0)20 8943 7272\",\n    \"website\": \"www.bis.gov.uk/nmo\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Avery Weigh-Tronix\",\n      \"address_lines\": [\"Foundry Lane\", \"Smethwick\", \"West Midlands B66 2LP\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Avery Weigh-Tronix\",\n      \"address_lines\": [\"Foundry Lane\", \"Smethwick\", \"West Midlands B66 2LP\", \"United Kingdom\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Non-Automatic Weighing Instrument (Checkweigher)\",\n    \"type_designations\": [\"ZQ375\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Family of instruments designated ZQ375 Checkweigher, comprising the Torsion base (BSF/BSG) and Diamond base (BS) models. Class III, mains or battery-powered, self-indicating non-automatic weighing instruments, not designed for direct sales to the public. Main features: ZQ375 Indicating Device (fully described in R76/2006-GB1-12.04), BSF/BSG Torsion or BS Diamond base stainless steel load receptor, stainless steel column, optional ZQ-BAT battery box, optional ZQ-OPTO interface box (with or without beacon assembly). Devices: semi-automatic zero setting (≤ 4% Max), zero tracking (≤ 4% Max), semi-automatic subtractive tare weighing, pre-set tare, recall of gross indication when tare is active, determination and indication of stability of equilibrium, checking of display, printing, PLUs, alibi storage device, gravity compensation, real time clock, command via external device (PC), simple checkweighing (Sim375), mid-level checkweighing (Mid375), advanced checkweighing (Adv375), percentage checkweighing (Per375), grading checkweighing (Grad375), and gross/net/tare/preset tare/print/zero/motion/accumulation/over-under weight/network indicators. Interfaces: load cell 4-wire or 6-wire shielded connection, logic level inputs, open collector outputs, current loop, RS232/422/485, 10/100 Ethernet, USB host, USB device, wireless LAN 802.11b/g, ZQ-BAT battery pack, ZQ-OPTO interface box. Software designated AWT30-500161 version 1.x.x.x or 2.x.x.x; calibration and legally relevant parameters protected via physical means (jumper on main board) or software means (password and incrementing counters).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"ZQ375 Checkweigher\",\n    \"models\": [\n      {\"model_id\": \"BSF-99-3 (3 kg)\", \"label\": \"ZQ375 with BSF-99 Torsion base, Max 3 kg\", \"attributes\": {\"base_model\": \"BSF-99-3\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/10 kg\"}},\n      {\"model_id\": \"BSF-99-6 (6 kg, Emax 10 kg)\", \"label\": \"ZQ375 with BSF-99 Torsion base, Max 6 kg\", \"attributes\": {\"base_model\": \"BSF-99-6\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/10 kg\"}},\n      {\"model_id\": \"BSF-99-6 (6 kg, Emax 20 kg)\", \"label\": \"ZQ375 with BSF-99 Torsion base, Max 6 kg\", \"attributes\": {\"base_model\": \"BSF-99-6\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/20 kg\"}},\n      {\"model_id\": \"BSF-1214-15 (6 kg)\", \"label\": \"ZQ375 with BSF-1214 Torsion base, Max 6 kg\", \"attributes\": {\"base_model\": \"BSF-1214-15\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/20 kg\"}},\n      {\"model_id\": \"BSF-1214-15 (15 kg)\", \"label\": \"ZQ375 with BSF-1214 Torsion base, Max 15 kg\", \"attributes\": {\"base_model\": \"BSF-1214-15\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/20 kg\"}},\n      {\"model_id\": \"BSF-1214-30 (30 kg)\", \"label\": \"ZQ375 with BSF-1214 Torsion base, Max 30 kg\", \"attributes\": {\"base_model\": \"BSF-1214-30\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/50 kg\"}},\n      {\"model_id\": \"BSF-1214-45 (45 kg)\", \"label\": \"ZQ375 with BSF-1214 Torsion base, Max 45 kg\", \"attributes\": {\"base_model\": \"BSF-1214-45\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/100 kg\"}},\n      {\"model_id\": \"BSF-1214-60 (60 kg)\", \"label\": \"ZQ375 with BSF-1214 Torsion base, Max 60 kg\", \"attributes\": {\"base_model\": \"BSF-1214-60\", \"base_type\": \"Torsion\", \"load_cell_model\": \"HBM PW15AHC3MR/100 kg\"}},\n      {\"model_id\": \"BSG-99-6 (3 kg)\", \"label\": \"ZQ375 with BSG-99 Torsion base, Max 3 kg\", \"attributes\": {\"base_model\": \"BSG-99-6\", \"base_type\": \"Torsion\", \"load_cell_model\": \"Vishay 1130-10 kg\"}},\n      {\"model_id\": \"BSG-99-6 (6 kg)\", \"label\": \"ZQ375 with BSG-99 Torsion base, Max 6 kg\", \"attributes\": {\"base_model\": \"BSG-99-6\", \"base_type\": \"Torsion\", \"load_cell_model\": \"Vishay 1130-10 kg\"}},\n      {\"model_id\": \"BSG-1214-15 (6 kg)\", \"label\": \"ZQ375 with BSG-1214 Torsion base, Max 6 kg\", \"attributes\": {\"base_model\": \"BSG-1214-15\", \"base_type\": \"Torsion\", \"load_cell_model\": \"Vishay 1130-20 kg\"}},\n      {\"model_id\": \"BSG-1214-15 (15 kg)\", \"label\": \"ZQ375 with BSG-1214 Torsion base, Max 15 kg\", \"attributes\": {\"base_model\": \"BSG-1214-15\", \"base_type\": \"Torsion\", \"load_cell_model\": \"Vishay 1130-20 kg\"}},\n      {\"model_id\": \"BSG-1214-30 (30 kg)\", \"label\": \"ZQ375 with BSG-1214 Torsion base, Max 30 kg\", \"attributes\": {\"base_model\": \"BSG-1214-30\", \"base_type\": \"Torsion\", \"load_cell_model\": \"Vishay 1130-50 kg\"}},\n      {\"model_id\": \"BS-1824-45 (30 kg)\", \"label\": \"ZQ375 with BS-1824 Diamond base, Max 30 kg\", \"attributes\": {\"base_model\": \"BS-1824-45\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 59.5 kg\"}},\n      {\"model_id\": \"BS-1824-45 (45 kg)\", \"label\": \"ZQ375 with BS-1824 Diamond base, Max 45 kg\", \"attributes\": {\"base_model\": \"BS-1824-45\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 59.5 kg\"}},\n      {\"model_id\": \"BS-2020-50 (30 kg)\", \"label\": \"ZQ375 with BS-2020 Diamond base, Max 30 kg\", \"attributes\": {\"base_model\": \"BS-2020-50\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 59.5 kg\"}},\n      {\"model_id\": \"BS-2020-45 (45 kg)\", \"label\": \"ZQ375 with BS-2020 Diamond base, Max 45 kg\", \"attributes\": {\"base_model\": \"BS-2020-45\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS 125 lb\"}},\n      {\"model_id\": \"BS-2020-50 (45 kg)\", \"label\": \"ZQ375 with BS-2020 Diamond base, Max 45 kg\", \"attributes\": {\"base_model\": \"BS-2020-50\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 59.5 kg\"}},\n      {\"model_id\": \"BS-2020-50 (50 kg)\", \"label\": \"ZQ375 with BS-2020 Diamond base, Max 50 kg\", \"attributes\": {\"base_model\": \"BS-2020-50\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 59.5 kg\"}},\n      {\"model_id\": \"BS-2020-100 (60 kg)\", \"label\": \"ZQ375 with BS-2020 Diamond base, Max 60 kg\", \"attributes\": {\"base_model\": \"BS-2020-100\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 119 kg\"}},\n      {\"model_id\": \"BS-2020-100 (90 kg)\", \"label\": \"ZQ375 with BS-2020 Diamond base, Max 90 kg\", \"attributes\": {\"base_model\": \"BS-2020-100\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 119 kg\"}},\n      {\"model_id\": \"BS-2020-100 (100 kg)\", \"label\": \"ZQ375 with BS-2020 Diamond base, Max 100 kg\", \"attributes\": {\"base_model\": \"BS-2020-100\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 119 kg\"}},\n      {\"model_id\": \"BS-2424-90 (90 kg)\", \"label\": \"ZQ375 with BS-2424 Diamond base, Max 90 kg\", \"attributes\": {\"base_model\": \"BS-2424-90\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS 250 lb\"}},\n      {\"model_id\": \"BS-2424-150 (150 kg)\", \"label\": \"ZQ375 with BS-2424 Diamond base, Max 150 kg\", \"attributes\": {\"base_model\": \"BS-2424-150\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 299 kg\"}},\n      {\"model_id\": \"BS-2424-200 (200 kg, Emax 299 kg)\", \"label\": \"ZQ375 with BS-2424 Diamond base, Max 200 kg\", \"attributes\": {\"base_model\": \"BS-2424-200\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 299 kg\"}},\n      {\"model_id\": \"BS-2424-200 (200 kg, Emax 440 kg)\", \"label\": \"ZQ375 with BS-2424 Diamond base, Max 200 kg\", \"attributes\": {\"base_model\": \"BS-2424-200\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS 1000 lb\"}},\n      {\"model_id\": \"BS-2424-250 (250 kg)\", \"label\": \"ZQ375 with BS-2424 Diamond base, Max 250 kg\", \"attributes\": {\"base_model\": \"BS-2424-250\", \"base_type\": \"Diamond\", \"load_cell_model\": \"Avery Weigh-Tronix FLS R60 299 kg\"}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"indicating device\",\n      \"type_designations\": [\"ZQ375\"],\n      \"characteristics\": {\n        \"described_in_certificate\": {\"value\": \"R76/2006-GB1-12.04\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n      }\n    },\n    {\n      \"role\": \"base / load receptor\",\n      \"type_designations\": [\"BSF-99\", \"BSF-1214\", \"BSG-99\", \"BSG-1214\", \"BS-1824\", \"BS-2020\", \"BS-2424\"],\n      \"characteristics\": {}\n    },\n    {\n      \"role\": \"load cell\",\n      \"type_design