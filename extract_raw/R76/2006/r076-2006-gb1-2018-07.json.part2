      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R76/2006-A-GB1-18.07\",\n    \"scheme\": \"A\",\n    \"page_total\": 5\n  },\n  \"certified_type\": {\n    \"category\": \"Weighing instrument\",\n    \"type_designations\": [\"PMA-EV\", \"PMA-HD\"],\n    \"description\": \"Instrument series with: 3 feet, 2 adjustable; level indicator; LCD segment display with fixed position touch keys (models EVO1*, LAB1*, SPO1*); LCD graphic display with touch function (models VIS1*); EX-link converter for voltage supply and data transfer (models EVO1X*, LAB1X*, VIS1X*, VIS1Y*). A PC with compatible paint mixing software can be connected to the instruments by the interfaces provided; all devices can be initiated via a PC; preset-tare can only be introduced via a PC. Interfaces: USB either directly (models SPO1S*, EVO1S*, EVO1Y*) or via Ex-Link converter (models EVO1X*, LAB1X*); Ethernet via Ex-link converter (models VIS1X*, VIS1Y*). The instrument is fitted with one strain gauge load cell as per technical data, manufactured by Bizerba. The instrument operates on a 5 V DC power supply provided by USB; for models LAB1X*, EVO1X*, VIS1X*, VIS1Y* power is delivered from USB to Ex-link converter, and then to the instrument via RJ-45. Software: permitted versions BAC (software ID 05496, 1578 for VIS models, version 00-56-02.xx) and APC (only VIS models, software ID 6587, version 01-72-03.xx), where xx reflects legally non-relevant changes. Access to the legally relevant parameters and download of software is only possible via the Menu access switch. Sealing: access to the electronics and load cell is prevented by two tamper evident labels on the underside of the instrument; access to the Menu access switch is prevented by a tamper evident label covering the switch.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\n        \"model_id\": \"PMA-EV\",\n        \"label\": \"PMA-EV\",\n        \"attributes\": {\n          \"accuracy_class\": \"II\",\n          \"included_models\": [\"EVO1S1N3CI-C\", \"EVO1S1CI-C\", \"EVO1Y1N3CI-C\", \"EVO1Y1CI-C\", \"EVO1X1N3CI-C\", \"EVO1X1CI-C\", \"EVO1X2N3CI-C\", \"EVO1X2CI-C\", \"EVO1X3N3CI-C\", \"EVO1X3CI-C\", \"EVO1X4N3CI-C\", \"EVO1X4CI-C\", \"VIS1Y1M3CI-C\", \"VIS1Y1CI-C\", \"VIS1Y2M3CI-C\", \"VIS1Y2CI-C\", \"VIS1Y3M3CI-C\", \"VIS1Y3CI-C\", \"VIS1Y4M3CI-C\", \"VIS1Y4CI-C\", \"VIS1X1M3CI-C\", \"VIS1X1CI-C\", \"VIS1X2M3CI-C\", \"VIS1X2CI-C\", \"VIS1X3M3CI-C\", \"VIS1X3CI-C\", \"VIS1X4M3CI-C\", \"VIS1X4CI-C\"]\n        }\n      },\n      {\n        \"model_id\": \"PMA-HD\",\n        \"label\": \"PMA-HD\",\n        \"attributes\": {\n          \"accuracy_class\": \"III\",\n          \"included_models\": [\"SPO1S1N3CI-C\", \"SPO1S1CI-C\", \"LAB1X1N3CI-C\", \"LAB1X1CI-C\", \"LAB1X2N3CI-C\", \"LAB1X2CI-C\", \"LAB1X3N3CI-C\", \"LAB1X3CI-C\", \"LAB1X4N3CI-C\", \"LAB1X4CI-C\"]\n        }\n      }\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"load_cell\",\n      \"type_designations\": [\"Bizerba WS8\", \"Bizerba WS3\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"technology\": \"strain gauge\",\n        \"manufacturer\": \"Bizerba\",\n        \"quantity_per_instrument\": 1,\n        \"mapping\": {\"PMA-EV\": \"Bizerba WS8\", \"PMA-HD\": \"Bizerba WS3\"},\n        \"maximum_capacity\": {\n          \"PMA-EV\": {\"value\": 8, \"unit_symbol\": \"kg\", \"unit_id\": null},\n          \"PMA-HD\": {\"value\": 3, \"unit_symbol\": \"kg\", \"unit_id\": null}\n        }\n      }\n    },\n    {\n      \"role\": \"display\",\n      \"type_designations\": [\"EVO1*\", \"LAB1*\", \"SPO1*\", \"VIS1*\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"variants\": [\n          {\"type\": \"LCD segment display with fixed position touch keys\", \"applicable_models\": [\"EVO1*\", \"LAB1*\", \"SPO1*\"]},\n          {\"type\": \"LCD graphic display with touch function\", \"applicable_models\": [\"VIS1*\"]}\n        ]\n      }\n    },\n    {\n      \"role\": \"ex_link_converter\",\n      \"characteristics\": {\n        \"function\": \"voltage supply and data transfer\",\n        \"applicable_models\": [\"EVO1X*\", \"LAB1X*\", \"VIS1X*\", \"VIS1Y*\"]\n      }\n    },\n    {\n      \"role\": \"usb_interface\",\n      \"characteristics\": {\n        \"connection\": \"direct (models SPO1S*, EVO1S*, EVO1Y*) or via Ex-Link converter (models EVO1X*, LAB1X*)\"\n      }\n    },\n    {\n      \"role\": \"ethernet_interface\",\n      \"characteristics\": {\n        \"connection\": \"via Ex-link converter\",\n        \"applicable_models\": [\"VIS1X*\", \"VIS1Y*\"]\n      }\n    },\n    {\n      \"role\": \"initial_zero_setting_device\",\n      \"characteristics\": {\n        \"range\": {\"value\": {\"min\": null, \"max\": 20}, \"unit_symbol\": \"%\", \"unit_id\": null},\n        \"range_reference\": \"Max\"\n      }\n    },\n    {\n      \"role\": \"zero_tracking_device\",\n      \"characteristics\": {\n        \"range\": {\"value\": {\"min\": null, \"max\": 4}, \"unit_symbol\": \"%\", \"unit_id\": null},\n        \"range_reference\": \"Max\"\n      }\n    },\n    {\n      \"role\": \"zero_indicator\",\n      \"characteristics\": {\"applicable_models\": [\"LAB1*\", \"SPO1*\"]}\n    },\n    {\n      \"role\": \"combined_zero_setting_and_tare_balancing_device\"\n    },\n    {\n      \"role\": \"preset_tare_device\",\n      \"characteristics\": {\"introduction\": \"only via a PC\"}\n    },\n    {\n      \"role\": \"approximate_displaying_device\",\n      \"characteristics\": {\"applicable_models\": [\"EVO1*\", \"VIS1*\"]}\n    },\n    {\n      \"role\": \"weight_accumulation_device\"\n    },\n    {\n      \"role\": \"weight_calculating_device\"\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"power_supply_voltage\": {\"value\": 5, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"power_supply_type\": {\"value\": \"DC\", \"unit_symbol\": null, \"unit_id\": null},\n      \"tare_limit\": {\"value\": \"≤ Max\", \"unit_symbol\": null, \"unit_id\": null}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"accuracy_class\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": \"II\"},\n          {\"model\": \"PMA-HD\", \"value\": \"III\"}\n        ]\n      },\n      {\n        \"attribute\": \"maximum_capacity\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": 7500},\n          {\"model\": \"PMA-HD\", \"value\": 2200}\n        ]\n      },\n      {\n        \"attribute\": \"minimum_capacity\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": 5},\n          {\"model\": \"PMA-HD\", \"value\": 20}\n        ]\n      },\n      {\n        \"attribute\": \"scale_interval_e\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": 1},\n          {\"model\": \"PMA-HD\", \"value\": 1}\n        ]\n      },\n      {\n        \"attribute\": \"scale_interval_d\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": 0.1},\n          {\"model\": \"PMA-HD\", \"value\": 1}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_range\",\n        \"unit_symbol\": \"°C\",\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": {\"min\": 10, \"max\": 30}},\n          {\"model\": \"PMA-HD\", \"value\": {\"min\": 10, \"max\": 40}}\n        ]\n      },\n      {\n        \"attribute\": \"load_cell\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": \"Bizerba WS8\"},\n          {\"model\": \"PMA-HD\", \"value\": \"Bizerba WS3\"}\n        ]\n      },\n      {\n        \"attribute\": \"load_cell_maximum_capacity\",\n        \"unit_symbol\": \"kg\",\n        \"values\": [\n          {\"model\": \"PMA-EV\", \"value\": 8},\n          {\"model\": \"PMA-HD\", \"value\": 3}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Technical data by type\",\n      \"columns\": [\"type\", \"models\", \"accuracy_class\", \"maximum_capacity\", \"minimum_capacity\", \"scale_interval_e\", \"scale_interval_d\", \"tare_limit\", \"temperature_range\", \"load_cell\", \"load_cell_maximum_capacity\"],\n      \"column_units\": [null, null, null, \"g\", \"g\", \"g\", \"g\", null, \"°C\", null, \"kg\"],\n      \"rows\": [\n        {\n          \"type\": \"PMA-EV\",\n          \"models\": [\"EVO1S1N3CI-C\", \"EVO1S1CI-C\", \"EVO1Y1N3CI-C\", \"EVO1Y1CI-C\", \"EVO1X1N3CI-C\", \"EVO1X1CI-C\", \"EVO1X2N3CI-C\", \"EVO1X2CI-C\", \"EVO1X3N3CI-C\", \"EVO1X3CI-C\", \"EVO1X4N3CI-C\", \"EVO1X4CI-C\", \"VIS1Y1M3CI-C\", \"VIS1Y1CI-C\", \"VIS1Y2M3CI-C\", \"VIS1Y2CI-C\", \"VIS1Y3M3CI-C\", \"VIS1Y3CI-C\", \"VIS1Y4M3CI-C\", \"VIS1Y4CI-C\", \"VIS1X1M3CI-C\", \"VIS1X1CI-C\", \"VIS1X2M3CI-C\", \"VIS1X2CI-C\", \"VIS1X3M3CI-C\", \"VIS1X3CI-C\", \"VIS1X4M3CI-C\", \"VIS1X4CI-C\"],\n          \"accuracy_class\": \"II\",\n          \"maximum_capacity\": 7500,\n          \"minimum_capacity\": 5,\n          \"scale_interval_e\": 1,\n          \"scale_interval_d\": 0.1,\n          \"tare_limit\": \"≤ Max\",\n          \"temperature_range\": {\"min\": 10, \"max\": 30},\n          \"load_cell\": \"Bizerba WS8\",\n          \"load_cell_maximum_capacity\": 8\n        },\n        {\n          \"type\": \"PMA-HD\",\n          \"models\": [\"SPO1S1N3CI-C\", \"SPO1S1CI-C\", \"LAB1X1N3CI-C\", \"LAB1X1CI-C\", \"LAB1X2N3CI-C\", \"LAB1X2CI-C\", \"LAB1X3N3CI-C\", \"LAB1X3CI-C\", \"LAB1X4N3CI-C\", \"LAB1X4CI-C\"],\n          \"accuracy_class\": \"III\",\n          \"maximum_capacity\": 2200,\n          \"minimum_capacity\": 20,\n          \"scale_interval_e\": 1,\n          \"scale_interval_d\": 1,\n          \"tare_limit\": \"≤ Max\",\n          \"temperature_range\": {\"min\": 10, \"max\": 40},\n          \"load_cell\": \"Bizerba WS3\",\n          \"load_cell_maximum_capacity\": 3\n        }\n      ],\n      \"description\": \"Technical data table; each column corresponds to a certified type (PMA-EV, PMA-HD) covering the listed models.\",\n      \"footnotes\": []\n    },\n    {\n      \"name\": \"Permitted software versions\",\n      \"columns\": [\"software\", \"software_id\", \"software_version\", \"applicable_models\"],\n      \"column_units\": [null, null, null, null],\n      \"rows\": [\n        {\n          \"software\": \"Weighing instrument software BAC\",\n          \"software_id\": \"05496\",\n          \"software_version\": \"00-56-02.xx\",\n          \"applicable_models\": \"all models (software ID 1578 for VIS models)\"\n        },\n        {\n          \"software\": \"Software application APC\",\n          \"software_id\": \"6587\",\n          \"software_version\": \"01-72-03.xx\",\n          \"applicable_models\": \"VIS models only\"\n        }\n      ],\n      \"description\": \"xx in the version numbers reflects legally non-relevant changes. For VIS1 models, software information is displayed via Menu > Settings > Device information; for all other models, by holding 'OK' for 2 seconds then navigating to INFO > Ver.no.\",\n      \"footnotes\": []\n    }\n  ],\n  \"recommendation\": {\n    \"id\": \"R76\",\n    \"edition\": 2006,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [\"II\", \"III\"]\n  }\n}"
    }
