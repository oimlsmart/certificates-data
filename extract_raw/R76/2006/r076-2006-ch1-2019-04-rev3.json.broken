ue\": {\"min\": 500, \"max\": 6200}},\n          {\"model\": \"BC-EG/BC-AG\", \"value\": {\"min\": 5000, \"max\": 12200}},\n          {\"model\": \"BC-EH/BC-AH\", \"value\": {\"min\": 5000, \"max\": 12200}}\n        ]\n      },\n      {\n        \"attribute\": \"verification_scale_interval_e\",\n        \"unit_symbol\": \"mg\",\n        \"values\": [\n          {\"model\": \"BC-EA/BC-AA\", \"value\": {\"min\": 1, \"max\": 2}},\n          {\"model\": \"BC-EB/BC-AB\", \"value\": {\"min\": 1, \"max\": 2}},\n          {\"model\": \"BC-EB/BC-AB (class II)\", \"value\": {\"min\": 1, \"max\": 2}},\n          {\"model\": \"BC-EC/BC-AC\", \"value\": {\"min\": 10, \"max\": 20}}\n        ]\n      },\n      {\n        \"attribute\": \"verification_scale_interval_e\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"BC-ED/BC-AD\", \"value\": {\"min\": 0.01, \"max\": 0.1}},\n          {\"model\": \"BC-EE/BC-AE\", \"value\": {\"min\": 0.1, \"max\": 1}},\n          {\"model\": \"BC-EF/BC-AF\", \"value\": {\"min\": 0.1, \"max\": 1}},\n          {\"model\": \"BC-EG/BC-AG\", \"value\": 1},\n          {\"model\": \"BC-EH/BC-AH\", \"value\": 1}\n        ]\n      },\n      {\n        \"attribute\": \"actual_scale_interval_d\",\n        \"unit_symbol\": \"mg\",\n        \"values\": [\n          {\"model\": \"BC-EA/BC-AA\", \"value\": {\"min\": 0.1, \"max\": 2}},\n          {\"model\": \"BC-EB/BC-AB\", \"value\": {\"min\": 0.1, \"max\": 2}},\n          {\"model\": \"BC-EB/BC-AB (class II)\", \"value\": {\"min\": 0.1, \"max\": 2}},\n          {\"model\": \"BC-EC/BC-AC\", \"value\": {\"min\": 1, \"max\": 20}}\n        ]\n      },\n      {\n        \"attribute\": \"actual_scale_interval_d\",\n        \"unit_symbol\": \"g\",\n        \"values\": [\n          {\"model\": \"BC-ED/BC-AD\", \"value\": {\"min\": 0.001, \"max\": 0.1}},\n          {\"model\": \"BC-EE/BC-AE\", \"value\": {\"min\": 0.01, \"max\": 1}},\n          {\"model\": \"BC-EF/BC-AF\", \"value\": {\"min\": 0.01, \"max\": 1}},\n          {\"model\": \"BC-EG/BC-AG\", \"value\": {\"min\": 0.1, \"max\": 1}},\n          {\"model\": \"BC-EH/BC-AH\", \"value\": {\"min\": 0.1, \"max\": 1}}\n        ]\n      },\n      {\n        \"attribute\": \"max_number_of_scale_intervals\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"BC-EA/BC-AA\", \"value\": {\"min\": null, \"max\": 320000}},\n          {\"model\": \"BC-EB/BC-AB\", \"value\": {\"min\": null, \"max\": 220000}},\n          {\"model\": \"BC-EB/BC-AB (class II)\", \"value\": {\"min\": null, \"max\": 100000}},\n          {\"model\": \"BC-EC/BC-AC\", \"value\": {\"min\": null, \"max\": 150000}},\n          {\"model\": \"BC-ED/BC-AD\", \"value\": {\"min\": null, \"max\": 65000}},\n          {\"model\": \"BC-EE/BC-AE\", \"value\": {\"min\": null, \"max\": 62000}},\n          {\"model\": \"BC-EF/BC-AF\", \"value\": {\"min\": null, \"max\": 62000}},\n          {\"model\": \"BC-EG/BC-AG\", \"value\": {\"min\": null, \"max\": 12200}},\n          {\"model\": \"BC-EH/BC-AH\", \"value\": {\"min\": null, \"max\": 12200}}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_range_1\",\n        \"unit_symbol\": \"°C\",\n        \"values\": [\n          {\"model\": \"BC-EA/BC-AA\", \"value\": {\"min\": 17, \"max\": 27}},\n          {\"model\": \"BC-EB/BC-AB\", \"value\": {\"min\": 17, \"max\": 27}},\n          {\"model\": \"BC-EB/BC-AB (class II)\", \"value\": {\"min\": 10, \"max\": 30}},\n          {\"model\": \"BC-EC/BC-AC\", \"value\": {\"min\": 17, \"max\": 27}},\n          {\"model\": \"BC-ED/BC-AD\", \"value\": {\"min\": 10, \"max\": 30}},\n          {\"model\": \"BC-EE/BC-AE\", \"value\": {\"min\": 10, \"max\": 30}},\n          {\"model\": \"BC-EF/BC-AF\", \"value\": {\"min\": 10, \"max\": 30}}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_range_2\",\n        \"unit_symbol\": \"°C\",\n        \"values\": [\n          {\"model\": \"BC-EA/BC-AA\", \"value\