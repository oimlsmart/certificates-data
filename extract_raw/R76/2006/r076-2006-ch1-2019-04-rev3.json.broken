      "text": "{\n  \"certificate\": {\n    \"number\": \"R076/2006-A-CH1-2019.04\",\n    \"scheme\": \"A\",\n    \"page_total\": 4,\n    \"member_state\": \"Switzerland\",\n    \"date_issued\": \"2021-04-15\",\n    \"oiml_issuer_id\": \"CH1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Federal Institute of Metrology METAS\",\n    \"address_lines\": [\"Lindenweg 50\", \"3003 Bern-Wabern\", \"Switzerland\"],\n    \"person_responsible\": \"Gulian Couvreur\",\n    \"person_title\": \"Head of METAS-Cert\",\n    \"phone\": \"+41 58 387 01 11\",\n    \"website\": \"www.metas.ch\",\n    \"oiml_issuer_id\": \"CH1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Sartorius Lab Instruments GmbH & Co KG\",\n      \"address_lines\": [\"Otto-Brenner-Strasse 20\", \"37079 Göttingen\", \"Germany\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Sartorius Scientific Instruments (Beijing) Co, Limited\",\n      \"address_lines\": [\"Yu An Road No. 33, Zone B\", \"Tianzhu Airport Industrialzone, Shunyi District\", \"101 300 Beijing\", \"PR China\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Non-automatic weighing instrument\",\n    \"type_designations\": [\"BC-EA\", \"BC-EB\", \"BC-EC\", \"BC-ED\", \"BC-EE\", \"BC-EF\", \"BC-EG\", \"BC-EH\", \"BC-AA\", \"BC-AB\", \"BC-AC\", \"BC-AD\", \"BC-AE\", \"BC-AF\", \"BC-AG\", \"BC-AH\"],\n    \"module_designation\": null,\n    \"description\": \"Precision and analysis balances BC-E and BC-A Line\"\n  },\n  \"model_family\": {\n    \"family_name\": \"BC-E and BC-A Line\",\n    \"models\": [\n      {\"model_id\": \"BC-EA/BC-AA\", \"label\": \"Accuracy class I\"},\n      {\"model_id\": \"BC-EB/BC-AB\", \"label\": \"Accuracy class I\"},\n      {\"model_id\": \"BC-EB/BC-AB (class II)\", \"label\": \"Accuracy class II; printed in the certificate with the same designation BC-EB/BC-AB\"},\n      {\"model_id\": \"BC-EC/BC-AC\", \"label\": \"Accuracy class I\"},\n      {\"model_id\": \"BC-ED/BC-AD\", \"label\"