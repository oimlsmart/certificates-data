      "text": "{\n  \"certificate\": {\n    \"number\": \"R76/1992-GB1-10.04\",\n    \"project_number\": \"T1128/0107\",\n    \"page_total\": 4,\n    \"member_state\": \"United Kingdom of Great Britain and Northern Ireland\",\n    \"date_issued\": \"2014-05-19\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"National Measurement Office\",\n    \"address_lines\": [\"Stanton Avenue\", \"Teddington\", \"TW11 0JZ\", \"United Kingdom\"],\n    \"person_responsible\": \"Paul Dixon\",\n    \"person_title\": \"Director, Product Certification\",\n    \"phone\": \"+44 (0)20 8943 7272\",\n    \"website\": \"www.gov.uk/nmo\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"CAS Corporation\",\n      \"address_lines\": [\"#262, Geurugogae-ro\", \"Gwangjeok-myeon\", \"Yangju-si\", \"Gyeonggi-do\", \"Republic of Korea\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"CAS Corporation\",\n      \"address_lines\": [\"#262, Geurugogae-ro\", \"Gwangjeok-myeon\", \"Yangju-si\", \"Gyeonggi-do\", \"Republic of Korea\"]\n    },\n    {\n      \"name\": \"Shanghai CAS Electronics Co., Ltd\",\n      \"address_lines\": [\"Maixinroad 448\", \"Xinqiaozhen\", \"Songjiangqu\", \"Shanghai\", \"China\"]\n    },\n    {\n      \"name\": \"CAS Elektronik San. Tic. A.S.\",\n      \"address_lines\": [\"Yukari Dudulu, Bostancı Cad. Mevdudi Sokak No: 34\", \"Umraniye-Istanbul\", \"Turkey\"]\n    },\n    {\n      \"name\": \"CAS (Zhejiang) Electronics Co., Ltd\",\n      \"address_lines\": [\"99# Changjiang Road\", \"Jiashan County\", \"Zhejiang Province\", \"China\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Non-automatic weighing instrument\",\n    \"type_designations\": [\"SW Series\", \"ED\", \"ER PLUS\", \"ER PLUS-M\", \"SW-1\", \"SW-1S\", \"SW-1C\", \"SW-1W\", \"SW-1LR\", \"SW-1WR\", \"ER JR\", \"PW-II\"],\n    \"module_designation\": null,\n    \"description\": \"Class III, mains or battery-operated, self-indicating, non-automatic weighing instruments designated SW Series, comprising the ED, ER PLUS, ER PLUS-M, SW-1, ER JR and PW-II models and their variants. Steel construction with operator's keypad, stainless steel load receptor, level indicator, and operator and customer display. Devices: initial zero setting device, semi-automatic zero setting device, zero tracking device, zero indicator, net indicator, semi-automatic subtractive tare balancing device, gravity compensation, and check weighing and weighing unstable samples modes (SW-1S, SW-1C, SW-1W, SW-1LR, SW-1WR, ER JR, PW-II and ED models only). Sealing: access to the load cell and calibration switch is prevented by sealing the enclosure using a wire-and-seal or tamper-evident sticker.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"SW Series\",\n    \"models\": [\n      {\"model_id\": \"ED single-interval Max 3 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"ED single-interval Max 6 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"ED single-interval Max 15 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"ED single-interval Max 30 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"ER PLUS/ER PLUS M single-interval Max 6 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"ER PLUS/ER PLUS M single-interval Max 15 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"ER PLUS/ER PLUS M single-interval Max 30 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"SW-1S/SW-1C/SW-1W/SW-1LR/SW-1WR single-interval Max 2 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"SW-1S/SW-1C/SW-1W/SW-1LR/SW-1WR single-interval Max 3 kg\", \"attributes\": {\"interval_type\": \"single-interval\"}},\n      {\"model_id\": \"SW-1S/SW-1C/SW-1W/SW-1LR/SW-1WR single-interval Max 5 kg\", \"