      "text": "{\n  \"certificate\": {\n    \"number\": \"R76/1992-GB1-10.04\",\n    \"scheme\": \"B\",\n    \"project_number\": \"T1128/0107\",\n    \"page_total\": 4,\n    \"member_state\": \"United Kingdom of Great Britain and Northern Ireland\",\n    \"date_issued\": \"2014-05-12\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"National Measurement Office\",\n    \"address_lines\": [\"Stanton Avenue\", \"Teddington\", \"TW11 0JZ\", \"United Kingdom\"],\n    \"person_responsible\": \"Paul Dixon\",\n    \"person_title\": \"Director, Product Certification\",\n    \"phone\": \"+44 (0)20 8943 7272\",\n    \"email\": null,\n    \"website\": \"www.bis.gov.uk/nmo\",\n    \"oiml_issuer_id\": null\n  },\n  \"applicants\": [\n    {\n      \"name\": \"CAS Corporation\",\n      \"address_lines\": [\"19 Ganap-Ri\", \"Gwangjuk-Myoun\", \"Yangju-Si\", \"Gyeonggi-Do 482-841\", \"Republic of Korea\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"CAS Corporation\",\n      \"address_lines\": [\"19 Ganap-Ri\", \"Gwangjuk-Myoun\", \"Yangju-Si\", \"Gyeonggi-Do 482-841\", \"Republic of Korea\"]\n    },\n    {\n      \"name\": \"Shanghai CAS Electronics Co., Ltd\",\n      \"address_lines\": [\"Maixinroad 448\", \"Xinqiaozhen\", \"Songjiangqu\", \"Shanghai\", \"China\"]\n    },\n    {\n      \"name\": \"CAS Elektronik San. Tic. A.S.\",\n      \"address_lines\": [\"Yukari Dudulu\", \"Bostanci Cad. Mevdudi Sokak No: 34\", \"Umraniye-Istanbul\", \"Turkey\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Non-automatic weighing instrument\",\n    \"type_designations\": [\"SW Series\", \"ED\", \"ER PLUS\", \"ER PLUS-M\", \"SW-1\", \"SW-1S\", \"SW-1C\", \"SW-1W\", \"SW-1LR\", \"SW-1WR\", \"ER JR\", \"PW-II\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Class III, mains or battery-operated, self-indicating, non-automatic weighing instruments designated SW Series and comprising the ED, ER PLUS, ER PLUS-M, SW-1, ER JR and PW-II models and their variants, in single-interval and dual-interval versions. Construction: steel construction, operator's keypad, stainless steel load receptor, level indicator, operator and customer display. Devices: initial zero setting device (≤ 20% of Max), semi-automatic zero setting device (≤ 4% of Max), zero tracking device (≤ 4% of Max), zero indicator, net indicator, semi-automatic subtractive tare balancing device, gravity compensation, and check weighing and weighing unstable samples modes (SW-1S, SW-1C, SW-1W, SW-1LR, SW-1WR, ER JR, PW-II and ED models only). Sealing: access to the load cell and calibration switch is prevented by sealing the enclosure using a wire-and-seal or tamper-evident sticker. Load cell: CAS load cell, model SW. Power supply: any compatible CE-marked mains adaptor supplying 12 V DC (ED, ER PLUS, SW-1 and ER JR models) or 9 V DC (PW-II model), or integrated batteries.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"SW Series\",\n    \"models\": [\n      {\"model_id\": \"ED Max=3kg (single-interval)\", \"label\": \"ED, single-interval, Max 3 kg\", \"attributes\": {\"interval_configuration\": \"single-interval\"}},\n      {\"model_id\": \"ED Max=6kg (single-interval)\", \"label\": \"ED, single-interval, Max 6 kg\", \"attributes\": {\"interval_configuration\": \"single-interval\"}},\n      {\"model_id\": \"ED Max=15kg (single-interval)\", \"label\": \"ED, single-interval, Max 15 kg\", \"attributes\": {\"interval_configuration\": \"single-interval\"}},\n      {\"model_id\": \"ED Max=30kg (single-interval)\", \"label\": \"ED, single-interval, Max 30 kg\", \"attributes\": {\"interval_configuration\": \"single-interval\"}},\n      {\"model_id\": \"ER PLUS-M Max=6kg (single-interval)\", \"label\": \"ER PLUS and ER PLUS-M, single-interval, Max 6 kg\", \"attributes\": {\"interval_configuration\": \"single-interval\"}},\n      {\"model_id\": \"ER PLUS-M Max=15kg (single-interval)\", \"label\": \"ER PLUS and ER PLUS-M, single-interval, Max 15 kg\"