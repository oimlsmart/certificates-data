S\", \"SW-1C\", \"SW-1W\", \"SW-1LR\", \"SW-1WR\"]}},\n      {\"model_id\": \"SW-1 Max=4/10kg (dual-interval)\", \"label\": \"SW-1S, SW-1C, SW-1W, SW-1LR, SW-1WR — dual-interval, Max1/Max2 = 4/10 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\", \"submodels\": [\"SW-1S\", \"SW-1C\", \"SW-1W\", \"SW-1LR\", \"SW-1WR\"]}},\n      {\"model_id\": \"SW-1 Max=6/15kg (dual-interval)\", \"label\": \"SW-1S, SW-1C, SW-1W, SW-1LR, SW-1WR — dual-interval, Max1/Max2 = 6/15 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\", \"submodels\": [\"SW-1S\", \"SW-1C\", \"SW-1W\", \"SW-1LR\", \"SW-1WR\"]}},\n      {\"model_id\": \"SW-1 Max=10/20kg (dual-interval)\", \"label\": \"SW-1S, SW-1C, SW-1W, SW-1LR, SW-1WR — dual-interval, Max1/Max2 = 10/20 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\", \"submodels\": [\"SW-1S\", \"SW-1C\", \"SW-1W\", \"SW-1LR\", \"SW-1WR\"]}},\n      {\"model_id\": \"SW-1 Max=15/30kg (dual-interval)\", \"label\": \"SW-1S, SW-1C, SW-1W, SW-1LR, SW-1WR — dual-interval, Max1/Max2 = 15/30 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\", \"submodels\": [\"SW-1S\", \"SW-1C\", \"SW-1W\", \"SW-1LR\", \"SW-1WR\"]}},\n      {\"model_id\": \"ER JR Max=3/6kg (dual-interval)\", \"label\": \"ER JR, dual-interval, Max1/Max2 = 3/6 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\"}},\n      {\"model_id\": \"ER JR Max=6/15kg (dual-interval)\", \"label\": \"ER JR, dual-interval, Max1/Max2 = 6/15 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\"}},\n      {\"model_id\": \"ER JR Max=15/30kg (dual-interval)\", \"label\": \"ER JR, dual-interval, Max1/Max2 = 15/30 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\"}},\n      {\"model_id\": \"PW-II Max=1/2kg (dual-interval)\", \"label\": \"PW-II, dual-interval, Max1/Max2 = 1/2 kg\", \"attributes\": {\"interval_configuration\": \"dual-interval\"}},\n      {\"model_id\": \"PW-II Max=2.5/5kg (dual-interval