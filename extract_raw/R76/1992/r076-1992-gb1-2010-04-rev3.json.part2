      "text": "{\n  \"certificate\": {\n    \"number\": \"R76/1992-GB1-10.04\",\n    \"page_total\": 4,\n    \"date_issued\": \"2014-05-19\"\n  },\n  \"recommendation\": {\n    \"id\": \"R76\",\n    \"edition\": 1992\n  },\n  \"manufacturers\": [\n    {\n      \"name\": \"CAS (Zhejiang) Electronics Co., Ltd\",\n      \"address_lines\": [\n        \"99# Changjiang Road\",\n        \"Jiashan County\",\n        \"Zhejiang Province\",\n        \"China\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Non-automatic weighing instrument\",\n    \"type_designations\": [\n      \"ED\",\n      \"ER PLUS\",\n      \"SW-1\",\n      \"SW-1S\",\n      \"SW-1C\",\n      \"SW-1W\",\n      \"SW-1LR\",\n      \"SW-1WR\",\n      \"ER JR\",\n      \"PW-II\"\n    ],\n    \"description\": \"Steel construction with operator's keypad, stainless steel load receptor, level indicator, and operator and customer display. Equipped with initial zero setting device, semi-automatic zero setting device, zero tracking device, zero indicator, net indicator, semi-automatic subtractive tare balancing device and gravity compensation. Access to the load cell and calibration switch is prevented by sealing the enclosure using a wire-and-seal or tamper-evident sticker.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"ED\"},\n      {\"model_id\": \"ER PLUS\"},\n      {\"model_id\": \"SW-1\"},\n      {\"model_id\": \"SW-1S\"},\n      {\"model_id\": \"SW-1C\"},\n      {\"model_id\": \"SW-1W\"},\n      {\"model_id\": \"SW-1LR\"},\n      {\"model_id\": \"SW-1WR\"},\n      {\"model_id\": \"ER JR\"},\n      {\"model_id\": \"PW-II\"}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"load_cell\",\n      \"type_designations\": [\"SW\"],\n      \"characteristics\": {\n        \"manufacturer\": {\"value\": \"CAS\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"temperature_range\": {\"value\": {\"min\": -10, \"max\": 40}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_type\": {\"value\": \"DC\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"mains_adaptor\": {\"value\": \"any compatible CE-marked\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"initial_zero_setting_range\": {\"value\": {\"min\": null, \"max\": 20}, \"unit_symbol\": \"% of Max\", \"unit_id\": null, \"footnote_markers\": []},\n      \"semi_automatic_zero_setting_range\": {\"value\": {\"min\": null, \"max\": 4}, \"unit_symbol\": \"% of Max\", \"unit_id\": null, \"footnote_markers\": []},\n      \"zero_tracking_range\": {\"value\": {\"min\": null, \"max\": 4}, \"unit_symbol\": \"% of Max\", \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"power_supply_voltage\",\n        \"unit_symbol\": \"V\",\n        \"values\": [\n          {\"model\": \"ED\", \"value\": 12, \"footnote_markers\": []},\n          {\"model\": \"ER PLUS\", \"value\": 12, \"footnote_markers\": []},\n          {\"model\": \"SW-1\", \"value\": 12, \"footnote_markers\": []},\n          {\"model\": \"ER JR\", \"value\": 12, \"footnote_markers\": []},\n          {\"model\": \"PW-II\", \"value\": 9, \"footnote_markers\": []}\n        ]\n      },\n      {\n        \"attribute\": \"battery_configuration\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"ED\", \"value\": \"integrated rechargeable 6 V 3.6 Ah battery\", \"footnote_markers\": []},\n          {\"model\": \"ER PLUS\", \"value\": \"integrated rechargeable 6 V 3.6 Ah battery\", \"footnote_markers\": []},\n          {\"model\": \"ER JR\", \"value\": \"integrated rechargeable 6 V 3.6 Ah battery OR integrated 4 x 1.5 V D type batteries\", \"footnote_markers\": []},\n          {\"model\": \"SW-1\", \"value\": \"integrated rechargeable 6 V 3.5 Ah battery\", \"footnote_markers\": []},\n          {\"model\": \"PW-II\", \"value\": \"integrated 6 x 1.5 V AA batteries\", \"footnote_markers\": []}\n        ]\n      },\n      {\n        \"attribute\": \"battery_capacity\",\n        \"unit_symbol\": \"Ah\",\n        \"values\": [\n          {\"model\": \"ED\", \"value\": 3.6, \"footnote_markers\": []},\n          {\"model\": \"ER PLUS\", \"value\": 3.6, \"footnote_markers\": []},\n          {\"model\": \"ER JR\", \"value\": 3.6, \"footnote_markers\": []},\n          {\"model\": \"SW-1\", \"value\": 3.5, \"footnote_markers\": []}\n        ]\n      },\n      {\n        \"attribute\": \"check_weighing_and_weighing_unstable_samples_modes\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"SW-1S\", \"value\": true, \"footnote_markers\": []},\n          {\"model\": \"SW-1C\", \"value\": true, \"footnote_markers\": []},\n          {\"model\": \"SW-1W\", \"value\": true, \"footnote_markers\": []},\n          {\"model\": \"SW-1LR\", \"value\": true, \"footnote_markers\": []},\n          {\"model\": \"SW-1WR\", \"value\": true, \"footnote_markers\": []},\n          {\"model\": \"ER JR\", \"value\": true, \"footnote_markers\": []},\n          {\"model\": \"PW-II\", \"value\": true, \"footnote_markers\": []},\n          {\"model\": \"ED\", \"value\": true, \"footnote_markers\": []}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"semi_automatic_subtractive_tare_range\",\n        \"axis\": \"instrument type\",\n        \"values\": [\n          {\"condition\": \"single-interval instruments\", \"value\": {\"min\": null, \"max\": -50}, \"unit_symbol\": \"% of Max\", \"footnote_markers\": []},\n          {\"condition\": \"dual-interval instruments\", \"value\": \"-Max1\", \"unit_symbol\": null, \"footnote_markers\": []}\n        ]\n      }\n    ]\n  },\n  \"revision_history\": [\n    {\n      \"revision\": \"0\",\n      \"date\": \"2009-05-27\",\n      \"changes\": \"Certificate first issued\"\n    },\n    {\n      \"revision\": \"1\",\n      \"date\": \"2012-09-04\",\n      \"changes\": \"Load cell and technical data sections added.\"\n    },\n    {\n      \"revision\": \"2\",\n      \"date\": \"2014-05-12\",\n      \"changes\": \"Single-interval instruments added. Max tare value added to devices section. Sealing section added.\"\n    },\n    {\n      \"revision\": \"3\",\n      \"date\": \"2014-05-19\",\n      \"changes\": \"Applicant's address changed from 19 Ganap-Ri, Gwangjuk-Myoun, Yangju-Si, Gyeonggi-Do 482-841, Republic of Korea. Alternative manufacturer added.\"\n    }\n  ]\n}"
