      "text": "{\n  \"certificate\": {\n    \"number\": \"R 117/2007-A-NL1-22.02\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2638810\",\n    \"page_total\": 15,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2022-04-07\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\n      \"Thijsseweg 11\",\n      \"2629 JA Delft\",\n      \"The Netherlands\"\n    ],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Silea Liquid Transfer S.r.l.\",\n      \"address_lines\": [\n        \"Via 1° Maggio, 31\",\n        \"40064 Ozzano dell'Emilia (BO)\",\n        \"Italy\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Silea Liquid Transfer S.r.l.\",\n      \"address_lines\": [\n        \"Via 1° Maggio, 31\",\n        \"40064 Ozzano dell'Emilia (BO)\",\n        \"Italy\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Measuring system\",\n    \"type_designations\": [\n      \"(Un)Loading, transferring, measuring system for depot, oil terminal, airport\"\n    ],\n    \"module_designation\": null,\n    \"description\": \"An interruptible measuring system for liquids other than water. Each measuring instrument consists at least of: one pump, one measurement transducer (meter), one calculating/indicating device (calculator), and optionally one gas elimination device (gas extractor). If air or gas can possibly enter the system, for example when the supply tank becomes empty, then a gas elimination device or an empty detection device should be installed.\"\n  },\n  \"components\": [\n    {\n      \"role\": \"mechanical measurement transducer\",\n      \"type_designations\": [\"DM\", \"BMxxx\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"manufacturer\": \"Silea Liquid Transfer S.r.l.\",\n        \"test_report_ids\": [\"NMi-19017928-01\", \"NMi-2273797-01\"]\n      }\n    },\n    {\n      \"role\": \"measurement sensor\",\n      \"type_designations\": [\"CMFxxxy\", \"DS600\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"manufacturer\": \"Emerson Process Management Flow B.V.\",\n        \"test_report_ids\": [\n          \"CVN-201269\", \"CVN-207999-01\", \"CVN-410178-1\", \"CVN-410178-2\",\n          \"CVN-410178-3\", \"CVN-410178-4\", \"C-SP/603876\", \"CPC-607580-1\",\n          \"CPC-802620-01\", \"NMi-10200543-2\", \"NMi-11200345-2\", \"NMi-1901179-01\"\n        ]\n      }\n    },\n    {\n      \"role\": \"core processor\",\n      \"type_designations\": [\"700\", \"800\", \"820\", \"1700\", \"2500\", \"2700\", \"3500\", \"3700\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"manufacturer\": \"Emerson Process Management Flow B.V.\",\n        \"series_name\": \"MVD series\",\n        \"test_report_ids\": [\n          \"CPC-307228-1\", \"CPC-607580-1\", \"CPC-610406-2\", \"CPC-710466-1\",\n          \"NMi-11200214-01\", \"NMi-11200214-02\", \"NMi-11200345-2\", \"NMi-11200708-2\",\n          \"NMi-SO12200192-1\", \"NMi-SO12200736-1\", \"NMi-SO13200862-1\",\n          \"NMi-SO13203381-01\", \"NMi-SO13204037-01\", \"NMi-SO14200881-01\",\n          \"NMi-1901208-01\", \"NMi-1901208-02\", \"NMi-1902436-01\"\n        ]\n      }\n    },\n    {\n      \"role\": \"flow transmitter\",\n      \"type_designations\": [\"5700*1(2,3 or 5)A***ZZ*\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"manufacturer\": \"Emerson Process Management Flow B.V.\",\n        \"test_report_ids\": [\n          \"NMi-1902436-01\", \"NMi-2571596-01\", \"NMi-14200115-01\", \"NMi-14200115-02\",\n          \"NMi-14200115-03\", \"NMi-14200115-04\", \"NMi-14200115-05\", \"NMi-14200115-06\",\n          \"NMi-15200770-01\"\n        ]\n      }