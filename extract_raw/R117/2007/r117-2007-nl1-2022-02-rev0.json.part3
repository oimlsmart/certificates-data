\"checksum_2\": \"756C1BFD\", \"version_3\": \"4.70\", \"checksum_3\": \"AEB92E3F\"}\n5. {\"version\": \"3.50\", \"checksum\": \"D9343F05\", \"version_2\": \"4.00\", \"checksum_2\": \"C582F843\", \"version_3\": \"4.80\", \"checksum_3\": \"F1583A44\"}\n6. {\"version\": \"3.52\", \"checksum\": \"132CCB63\", \"version_2\": \"4.02\", \"checksum_2\": \"8D61C368\", \"version_3\": \"4.9\", \"checksum_3\": \"6083BF9B\"}\n7. {\"version\": \"3.6\", \"checksum\": \"A9CA4E81\", \"version_2\": \"4.14\", \"checksum_2\": \"40860C63\", \"version_3\": \"5.08\", \"checksum_3\": \"4D368E71\"}\n8. {\"version\": \"3.61–ETO17170\", \"checksum\": \"9AA358FF\", \"version_2\": \"4.20\", \"checksum_2\": \"2983A9BE\", \"version_3\": \"5.1\", \"checksum_3\": \"82C541D9\"}\n9. {\"version\": \"3.7\", \"checksum\": \"BE73CD62\", \"version_2\": \"4.21–ETO21931\", \"checksum_2\": \"D6349259\", \"version_3\": \"5.2\", \"checksum_3\": \"BD69FDD6\"}\n10. {\"version\": \"3.71–ETO18982\", \"checksum\": \"580D32B6\", \"version_2\": \"4.40\", \"checksum_2\": \"B280233F\", \"version_3\": \"5.22\", \"checksum_3\": \"F4A8D922\"}\n11. {\"version\": \"3.8\", \"checksum\": \"8CA8E7D1\", \"version_2\": \"4.42\", \"checksum_2\": \"D7BA0841\", \"version_3\": \"5.23–ETO45214\", \"checksum_3\": \"B1D70450\"}\n12. {\"version\": \"3.81–ETO20775\", \"checksum\": \"7931CE3D\", \"version_2\": \"4.50\", \"checksum_2\": \"6B48C624\", \"version_3\": \"5.30\", \"checksum_3\": \"65828884\"}\n\n820 rows:\n1. {\"version\": \"1.00\", \"checksum\": \"52FB 1CF0\", \"version_2\": \"1.30\", \"checksum_2\": \"AC56C460\", \"version_3\": \"1.50\", \"checksum_3\": \"F42A4B2C\"}\n2. {\"version\": \"1.10\", \"checksum\": \"787951AA\", \"version_2\": \"1.40\", \"checksum_2\": \"8B64EF94\", \"version_3\": null, \"checksum_3\": null}\n3. {\"version\": \"1.20\", \"checksum\": \"3B7249F6\", \"version_2\": \"1.41\", \"checksum_2\": \"073C45F2\", \"version_3\": null, \"checksum_3\": null}\n\nSoftware versions with no checksum rows:\n1. {\"part\": [\"1700\", \"2700\"], \"version\": [\"3.2\", \"3.3\", \"3.4\", \"3.4.1\", \"3.5.3\", \"3.6\", \"3.7\", \"4.1\", \"4.2\"], \"remark\": null}\n2. {\"part\": [\"2500\"], \"version\": [\"4.0\", \"4.1\", \"4.2\"], \"remark\": null}\n\n1700/2700/2500 rows:\n1. {\"version\": \"5.0/1.0\", \"checksum\": \"7A7F0B39\", \"version_2\": \"6.4/1.3\", \"checksum_2\": \"B77B25C9\", \"version_3\": \"7.1/1.3\", \"checksum_3\": \"88FB1B5C\"}\n2. {\"version\": \"5.1/1.0\", \"checksum\": \"95F0BC47\", \"version_2\": \"6.5/1.3\", \"checksum_2\": \"88FB1B5C\", \"version_3\": \"7.2/1.3\", \"checksum_3\": \"9ECE81F1\"}\n3. {\"version\": \"5.12/1.0\", \"checksum\": \"A14FBFB9\", \"version_2\": \"6.6/1.3\", \"checksum_2\": \"9ECE81F1\", \"version_3\": \"7.3/1.3\", \"checksum_3\": \"4A5365D4\"}\n4. {\"version\": \"5.2/1.0\", \"checksum\": \"746CBE79\", \"version_2\": \"6.7/1.3\", \"checksum_2\": \"4A5365D4\", \"version_3\": \"8.0/1.3\", \"checksum_3\": \"1E1467F9\"}\n5. {\"version\": \"6.0/1.1\", \"checksum\": \"BB615B55\", \"version_2\": \"6.8/1.3\", \"checksum_2\": \"1E1467F9\", \"version_3\": \"8.02/1.3\", \"checksum_3\": \"201465F9\"}\n6. {\"version\": \"6.1/1.2\", \"checksum\": \"13176BE6\", \"version_2\": \"6.82/1.3\", \"checksum_2\": \"201465F9\", \"version_3\": null, \"checksum_3\": null}\n7. {\"version\": \"6.11–ETO19266\", \"checksum\": \"9B13F21A\", \"version_2\": \"7.0/1.3\", \"checksum_2\": \"B77B25C9\", \"version_3\": null, \"checksum_3\": null}\n\n3500/3700 rows:\n1. {\"version\": \"7.0/1.1\", \"checksum\": \"A1C34F1C\", \"version_2\": \"8.1/1.3\", \"checksum_2\": \"4279A001\", \"version_3\": \"8.41–ETO26097\", \"checksum_3\": \"31D36D05\"}\n2. {\"version\": \"7.1/1.1\", \"checksum\": \"D5783FCF\", \"version_2\": \"8.14/1.3\", \"checksum_2\": \"62F125F2\", \"version_3\": \"8.43–ETO31478\", \"checksum_3\": \"E35DF3C0\"}\n3. {\"version\": \"7.2/1.1\", \"checksum\": \"20609FD3\", \"version_2\": \"8.2/1.4\", \"checksum_2\": \"368139C5\", \"version_3\": \"8.50/1.5\", \"checksum_3\": \"1C146AF7\"}\n4. {\"version\": \"8.0/1.2\", \"checksum\": \"158A12BD\", \"version_2\": \"8.21–ETO23686\", \"checksum_2\": \"D507F464\", \"version_3\": \"8.51-ETO22243\", \"checksum_3\": \"B18A0CB3\"}\n5. {\"version\": \"8.02–ETO18947\", \"checksum\": \"1CC007C4\", \"version_2\": \"8.3/1.4\", \"checksum_2\": \"8F65A9E9\", \"version_3\": null, \"checksum_3\": null}\n6. {\"version\": \"8.03–ETO19299\", \"checksum\": \"2D6104C2\", \"version_2\": \"8.4/1.4\", \"checksum_2\": \"227B10D2\", \"version_3\": null, \"checksum_3\": null}\n\nNow components. Let me reconsider whether to include components. The schema: \"components[]: include ONLY if cert names sub-assemblies\". The fragment names: 700 Core Processor, 800 Enhanced Core Processor, 820 Remote Dual Core Processor, flow transmitter 5700. Yes, include.\n\nFor hardware versions of 800 and 820, I could put them in component characteristics. Let me define component entries with a \"characteristics\" sub-object using structured values? The rule 2 strictness — every characteristic value must be {value, unit_symbol, unit_id, footnote_markers}. For string values like part numbers, unit_symbol/unit_id null. OK:\n\n800 component characteristics:\n- hardware_version_v1: {value: \"20006069\"} — part number\nHmm, naming. Alternatively \"part_number_hardware_v1\".\n\nActually, maybe simpler to not duplicate; the description in matrix_tables holds this. But component-level info is more machine-usable. Given effort/benefit, I'll put hardware version part numbers in the components' characteristics and keep table descriptions shorter with the notes.\n\nLet me draft components:\n\n```json\n{\n  \"role\": \"core processor\",\n  \"type_designations\": [\"700\"]\n},\n{\n  \"role\": \"enhanced core processor\",\n  \"type_designations\": [\"800\"],\n  \"characteristics\": {\n    \"hardware_version_1_part_number\": {\"value\": \"20006069\", \"unit_symbol\": null, \"unit_id\": null},\n    \"hardware_version_2_part_number\": {\"value\": \"20016889\", \"unit_symbol\": null, \"unit_id\": null},\n    \"hardware_version_3_part_number\": {\"value\": \"MMI-20020807, rev. AD\", \"unit_symbol\": null, \"unit_id\": null},\n    \"hardware_version_4_part_number\": {\"value\": \"MMI-20020807, rev. AE\", \"unit_symbol\": null, \"unit_id\": null},\n    \"hardware_version_5_part_number\": {\"value\": \"MMI-20088230, rev. AA\", \"unit_symbol\": null, \"unit_id\": null},\n    \"hardware_version_6_part_number\": {\"value\": \"MMI-20093828, rev. AA\", \"unit_symbol\": null, \"unit_id\": null},\n    \"linearization_activation\": {\"value\": \"ETO number 13511 in Modbus register 5005 (800ECP v3.80 or higher)\", \"unit_symbol\": null, \"unit_id\": null}\n  }\n},\n{\n  \"role\": \"remote dual core processor\",\n  \"type_designations\": [\"820\"],\n  \"characteristics\": {\n    \"hardware_version_1_part_number\": {\"value\": \"MMI-200229698, Rev. AB\", \"unit_symbol\": null, \"unit_id\": null},\n    \"hardware_version_2_part_number\": {\"value\": \"MMI-20029698, Rev. AC\", \"unit_symbol\": null, \"unit_id\": null}\n  }\n},\n{\n  \"role\": \"flow transmitter\",\n  \"type_designations\": [\"5700*1(2,3 or 5)A***ZZ*\"],\n  \"characteristics\": {\n    \"documentation_folder\": {\"value\": \"TC8519-4\", \"unit_symbol\": null, \"unit_id\": null}\n  }\n}\n```\n\nWait, 820 v1 part number: \"MMI-200229698 Rev. AB\" — as printed. And v2: \"MMI-20029698 Rev. AC\". Note the source has inconsistent digits (200229698 vs 20029698) — keep verbatim: \"MMI-200229698 Rev. AB\" and \"MMI-20029698 Rev. AC\".\n\nNotes for 800 v2: \"same as the v1 but equipped with RoHS components\". v4: uses SSM2604 CODEC from different supplier, updated board electronics, software 5.00+, backwards compatible with v1–v3. v5: same CODEC as v4 with added compensation circuit, removal of unused board parts. v6: ADAU1361 CODEC instead of SSM2604, needs software 5.00+.\n\nI could add \"notes\" characteristics but that's verbose. I'll put a summary in the matrix_table description and keep component characteristics to part numbers. Also \"Fuel Consumption feature from v1.10 onwards is not approved\" for 820 — put in 820 table description.\n\nAnd \"800 ECP versions lower than 5.xx are not compatible with hardware version v4\" — description.\n\nManufacturers: [{ \"name\": \"Emerson Process Management Flow B.V.\" }]. Label \"Producer\" — I'll include as manufacturer. \n\nNow, one more consideration: the doc-level \"footnotes\" — I'll skip since scoped. OK.\n\nShould certified_type be omitted? Yes — no info in fragment about the overall type. Omit.\n\ntest_reports: none. Omit.\n\napplicants: none named. Omit.\n\nLet me double check the certificate number: \"R 117/2007-A-NL1-22.02 revision 0\". I'll set number: \"R 117/2007-A-NL1-22.02\". scheme: \"A\". Also recommendation scheme \"A\".\n\nAlso, should certificate include \"revision\"? Not in schema; skip. revision_history with revision \"0\"? The schema example: revision (string, e.g. \"0\"). There's a hint that revision 0 is expected as a revision_history entry! \"revision (string, e.g. '0' not 0)\". Hmm, but revision_history entries need date and changes, which aren't given. I could add {\"revision\": \"0\"} with omitted date/changes. The \"revision 0\" line in the header is present in fragment. I'll include revision_history: [{\"revision\": \"0\"}]. Rules say omit fields not present — date/changes absent, omit them. OK, include just revision \"0\". That seems safe and matches the schema hint.\n\nissuing_authority: name \"NMi\". The headers just say \"NMi\". Include name only.\n\nmatrix_tables name for the no-checksum table: \"Software versions with no checksum\". Good.\n\nAlso note for the 1700/2700/2500 and 3500/3700 tables — these look like software for the 1700/2700/2500/3500/3700 instruments (probably Micro Motion transmitters). Description for each: \"Software versions (application/bootloader) for parts 1700, 2700, 2500\" — I'd rather not fabricate \"application/bootloader\". The versions have format \"5.0/1.0\" — two-part. Don't interpret. Just names.\n\nThe \"See documentation folder page 7057/35-01 with an overview of the ETO Software for the different transmitters.\" — add to 3500/3700 description.\n\nNow assemble final JSON. Keep the en-dashes as \"–\" in version strings.\n\nOne more check: \"5700\\*1(2,3 or 5)A\\*\\*\\*ZZ\\*\" → unescaped: \"5700*1(2,3 or 5)A***ZZ*\". Good.\n\ncertificate.page_total: 15 (from \"Page 8 of 15\"). member_state: \"The Netherlands\". project_number: \"2638810\". date_issued: not present. oiml_issuer_id: not present.\n\nFinal JSON structure:\n\n{\n  \"certificate\": {...},\n  \"issuing_authority\": {\"name\": \"NMi\"},\n  \"manufacturers\": [{\"name\": \"Emerson Process Management Flow B.V.\"}],\n  \"components\": [...],\n  \"matrix_tables\": [...],\n  \"recommendation\": {\"id\": \"R117\", \"edition\": 2007, \"scheme\": \"A\"},\n  \"revision_history\": [{\"revision\": \"0\"}]\n}\n\nHmm, recommendation scheme — is scheme \"A\" a property of the recommendation or cert? Both per schema. Include in both? The schema lists scheme in both certificate and recommendation. I'll include in certificate.scheme and recommendation.scheme.\n\nActually wait — should recommendation.id be \"R117\"? The cert number is \"R 117/2007-A-NL1-22.02\". Canonical id: \"R117\". Edition 2007. Good.\n\nLet me reconsider the 800 note: \"For the 800ECP v3.80 or higher: by writing ETO number 13511 in Modbus register 5005, the linearization feature is enabled.\" I'll include in description.\n\nAlso 800 description includes \"See the documentation folder, section 800 Core Processor\". Include.\n\n820 description: \"Fuel Consumption feature from v1.10 onwards is not approved. 820 versions lower than 1.50 are not compatible with hardware version v2 of the Remote Dual Core Processor. See the documentation folder, section 820 Dual Core-Processor.\"\n\nI'll put hardware part numbers both in component characteristics AND briefly in table descriptions? Redundant. Choose component characteristics only, description references notes about compatibility/features.\n\nHmm, but the component characteristics schema in rule 6 says \"role, type_designations, and any sub-characteristics\" — fine.\n\nLet me also decide: for the 800 component, also add \"software_5xx_hardware_compatibility\" note? Getting too deep. Keep: part numbers + linearization activation. Also for v4 note CODEC change — skip detail, it's in table description... wait I said I'd keep hardware info in component characteristics and compatibility notes in description. Let me put FULL notes in matrix_tables.description to be safe (preserve), and component characteristics hold the structured part numbers. Slight duplication is fine.\n\nActually, to keep response manageable, I'll write concise but complete descriptions.\n\nLet me write the 800 description:\n\n\"Notes: For the 800ECP v3.80 or higher, the linearization feature is enabled by writing ETO number 13511 in Modbus register 5005. 800 ECP versions lower than 5.xx are not compatible with hardware version v4 of the Enhanced Core Processor. Hardware versions: 800 v1 — part number 20006069; 800 v2 — part number 20016889 (same as v1 but equipped with RoHS components); 800 v3 — part number MMI-20020807, rev AD; 800 v4 — part number MMI-20020807, rev. AE (uses the SSM2604 CODEC from a different supplier; updated board electronics; software version 5.00 and higher, backwards compatible with v1, v2 and v3); 800 v5 — part number MMI-20088230, rev. AA (same CODEC as v4 with added compensation circuit and removal of unused board parts); 800 v6 — part number MMI-20093828, rev. AA (uses the ADAU1361 CODEC instead of the SSM2604; needs software version 5.00 and higher). See the documentation folder, section 800 Core Processor.\"\n\nGood.\n\nNow finalize. Output raw JSON without fences.",
