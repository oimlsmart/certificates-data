      "text": "{\n  \"certificate\": {\n    \"number\": \"R 117/2007-A-NL1-22.02\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2638810\",\n    \"page_total\": 15,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2022-04-07\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"person_title\": \"Certification Board\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Silea Liquid Transfer S.r.l.\",\n      \"address_lines\": [\"Via 1° Maggio, 31\", \"40064 Ozzano dell'Emilia (BO)\", \"Italy\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Silea Liquid Transfer S.r.l.\",\n      \"address_lines\": [\"Via 1° Maggio, 31\", \"40064 Ozzano dell'Emilia (BO)\", \"Italy\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Measuring system\",\n    \"type_designations\": [\"(Un)Loading, transferring, measuring system for depot, oil terminal, airport\"],\n    \"module_designation\": null,\n    \"description\": \"Interruptible measuring system for liquids other than water. Each measuring instrument consists at least of one pump, one measurement transducer (meter), one calculating/indicating device (calculator), and optionally one gas elimination device (gas extractor). If air or gas can enter the system (e.g. when the supply tank becomes empty), a gas elimination device or an empty detection device must be installed upstream with sufficient distance of the meter. A non-return valve can be fitted upstream of the measurement sensor to prevent reverse flow being measured. A printer (any brand/type, equipped with paper-out detection) is connected to the flow computer for printing deliveries, events and alarms.\"\n  },\n  \"components\": [\n    {\n      \"role\": \"Measurement transducer (meter)\",\n      \"manufacturer\": \"Silea Liquid Transfer S.r.l.\",\n      \"type_designations\": [\"DM\", \"BMxxx\"],\n      \"documentation_folder\": \"TC12118-1\",\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"maximum_pressure\": {\"value\": 1034, \"unit_symbol\": \"kPa\", \"unit_id\": null, \"footnote_markers\": []},\n        \"environmental_class\": {\"value\": \"M3\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n        \"ambient_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n        \"product_temperature_range\": {\"value\": {\"min\": -5, \"max\": 35}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n        \"intended_measurement\": {\"value\": \"Hydrocarbon based oils and fuels with maximum viscosity of 20 mPa·s at 20 °C\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n        \"impulse_encoder_or_pulser\": {\"value\": \"Eltomatic A/S Impulse Encoder, type 01-09\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n      }\n    },\n    {\n      \"role\": \"Measurement sensor\",\n      \"manufacturer\": \"Emerson Process Management Flow B.V.\",\n      \"type_designations\": [\"CMFxxxy\", \"DS600\"],\n      \"documentation_folder\": \"TC7056-13\",\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"maximum_pressure\": {\"value\": 413, \"unit_symbol\": \"bar\", \"unit_id\": null, \"footnote_markers\": []},\n        \"accuracy_class\": {\"value\": \"0.3 and 0.5\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n        \"environmental_class\": {\"value\": \"M3 / E3\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n        \"ambient_temperature_range\": {\"value\": {\"min\": -40, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n        \"product_temperature_range\": {\"value\": {\"min\": -40, \"max\": 250}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n        \"intended_measurement\": {\"value\": \"Oil and oil products up to 1242 mPa·s\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n      }\n    },\n    {\n      \"role\": \"Core processor\",\n      \"manufacturer\": \"Emerson Process Management Flow B.V.\",\n      \"type_designations\": [\"700\", \"800\", \"820\", \"1700\", \"2500\", \"2700\", \"3500\", \"3700\"],\n      \"documentation_folder\": \"TC7057-17\",\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"product_series\": {\"value\": \"MVD series\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n        \"environmental_class\": {\"value\": \"M3 / E3 for 700, 800, 820, 1700, 2700, 3500, 3700 and dual pulse converter; M2 / E2 for 2500\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n        \"ambient_temperature_range\": {\"value\": {\"min\": -40, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n        \"validated_software_versions\": {\"value\": \"700: v2.0-v3.52; 800: v3.11-v5.30; 820: v1.00-v1.50; 1700/2700/2500: v5.0/1.0-v8.02/1.3 (plus 1700/2700 v3.2-v4.2 and 2500 v4.0-v4.2 without checksums); 3500/3700: v7.0/1.1-v8.51-ETO22243; versions and checksums listed in the certificate\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n      }\n    },\n    {\n      \"role\": \"Flow transmitter\",\n      \"manufacturer\": \"Emerson Process Management Flow B.V.\",\n      \"type_designations\": [\"5700*1(2,3 or 5)A***ZZ*\"],\n      \"documentation_folder\": \"TC8519-4\",\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"environmental_class\": {\"value\": \"M3 / E3 / H3\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n   