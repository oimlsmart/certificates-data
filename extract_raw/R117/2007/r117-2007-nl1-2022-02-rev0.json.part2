      "text": "{\n  \"certificate\": {\n    \"number\": \"R 117/2007-A-NL1-22.02\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2638810\",\n    \"page_total\": 15,\n    \"member_state\": \"The Netherlands\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\"\n  },\n  \"certified_type\": {\n    \"category\": \"Measuring system\",\n    \"description\": \"A non-return valve can be fitted upstream of the measurement sensor to prevent the reverse flow to be measured with the measuring system. A printer is connected to the flow computer and is used for printing the reports (deliveries), events and alarms. The printer can be of any brand and type under the condition that it is equipped with a paper out detection and that the communication with the printer is safeguarded. The characteristics of the mentioned parts of the measuring system are presented at table 3 and higher.\"\n  },\n  \"recommendation\": {\n    \"id\": \"R117\",\n    \"edition\": 2007,\n    \"scheme\": \"A\"\n  },\n  \"components\": [\n    {\n      \"role\": \"measurement_transducer\",\n      \"producer\": \"Silea Liquid Transfer S.r.l.\",\n      \"type_designations\": [\"DM\", \"BM250 (S)\", \"BM950 (S)\", \"BM450 (D)\", \"BM550 (D)\", \"BM350 (D)\", \"BM650 (T)\", \"BM850 (T)\"],\n      \"documentation_folder\": \"TC12118-1\",\n      \"characteristics\": {\n        \"type_level\": {\n          \"maximum_pressure\": {\"value\": 1034, \"unit_symbol\": \"kPa\", \"unit_id\": null},\n          \"environmental_class\": {\"value\": \"M3\", \"unit_symbol\": null, \"unit_id\": null},\n          \"ambient_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n          \"product_temperature_range\": {\"value\": {\"min\": -5, \"max\": 35}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n          \"intended_fluid\": {\"value\": \"Hydrocarbon based oils and fuels\", \"unit_symbol\": null, \"unit_id\": null},\n          \"maximum_viscosity\": {\"value\": 20, \"unit_symbol\": \"mPa·s\", \"unit_id\": null},\n          \"viscosity_reference_temperature\": {\"value\": 20, \"unit_symbol\": \"°C\", \"unit_id\": null},\n          \"impulse_encoder_or_pulser\": {\"value\": \"Eltomatic A/S Impulse Encoder, type 01-09\", \"unit_symbol\": null, \"unit_id\": null}\n        },\n        \"model_level\": [\n          {\n            \"attribute\": \"accuracy_class\",\n            \"unit_symbol\": null,\n            \"values\": [\n              {\"model\": \"BM250 (S)\", \"value\": 0.3},\n              {\"model\": \"BM950 (S)\", \"value\": 0.3},\n              {\"model\": \"BM450 (D)\", \"value\": 0.3},\n              {\"model\": \"BM550 (D)\", \"value\": 0.3},\n              {\"model\": \"BM350 (D)\", \"value\": 0.3},\n              {\"model\": \"BM650 (T)\", \"value\": 0.3},\n              {\"model\": \"BM850 (T)\", \"value\": 0.3},\n              {\"model\": \"DM (S)\", \"value\": 0.3}\n            ]\n          },\n          {\n            \"attribute\": \"flange_size\",\n            \"unit_symbol\": null,\n            \"values\": [\n              {\"model\": \"BM250 (S)\", \"value\": \"2½\\\" (DN 65)\"},\n              {\"model\": \"BM950 (S)\", \"value\": \"3\\\" (DN 80)\"},\n              {\"model\": \"BM450 (D)\", \"value\": \"3\\\" (DN 80)\"},\n              {\"model\": \"BM550 (D)\", \"value\": \"4\\\" (DN 100)\"},\n              {\"model\": \"BM350 (D)\", \"value\": \"4\\\" (DN 100)\"},\n              {\"model\": \"BM650 (T)\", \"value\": \"4\\\" (DN 100)\"},\n              {\"model\": \"BM850 (T)\", \"value\": \"6\\\" (DN 150)\"},\n              {\"model\": \"DM (S)\", \"value\": \"4\\\" (DN 100)\"}\n            ]\n          },\n          {\n            \"attribute\": \"cyclic_volume\",\n            \"unit_symbol\": \"L\",\n            \"values\": [\n              {\"model\": \"BM250 (S)\", \"value\": 2.27},\n              {\"model\": \"BM950 (S)\", \"value\": 2.27},\n              {\"model\": \"BM450 (D)\", \"value\": 4.5