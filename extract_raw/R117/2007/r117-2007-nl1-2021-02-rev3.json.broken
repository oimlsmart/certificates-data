      "text": "{\n  \"certificate\": {\n    \"number\": \"R117/2007-A-NL1-21.02\",\n    \"revision\": \"3\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3800938\",\n    \"page_total\": 9,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2024-09-11\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Emerson Process Management Flow B.V.\",\n      \"address_lines\": [\"Neostraat 1\", \"6718 WX Ede\", \"The Netherlands\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Emerson Process Management Flow B.V.\",\n      \"address_lines\": [\"Neostraat 1\", \"6718 WX Ede\", \"The Netherlands\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Measurement transducer\",\n    \"type_designations\": [\"CMFxxx\", \"CMFHCx\"],\n    \"module_designation\": null,\n    \"description\": \"Measurement transducer consisting of a CMF or CMFHC series measurement sensor combined with MVD series electronics or 5700 electronics, for dynamic measuring systems for liquids other than water. Intended for the measurement of oil and oil products, alcohol, chemicals, potable liquids, liquefied gases under pressure, and cryogenic liquids.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"CMF010y\", \"label\": \"CMF series measurement sensor, size 010\"},\n      {\"model_id\": \"CMF025y\", \"label\": \"CMF series measurement sensor, size 025\"},\n      {\"model_id\": \"CMF050y\", \"label\": \"CMF series measurement sensor, size 050\"},\n      {\"model_id\": \"CMF100y\", \"label\": \"CMF series measurement sensor, size 100\"},\