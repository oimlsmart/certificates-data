      "text": "```json\n{\n  \"certificate\": {\n    \"number\": \"R49-1/2006-NL1-12.01\",\n    \"project_number\": \"12200373\",\n    \"page_total\": 7,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2012-10-22\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\n      \"Hugo de Grootplein 1\",\n      \"3314 EG Dordrecht\",\n      \"The Netherlands\"\n    ],\n    \"person_responsible\": \"C. Oosterman\",\n    \"person_title\": \"Head Certification Board\",\n    \"phone\": \"+31 78 63323232\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"KROHNE Altometer\",\n      \"address_lines\": [\n        \"Kerkeplaat 12\",\n        \"3313 LC Dordrecht\",\n        \"The Netherlands\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"KROHNE Altometer\",\n      \"address_lines\": [\n        \"Kerkeplaat 12\",\n        \"3313 LC Dordrecht\",\n        \"The Netherlands\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"WATERFLUX 3070\"],\n    \"description\": \"Water meter intended for the metering of cold potable water and hot water, based on an electromagnetic principle, designed to measure forward and reverse flow, with (minimum) 0 D straight inlet and outlet, with no flow conditioner and equipped with an electronic calculating/indicating device. Accuracy classes 1 and 2.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"WATERFLUX 3070\",\n    \"models\": [\n      {\"model_id\": \"AC1-DN65-Q3=100\", \"label\": \"DN65, Q3 = 100 m³/h, accuracy class 1\"},\n      {\"model_id\": \"AC1-DN80-Q3=100\", \"label\": \"DN80, Q3 = 100 m³/h, accuracy class 1\"},\n      {\"model_id\": \"AC1-DN80-Q3=160\", \"label\": \"DN80, Q3 = 160 m³/h, accuracy class 1\"},\n      {\"model_id\": \"AC1-DN100-Q3