      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2006-CZ-11.01\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2011-12-19\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"CZ\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Emerson Process Management / Rosemount Flow Division\",\n      \"address_lines\": [\"12001 Technology Drive\", \"Eden Prairie, 553 44 MN\", \"USA\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Emerson Process Management / Rosemount Flow Division\",\n      \"address_lines\": [\"12001 Technology Drive\", \"Eden Prairie, 553 44 MN\", \"USA\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"8732\", \"8705\", \"8711\"],\n    \"description\": \"Magnetic flow meter intended for metering cold and hot potable water, consisting of flow sensor types 8705 and 8711 and of a measuring transducer with electronic calculator type 8732, based on the electromagnetic principle. The flow sensor body is made of stainless and carbon steel with lining material of Neoprene, Polyurethane or PTFE, with standard flanges (type 8705) or flangeless wafer connection (type 8711), with measurement electrodes. The measuring transducer is covered by a stainless steel box with transparent sight hole for LCD display and four buttons; it includes two connector cables for supply and for communication by impulse output and current output, and a two-row LCD display of metrological parameters. Flow sensor and transducer are remote mount design (connected via cable) or compact design. The characteristics tables cover Magnetic Flow Sensor type 8711 with lining material PTFE.\"\n  },\n  \"components\": [\n    {\n      \"role\": \"Measuring transducer (transmitter with electronic calculator)\",\n      \"type_designations\": [\"8732\"]\n    },\n    {\n      \"role\": \"Flow sensor\",\n      \"type_designations\": [\"8705\", \"8711\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"connection\": {\"8705\": \"standard flanges\", \"8711\": \"flangeless (wafer)\"},\n        \"lining_materials\": [\"Neoprene\", \"Polyurethane\", \"PTFE\"]\n      }\n    }\n  ],\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"DN4\", \"attributes\": {\"nominal_diameter\": 4}},\n      {\"model_id\": \"DN8\", \"attributes\": {\"nominal_diameter\": 8}},\n      {\"model_id\": \"DN15\", \"attributes\": {\"nominal_diameter\": 15}},\n      {\"model_id\": \"DN25\", \"attributes\": {\"nominal_diameter\": 25}},\n      {\"model_id\": \"DN40\", \"attributes\": {\"nominal_diameter\": 40}},\n      {\"model_id\": \"DN50\", \"attributes\": {\"nominal_diameter\": 50}},\n      {\"model_id\": \"DN65\", \"attributes\": {\"nominal_diameter\": 65}},\n      {\"model_id\": \"DN80\", \"attributes\": {\"nominal_diameter\": 80}},\n      {\"model_id\": \"DN100\", \"attributes\": {\"nominal_diameter\": 100}},\n      {\"model_id\": \"DN150\", \"attributes\": {\"nominal_diameter\": 150}},\n      {\"model_id\": \"DN200\", \"attributes\": {\"nominal_diameter\": 200}}\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"temperature_class\": {\"value\": \"T90\", \"unit_symbol\": null, \"unit_id\": null},\n      \"ratio_q2_q1\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\": null},\n      \"ratio_q4_q3\": {\"value\": 1.25, \"unit_symbol\": null, \"unit_id\": null},\n      \"max_pressure_loss\": {\"value\": 0.16, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      \"environmental_class\": {\"value\": \"B and C\", \"unit_symbol\": null, \"unit_id\": null},\n      \"electromagnetic_environment\": {\"value\": \"E1 and E2\", \"unit_symbol\": null, \"unit_id\": null},\n      \"minimum_straight_length_inlet_pipe\": {\"value\": 5, \"unit_symbol\": null, \"unit_id\": null},\n      \"minimum_straight_length_outlet_pipe\": {\"value\": 3, \"unit_symbol\": null, \"unit_id\": null},\n      \"orientation_limitation\": {\"value\": \"Arbitrary orientation\", \"unit_symbol\": null, \"unit_id\": null},\n      \"connection_type\": {\"value\": \"Wafer\", \"unit_symbol\": null, \"unit_id\": null},\n      \"power_supply_type\": {\"value\": \"AC or DC\", \"unit_symbol\": null, \"unit_id\": null}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"nominal_diameter\",\n        \"unit_symbol\": \"mm\",\n        \"values\": [\n          {\"model\": \"DN4\", \"value\": 4}, {\"model\": \"DN8\", \"value\": 8}, {\"model\": \"DN15\", \"value\": 15},\n          {\"model\": \"DN25\", \"value\": 25}, {\"model\": \"DN40\", \"value\": 40}, {\"model\": \"DN50\", \"value\": 50},\n          {\"model\": \"DN65\", \"value\": 65}, {\"model\": \"DN80\", \"value\": 80}, {\"model\": \"DN100\", \"value\": 100},\n          {\"model\": \"DN150\", \"value\": 150}, {\"model\": \"DN200\", \"value\": 200}\n        ]\n      },\n      {\n        \"attribute\": \"overload_flowrate_q4_max\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"DN4\", \"value\": {\"min\": null, \"max\": 0.5}}, {\"model\": \"DN8\", \"value\": {\"min\": null, \"max\": 2.0}},\n          {\"model\": \"DN15\", \"value\": {\"min\": null, \"max\": 7.9}}, {\"model\": \"DN25\", \"value\": {\"min\": null, \"max\": 20.0}},\n          {\"model\": \"DN40\", \"value\": {\"min\": null, \"max\": 50.0}}, {\"model\": \"DN50\", \"value\": {\"min\": null, \"max\": 78.8}},\n          {\"model\": \"DN65\", \"value\": {\"min\": null, \"max\": 125}}, {\"model\": \"DN80\", \"value\": {\"min\": null, \"max\": 200}},\n          {\"model\": \"DN100\", \"value\": {\"min\": null, \"max\": 313}}, {\"model\": \"DN150\", \"value\": {\"min\": null, \"max\": 788}},\n          {\"model\": \"DN200\", \"value\": {\"min\": null, \"max\": 1250}}\n        ]\n      },\n    