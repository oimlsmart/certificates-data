\"value\": {\"min\": null, \"max\": 100}, \"footnote_markers\": [\"2)\"]},\n          {\"model\": \"DN80\", \"value\": {\"min\": null, \"max\": 100}, \"footnote_markers\": [\"2)\"]},\n          {\"model\": \"DN100\", \"value\": {\"min\": null, \"max\": 100}, \"footnote_markers\": [\"2)\"]},\n          {\"model\": \"DN150\", \"value\": {\"min\": null, \"max\": 100}, \"footnote_markers\": [\"2)\"]},\n          {\"model\": \"DN200\", \"value\": {\"min\": null, \"max\": 100}, \"footnote_markers\": [\"2)\"]}\n        ]\n      },\n      {\n        \"attribute\": \"accuracy_class\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"DN4\", \"value\": 2}, {\"model\": \"DN8\", \"value\": 2}, {\"model\": \"DN15\", \"value\": 2},\n          {\"model\": \"DN25\", \"value\": 2}, {\"model\": \"DN40\", \"value\": 2}, {\"model\": \"DN50\", \"value\": 2},\n          {\"model\": \"DN65\", \"value\": 1}, {\"model\": \"DN80\", \"value\": 1}, {\"model\": \"DN100\", \"value\": 1},\n          {\"model\": \"DN150\", \"value\": 1}, {\"model\": \"DN200\", \"value\": 1}\n        ]\n      },\n      {\n        \"attribute\": \"mpe_lower_zone\",\n        \"unit_symbol\": \"%\",\n        \"values\": [\n          {\"model\": \"DN4\", \"value\": 5}, {\"model\": \"DN8\", \"value\": 5}, {\"model\": \"DN15\", \"value\": 5},\n          {\"model\": \"DN25\", \"value\": 5}, {\"model\": \"DN40\", \"value\": 5}, {\"model\": \"DN50\", \"value\": 5},\n          {\"model\": \"DN65\", \"value\": 3}, {\"model\": \"DN80\", \"value\": 3}, {\"model\": \"DN100\", \"value\": 3},\n          {\"model\": \"DN150\", \"value\": 3}, {\"model\": \"DN200\", \"value\": 3}\n        ]\n      },\n      {\n        \"attribute\": \"mpe_upper_zone_water_up_to_30c\",\n        \"unit_symbol\": \"%\",\n        \"values\": [\n          {\"model\": \"DN4\", \"value\": 2}, {\"model\": \"DN8\", \"value\": 2}, {\"model\": \"DN15\", \"value\": 2},\n          {\"model\": \"DN25\", \"value\": 2}, {\"model\": \"DN