      "text": "```json\n{\n  \"certificate\": {\n    \"number\": \"R49/2006-CZ-11.01\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2011-06-28\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"CZ\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Emerson Process Management / Rosemount Flow Division\",\n      \"address_lines\": [\"12001 Technology Drive\", \"Eden Prairie, 553 44 MN\", \"USA\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Emerson Process Management / Rosemount Flow Division\",\n      \"address_lines\": [\"12001 Technology Drive\", \"Eden Prairie, 553 44 MN\", \"USA\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Magnetic flow meter\",\n    \"type_designations\": [\"8732\", \"8705\", \"8711\"],\n    \"description\": \"Water meters (magnetic flow meters) intended for metering cold and hot potable water, based on the electromagnetic principle. They consist of a flow sensor (type 8705 with standard flanges, or type 8711 flangeless/wafer) and a measuring transducer with electronic calculator (type 8732). The sensor body is made of stainless and carbon steel with lining of polyurethane or PTFE and is fitted with measurement electrodes. The transmitter is housed in a stainless steel box with transparent sight hole for a two-row LCD display and four buttons, and includes two connector cables for supply and for communication via impulse output and current output. Remote mount design (connected via cable) or compact design.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"8711-DN4\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 4 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 4, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN8\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 8 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 8, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN15\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 15 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 15, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN25\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 25 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 25, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN40\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 40 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 40, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN50\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 50 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 50, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN65\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 65 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 65, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN80\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 80 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 80, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN100\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 100 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 100, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN150\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 150 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 150, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8711-DN200\", \"label\": \"Transmitter 8732 + flow sensor 8711, DN 200 (wafer, PTFE liner)\", \"attributes\": {\"sensor_type\": \"8711\", \"nominal_diameter\": 200, \"connection_type\": \"Wafer\", \"lining_material\": \"PTFE\"}},\n      {\"model_id\": \"8705-DN15\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 15 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 15, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN25\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 25 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 25, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN40\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 40 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 40, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN50\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 50 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 50, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN80\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 80 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 80, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN100\", \"label\": \"T