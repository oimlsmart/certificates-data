DN450\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 450 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 450, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN500\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 500 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 500, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN600\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 600 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 600, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN750\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 750 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 750, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}},\n      {\"model_id\": \"8705-DN900\", \"label\": \"Transmitter 8732 + flow sensor 8705, DN 900 (flanged, PU or PTFE liner)\", \"attributes\": {\"sensor_type\": \"8705\", \"nominal_diameter\": 900, \"connection_type\": \"Standard flanges\", \"lining_material\": \"Polyurethane or PTFE\"}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"measuring_transducer_with_electronic_calculator\",\n      \"type_designations\": [\"8732\"],\n      \"characteristics\": {\"design\": {\"value\": \"Remote mount (connected via cable) or compact design\", \"unit_symbol\": null, \"unit_id\": null}}\n    },\n    {\n      \"role\": \"flow_sensor\",\n      \"type_designations\": [\"8705\", \"8711\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"connection_type_8705\": {\"value\": \"Standard flanges\", \"unit_symbol\": null, \"unit_id\": null},\n 