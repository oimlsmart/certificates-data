11\", value \"Wafer\"}, {condition \"8705\", value \"Standard flanges\"}]\n- lining_material, axis \"sensor_type\": [{condition \"8711\", value \"PTFE\"}, {condition \"8705\", value \"Polyurethane or PTFE\"}]\n- minimum_straight_length_outlet_pipe, axis \"sensor_type\": [{condition \"8711\", value 3}, {condition \"8705\", value 2}]\n- mpe_lower_zone, axis \"accuracy_class\": [{condition \"class 2\", value {min:-5,max:5} \"%\"}, {condition \"class 1\", value {min:-3,max:3} \"%\"}]\n- mpe_upper_zone, axis \"accuracy_class × water_temperature\": [{condition \"class 2, water temperature ≤ 30 °C\", value ±2%}, {condition \"class 2, water temperature > 30 °C\", value ±3%}, {condition \"class 1, water temperature ≤ 30 °C\", value ±1%}, {condition \"class 1, water temperature > 30 °C\", value ±2%}]\n\nconfig_level values form: {condition, value, unit_symbol}. Good.\n\nType-level:\n- ratio_q2_q1: 1.6\n- ratio_q4_q3: 1.25\n- maximum_pressure_loss: 0.16, unit \"bar\"\n- minimum_straight_length_inlet_pipe: 5, unit null (dimensionless, in DN multiples)\n- temperature_classes: value \"T50 (polyurethane liner), T90 (PTFE liner)\" string\n- environmental_classes: \"B and C\"\n- electromagnetic_environment: \"E1 and E2\"\n- orientation_limitation: \"Arbitrary orientation\"\n- ac_power_supply_voltage: {min:90, max:250} V\n- ac_power_supply_frequency: {min:50, max:60} Hz\n- dc_power_supply_voltage: {min:12, max:42} V\n\nAlso meter purpose: description covers it.\n\nmatrix_tables: 5 tables with rows per DN. Columns:\n[\"model_id\", \"sensor_type\", \"nominal_diameter\", \"q4_max\", \"q3_max\", \"q2_min\", \"q1_min\", \"ratio_q3_q1_max\", \"accuracy_class\", \"meter_length\", \"indicating_device_resolution\", \"maximum_admissible_pressure\", \"indicating_range\"]\n\nHmm indicating_range as string \"9999–999999\". Column_units: [null, null, \"mm\", \"m³/h\", \"m³/h\", \"m³/h\", \"m³/h\", null, null, \"mm\", \"L\", \"bar\", \"m³\"].\n\nRows for table 1 (8711, PTFE, DN 4–40):\n- DN4: q4 0.5, q3 0.4, q2 0.00512, q1 0.0032, ratio 125, class 2, length 55, res 0.01, pressure \"0–19\", range \"9999–99999\"\n- DN8: 2.0, 1.6, 0.0205, 0.0128, 125, 2, 55, 0.01, \"0–19\", same range\n- DN15: 7.9, 6.3, 0.0504, 0.032, 200, 2, 56, 0.1, \"0–19\"\n- DN25: 20.0, 16.0, 0.128, 0.08, 200, 2, 57, 0.1, \"0–50\"\n- DN40: 50.0, 40.0, 0.32, 0.2, 200, 2, 73, 1, \"0–50\"\n\nTable 2 (8711, PTFE, DN 50–200):\n- DN50: 78.8, 63.0, 0.504, 0.315, 100, 2, 84, 1, \"0–50\", \"999999–9999999\"\n- DN65: 125, 100, 1.6, 1.0, 100, 1, 120, 1, \"0–50\"\n- DN80: 200, 160, 2.56, 1.6, 100, 1, 149, 1\n- DN100: 313, 250, 4.0, 2.5, 100, 1, 180, 1\n- DN150: 788, 630, 10.1, 6.3, 100, 1, 230, 10\n- DN200: 1250, 1000, 16.0, 10.0, 100, 1, 230, 10\n\nTable 3 (8705, PU & PTFE, DN 15–80):\n- DN15: 7.9, 6.3, 0.0504, 0.032, 200, 2, 200, 0.1, \"0–50\", \"99999–999999\"\n- DN25: 20.0, 16.0, 0.128, 0.08, 200, 2, 200, 0.1\n- DN40: 50.0, 40.0, 0.32, 0.2, 200, 2, 200, 1\n- DN50: 78.8, 63.0, 0.504, 0.315, 200, 2, 200, 1\n- DN80: 200, 160, 2.56, 1.6, 100, 1, 200, 1\n\nTable 4 (8705, DN 100–350):\n- DN100: 313, 250, 4.0, 2.5, 100, 1, 250, 1, \"0–50\", \"999999–9999999\"\n- DN150: 788, 630, 10.1, 6.3, 100, 1, 300, 10\n- DN200: 1250, 1000, 16.0, 10.0, 100, 1, 350, 10\n- DN250: 2000, 1600, 25.6, 16.0, 100, 1, 435, 10\n- DN300: 3125, 2500, 40.0, 25.0, 100, 1, 512, 10\n- DN350: 3125, 2500, 50.0, 31.3, 80, 1, 588, 100\n\nTable 5 (8705, DN 400–900):\n- DN400: 3125, 2500, 63.5, 39.7, 63, 1, 664, 100, \"0–40\", \"9999999\"\n- DN450: 3125, 2500, 80.0, 50.0, 50, 1, 761, 100\n- DN500: 5000, 4000, 101.6, 63.5, 63, 1, 839, 100\n- DN600: 5000, 4000, 128.0, 80.0, 50, 1, 1000, 100\n- DN750: 7875, 6300, 201.6, 126.0, 50, 1, 1200, 100\n- DN900: 12500, 10000, 320.0, 200.0, 50, 1, 1200, 100\n\nFootnotes arrays for each table: footnote 1 and 2.\n\ncertified_type.description: condensed from page 2.\n\ncertified_type:\n- category: \"Water meter\"? or \"Magnetic flow meter\"? I'll go with \"Water meter\" since R49 is Water meters and doc calls them water meters... but identification says \"Magnetic Flow Meter\". The category list includes \"Measuring system\", \"Gas meter\" etc. I'll use \"Magnetic flow meter\" — hmm. Let me think: The certificate's own identification: \"Magnetic Flow Meter\". Description: \"The water meters are intended for metering...\" The product is an electromagnetic flow meter used as a water meter under R49. Category: \"Magnetic flow meter\" is most literal for the certified type. I'll use that.\n\n- module_designation: null or \"Not applicable\"? The cert doesn't state. Omit or null. I'll set null... Actually for R49 water meters, module concept doesn't apply. Doc doesn't mention. Omit (rule 8: don't fabricate). I'll omit field entirely.\n\n- type_designations: [\"8732\", \"8705\", \"8711\"]. Maybe include descriptive: \"Transmitter 8732\", \"Flow sensor 8705\", \"Flow sensor 8711\". The rule: \"all type/model identifiers mentioned\". I'll list [\"8732\", \"8705\", \"8711\"] and also include the full type names in components.\n\nmodel_family.family_name: null.\n\nmodels list with attributes: maybe include sensor_type and dn in attributes per model? The models[]: {model_id, label, attributes{}}. I can add attributes: {sensor_type, nominal_dn, connection, lining}. That's helpful. label: e.g. \"Magnetic flow sensor 8711, DN 4\". \n\nLet me construct models:\n\n8711 models (PTFE liner, wafer):\n1. 8711-DN4\n2. 8711-DN8\n3. 8711-DN15\n4. 8711-DN25\n5. 8711-DN40\n6. 8711-DN50\n7. 8711-DN65\n8. 8711-DN80\n9. 8711-DN100\n10. 8711-DN150\n11. 8711-DN200\n\n8705 models (PU or PTFE liner, flanged):\n12. 8705-DN15\n13. 8705-DN25\n14. 8705-DN40\n15. 8705-DN50\n16. 8705-DN80\n17. 8705-DN100\n18. 8705-DN150\n19. 8705-DN200\n20. 8705-DN250\n21. 8705-DN300\n22. 8705-DN350\n23. 8705-DN400\n24. 8705-DN450\n25. 8705-DN500\n26. 8705-DN600\n27. 8705-DN750\n28. 8705-DN900\n\nI'll include attributes {sensor_type, nominal_diameter_mm, connection_type, lining_material}.\n\nTest report role: \"test_repor