      "text": "{\n  \"certificate\": {\n    \"number\": \"R49-1/2006-NL1-12.02\",\n    \"scheme\": \"A\",\n    \"project_number\": \"SO12200080\",\n    \"page_total\": 7,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2013-01-25\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Hugo de Grootplein 1\", \"3314 EG Dordrecht\", \"The Netherlands\"],\n    \"person_responsible\": \"C. Oosterman\",\n    \"person_title\": \"Head Certification Board\",\n    \"phone\": \"+31 78 6332332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Itron Eau et Energie Thermique\",\n      \"address_lines\": [\"11 Boulevard Pasteur\", \"67500 Haguenau\", \"France\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Itron Eau et Energie Thermique\",\n      \"address_lines\": [\"11 Boulevard Pasteur\", \"67500 Haguenau\", \"France\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"Sharpflow SWB7 + CWB7\", \"SWB7\", \"CWB7\"],\n    \"description\": \"Water meter intended for the metering of cold potable water and hot water, model \\\"Sharpflow SWB7 + CWB7\\\", class 1 and 2, based on an electromagnetic principle, designed to measure forward and reverse flow, with (minimum) 0 D straight inlet and outlet, with no flow conditioner and equipped with an electronic calculating/indicating device.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"Sharpflow\",\n    \"models\": [\n      {\"model_id\": \"DN65 class 1 Q3=100\", \"label\": \"DN65, class 1, Q3=100 m³/h\"},\n      {\"model_id\": \"DN80 class 1 Q3=100\", \"label\": \"DN80, class 1, Q3=100 m³/h\"},\n      {\"model_id\": \"DN80 class 1 Q3=160\", \"label\": \"DN80, class 1, Q3=160 m³/h\"},\n      {\"model_id\": \"DN100 class 1 Q3=160\", \"label\": \"DN100, class 1