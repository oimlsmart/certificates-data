      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2006-CZ-11.01\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2011-12-19\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"CZ\"],\n    \"person_responsible\": \"Jan Kalandra\",\n    \"oiml_issuer_id\": null\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Emerson Process Management / Rosemount Flow Division\",\n      \"address_lines\": [\"12001 Technology Drive\", \"Eden Prairie, 553 44 MN\", \"USA\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Emerson Process Management / Rosemount Flow Division\",\n      \"address_lines\": [\"12001 Technology Drive\", \"Eden Prairie, 553 44 MN\", \"USA\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"8732\", \"8705\", \"8711\"],\n    \"description\": \"Magnetic flow meter (water meter) for metering cold and hot potable water, based on the electromagnetic principle. Consists of a flow sensor type 8705 or 8711 and a measuring transducer with electronic calculator (transmitter) type 8732. Sensor body of stainless and carbon steel with lining of neoprene, polyurethane or PTFE; type 8705 with standard flanges, type 8711 flangeless (wafer), installed with measurement electrodes. Measuring transducer in stainless steel housing with two-row LCD display and four buttons, with impulse and current outputs via two connector cables. Flow sensor and transducer in remote-mount design (connected via cable) or compact design.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"8711-DN4\", \"label\": \"Transmitter 8732 + sensor 8711, DN 4\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN8\", \"label\": \"Transmitter 8732 + sensor 8711, DN 8\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN15\", \"label\": \"Transmitter 8732 + sensor 8711, DN 15\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN25\", \"label\": \"Transmitter 8732 + sensor 8711, DN 25\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN40\", \"label\": \"Transmitter 8732 + sensor 8711, DN 40\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN50\", \"label\": \"Transmitter 8732 + sensor 8711, DN 50\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN65\", \"label\": \"Transmitter 8732 + sensor 8711, DN 65\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN80\", \"label\": \"Transmitter 8732 + sensor 8711, DN 80\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN100\", \"label\": \"Transmitter 8732 + sensor 8711, DN 100\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN150\", \"label\": \"Transmitter 8732 + sensor 8711, DN 150\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8711-DN200\", \"label\": \"Transmitter 8732 + sensor 8711, DN 200\", \"attributes\": {\"sensor_type\": \"8711\", \"connection_type\": \"wafer\", \"liner_material\": [\"PTFE\"]}},\n      {\"model_id\": \"8705-DN15\", \"label\": \"Transmitter 8732 + sensor 8705, DN 15\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN25\", \"label\": \"Transmitter 8732 + sensor 8705, DN 25\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN40\", \"label\": \"Transmitter 8732 + sensor 8705, DN 40\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN50\", \"label\": \"Transmitter 8732 + sensor 8705, DN 50\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN80\", \"label\": \"Transmitter 8732 + sensor 8705, DN 80\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN100\", \"label\": \"Transmitter 8732 + sensor 8705, DN 100\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN150\", \"label\": \"Transmitter 8732 + sensor 8705, DN 150\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN200\", \"label\": \"Transmitter 8732 + sensor 8705, DN 200\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN250\", \"label\": \"Transmitter 8732 + sensor 8705, DN 250\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN300\", \"label\": \"Transmitter 8732 + sensor 8705, DN 300\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN350\", \"label\": \"Transmitter 8732 + sensor 8705, DN 350\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN400\", \"label\": \"Transmitter 8732 + sensor 8705, DN 400\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN450\", \"label\": \"Transmitter 8732 + sensor 8705, DN 450\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN500\", \"label\": \"Transmitter 8732 + sensor 8705, DN 500\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN600\", \"label\": \"Transmitter 8732 + sensor 8705, DN 600\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN750\", \"label\": \"Transmitter 8732 + sensor 8705, DN 750\", \"attributes\": {\"sensor_type\": \"8705\", \"connection_type\": \"standard flanges\", \"liner_material\": [\"neoprene\", \"polyurethane\", \"PTFE\"]}},\n      {\"model_id\": \"8705-DN900\", \"label\": \"Transmitter 8732 + sensor 8705, DN 900\", \"attributes\": {\"sensor_type\": \"8705\