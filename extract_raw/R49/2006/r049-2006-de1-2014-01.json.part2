      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2006-DE1-14.01\",\n    \"page_total\": 11\n  },\n  \"issuing_authority\": {\n    \"name\": \"Physikalisch-Technische Bundesanstalt\"\n  },\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"ET1\", \"ET2\", \"ET3\", \"ET4\"],\n    \"description\": \"Water meter types ET1, ET2, ET3, ET4 in DN15 and DN20 with Q3 = 1.6 / 2.5 / 4.0 m3/h; multiple flow-range options (Q3/Q1 = 16 to 100); cold-water variants (0.1-30 °C) and hot-water variants (30-90 °C); installation horizontal (H) or vertical (rising pipe and falling pipe / V 90° / V 45°).\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\n        \"model_id\": \"ET1+ET2+ET3+ET4_DN20_Q3-2.5_H\",\n        \"label\": \"ET1, ET2, ET3, ET4, DN20, Q3 2.5 m³/h, orientation H\",\n        \"attributes\": {\n          \"flow_sensor_types\": [\"ET1\", \"ET2\", \"ET3\", \"ET4\"],\n          \"nominal_diameter\": {\"value\": \"DN20\", \"unit_symbol\": null, \"unit_id\": null},\n          \"q3\": {\"value\": 2.5, \"unit_symbol\": \"m³/h\", \"unit_id\": null},\n          \"q4\": {\"value\": 3.13, \"unit_symbol\": \"m³/h\", \"unit_id\": null},\n          \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 30}, \"unit_symbol\": \"°C\", \"unit_id\": \"u:degree_Celsius\"},\n          \"maximum_permissible_error_high_zone\": {\"value\": 2, \"unit_symbol\": \"%\", \"unit_id\": null},\n          \"maximum_permissible_error_low_zone\": {\"value\": 5, \"unit_symbol\": \"%\", \"unit_id\": null},\n          \"orientation\": {\"value\": \"H\", \"unit_symbol\": null, \"unit_id\": null}\n        }\n      },\n      {\n        \"model_id\": \"ET1+ET2+ET3+ET4_DN20_Q3-2.5_V\",\n        \"label\": \"ET1, ET2, ET3, ET4, DN20, Q3 2.5 m³/h, orientation rising pipe and falling pipe / V 90° / V 45°\",\n        \"attributes\": {\n          \"flow_sensor_types\": [\"ET1\", \"ET2\", \"ET3\", \"ET4\"],\n          