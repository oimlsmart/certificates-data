      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2006-CZ-12.01\",\n    \"scheme\": \"A\",\n    \"page_total\": 5,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2012-04-13\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"CZ\"],\n    \"person_responsible\": \"Jan Kalandra\",\n    \"person_title\": \"The Issuing Authority\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ELIS PLZEŇ a.s.\",\n      \"address_lines\": [\"Luční 15\", \"P.O.BOX 126\", \"304 26 Plzeň\", \"Czech Republic\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ELIS PLZEŇ a.s.\",\n      \"address_lines\": [\"Luční 15\", \"P.O.BOX 126\", \"304 26 Plzeň\", \"Czech Republic\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"FLOMIC FL5024\", \"FLOMIC FL5044\"],\n    \"description\": \"Ultrasound water meters for metering cold potable water, based on the ultrasonic principle. Consist of a flow sensor and a measuring transducer with electronic calculator in compact version, powered by battery. The flow sensor body is made by shaped casting from ductile iron with standard flanges, fitted with one pair of ultrasonic sensors for the single-beam model (type FL5024) or two pairs for the double-beam model (type FL5044). The measuring transducer is an aluminium box with plastic lid, transparent sight hole for LCD display, button, pressure-equalization valve, plate for communication by optical probe and three connectors for RS232, impulse output and current output; unused connectors must be blind; maximum communication cable length 2 m. The water meter type FL5024 with nominal diameter DN32 must be installed with a cross type of flow straightener.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"FL5024-DN32\", \"label\": \"FLOMIC FL5024, DN 32\", \"attributes\": {\"beam_configuration\": \"single-beam\", \"flow_straightener\": \"cross type flow straightener required\"}},\n      {\"model_id\": \"FL5024-DN40\", \"label\": \"FLOMIC FL5024, DN 40\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5024-DN50\", \"label\": \"FLOMIC FL5024, DN 50\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5024-DN65\", \"label\": \"FLOMIC FL5024, DN 65\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5024-DN80\", \"label\": \"FLOMIC FL5024, DN 80\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5024-DN100\", \"label\": \"FLOMIC FL5024, DN 100\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5024-DN125\", \"label\": \"FLOMIC FL5024, DN 125\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5024-DN150\", \"label\": \"FLOMIC FL5024, DN 150\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5024-DN200\", \"label\": \"FLOMIC FL5024, DN 200\", \"attributes\": {\"beam_configuration\": \"single-beam\"}},\n      {\"model_id\": \"FL5044-DN65\", \"label\": \"FLOMIC FL5044, DN 65\", \"attributes\": {\"beam_configuration\": \"double-beam\"}},\n      {\"model_id\": \"FL5044-DN80\", \"label\": \"FLOMIC FL5044, DN 80\", \"attributes\": {\"beam_configuration\": \"double-beam\"}},\n      {\"model_id\": \"FL5044-DN100\", \"label\": \"FLOMIC FL5044, DN 100\", \"attributes\": {\"beam_configuration\": \"double-beam\"}},\n      {\"model_id\": \"FL5044-DN125\", \"label\": \"FLOMIC FL5044, DN 125\", \"attributes\": {\"beam_configuration\": \"double-beam\"}},\n      {\"model_id\": \"FL5044-DN150\", \"label\": \"FLOMIC FL5044, DN 150\", \"attributes\": {\"beam_configuration\": \"double-beam\"}},\n      {\"model_id\": \"FL5044-DN200\", \"label\": \"FLOMIC FL5044, DN 200\", \"attributes\": {\"beam_conf