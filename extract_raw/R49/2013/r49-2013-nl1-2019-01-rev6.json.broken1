      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-19.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"4086814\",\n    \"page_total\": 7,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2026-08-10\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V., OIML Issuing Authority NL1\",\n    \"address_lines\": [\"Thijseweg 11\", \"2629 JA Delft\", \"the Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"person_title\": \"Certification Board\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Euromag International S.r.l.\",\n      \"address_lines\": [\"Via Balla, 55\", \"35010 Villafranca Padovana (PD)\", \"Italy\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Euromag International S.r.l.\",\n      \"address_lines\": [\"Via Balla, 55\", \"35010 Villafranca Padovana (PD)\", \"Italy\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MUT1000EL\", \"MUT2200EL\", \"MUT2300\", \"MC406M\", \"MC406AM\"],\n    \"module_designation\": null,\n    \"description\": \"Electromagnetic water meter, types MUT1000EL, MUT2200EL and MUT2300, with electronic converter MC406M or MC406AM. The measurement sensor can have a cylindrical measuring tube: full bore (MUT1000EL without flanges or MUT2200EL with flanges) or reduced bore (MUT2300). Accuracy class 2 applies to MUT2200EL, accuracy class 1 to MUT2300.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"Full bore DN32\", \"label\": \"MUT1000EL/MUT2200EL DN32\"},\n      {\"model_id\": \"Full bore DN40\", \"label\": \"MUT1000EL/MUT2200EL DN40\"},\n      {\"model_id\": \"Full bore DN50\", \"label\": \"MUT1000EL/MUT2200EL DN50\"},\n      {\"model_id\": \"Full bore 