      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-2023.01\",\n    \"scheme\": \"A\",\n    \"page_total\": 10,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2023-01-31\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Cixi Cidong Flow Instrument Co., Ltd\",\n      \"address_lines\": [\"No. 148, Longzhen Road, Longshan Industrial Park\", \"315 311 Ningbo, Zhejiang\", \"China\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Cixi Cidong Flow Instrument Co., Ltd\",\n      \"address_lines\": [\"No. 148, Longzhen Road, Longshan Industrial Park\", \"315 311 Ningbo, Zhejiang\", \"China\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"LXLC\", \"LXSG-20\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Horizontal Woltmann water meter consisting of a cast iron body with connecting flanges, an interchangeable wet measurement unit with adjusting device, and a dry mechanical indicating device (Plastic Calculator - LYG) or super dry mechanical indicating device (Copper Can Calculator - GB). Indicating device formed by numbered rollers with six drums and three rotary pointers, or seven drums and two rotary pointers. Optionally equipped with a reed impulse transmitter for remote reading. To be installed in horizontal position only with the indicating device positioned at the top.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"LXLC\",\n    \"models\": [\n      {\"model_id\": \"LXLC-50-GB-R40\", \"label\": \"LXLC - 50, dial plate GB, Q3/Q1 = 40\", \"attributes\": {\"nominal_diameter\": 50, \"dial_plate_design\": \"GB\", \"calculator_type\": \"Copper Can Calculator (super dry)\", \"q3_q1_ratio\": 40}},\n      {\"model_id\": \"LX