      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-24.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2024-06-06\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\",\n    \"oiml_issuer_id\": null\n  },\n  \"applicants\": [\n    {\n      \"name\": \"GWF AG\",\n      \"address_lines\": [\"Obergrundstrasse 119\", \"CH-6005 Luzern\", \"Switzerland\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"GWF AG\",\n      \"address_lines\": [\"Obergrundstrasse 119\", \"CH-6005 Luzern\", \"Switzerland\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"sonico NANO\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Ultrasonic water meter with dry dial and electronic indicating device, designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consists of a cast brass body with connecting screw threads, one pair of ultrasonic transducers and the electronic indicating device formed by an LCD display showing volume and flow. Display volume resolution 0.00001 m³. Without buttons; legally non-relevant communication possible via NFC sensor connected on the register. Software separation is implemented; CRC and SW version of the legally relevant part are displayed in the auto-rounding menu. Displays the delivered volume for reverse flow and for forward flow separately every two minutes; the permanently shown delivered volume is the difference between the two. Can be equipped by an impulse module which is not part of this certificate. Powered by a 3.6 V battery. Shall be installed to operate in any positions. Sealed by a plastic seal (plastic frame holding the display glass) forming part of the meter body.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"sonico NANO\",\n    \"models\": [\n      {\"model_id\": \"DN15-Q3=1.6-R40\"},\n      {\"model_id\": \"DN15-Q3=2.5-R40\"},\n      {\"model_id\": \"DN15-Q3=1.6-R50\"},\n      {\"model_id\": \"DN15-Q3=2.5-R50\"},\n      {\"model_id\": \"DN15-Q3=1.6-R63\"},\n      {\"model_id\": \"DN15-Q3=2.5-R63\"},\n      {\"model_id\": \"DN15-Q3=1.6-R80\"},\n      {\"model_id\": \"DN15-Q3=2.5-R80\"},\n      {\"model_id\": \"DN15-Q3=1.6-R100\"},\n      {\"model_id\": \"DN15-Q3=2.5-R100\"},\n      {\"model_id\": \"DN15-Q3=1.6-R125\"},\n      {\"model_id\": \"DN15-Q3=2.5-R125\"},\n      {\"model_id\": \"DN15-Q3=1.6-R160\"},\n      {\"model_id\": \"DN15-Q3=2.5-R160\"},\n      {\"model_id\": \"DN15-Q3=1.6-R200\"},\n      {\"model_id\": \"DN15-Q3=2.5-R200\"},\n      {\"model_id\": \"DN15-Q3=1.6-R250\"},\n      {\"model_id\": \"DN15-Q3=2.5-R250\"},\n      {\"model_id\": \"DN15-Q3=1.6-R315\"},\n      {\"model_id\": \"DN15-Q3=2.5-R315\"},\n      {\"model_id\": \"DN15-Q3=1.6-R400\"},\n      {\"model_id\": \"DN15-Q3=2.5-R400\"},\n      {\"model_id\": \"DN15-Q3=1.6-R500\"},\n      {\"model_id\": \"DN15-Q3=2.5-R500\"},\n      {\"model_id\": \"DN15-Q3=1.6-R630\"},\n      {\"model_id\": \"DN15-Q3=2.5-R630\"},\n      {\"model_id\": \"DN15-Q3=2.5-R800\"},\n      {\"model_id\": \"DN15-Q3=2.5-R1000\"},\n      {\"model_id\": \"DN20-Q3=2.5-R40\"},\n      {\"model_id\": \"DN20-Q3=4.0-R40\"},\n      {\"model_id\": \"DN20-Q3=2.5-R50\"},\n      {\"model_id\": \"DN20-Q3=4.0-R50\"},\n      {\"model_id\": \"DN20-Q3=2.5-R63\"},\n      {\"model_id\": \"DN20-Q3=4.0-R63\"},\n      {\"model_id\": \"DN20-Q3=2.5-R80\"},\n      {\"model_id\": \"DN20-Q3=4.0-R80\"},\n      {\"model_id\": \"DN20-Q3=2.5-R100\"},\n      {\"model_id\": \"DN20-Q3=4.0-R100\"},\n      {\"model_id\": \"DN20-Q3=2.5-R125\"},\n      {\"model_id\": \"DN20-Q3=4.0-R125\"},\n      {\"model_id\": \"DN20-Q3=2.5-R160\"},\n      {\"model_id\": \"DN20-Q3=4.0-R160\"},\n      {