      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3489487\",\n    \"page_total\": 11,\n    \"member_state\": \"The Netherlands\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"description\": \"Family of instruments: full bore and reduced bore water meters, meter sizes DN40 to DN1800, accuracy classes 1 and 2, with indicating devices powered by AC mains or by battery / renewable energy.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"DN40 class 1\", \"attributes\": {\"accuracy_class\": \"1\"}},\n      {\"model_id\": \"DN40 class 2\", \"attributes\": {\"accuracy_class\": \"2\"}},\n      {\"model_id\": \"DN50 class 1\", \"attributes\": {\"accuracy_class\": \"1\"}},\n      {\"model_id\": \"DN50 class 2\", \"attributes\": {\"accuracy_class\": \"2\"}},\n      {\"model_id\": \"DN65 class 1 & 2\", \"attributes\": {\"accuracy_class\": \"1 & 2\"}},\n      {\"model_id\": \"DN80 class 1 & 2\", \"attributes\": {\"accuracy_class\": \"1 & 2\"}},\n      {\"model_id\": \"DN100 class 1 & 2\", \"attributes\": {\"accuracy_class\": \"1 & 2\"}},\n      {\"model_id\": \"DN125 class 1 & 2\", \"attributes\": {\"accuracy_class\": \"1 & 2\"}},\n      {\"model_id\": \"DN150 class 1\", \"attributes\": {\"accuracy_class\": \"1\"}},\n      {\"model_id\": \"DN150 class 2\", \"attributes\": {\"accuracy_class\": \"2\"}},\n      {\"model_id\": \"DN200 class 1\", \"attributes\": {\"accuracy_class\": \"1\"}},\n      {\"model_id\": \"DN200 class 2\", \"attributes\": {\"accuracy_class\": \"2\"}},\n      {\"model_id\": \"DN250 class 1\", \"attributes\": {\"accuracy_class\": \"1\"}},\n      {\"model_id\": \"DN250 class 2\", \"attributes\": {\"accuracy_class\": \"2\"}},\n      {\"model_id\": \"DN300 class 1\", \"attributes\