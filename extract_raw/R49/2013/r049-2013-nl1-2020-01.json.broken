      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2254799\",\n    \"page_total\": 5,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2020-08-14\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M. Boudewijns\",\n    \"person_title\": \"Certification Board\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    },\n    {\n      \"name\": \"ABB Engineering (Shanghai) Ltd.\",\n      \"address_lines\": [\"No. 4528, Kangxin Highway\", \"Pudong New District\", \"Shanghai, 201319\", \"P.R. China\"]\n    },\n    {\n      \"name\": \"ABB Inc.\",\n      \"address_lines\": [\"125 E. County Line Road\", \"Warminster, PA 18974\", \"United States of America (USA)\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW4XX.R\", \"AquaMaster4 FET4*\"],\n    \"description\": \"An electromagnetic water meter\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\"model_id\": \"DN40-AC-C1\", \"label\": \"DN40, AC mains powered, accuracy class 1\", \"attributes\": {\"meter_size\": \"DN40\", \"power_supply\": \"AC mains\", \"accuracy_class\": 1}},\n      {\"model_id\": \"DN40-AC-C2\", \"label\": \"DN40, AC mains powered, accuracy class 2\", \"attributes\": {\"meter_size\": \"DN40\", \"power_supply\":