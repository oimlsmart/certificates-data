re_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1100\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1200\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1350\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1400\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1500\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1600\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1650\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\", \"full_bore_battery_renewable\"]}},\n      {\"model_id\": \"DN1800\", \"attributes\": {\"available_configurations\": [\"full_bore_ac_mains\"]}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"Flow sensor\",\n      \"type_designations\": [\"FEW4XY.Z\"],\n      \"alternatives\": null,\n      \"characteristics\": {}\n    },\n    {\n      \"role\": \"Flow transmitter\",\n      \"type_designations\": [\"FET4*\"],\n      \"alternatives\": null,\n      \"characteristics\": {}\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic\", \"unit_symbol\": null, \"unit_id\": null},\n      \"accuracy_class\": {\"value\": \"1 and 2\", \"unit_symbol\": null, \"unit_id\": null},\n      \"environmental_class\": {\"value\": \"O (installed outdoors)\", \"unit_symbol\": null, \"unit_id\": null},\n      \"electromagnetic_environment\": {\"value\": \"E2\", \"unit_symbol\": null, \"unit_id\": null},\n      \"mechanical_class\": {\"value\": \"M1\", \"unit_symbol\": null, \"unit_id\": null},\n      \"ambient_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": \"u:degree_Celsius\"},\n      \"ambient_temperature_range_applies_to\": {\"value\": \"Both flow sensor and flow transmitter\", \"unit_symbol\": null, \"unit_id\": null},\n      \"water_temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null},\n      \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": \"u:degree_Celsius\"},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null},\n      \"maximum_admissible_pressure_equivalent\": {\"value\": 16, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      \"orientation\": {\"value\": \"All positions (horizontal, vertical, or diagonal)\", \"unit_symbol\": null, \"unit_id\": null},\n      \"reverse_flow\": {\"value\": \"Sensor is intended to measure reverse flow\", \"unit_symbol\": null, \"unit_id\": null},\n      \"ac_mains_supply_voltage\": {\"value\": {\"min\": 85, \"max\": 240}, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"ac_mains_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null},\n      \"dc_renewable_energy_supply_voltage\": {\"value\": {\"min\": 6, \"max\": 32}, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"battery_quantity\": {\"value\": 2, \"unit_symbol\": null, \"unit_id\": null},\n      \"battery_voltage\": {\"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"battery_operating_voltage_range\": {\"value\": {\"min\": 2.9, \"max\": 3.6}, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"battery_type\": {\"value\": \"Replaceable\", \"unit_symbol\": null, \"unit_id\": null},\n      \"checking_facility\": {\"value\": \"Type P (permanent) automatic checking facility\", \"unit_symbol\": null, \"unit_id\": null}\n    },\n    \"model_level\": [],\n    \"config_level\": [\n      {\n        \"attribute\": \"flow_profile_sensitivity_class\",\n        \"axis\": \"bore_type_and_meter_size\",\n        \"values\": [\n          {\"condition\": \"All sizes except full bore DN250 and larger\", \"value\": \"U0 and D0 (0 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null},\n          {\"condition\": \"Full bore, DN250 and larger\", \"value\": \"U3 and D0 (3 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss_class\",\n        \"axis\": \"bore_type_and_meter_size\",\n        \"values\": [\n          {\"condition\": \"Reduced bore, DN40 and DN50\", \"value\": \"Δp 40 (0.40 bar)\", \"unit_symbol\": null},\n          {\"condition\": \"Reduced bore, larger than DN50\", \"value\": \"Δp 63 (0.63 bar)\", \"unit_symbol\": null},\n          {\"condition\": \"Virtual or full bore, DN40 and DN50\", \"value\": \"Δp 10 (0.10 bar)\", \"unit_symbol\": null},\n          {\"condition\": \"Virtual or full bore, DN65 to DN200\", \"value\": \"Δp 16 (0.16 bar)\", \"unit_symbol\": null},\n          {\"condition\": \"Virtual or full bore, DN250 and larger\", \"value\": \"Δp 10 (0.10 bar)\", \"unit_symbol\": null}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Table 2: General characteristics of the family of instruments - Reduced bore, AC mains powered\",\n      \"columns\": [\"meter_size\", \"accuracy_class\", \"q1_minimum\", \"q2_transitional\", \"q3_permanent\", \"q4_overload\", \"ratio_q3_q1\"],\n      \"column_units\": [null, null, \"m³/h\", \"m³/h\", \"m³/h\", \"m³/h\", null],\n      \"description\": \"Flow rates Q1, Q2, Q3 and Q4 can be freely chosen as long as: Q3 and ratio Q3/Q1 are selected from paragraph 4.1 of OIML R49-1:2013; Q1 and Q2 are minimum values and ratio Q2/Q1 = 1.6; Q3 and Q4 are maximum values and ratio Q4/Q3 = 1.25; ratio Q3/Q1 is at least 40.\",\n      \"footnotes\": [],\n      \"rows\": [\n        {\"meter_size\": \"DN40\", \"accuracy_class\": \"1\", \"q1_minimum\": 0.05, \"q2_transitional\": 0.08, \"q3_permanent\": 25, \"q4_overload\": 31.25, \"ratio_q3_q1\": 500},\n        {\"meter_size\": \"DN40\", \"accuracy_class\": \"2\", \"q1_minimum\": 0.025, \"q2_transitional\": 0.04, \"q3_permanent\": 25, \"q4_overload\": 31.25, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN50\", \"accuracy_class\": \"1\", \"q1_minimum\": 0.08, \"q2_transitional\": 0.128, \"q3_permanent\": 40, \"q4_overload\": 50, \"ratio_q3_q1\": 500},\n        {\"meter_size\": \"DN50\", \"accuracy_class\": \"2\", \"q1_minimum\": 0.04, \"q2_transitional\": 0.064, \"q3_permanent\": 40, \"q4_overload\": 50, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN65\", \"accuracy_class\": \"1 & 2\", \"q1_minimum\": 0.063, \"q2_transitional\": 0.1008, \"q3_permanent\": 63, \"q4_overload\": 78.75, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN80\", \"accuracy_class\": \"1 & 2\", \"q1_minimum\": 0.1, \"q2_transitional\": 0.16, \"q3_permanent\": 100, \"q4_overload\": 125, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN100\", \"accuracy_class\": \"1\", \"q1_minimum\": 0.32, \"q2_transitional\": 0.512, \"q3_permanent\": 160, \"q4_overload\": 200, \"ratio_q3_q1\": 500},\n        {\"meter_size\": \"DN100\", \"accuracy_class\": \"2\", \"q1_minimum\": 0.16, \"q2_transitional\": 0.256, \"q3_permanent\": 160, \"q4_overload\": 200, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN125\", \"accuracy_class\": \"1\", \"q1_minimum\": 0.32, \"q2_transitional\": 0.512, \"q3_permanent\": 160, \"q4_overload\": 200, \"ratio_q3_q1\": 500},\n        {\"meter_size\": \"DN125\", \"accuracy_class\": \"2\", \"q1_minimum\": 0.16, \"q2_transitional\": 0.256, \"q3_permanent\": 160, \"q4_overload\": 200, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN150\", \"accuracy_class\": \"1 & 2\", \"q1_minimum\": 0.4, \"q2_transitional\": 0.64, \"q3_permanent\": 400, \"q4_overload\":