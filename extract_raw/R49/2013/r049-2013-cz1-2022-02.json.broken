      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-2022.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 16,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2022-05-30\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ISOIL INDUSTRIA SPA\",\n      \"address_lines\": [\"Via F.lli Gracchi, 27\", \"Cinisello Balsamo\", \"20099 Italy\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Hemina SPA\",\n      \"address_lines\": [\"Via Piemonte 1\", \"Montagnana (PD)\", \"35044 Italy\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MS2500 / MV110\", \"MS2500 / MV110 HV\", \"MS2500 / MV110 LV\", \"MS2500 / MV110 LLV\", \"MS2500\", \"MV110\"],\n    \"module_designation\": \"MS2500 / MV110 HV; MS2500 / MV110 LV; MS2500 / MV110 LLV\",\n    \"description\": \"Electromagnetic water meters designed to measure, memorise and display the volume of water at metering conditions. The type consists of a sensor (MS2500) and a converter (MV110) in compact or separate version with connecting cable. The sensor MS2500 comprises a steel body with connecting flanges, one pair of excitation coils and electrodes, and can be fitted with PTFE, polypropylene, Rilsan or ebonite liners. The converter MV110 (plastic and aluminium body) provides an LCD display of volume and flow, impulse and current outputs, and legally non-relevant communication via RS485 or USB mini-B; legally relevant software version V.1.04.0005.0004 (CRC 9BA34F3B). Available in three power-supply variants: HV (100-240 V AC), LV (24-36 V AC/DC) and LLV (10-48 V DC). Installation in any orientation; sealing of sensor and converter per Figures 1-4 of the certificate.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"MS2500 / MV110\",\n    \"models\": [\n      {\"model_id\": \"DN25 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN25, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 25, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN25 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN25, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 25, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN32 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN32, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 32, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN32 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN32, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 32, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN40 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN40, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 40, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN40 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN40, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 40, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN50 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN50, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 50, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN50 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN50, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 50, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN65 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN65, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 65, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN65 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN65, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 65, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN80 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN80, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 80, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN80 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN80, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 80, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN100 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN100, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 100, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN100 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN100, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 100, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN125 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN125, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 125, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN125 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN125, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 125, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN150 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN150, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 150, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN150 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN150, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 150, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN200 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN200, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 200, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN200 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN200, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 200, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN250 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN250, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 250, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN250 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN250, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 250, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN300 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN300, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 300, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN300 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN300, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 300, \"q3_over_q1\": 400, \"accuracy_class\": 2}},\n      {\"model_id\": \"DN350 (Q3/Q1=250)\", \"label\": \"MS2500 / MV110 DN350, Q3/Q1=250, accuracy class 1\", \"attributes\": {\"nominal_diameter\": 350, \"q3_over_q1\": 250, \"accuracy_class\": 1}},\n      {\"model_id\": \"DN350 (Q3/Q1=400)\", \"label\": \"MS2500 / MV110 DN350, Q3/Q1=400, accuracy class 2\", \"attributes\": {\"nominal_diameter\": 350, \"q3_over_q1\": 400, \"accuracy_class\": 2}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"sensor (measurement transducer)\",\n      \"type_designations\": [\"MS2500\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"construction\": \"steel body with connecting flanges, one pair of excitation coils, electrodes and connection to the converter\",\n        \"liners\": [\n          {\"material\": \"PTFE\", \"nominal_diameters\": {\"min\": 25, \"max\": 350}, \"max_water_temperature_c\": 90},\n          {\"material\": \"polypropylene\", \"nominal_diameters\": {\"min\": 25, \"max\": 150}, \"max_water_temperature_c\": 50},\n          {\"material\": \"Rilsan\", \"nominal_diameters\": {\"min\": 50, \"max\": 350}, \"max_water_temperature_c\": 50},\n          {\"material\": \"ebonite\", \"nominal_diameters\": {\"min\": 200, \"max\": 350}, \"max_water_temperature_c\": 50}\n        ]\n      }\n    },\n    {\n      \"role\": \"converter (electronic indicating and calculating device)\",\n      \"type_designations\": [\"MV110\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"housing\": \"plastic and aluminium body\",\n        \"display\": \"LCD showing volume and flow\",\n        \"outputs\": [\"impulse output\", \"current output\"],\n        \"communication_interfaces\": [\"RS485\", \"USB mini-B\"],\n        \"note\": \"RS485 / USB mini-B communication is a legally non-relevant part; password-protected security levels\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic water meter\", \"unit_symbol\": null, \"unit_id\": null},\n      \"q2_over_q1\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\": null},\n      \"q4_over_q3\": {\"value\": 1.25, \"unit_symbol\": null, \"unit_id\": null},\n      \"water_pressure_class\": {\"value\": \"MAP16\", \"unit_symbol\": null, \"unit_id\": null},\n      \"pressure_loss_class\": {\"value\": \"Δp40\", \"unit_symbol\": null, \"unit_id\": null},\n      \"reverse_flow\": {\"value\": \"designed to measure\", \"unit_symbol\": null, \"unit_id\": null},\n      \"environmental_class\": {\"value\": \"O\", \"unit_symbol\": null, \"unit_id\": null},\n      \"environmental_class_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n      \"electromagnetic_environment\": {\"value\": \"E1, E2\", \"unit_symbol\": null, \"unit_id\": null},\n      \"mechanical_class\": {\"value\": \"B, O\", \"unit_symbol\": null, \"unit_id\": null},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null},\n      \"orientation_limitation\": {\"value\": \"any\", \"unit_symbol\": null, \"unit_id\": null},\n      \"eut_testing_categor