      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-24.06\",\n    \"scheme\": \"A\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2024-11-11\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"JANZ - Contagem e Gestao de Fluídos, S.A.\",\n      \"address_lines\": [\"Avenida Infante D. Henrique, 288\", \"1950-421 Lisboa\", \"PT\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"JANZ - Contagem e Gestao de Fluídos, S.A.\",\n      \"address_lines\": [\"Avenida Infante D. Henrique, 288\", \"1950-421 Lisboa\", \"PT\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"Smartio\"],\n    \"module_designation\": null,\n    \"description\": \"Ultrasonic water meter, dry dial, designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consists of a cast brass body with connecting screw threads, one pair of ultrasonic transducers and an electronic indicating device with LCD display; volume resolution 0.00001 m³. Legally non-relevant communication possible via NFC sensor. Software separation applied. Powered by non-replaceable 3.6 V battery. Can be installed in any position. Optionally equipped with an impulse module, which is not part of this certificate.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"Smartio\",\n    \"models\": [\n      {\"model_id\": \"DN15_Q3=1.6_R40\", \"label\": \"DN15, Q3 = 1.6 m³/h, R = 40\", \"attributes\": {\"nominal_diameter\": 15, \"q3\": 1.6, \"q4\": 2.0, \"q3_over_q1_ratio\": 40}},\n      {\"model_id\": \"DN15_Q3=1.6_R50\", \"label\": \"DN15, Q3 = 1.6 m³/h, R = 50\", \"attributes\": {\"nominal_diameter\": 15, \"q3\": 1.6, \"q4\": 2.0,