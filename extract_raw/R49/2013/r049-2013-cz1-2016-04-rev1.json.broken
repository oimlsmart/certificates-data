      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-CZ-16.04\",\n    \"scheme\": \"B\",\n    \"page_total\": 8,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2017-10-12\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"CZ\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Arkon Flow Systems, s.r.o.\",\n      \"address_lines\": [\"Berkova 534/92\", \"612 00 Brno\", \"Czech Republic\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Arkon Flow Systems, s.r.o.\",\n      \"address_lines\": [\"Berkova 534/92\", \"612 00 Brno\", \"Czech Republic\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MAGX2\"],\n    \"module_designation\": null,\n    \"description\": \"Electromagnetic water meter for metering cold and hot potable water, based on an inductive principle, with PTFE and hard rubber lining, straight inlet (5 times the diameter) and outlet (3 times the diameter) length, without flow conditioner, equipped with an electronic calculating/indicating device. Two modifications: compact and remote version (maximum cable length for remote version 6 m). The display shows volume (positive, negative, total and auxiliary) in m³ and flow rate in m³/h; the meter is not designed to measure reverse flow. Access to metrological parameters is secured by user, service and factory passwords; software version and checksum can be displayed using buttons. Optional frequency output for remote reading or RS 485 communication. Nominal diameters DN25 to DN300 with flanged connections; mounting with flow axis horizontal or vertical (upward or downward), indicating device positioned at top or at side.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"MAGX2\",\n    \"models\": [\n      {\"model_id\": \"MAGX2 DN25\"},\n      {\"model_id\": \"MAGX2 DN32\"},\n      {\"model_id\": \"MAGX2 DN40\"},\n      {\"model_id\": \"MAGX2 DN50\"},\n      {\"model_id\": \"MAGX2 DN65\"},\n      {\"model_id\": \"MAGX2 DN80\"},\n      {\"model_id\": \"MAGX2 DN100\"},\n      {\"model_id\": \"MAGX2 DN125\"},\n      {\"model_id\": \"MAGX2 DN150\"},\n      {\"model_id\": \"MAGX2 DN200\"},\n      {\"model_id\": \"MAGX2 DN250\"},\n      {\"model_id\": \"MAGX2 DN300\"}\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"accuracy_class\": {\"value\": 2, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"q2_q1_ratio\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"q4_q3_ratio\": {\"value\": 1.25, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_permissible_error_lower_flowrate_zone\": {\"value\": 5, \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []},\n      \"temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"pressure_loss_class\": {\"value\": \"ΔP10\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_pressure_class\": {\"value\": \"MAP10\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"flow_profile_sensitivity_classes\": {\"value\": \"U5 D3\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"orientation_limitation\": {\"value\": \"any\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"connection_type\": {\"value\": \"flange\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"climatic_environment_class\": {\"value\": \"B\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"electromagnetic_environment_class\": {\"value\": \"E2\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"software_version\": {\"value\": \"21.39\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"checksum\": {\"value\": \"09585\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_voltage_ac\": {\"value\": {\"min\": 90, \"max\": 250}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_frequency\": {\"value\": 50, \"unit_symbol\": \"Hz\", \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_voltage_dc\": {\"value\": {\"min\": 12, \"max\": 36}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"low_flow_cutoff\": {\"value\": 1, \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"nominal_diameter\",\n        \"unit_symbol\": \"mm\",\n        \"values\": [\n          {\"model\": \"MAGX2 DN25\", \"value\": 25},\n          {\"model\": \"MAGX2 DN32\", \"value\": 32},\n          {\"model\": \"MAGX2 DN40\", \"value\": 40},\n          {\"model\": \"MAGX2 DN50\", \"value\": 50},\n          {\"model\": \"MAGX2 DN65\", \"value\": 65},\n          {\"model\": \"MAGX2 DN80\", \"value\": 80},\n          {\"model\": \"MAGX2 DN100\", \"value\": 100},\n          {\"model\": \"MAGX2 DN125\", \"value\": 125},\n          {\"model\": \"MAGX2 DN150\", \"value\": 150},\n          {\"model\": \"MAGX2 DN200\", \"value\": 200},\n          {\"model\": \"MAGX2 DN250\", \"value\": 250},\n          {\"model\": \"MAGX2 DN300\", \"value\": 300}\n        ]\n      },\n      {\n        \"attribute\": \"permanent_flowrate_q3\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"MAGX2 DN25\", \"value\": 16.0},\n          {\"model\": \"MAGX2 DN32\", \"value\": 25.0},\n          {\"model\": \"MAGX2 DN40\", \"value\": 40.0},\n          {\"model\": \"MAGX2 DN50\", \"value\": 63.0},\n          {\"model\": \"MAGX2 DN65\", \"value\": 100.0},\n          {\"model\": \"MAGX2 DN80\", \"value\": 160.0},\n          {\"model\": \"MAGX2 DN100\", \"value\": 250.0},\n          {\"model\": \"MAGX2 DN125\", \"value\": 400.0},\n          {\"model\": \"MAGX2 DN150\", \"value\": 630.0},\n          {\"model\": \"MAGX2 DN200\", \"value\": 1000.0},\n          {\"model\": \"MAGX2 DN250\", \"value\": 1000.0},\n          {\"model\": \"MAGX2 DN300\", \"value\": 1600.0}\n        ]\n      },\n      {\n        \"attribute\": \"overload_flowrate_q4\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"MAGX2 DN25\", \"value\": 20.0},\n          {\"model\": \"MAGX2 DN32\", \"value\": 31.3},\n          {\"model\": \"MAGX2 DN40\", \"value\": 50.0},\n          {\"model\": \"MAGX2 DN50\", \"value\": 78.8},\n          {\"model\": \"MAGX2 DN65\", \"value\": 125.0},\n          {\"model\": \"MAGX2 DN80\", \"value\": 200.0},\n          {\"model\": \"MAGX2 DN100\", \"value\": 312.5},\n          {\"model\": \"MAGX2 DN125\", \"value\": 500.0},\n          {\"model\": \"MAGX2 DN150\", \"value\": 787.5},\n          {\"model\": \"MAGX2 DN200\", \"value\": 1250.0},\n          {\"model\": \"MAGX2 DN250\", \"value\": 1250.0},\n          {\"model\": \"MAGX2 DN300\", \"value\": 2000.0}\n        ]\n      },\n      {\n        \"attribute\": \"length_of_horizontal_water_meter\",\n        \"unit_symbol\": \"mm\",\n        \"values\": [\n          {\"model\": \"MAGX2 DN25\", \"value\": 200},\n          {\"model\": \"MAGX2 DN32\", \"value\": 200},\n          {\"model\": \"MAGX2 DN40\", \"value\": 200},\n          {\"model\": \"MAGX2 DN50\", \"value\": 200},\n          {\"model\": \"MAGX2 DN65\", \"value\": 200},\n          {\"model\": \"MAGX2 DN80\", \"value\": 200},\n          {\"model\": \"MAGX2 DN100\", \"value\": 250},\n          {\"model\": \"MAGX2 DN125\", \"value\": 250},\n          {\"model\": \"MAGX2 DN150\", \"value\": 300},\n          {\"model\": \"MAGX2 DN200\", \"value\": 350},\n          {\"model\": \"MAGX2 DN250\", \"value\": 400},\n          {\"model\": \"MAGX2 DN300\", \"value\": 500}\n        ]\n      },\n      {\n        \"attribute\": \"indicating_range\",\n        \"unit_symbol\": \"m³\",\n        \"values\": [\n          {\"model\": \"MAGX2 DN25\", \"value\": 99999},\n          {\"model\": \"MAGX2 DN32\", \"value\": 99999},\n          {\"model\": \"MAGX2 DN40\", \"value\": 99999},\n          {\"model\": \"MAGX2 DN50\", \"value\": 99999},\n          {\"model\": \"MAGX2 DN65\", \"value\": 999999},\n          {\"model\": \"MAGX2 DN80\", \"value\": 999999},\n          {\"model\": \"MAGX2 DN100\", \"value\": 999999},\n          {\"model\": \"MAGX2 DN125\", \"value\": 999999},\n          {\"model\": \"MAGX2 DN150\", \"value\": 999999},\n          {\"model\": \"MAGX2 DN200\", \"value\": 9999999},\n          {\"model\": \"MAGX2 DN250\", \"value\": 9999999},\n          {\"model\": \"MAGX2 DN300\", \"value\": 9999999}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"maximum_permissible_error_upper_flowrate_zone\",\n        \"axis\": \"water_temperature\",\n        \"values\": [\n          {\"condition\": \"water temperature ≤ 30°C\", \"value\": 2, \"unit_symbol\": \"%\"},\n          {\"condition\": \"water temperature > 30°C\", \"value\": 3, \"unit_symbol\": \"%\"}\n        ]\n      },\n      {\n        \"attribute\": \"resolution_of_indicating_device\",\n        \"axis\": \"display_mode\",\n        \"values\": [\n          {\"condition\": \"normal mode\", \"value\": 0.001, \"unit_symbol\": \"m³\"},\n          {\"condition\": \"calibration mode\", \"value\": 0.000001, \"unit_symbol\": \"m³\"}\n        ]\n      },\n      {\n        \"attribute\": \"q3_q1_ratio\",\n        \"axis\": \"nominal_ratio_selection\",\n        \"values\": [\n          {\"condition\": \"R400\", \"value\": 400, \"unit_symbol\": null},\n          {\"condition\": \"R250\", \"value\": 250, \"unit_symbol\": null},\n          {\"condition\": \"R200\", \"value\": 200, \"unit_symbol\": null},\n   