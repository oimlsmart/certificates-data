      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"4076767\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"16 February 2026\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V., OIML Issuing Authority NL1\",\n    \"address_lines\": [\n      \"Thijsseweg 11\",\n      \"2629 JA Delft\",\n      \"The Netherlands\"\n    ],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    },\n    {\n      \"name\": \"ABB Engineering (Shanghai) Ltd.\",\n      \"address_lines\": [\n        \"No. 4528, Kangxin Highway\",\n        \"Pudong New District, Shanghai, 201315\",\n        \"P.R. China\"\n      ]\n    },\n    {\n      \"name\": \"ABB Inc.\",\n      \"address_lines\": [\n        \"125 E. County Line Road\",\n        \"Warminster, PA 18974\",\n        \"United States of America\"\n      ]\n    },\n    {\n      \"name\": \"ABB India Limited\",\n      \"address_lines\": [\n        \"Plot No. 5 & 6, 2nd Phase, Peenya Industrial Area\",\n        \"Bengaluru - 560058, Karnataka\",\n        \"India\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\n      \"AquaMaster4 FEW4XY.Z\",\n      \"AquaMaster4 FET4*\",\n      \"FEW41Y.Z\",\n      \"FEW43Y.Z\",\n      \"FEW45Y.Z\"\n    ],\n    \"description\": \"Electromagnetic water meter AquaMaster4. With X being 1 for standard or 3 for advanced or 5 for premium (mobile Comms - MC) variant; Y being 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z being R (reduced bore), V (virtual full bore) or F (full bore). Reduced bore sizes DN40 to DN600; (virtual) full bore sizes DN40 to DN1800.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\n        \"model_id\": \"FEW41Y.Z\",\n        \"label\": \"Standard variant (X=1)\",\n        \"attributes\": {\n          \"x_variant\": \"1 - standard\"\n        }\n      },\n      {\n        \"model_id\": \"FEW43Y.Z\",\n        \"label\": \"Advanced variant (X=3)\",\n        \"attributes\": {\n          \"x_variant\": \"3 - advanced\"\n        }\n      },\n      {\n        \"model_id\": \"FEW45Y.Z\",\n        \"label\": \"Premium variant with mobile comms (X=5)\",\n        \"attributes\": {\n          \"x_variant\": \"5 - premium (mobile Comms - MC)\"\n        }\n      }\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"Flow sensor\",\n      \"type_designations\": [\n        \"FET4\"\n      ],\n      \"characteristics\": {\n        \"y_code\": \"Y = 1, 2, 8 or 9 (integral/remote version, optionally sensor only)\",\n        \"z_code\": \"Z = R (reduced bore), V (virtual full bore) or F (full bore)\"\n      }\n    },\n    {\n      \"role\": \"Transmitter (calculating and indicating device)\",\n      \"type_designations\": [\n        \"FEW41Y.Z\",\n        \"FEW43Y.Z\",\n        \"FEW45Y.Z\"\n      ],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"x_code\": \"X = 1 (standard), 3 (advanced), 5 (premium, mobile Comms - MC variant)\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\n        \"value\": \"Electromagnetic\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"accuracy_class\": {\n        \"value\": \"1 and 2\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"environmental_class\": {\n        \"value\": \"O (installed outdoors)\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"mechanical_class\": {\n        \"value\": \"M1\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"ambient_temperature_range\": {\n        \"value\": {\n          \"min\": -25,\n          \"max\": 55\n        },\n        \"unit_symbol\": \"°C\",\n        \"unit_id\": null\n      },\n      \"water_temperature_class\": {\n        \"value\": \"T50\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"water_temperature_range\": {\n        \"value\": {\n          \"min\": 0.1,\n          \"max\": 50\n        },\n        \"unit_symbol\": \"°C\",\n        \"unit_id\": null\n      },\n      \"maximum_admissible_pressure\": {\n        \"value\": 1.6,\n        \"unit_symbol\": \"MPa\",\n        \"unit_id\": null\n      },\n      \"orientation\": {\n        \"value\": \"All positions (horizontal, vertical, or diagonal)\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"reverse_flow\": {\n        \"value\": \"The sensor is intended to measure reverse flow\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"checking_facilities\": {\n        \"value\": \"Type P (permanent) automatic checking facility\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"ac_mains_voltage\": {\n        \"value\": {\n          \"min\": 95,\n          \"max\": 240\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"ac_mains_frequency\": {\n        \"value\": {\n          \"min\": 50,\n          \"max\": 60\n        },\n        \"unit_symbol\": \"Hz\",\n        \"unit_id\": null\n      },\n      \"dc_supply_voltage_renewable_energy\": {\n        \"value\": {\n          \"min\": 6,\n          \"max\": 32\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"battery_cell_voltage\": {\n        \"value\": 3.6,\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"battery_operating_voltage_range\": {\n        \"value\": {\n          \"min\": 2.9,\n          \"max\": 3.6\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"ratio_q2_q1\": {\n        \"value\": 1.6,\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"ratio_q4_q3\": {\n        \"value\": 1.25,\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"minimum_ratio_q3_q1\": {\n        \"value\": 40,\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      }\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"replaceable_battery_configuration\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\n            \"model\": \"FEW41Y.Z\",\n            \"value\": \"2x 3.6 V\"\n          },\n          {\n            \"model\": \"FEW43Y.Z\",\n            \"value\": \"2x 3.6 V\"\n          },\n          {\n            \"model\": \"FEW45Y.Z\",\n            \"value\": \"6x 3.6 V\"\n          }\n        ]\n      },\n      {\n        \"attribute\": \"backup_battery_configuration_ac_dc_powered_modes\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\n            \"model\": \"FEW45Y.Z\",\n            \"value\": \"4x 3.6 V replaceable batteries included in AC mains and renewable energy powered modes\"\n          }\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"electromagnetic_environment\",\n        \"axis\": \"transmitter_and_antenna_configuration\",\n        \"values\": [\n          {\n            \"condition\": \"FEW41Y.Z / FEW43Y.Z\",\n            \"value\": \"E2\",\n            \"unit_symbol\": null\n          },\n          {\n            \"condition\": \"FEW45Y.Z with external antenna cable\",\n            \"value\": \"E1\",\n            \"unit_symbol\": null\n          },\n          {\n            \"condition\": \"FEW45Y.Z without external antenna cable\",\n            \"value\": \"E2\",\n            \"unit_symbol\": null\n          }\n        ]\n      },\n      {\n        \"attribute\": \"flow_profile_sensitivity_class\",\n        \"axis\": \"bore_and_size\",\n        \"values\": [\n          {\n            \"condition\": \"all sizes except full bore DN250 and larger\",\n            \"value\": \"U0 and D0 (0 x DN upstream and 0 x DN downstream)\",\n            \"unit_symbol\": null\n          },\n          {\n            \"condition\": \"full bore DN250 and larger\",\n            \"value\": \"U3 and D0 (3 x DN upstream and 0 x DN downstream)\",\n            \"unit_symbol\": null\n          }\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss_class\",\n        \"axis\": \"bore_and_size\",\n        \"values\": [\n          {\n            \"condition\": \"reduced bore, DN40 and DN50\",\n            \"value\": \"Δp 40\",\n            \"unit_symbol\": null\n          },\n          {\n            \"condition\": \"reduced bore, larger than DN50\",\n            \"value\": \"Δp 63\",\n            \"unit_symbol\": null\n          },\n          {\n            \"condition\": \"(virtual) full bore, DN40 and DN50\",\n            \"value\": \"Δp 10\",\n            \"unit_symbol\": null\n          },\n          {\n            \"condition\": \"(virtual) full bore, DN65 to DN200\",\n            \"value\": \"Δp 16\",\n            \"unit_symbol\": null\n          },\n          {\n            \"condition\": \"(virtual) full bore, DN250 and larger\",\n            \"value\": \"Δp 10\",\n            \"unit_symbol\": null\n          }\n        ]\n      },\n      {\n        \"attribute\": \"max_pressure_loss\",\n        \"axis\": \"bore_and_size\",\n        \"values\": [\n          {\n            \"condition\": \"reduced bore, DN40 and DN50\",\n            \"value\": 0.4,\n            \"unit_symbol\": \"bar\"\n          },\n          {\n            \"condition\": \"reduced bore, larger than DN50\",\n            \"value\": 0.63,\n            \"unit_symbol\": \"bar\"\n          },\n          {\n            \"condition\": \"(virtual) full bore, DN40 and DN50\",\n            \"value\": 0.1,\n            \"unit_symbol\": \"bar\"\n          },\n          {\n            \"condition\": \"(virtual) full bore, DN65 to DN200\",\n            \"value\": 0.16,\n            \"unit_symbol\": \"bar\"\n          },\n          {\n            \"condition\": \"(virtual) full bore, DN250 and larger\",\n            \"value\": 0.1,\n            \"unit_symbol\": \"bar\"\n          }\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Software identification for AquaMaster4 FEW41Y.Z and FEW43Y.Z variant\",\n      \"columns\": [\n        \"software_part_code\",\n        \"software_function\",\n        \"software_version\",\n        \"crc_checksum\",\n        \"remarks\"\n      ],\n      \"rows\": [\n        {\n          \"software_part_code\": \"3KXF208402U0113\",\n          \"software_function\": \"Full functionality\",\n          \"software_version\": \"03.00.03\",\n          \"crc_checksum\": \"B26AFE6B\",\n          \"remarks\": null\n        },\n        {\n          \"software_part_code\": \"3KXF208402U0113\",\n          \"software_function\": \"Full functionality\",\n          \"software_version\": \"03.00.04\",\n          \"crc_checksum\": \"6E98963A\",\n          \"remarks\": null\n        },\n        {\n          \"software_part_code\": \"3KXF208402U0113\",\n          \"software_function\": \"Full functionality\",\n          \"software_version\": \"03.02.00\",\n          \"crc_checksum\": \"E12E5C04\",\n          \"remarks\": null\n        },\n        {\n          \"software_part_code\": \"3KXF208402U0113\",\n          \"software_function\": \"Full functionality\",\n          \"software_vers