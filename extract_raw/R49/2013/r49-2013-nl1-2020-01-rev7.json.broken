se, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN750\", \"label\": \"Meter size DN750\", \"attributes\": {\"meter_size_mm\": 750, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN800\", \"label\": \"Meter size DN800\", \"attributes\": {\"meter_size_mm\": 800, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN900\", \"label\": \"Meter size DN900\", \"attributes\": {\"meter_size_mm\": 900, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1000\", \"label\": \"Meter size DN1000\", \"attributes\": {\"meter_size_mm\": 1000, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1050\", \"label\": \"Meter size DN1050\", \"attributes\": {\"meter_size_mm\": 1050, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1100\", \"label\": \"Meter size DN1100\", \"attributes\": {\"meter_size_mm\": 1100, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1200\", \"label\": \"Meter size DN1200\", \"attributes\": {\"meter_size_mm\": 1200, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1350\", \"label\": \"Meter size DN1350\", \"attributes\": {\"meter_size_mm\": 1350, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1400\", \"label\": \"Meter size DN1400\", \"attributes\": {\"meter_size_mm\": 1400, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1500\", \"label\": \"Meter size DN1500\", \"attributes\": {\"meter_size_mm\": 1500, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1600\", \"label\": \"Meter size DN1600\", \"attributes\": {\"meter_size_mm\": 1600, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1650\", \"label\": \"Meter size DN1650\", \"attributes\": {\"meter_size_mm\": 1650, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": true}},\n      {\"model_id\": \"DN1800\", \"label\": \"Meter size DN1800\", \"attributes\": {\"meter_size_mm\": 1800, \"reduced_bore_ac_mains\": false, \"reduced_bore_battery_renewable\": false, \"full_bore_ac_mains\": true, \"full_bore_battery_renewable\": false}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow sensor\",\n      \"type_designations\": [\"AquaMaster4 FEW4XY.Z\"],\n      \"characteristics\": {\n        \"version_code_x\": {\"value\": \"1 or 3 (standard or advanced)\"},\n        \"version_code_y\": {\"value\": \"1, 2, 8 or 9 (integral/remote version, optionally sensor only)\"},\n        \"bore_code_z\": {\"value\": \"R (reduced bore), V (virtual full bore), F (full bore)\"}\n      }\n    },\n    {\n      \"role\": \"flow transmitter / indicating device\",\n      \"type_designations\": [\"AquaMaster4 FET4\"]\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic\", \"unit_symbol\": null},\n      \"environmental_class\": {\"value\": \"O (installed outdoors)\", \"unit_symbol\": null},\n      \"electromagnetic_environment\": {\"value\": \"E2\", \"unit_symbol\": null},\n      \"mechanical_class\": {\"value\": \"M1\", \"unit_symbol\": null},\n      \"temperature_range_ambient\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": \"u:degree_Celsius\"},\n      \"water_temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null},\n      \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": \"u:degree_Celsius\"},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null},\n      \"orientation\": {\"value\": \"all positions (horizontal, vertical, or diagonal)\", \"unit_symbol\": null},\n      \"reverse_flow\": {\"value\": \"the sensor is intended to measure reverse flow\", \"unit_symbol\": null},\n      \"power_supply_voltage_ac_mains\": {\"value\": {\"min\": 85, \"max\": 240}, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"power_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null},\n      \"power_supply_type\": {\"value\": \"AC mains; renewable energy power (DC powered); replaceable battery\", \"unit_symbol\": null},\n      \"power_supply_voltage_dc_renewable\": {\"value\": {\"min\": 6, \"max\": 32}, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"battery_quantity\": {\"value\": 2, \"unit_symbol\": null},\n      \"battery_cell_voltage\": {\"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"battery_operating_voltage_range\": {\"value\": {\"min\": 2.9, \"max\": 3.6}, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"software_identification\": {\"value\": \"Software part code 3KXF208402U0113: version 03.00.03 (checksum B26AFE6B); version 03.00.04 (checksum 6E98963A); version 03.02.00 (checksum E12E5C04); version 03.03.02 (checksum D4D1E40B); version 03.03.03 (checksum CEEF45F1). Software part code 3KXF208402U0313: version 02.00.02 (checksum 84EBD1C8). Software part code 3KXF208402U0513: version 02.00.01 (checksum C28EAA16).\", \"unit_symbol\": null},\n      \"automatic_checking_facility\": {\"value\": \"Type P (permanent) automatic checking facility\", \"unit_symbol\": null}\n    },\n    \"model_level\": [],\n    \"config_level\": [\n      {\n        \"attribute\": \"flow_profile_sensitivity_class\",\n        \"axis\": \"meter_size\",\n        \"values\": [\n          {\"condition\": \"sizes smaller than DN250 (0 x DN upstream and 0 x DN downstream)\", \"value\": \"U0 and D0\", \"unit_symbol\": null},\n          {\"condition\": \"full bore sizes DN250 and larger (3 x DN upstream and 0 x DN downstream)\", \"value\": \"U3 and D0\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss_class\",\n        \"axis\": \"bore_type_and_meter_size\",\n        \"values\": [\n          {\"condition\": \"reduced bore, sizes DN40 and DN50\", \"value\": \"Δp 40\", \"unit_symbol\": null},\n          {\"condition\": \"reduced bore, sizes larger than DN50\", \"value\": \"Δp 63\", \"unit_symbol\": null},\n          {\"condition\": \"(virtual) full bore, sizes DN40 and DN50\", \"value\": \"Δp 10\", \"unit_symbol\": null},\n          {\"condition\": \"(virtual) full bore, sizes DN65 to DN200\", \"value\": \"Δp 16\", \"unit_symbol\": null},\n          {\"condition\": \"(virtual) full bore, sizes DN250 and larger\", \"value\": \"Δp 10\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"maximum_pressure_loss\",\n        \"axis\": \"bore_type_and_meter_size\",\n        \"values\": [\n          {\"condition\": \"reduced bore, sizes DN40 and DN50\", \"value\": 0.40, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"reduced bore, sizes larger than DN50\", \"value\": 0.63, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"(virtual) full bore, sizes DN40 and DN50\", \"value\": 0.10, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"(virtual) full bore, sizes DN65 to DN200\", \"value\": 0.16, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"(virtual) full bore, sizes DN250 and larger\", \"value\": 0.10, \"unit_symbol\": \"bar\"}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Table 2 General characteristics of the family of instruments - Reduced bore, AC mains powered\",\n      \"columns\": [\"meter_size\", \"accuracy_class\", \"q1\", \"q2\", \"q3\", \"q4\", \"ratio_q3_q1\"],\n      \"column_units\": [null, null, \"m³/h\", \"m³/h\", \"m³/h\", \"m³/h\", null],\n      \"description\": \"Flow rates Q1, Q2, Q3 and Q4 can be freely chosen as long as: Q3 and ratio Q3/Q1 are selected from paragraph 4.1 of OIML R49-1:2013; Q1 and Q2 are minimum values and the ratio Q2/Q1 = 1.6; Q3 and Q4 are maximum values and the ratio Q4/Q3 = 1.25; the ratio Q3/Q1 is at least 40.\",\n      \"rows\": [\n        {\"meter_size\": \"DN40\", \"accuracy_class\": \"1\", \"q1\": 0.05, \"q2\": 0.08, \"q3\": 25, \"q4\": 31.25, \"ratio_q3_q1\": 500},\n        {\"meter_size\": \"DN40\", \"accuracy_class\": \"2\", \"q1\": 0.025, \"q2\": 0.04, \"q3\": 25, \"q4\": 31.25, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN50\", \"accuracy_class\": \"1\", \"q1\": 0.08, \"q2\": 0.128, \"q3\": 40, \"q4\": 50, \"ratio_q3_q1\": 500},\n        {\"meter_size\": \"DN50\", \"accuracy_class\": \"2\", \"q1\": 0.04, \"q2\": 0.064, \"q3\": 40, \"q4\": 50, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN65\", \"accuracy_class\": \"1 & 2\", \"q1\": 0.063, \"q2\": 0.1008, \"q3\": 63, \"q4\": 78.75, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN80\", \"accuracy_class\": \"1 & 2\", \"q1\": 0.1, \"q2\": 0.16, \"q3\": 100, \"q4\