      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-24.06\",\n    \"scheme\": \"A\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2024-11-11\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"JANZ - Contagem e Gestao de Fluídos, S.A.\",\n      \"address_lines\": [\"Avenida Infante D. Henrique, 288\", \"1950-421 Lisboa\", \"Portugal\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"JANZ - Contagem e Gestao de Fluídos, S.A.\",\n      \"address_lines\": [\"Avenida Infante D. Henrique, 288\", \"1950-421 Lisboa\", \"Portugal\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"Smartio\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Ultrasonic water meter with dry dial and electronic indicating device, designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consists of a cast brass body with connecting screw threads, one pair of ultrasonic transducers and the electronic indicating device formed by an LCD display showing volume and flow. Volume resolution of 0.00001 m³ on the digital display. Without buttons; legally non-relevant communication possible via NFC sensor connected on the register. Ultrasonic water meter has a separation of software; non-legally relevant parts have no inadmissible influence on legally relevant software, measured data or specific parameters. The SW version and CRC of the legally relevant part are displayed in the auto-rounding menu on the LCD display. The meter displays the indication of each delivered volume every two minutes - separately for reverse flow and for forward flow; the permanently shown delivered volume is the difference between the two. Can be equipped with an impulse module which is not part of this certificate. Powered by a non-replaceable 3.6 V battery. Shall be installed to operate in any positions. Sealed by a plastic seal on the plastic meter cover (plastic frame holding the display glass); the meter cannot be accessed without damaging the seal.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"Smartio\",\n    \"models\": [\n      {\"model_id\": \"DN15 Q3=1.6 R=40\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=40\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=50\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=50\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=63\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=63\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=80\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=80\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=100\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=100\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=125\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=125\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=160\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=160\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=200\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=200\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=250\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=250\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=315\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=315\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=400\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=400\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=500\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=500\"},\n      {\"model_id\": \"DN15 Q3=1.6 R=630\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=630\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=800\"},\n      {\"model_id\": \"DN15 Q3=2.5 R=1000\"},\n      {\"model_id\": \"DN20 Q3=2.5 R=40\"},\n      {\"model_id\": \"DN20 Q3=4.0 R=40\"},\n      {\"model_id\": \"DN20 Q3=2.5 R=50\"},\n      {\"model_id\": \"DN20 Q3=4.0 R=50\"},\n      {\"model_id\": \"DN20 Q3=2.5 R=63\"},\n      {\"model_id\": \"DN20 Q3=4.0 R=63\