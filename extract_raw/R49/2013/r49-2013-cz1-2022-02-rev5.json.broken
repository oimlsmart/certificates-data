      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-22.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 12,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2025-10-03\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ISOIL INDUSTRIA SPA\",\n      \"address_lines\": [\"Via F.lli Gracchi, 27\", \"Cinisello Balsamo - MI\", \"200 99\", \"Italy\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Hemina SPA\",\n      \"address_lines\": [\"Via Piemonte 2\", \"Montagnana - PD\", \"350 44\", \"Italy\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MS2500 / MV110\", \"MS2500 / MV210\", \"MS2500 / MV145\"],\n    \"module_designation\": \"MS2500 / MV110 HV, LV, LLV and MS2500 / MV210 HV, LV, LLV + SUPERCAP or Rechargeable Lithium (not replaceable); MS2500 / MV145 HV and MS2500 / MV145 LLV and/or Lithium or Alkaline Batteries (replaceable)\",\n    \"description\": \"Electromagnetic water meters designed to measure, memorise and display the volume of water at metering conditions, consisting of the MS2500 sensor and the MV110, MV210 or MV145 electronic converter in compact or separate version with connecting cable. Sensor: steel body with connecting flanges, one pair of excitation coils and electrodes, with PTFE, polypropylene, Rilsan or ebonite liner. Converter: plastic or aluminium housing with LCD display showing volume and flow (volume resolution 0.001 m³), impulse and current outputs; RS485 or USB mini-B for legally non-relevant communication. Several password-protected security levels.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"MS2500/MV110 HV\", \"label\": \"MS2500 / MV110 HV + SUPERCAP or Rechargeable Lithium (not replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV110\", \"power_supply_variant\": \"HV\"}},\n      {\"model_id\": \"MS2500/MV110 LV\", \"label\": \"MS2500 / MV110 LV + SUPERCAP or Rechargeable Lithium (not replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV110\", \"power_supply_variant\": \"LV\"}},\n      {\"model_id\": \"MS2500/MV110 LLV\", \"label\": \"MS2500 / MV110 LLV + SUPERCAP or Rechargeable Lithium (not replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV110\", \"power_supply_variant\": \"LLV\"}},\n      {\"model_id\": \"MS2500/MV210 HV\", \"label\": \"MS2500 / MV210 HV + SUPERCAP or Rechargeable Lithium (not replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV210\", \"power_supply_variant\": \"HV\"}},\n      {\"model_id\": \"MS2500/MV210 LV\", \"label\": \"MS2500 / MV210 LV + SUPERCAP or Rechargeable Lithium (not replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV210\", \"power_supply_variant\": \"LV\"}},\n      {\"model_id\": \"MS2500/MV210 LLV\", \"label\": \"MS2500 / MV210 LLV + SUPERCAP or Rechargeable Lithium (not replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV210\", \"power_supply_variant\": \"LLV\"}},\n      {\"model_id\": \"MS2500/MV145 HV\", \"label\": \"MS2500 / MV145 HV and/or Lithium or Alkaline Batteries (replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV145\", \"power_supply_variant\": \"HV\"}},\n      {\"model_id\": \"MS2500/MV145 LLV\", \"label\": \"MS2500 / MV145 LLV and/or Lithium or Alkaline Batteries (replaceable)\", \"attributes\": {\"sensor\": \"MS2500\", \"converter\": \"MV145\", \"power_supply_variant\": \"LLV\"}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"Sensor (measurement transducer)\",\n      \"type_designations\": [\"MS2500\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"description\": \"Steel body with connecting flanges, one pair of excitation coils, electrodes and connection to the converter; several liner types available\",\n        \"liners\": [\n          {\"material\": \"PTFE\", \"dn_range\": \"DN 25 - DN 2000\", \"max_water_temperature\": {\"value\": 90, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []}},\n          {\"material\": \"Polypropylene\", \"dn_range\": \"DN 25 - DN 150\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []}},\n          {\"material\": \"Rilsan\", \"dn_range\": \"DN 50 - DN 2000\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []}},\n          {\"material\": \"Ebonite\", \"dn_range\": \"DN 200 - DN 2000\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []}}\n        ]\n      }\n    },\n    {\n      \"role\": \"Converter (electronic indicating device)\",\n      \"type_designations\": [\"MV110\", \"MV210\", \"MV145\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"body\": \"plastic or aluminium\",\n        \"display\": \"LCD showing volume and flow\",\n        \"outputs\": \"impulse output and current output\",\n        \"legally_non_relevant_communication\": \"RS485 or USB mini-B\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic water meter\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"accuracy_class\": {\"value\": \"1; 2\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"q2_over_q1\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"q4_over_q3\": {\"value\": 1.25, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_permitted_error_lower_flowrate_zone\": {\"value\": \"±3 (class 1); ±5 (class 2)\", \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_permitted_error_upper_flowrate_zone\": {\"value\": \"±1 (class 1); ±2 (class 2) / ±2 (class 1); ±3 (class 2)\", \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []},\n      \"water_pressure_class\": {\"value\": \"MAP40\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"pressure_loss_class\": {\"value\": \"Δp40\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"reverse_flow\": {\"value\": \"designed to measure\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"environmental_class\": {\"value\": \"B, O\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"electromagnetic_environment\": {\"value\": \"E1; E2\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": [\"1\"]},\n      \"ambient_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_pressure\": {\"value\": 4, \"unit_symbol\": \"MPa\", \"unit_id\": null, \"footnote_markers\": []},\n      \"orientation_limitation\": {\"value\": \"any\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"flow_profile_sensitivity_class\": {\"value\": \"U0D0\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"installation_sensitivity_class\": {\"value\": \"U0 D0\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"connection_type\": {\"value\": \"Flanged\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"minimum_straight_length_inlet_pipe\": {\"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null, \"footnote_markers\": []},\n      \"minimum_straight_length_outlet_pipe\": {\"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null, \"footnote_markers\"