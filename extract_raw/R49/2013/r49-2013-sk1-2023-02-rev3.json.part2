inal_diameter\",\n        \"values\": [\n          {\"condition\": \"DN15\", \"value\": \"80, 105, 110, 115, 165, 170\", \"unit_symbol\": \"mm\"},\n          {\"condition\": \"DN20\", \"value\": \"105, 110, 130, 165, 190\", \"unit_symbol\": \"mm\"}\n        ]\n      },\n      {\n        \"attribute\": \"water_temperature_range\",\n        \"axis\": \"meter_temperature_class\",\n        \"values\": [\n          {\"condition\": \"T30\", \"value\": {\"min\": 0.1, \"max\": 30}, \"unit_symbol\": \"°C\"},\n          {\"condition\": \"T50\", \"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\"},\n          {\"condition\": \"T30/70\", \"value\": {\"min\": 30, \"max\": 70}, \"unit_symbol\": \"°C\"},\n          {\"condition\": \"T70\", \"value\": {\"min\": 0.1, \"max\": 70}, \"unit_symbol\": \"°C\"}\n        ]\n      },\n      {\n        \"attribute\": \"maximum_permitted_error_upper_flow_rates\",\n        \"axis\": \"water_temperature\",\n        \"values\": [\n          {\"condition\": \"≤ 30 °C\", \"value\": 2, \"unit_symbol\": \"%\"},\n          {\"condition\": \"> 30 °C\", \"value\": 3, \"unit_symbol\": \"%\"}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Tab. 1 – Technical and metrological data – DN15 (QALCOSONIC W1)\",\n      \"columns\": [\"model\", \"nominal_diameter_dn\", \"permanent_flowrate_q3\", \"minimum_flowrate_q1\", \"transitional_flowrate_q2\", \"overload_flowrate_q4\", \"ratio_q3_q1\", \"pressure_loss_delta_p\"],\n      \"column_units\": [null, \"mm\", \"m³/h\", \"m³/h\", \"m³/h\", \"m³/h\", null, \"bar\"],\n      \"rows\": [\n        {\"model\": \"DN15-Q3=1.6-R80\", \"nominal_diameter_dn\": 15, \"permanent_flowrate_q3\": 1.6, \"minimum_flowrate_q1\": 0.02, \"transitional_flowrate_q2\": 0.032, \"overload_flowrate_q4\": 2, \"ratio_q3_q1\": 80, \"pressure_loss_delta_p\": 0.16},\n        {\"model\": \"DN15-Q3=1.6-R160\", \"nominal_diameter_dn\": 15, \"permanent_flowrate_q3\": 1.6, \"minimum_flowrate_q1\": 0.01, \