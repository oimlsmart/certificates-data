      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-26.03\",\n    \"scheme\": \"A\",\n    \"page_total\": 9,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2026-07-20\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute (CMI)\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"RNDr. Pavel Klenovský\",\n    \"person_title\": \"Director of Certification Body\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ADD Production\",\n      \"address_lines\": [\"str. Dragomirna 36\", \"Chisinau\", \"PC: MD-2008\", \"Republic of Moldova\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ADD Production\",\n      \"address_lines\": [\"str. Dragomirna 36\", \"Chisinau\", \"PC: MD-2008\", \"Republic of Moldova\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"WMP\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Ultrasonic water meter with dry dial and electronic indicating device (LCD), designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consists of a brass body with connecting screw threads, one pair of ultrasonic transducers and the electronic indicating device. Volume resolution 0.000 001 m³ on the digital display. Battery powered 3.6 V DC, without buttons and without communication interfaces. Software separation with CRC and SW version of the legally relevant part displayed on the LCD. Can be installed in horizontal position with the indicating device at the top and at the side, and in vertical position with flow from bottom to top.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"WMP\",\n    \"models\": [\n      {\"model_id\": \"DN15_Q3=1.6\", \"label\": \"DN15, Q3 = 1.6 m³/h\", \"attributes\": {\"nominal_diameter_mm\": 15, \"q3_m3_h\": 1.6}},\n      {\"model_id\": 