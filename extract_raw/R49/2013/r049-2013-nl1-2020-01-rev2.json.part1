alue: {min: 0.1, max: 50}, unit_symbol: \"°C\"}\n- maximum_admissible_pressure: {value: 1.6, unit_symbol: \"MPa\"}\n- maximum_admissible_pressure_equivalent: {value: 16, unit_symbol: \"bar\"}\n- orientation: {value: \"All positions\"}\n- reverse_flow: {value: \"intended to measure reverse flow\"}\n- mains_power_supply_voltage: {value: {min: 85, max: 240}, unit_symbol: \"V\"}\n- mains_power_supply_frequency: {value: {min: 50, max: 60}, unit_symbol: \"Hz\"}\n- dc_power_supply_voltage: {value: {min: 6, max: 32}, unit_symbol: \"V\"}\n- battery_nominal_voltage: {value: 3.6, unit_symbol: \"V\"}\n- battery_operating_voltage_range: {value: {min: 2.9, max: 3.6}, unit_symbol: \"V\"}\n- software_identification: {value: \"03.00.03 (checksum B26AFE6B); 03.00.04 (checksum 6E98963A)\"}\n- checking_facility: {value: \"Type P (permanent) automatic checking facility\"}\n\nconfig_level:\n1. {attribute: \"flow_profile_sensitivity_class\", axis: \"meter_size\", values: [{condition: \"smaller than DN250\", value: \"U0 and D0 (0 x DN upstream and 0 x DN downstream)\"}, {condition: \"DN250 and larger\", value: \"U3 and D0 (3 x DN upstream and 0 x DN downstream)\"}]}\n2. {attribute: \"pressure_loss_class\", axis: \"meter_size (reduced bore)\", values: [{condition: \"DN40 and DN50\", value: \"Δp 40\"}, {condition: \"larger than DN50\", value: \"Δp 63\"}]}\n3. {attribute: \"maximum_pressure_loss\", unit_symbol: \"bar\", axis: \"meter_size (reduced bore)\", values: [{condition: \"DN40 and DN50\", value: 0.4}, {condition: \"larger than DN50\", value: 0.63}]}\n4. {attribute: \"pressure_loss_class\", axis: \"meter_size (virtual or full bore)\", values: [{condition: \"DN40 and DN50\", value: \"Δp 10\"}, {condition: \"DN65 to DN200\", value: \"Δp 16\"}, {condition: \"DN250 and larger\", value: \"Δp 10\"}]}\n5. {attribute: \"maximum_pressure_loss\", unit_symbol: \"bar\", axis: \"meter_size (virtual or full bore)\", values: [{condition: \"DN40 and DN50\", value: 0.1}, {condition: \"DN65 to DN200\", v