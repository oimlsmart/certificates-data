      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2254799\",\n    \"page_total\": 9,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2020-12-24\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijssseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M. Boudewijns\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW4XY.Z\", \"AquaMaster4 FET4*\"],\n    \"description\": \"Electromagnetic water meter. FEW4XY.Z: X = 1 or 3 (standard or enhanced), Y = 1, 2, 8 or 9 (integral/remote version, optionally sensor only), Z = R (reduced bore), V (virtual full bore) or F (full bore).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\"model_id\": \"DN40 class 1\", \"attributes\": {\"bore_type\": \"reduced\", \"power_supply\": \"AC mains\"}},\n      {\"model_id\": \"DN40 class 2\", \"attributes\": {\"bore_type\": \"reduced\", \"power_supply\": \"AC mains\"}},\n      {\"model_id\": \"DN50 class 1\", \"attributes\": {\"bore_type\": \"reduced\", \"power_supply\": \"AC mains\"}},\n      {\"model_id\": \"DN50 class 2\", \"attributes\": {\"bore_type\": \"reduced\", \"power_supply\": \"AC mains\"}},\n      {\"model_id\": \"DN65 class 1&2\", \"attributes\": {\"bore_type\": \"reduced\", \"power_supply\