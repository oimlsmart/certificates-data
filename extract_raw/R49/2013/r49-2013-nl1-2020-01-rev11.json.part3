      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"revision\": \"11\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3891281\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\"\n  },\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"description\": \"Family of full bore instruments (water meters); certificate covers configurations powered by AC mains (Table 7) and by battery / renewable energy (Table 8). Flow rates Q1 and Q2 listed are minimum values (Q2/Q1 = 1.6); Q3 and Q4 listed are maximum values (Q4/Q3 = 1.25); flow rates may be freely chosen within these constraints.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"Full bore\",\n    \"models\": [\n      {\"model_id\": \"DN40\", \"label\": \"DN40\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN50\", \"label\": \"DN50\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN65\", \"label\": \"DN65\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN80\", \"label\": \"DN80\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN100\", \"label\": \"DN100\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN125\", \"label\": \"DN125\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN150\", \"label\": \"DN150\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN200\", \"label\": \"DN200\", \"attributes\": {\"power_supply\": [\"AC mains\", \"Battery / Renewable energy\"]}},\n      {\"model_id\": \"DN250\", \"label\": \"DN250\", \"attributes\": {\"power_suppl