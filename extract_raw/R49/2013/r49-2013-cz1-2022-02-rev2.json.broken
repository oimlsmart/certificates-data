      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-2022.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 15,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2023-02-02\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ISOIL INDUSTRIA SPA\",\n      \"address_lines\": [\"Via F.lli Gracchi, 27\", \"Cinisello Balsamo\", \"20 099 Italy\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Hemina SPA\",\n      \"address_lines\": [\"Via Piemonte 1\", \"Montagnana – PD\", \"PC: 350 44\", \"Italy\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MS2500 / MV110\", \"MS2500 / MV145\"],\n    \"module_designation\": \"MS2500 / MV110 HV; MS2500 / MV110 LV; MS2500 / MV110 LLV; MS2500 / MV145 HV + lit. battery; MS2500 / MV145 LLV + alk. battery; MS2500 / MV145 LLV + lit. battery\",\n    \"description\": \"Electromagnetic water meters with electronic indicating device (LCD), designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consist of sensor MS2500 (steel body with flanges, excitation coils, electrodes) and converter MV110 or MV145, in compact set-up or separate version with connecting cable. Volume displayed with 0.001 m³ resolution; impulse and current outputs; legally non-relevant communication via RS485 or USB mini-B. Power-supply modifications: MV110 HV (100-240 V AC), MV110 LV (24-36 V AC/DC), MV110 LLV (10-48 V DC); MV145 HV + lithium battery (100-240 V AC, 3.7 V backup), MV145 LLV + alkaline battery (10-48 V DC, 9 V backup), MV145 LLV + lithium battery Li-SOCl2 (10-48 V DC, 3.6 V backup). Liner options: PTFE (DN25-DN350, 90°C), polypropylene (DN25-DN150, 50°C), Rilsan (DN50-DN350, 50°C), Ebonite (DN200-DN350, 50°C). Can be installed in any position.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"DN25 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 25, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN25 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 25, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN32 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 32, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN32 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 32, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN40 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 40, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN40 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 40, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN50 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 50, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN50 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 50, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN65 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 65, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN65 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 65, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN80 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 80, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN80 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 80, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN100 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 100, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN100 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 100, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN125 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 125, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN125 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 125, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN150 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 150, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN150 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 150, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN200 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 200, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN200 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 200, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN250 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 250, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN250 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 250, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN300 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 300, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN300 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 300, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}},\n      {\"model_id\": \"DN350 (Q3/Q1=250)\", \"attributes\": {\"nominal_diameter\": 350, \"accuracy_class\": 1, \"ratio_q3_over_q1\": 250}},\n      {\"model_id\": \"DN350 (Q3/Q1=400)\", \"attributes\": {\"nominal_diameter\": 350, \"accuracy_class\": 2, \"ratio_q3_over_q1\": 400}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"sensor (electromagnetic measurement transducer)\",\n      \"type_designations\": [\"MS2500\"],\n      \"characteristics\": {\n        \"construction\": \"steel body with connecting flanges, one pair of excitation coils, electrodes and connection to the converter\",\n        \"liner_options\": [\n          {\"material\": \"PTFE\", \"dn_range\": \"DN25 - DN350\", \"max_water_temperature\": {\"value\": 90, \"unit_symbol\": \"°C\"}},\n          {\"material\": \"polypropylene\", \"dn_range\": \"DN25 - DN150\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\"}},\n          {\"material\": \"Rilsan\", \"dn_range\": \"DN50 - DN350\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\"}},\n          {\"material\": \"Ebonite\", \"dn_range\": \"DN200 - DN350\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\"}}\n        ]\n      }\n    },\n    {\n      \"role\": \"converter (electronic calculator and indicator)\",\n      \"type_designations\": [\"MV110\", \"MV145\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"display\": \"LCD display showing volume and flow\",\n        \"outputs\": \"impulse output and current output\",\n        \"communication\": \"RS485 output or USB mini-B (legally non-relevant)\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic water meter\"},\n      \"ratio_q2_over_q1\": {\"value\": 1.6},\n      \"ratio_q4_over_q3\": {\"value\": 1.25},\n      \"water_pressure_class\": {\"value\": \"MAP16\"},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\"},\n      \"pressure_loss_class\": {\"value\": \"Δp40\"},\n      \"reverse_flow\": {\"value\": \"designed to measure\"},\n      \"environmental_class\": {\"value\": \"O\"},\n      \"operating_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\"},\n      \"electromagnetic_environment\": {\"value\": \"E1, E2\"},\n      \"mechanical_environment_class\": {\"value\": \"B, O\"},\n      \"orientation_limitation\": {\"value\": \"any\"},\n      \"connection_type\": {\"value\": \"Flanged\"},\n      \"minimum_straight_inlet_pipe_length\": {\"value\": 0, \"unit_symbol\": \"mm\"},\n      \"minimum_straight_outlet_pipe_length\": {\"value\": 0, \"unit_symbol\": \"mm\"},\n      \"flow_profile_sensitivity_class\": {\"value\": \"U0D0\"},\n      \"flow_conditioner_required\": {\"value\": false},\n      \"eut_test_category\": {\"value\": \"Electromagnetic water meter\"},\n      \"eut_test_case\": {\"value\": \"D\"},\n      \"cut_off\": {\"value\": 0.2, \"unit_symbol\": \"%\"},\n      \"empty_pipe_detection\": {\"value\": \"on\"},\n      \"display_volume_resolution\": {\"value\": 0.001, \"unit_symbol\": \"m³\"}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"minimum_flowrate_q1\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"DN25 (Q3/Q1=250)\", \"value\": 0.064},\n          {\"model\": \"DN25 (Q3/Q1=400)\", \"value\": 0.04},\n          {\"model\": \"DN32 (Q3/Q1=250)\", \"value\": 0.1},\n          {\"model\": \"DN32 (Q3/Q1=400)\", \"value\": 0.062},\n          {\"model\": \"DN40 (Q3/Q1=250)\", \"value\": 0.16},\n          {\"model\": \"DN40 (Q3/Q1=400)\", \"value\": 0.1},\n          {\"model\": \"DN50 (Q3/Q1=250)\", \"value\": 0.252},\n          {\"model\": \"DN50 (Q3/Q1=400)\", \"value\": 0.158},\n          {\"model\": \"DN65 (Q3/Q1=250)\", \"value\": 0.4},\n          {\"model\": \"DN65 (Q3/Q1=400)\", \"value\": 0.25},\n          {\"model\": \"DN80 (Q3/Q1=250)\", \"value\": 0.64},\n          {\"model\": \"DN80 (Q3/Q1=400)\", \"value\": 0.4},\n          {\"model\": \"DN100 (Q3/Q1=250)\", \"value\": 1.0},\n          {\"model\": \"DN100 (Q3/Q1=400)\", \"value\": 0.63},\n          {\"model\": \"DN125 (Q3/Q1=250)\", \"value\": 1.6},\n          {\"model\": \"DN125 (Q3/Q1=400)\", \"value\": 1.0},\n          {\"model\": \"DN150 (Q3/Q1=250)\", \"value\": 2.52},\n          {\"model\": \"DN150 (Q3/Q1=400)\", \"value\": 1.6},\n          {\"model\": \"DN200 (Q3/Q1=250)\", \"valu