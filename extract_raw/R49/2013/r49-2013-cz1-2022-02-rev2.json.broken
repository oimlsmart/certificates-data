25 (Q3/Q1=400)\", \"value\": 99999},\n          {\"model\": \"DN32 (Q3/Q1=250)\", \"value\": 99999},\n          {\"model\": \"DN32 (Q3/Q1=400)\", \"value\": 99999},\n          {\"model\": \"DN40 (Q3/Q1=250)\", \"value\": 99999},\n          {\"model\": \"DN40 (Q3/Q1=400)\", \"value\": 99999},\n          {\"model\": \"DN50 (Q3/Q1=250)\", \"value\": 99999},\n          {\"model\": \"DN50 (Q3/Q1=400)\", \"value\": 99999},\n          {\"model\": \"DN65 (Q3/Q1=250)\", \"value\": 999999},\n          {\"model\": \"DN65 (Q3/Q1=400)\", \"value\": 999999},\n          {\"model\": \"DN80 (Q3/Q1=250)\", \"value\": 999999},\n          {\"model\": \"DN80 (Q3/Q1=400)\", \"value\": 999999},\n          {\"model\": \"DN100 (Q3/Q1=250)\", \"value\": 999999},\n          {\"model\": \"DN100 (Q3/Q1=400)\", \"value\": 999999},\n          {\"model\": \"DN125 (Q3/Q1=250)\", \"value\": 999999},\n          {\"model\": \"DN125 (Q3/Q1=400)\", \"value\": 999999},\n          {\"model\": \"DN150 (Q3/Q1=250)\", \"value\": 999999},\n          {\"model\": \"DN150 (Q3/Q1=400)\", \"value\": 999999},\n          {\"model\": \"DN200 (Q3/Q1=250)\", \"value\": 9999999},\n          {\"model\": \"DN200 (Q3/Q1=400)\", \"value\": 9999999},\n          {\"model\": \"DN250 (Q3/Q1=250)\", \"value\": 9999999},\n          {\"model\": \"DN250 (Q3/Q1=400)\", \"value\": 9999999},\n          {\"model\": \"DN300 (Q3/Q1=250)\", \"value\": 9999999},\n          {\"model\": \"DN300 (Q3/Q1=400)\", \"value\": 9999999},\n          {\"model\": \"DN350 (Q3/Q1=250)\", \"value\": 9999999},\n          {\"model\": \"DN350 (Q3/Q1=400)\", \"value\": 9999999}\n        ]\n      },\n      {\n        \"attribute\": \"resolution_of_indicating_device\",\n        \"unit_symbol\": \"m³\",\n        \"values\": [\n          {\"model\": \"DN25 (Q3/Q1=250)\", \"value\": 0.0001},\n          {\"model\": \"DN25 (Q3/Q1=400)\", \"value\": 0.0001},\n          {\"model\": \"DN32 (Q3/Q1=250)\", \"value\": 0.0001},\n          {\"model\": \"DN32 (Q3/Q1=400)\", 