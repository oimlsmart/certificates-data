ol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"environmental_class\": {\"value\": \"O (installed outdoors)\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"mechanical_class\": {\"value\": \"M1\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"ambient_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"water_temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null, \"footnote_markers\": []},\n      \"orientation\": {\"value\": \"All positions (horizontal, vertical, or diagonal)\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"reverse_flow_measured\": {\"value\": true, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"checking_facility\": {\"value\": \"Type P (permanent) automatic checking facility\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"ac_mains_supply_voltage\",\n        \"unit_symbol\": \"V\",\n        \"values\": [\n          {\"model\": \"FEW41Y.Z\", \"value\": {\"min\": 95, \"max\": 240}},\n          {\"model\": \"FEW43Y.Z\", \"value\": {\"min\": 95, \"max\": 240}},\n          {\"model\": \"FEW45Y.Z\", \"value\": {\"min\": 95, \"max\": 240}}\n        ]\n      },\n      {\n        \"attribute\": \"ac_mains_supply_frequency\",\n        \"unit_symbol\": \"Hz\",\n        \"values\": [\n          {\"model\": \"FEW41Y.Z\", \"value\": {\"min\": 50, \"max\": 60}},\n          {\"model\": \"FEW43Y.Z\", \"value\": {\"min\": 50, \"max\": 60}},\n          {\"model\": \"FEW45Y.Z\", \"value\": {\"min\": 50, \"max\": 60}}\n        ]\n      },\n      {\n        \"attribute\": \"dc_powered_supply_voltage\",\n        \"unit_symbol\": \"V\",\n        \"values\": [\n          {\"model\": \"FEW41Y.Z\", \"value\": {\"min\": 6, \"max\": 32}},\n          {\"model\": \"FEW43Y.Z\", \"value\": {\"min\": 6, \"max\": 32}},\n          {\"model\": \"FEW45Y.Z\", \"value\": {\"min\": 6, \"max\": 32}}\n        ]\n      },\n      {\n        \"attribute\": \"replaceable_battery_cell_count\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"FEW41Y.Z\", \"value\": 2},\n          {\"model\": \"FEW43Y.Z\", \"value\": 2},\n          {\"model\": \"FEW45Y.Z\", \"value\": 6}\n        ]\n      },\n      {\n        \"attribute\": \"replaceable_battery_cell_voltage\",\n        \"unit_symbol\": \"V\",\n        \"values\": [\n          {\"model\": \"FEW41Y.Z\", \"value\": 3.6},\n          {\"model\": \"FEW43Y.Z\", \"value\": 3.6},\n          {\"model\": \"FEW45Y.Z\", \"value\": 3.6}\n        ]\n      },\n      {\n        \"attribute\": \"replaceable_battery_operating_voltage_range\",\n        \"unit_symbol\": \"V\",\n        \"values\": [\n          {\"model\": \"FEW41Y.Z\", \"value\": {\"min\": 2.9, \"max\": 3.6}},\n          {\"model\": \"FEW43Y.Z\", \"value\": {\"min\": 2.9, \"max\": 3.6}},\n          {\"model\": \"FEW45Y.Z\", \"value\": {\"min\": 2.9, \"max\": 3.6}}\n        ]\n      },\n      {\n        \"attribute\": \"replaceable_battery_cells_included_with_mains_or_dc_power\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"FEW45Y.Z\", \"value\": 4}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"electromagnetic_environment\",\n        \"axis\": \"model and antenna cable configuration\",\n        \"values\": [\n          {\"condition\": \"FEW41Y.Z and FEW43Y.Z\", \"value\": \"E2\", \"unit_symbol\": null},\n          {\"condition\": \"FEW45Y.Z transmitter with external antenna cable\", \"value\": \"E1\", \"unit_symbol\": null},\n          {\"condition\": \"FEW45Y.Z transmitter without external antenna cable\", \"value\": \"E2\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"flow_profile_sensitivity_class\",\n        \"axis\": \"bore and meter size\",\n        \"values\": [\n          {\"condition\": \"meter sizes below DN250\", \"value\": \"U0 and D0 (0 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null},\n          {\"condition\": \"full bore sizes DN250 and larger\", \"value\": \"U3 and D0 (3 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null}\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss\",\n        \"axis\": \"bore and meter size\",\n        \"values\": [\n          {\"condition\": \"reduced bore, DN40 and DN50 (pressure loss class Δp 40)\", \"value\": 0.4, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"reduced bore, sizes larger than DN50 (pressure loss class Δp 63)\", \"value\": 0.63, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"virtual full bore or full bore, DN40 and DN50 (pressure loss class Δp 10)\", \"value\": 0.1, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"virtual full bore or full bore, DN65 to DN200 (pressure loss class Δp 16)\", \"value\": 0.16, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"virtual full bore or full bore, DN250 and larger (pressure loss class Δp 10)\", \"value\": 0.1, \"unit_symbol\": \"bar\"}\n        ]\n      },\n      {\n        \"attribute\": \"power_supply_voltage\",\n        \"axis\": \"power source\",\n        \"values\": [\n          {\"condition\": \"AC mains\", \"value\": {\"min\": 95, \"max\": 240}, \"unit_symbol\": \"V\"},\n          {\"condition\": \"DC powered (renewable energy)\", \"value\": {\"min\": 6, \"max\": 32}, \"unit_symbol\": \"V\"},\n          {\"condition\": \"replaceable battery (cell voltage)\", \"value\": 3.6, \"unit_symbol\": \"V\"}\n        ]\n      },\n      {\n        \"attribute\": \"power_supply_frequency\",\n        \"axis\": \"power source\",\n        \"values\": [\n          {\"condition\": \"AC mains\", \"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\"}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Table 5 - General characteristics of the family of instruments: Reduced bore - AC mains powered\",\n      \"columns\": [\"meter_size\", \"accuracy_class\", \"q1\", \"q2\", \"q3\", \"q4\", \"q3_q1_ratio\"],\n      \"column_units\": [null, null, \"m³/h\", \"m³/h\", \"m³/h\", \"m³/h\", null],\n      \"rows\": [\n        {\"meter_size\": \"DN40\", \"accuracy_class\": 1, \"q1\": 0.05, \"q2\": 0.08, \"q3\": 25, \"q4\": 31.25, \"q3_q1_ratio\": 500},\n        {\"meter_size\": \"DN40\", \"accuracy_class\": 2, \"q1\": 0.025, \"q2\": 0.04, \"q3\": 25, \"q4\": 31.25, \"q3_q1_ratio\": 1000},\n        {\"meter_size\": \"DN50\", \"accuracy_class\": 1, \"q1\": 0.08, \"q2\": 0.128, \"q3\": 40, \"q4\": 50, \"q3_q1_ratio\": 500},\n        {\"meter_size\": \"DN50\", \"accuracy_class\": 2, \"q1\": 0.04, \"q2\": 0.064, \"q3\": 40, \"q4\": 50, \"q3_q1_ratio\": 1000},\n        {\"meter_size\": \"DN65\", \"accuracy_class\": \"1 & 2\", \"q1\": 0.063, \"q2\": 0.1008, \"q3\": 63, \"q4\": 78.75, \"q3_q1_ratio\": 1000},\n        {\"meter_size\": \"DN80\", \"accuracy_class\": \"1 & 2\", \"q1\": 0.1, \"q2\": 0.16, \"q3\": 100, \"q4\": 125, \"q3_q1_ratio\": 1000},\n        {\"meter_size\": \"DN100\", \"accuracy_class\": 1, \"q1\": 0.32, \"q2\": 0.512, \"q3\": 160, \"q4\": 200, \"q3_q1_ratio\": 500},\n        {\"meter_size\": \"DN100\", \"accuracy_class\": 2, \"q1\": 0.16, \"q2\": 0.256, \"q3\": 160, \"q4\": 200, \"q3_q1_ratio\": 1000},\n        {\"meter_size\": \"DN125\", \"accuracy_class\": 1, \"q1\": 0.32, \"q2\": 0.512, \"q3\": 160, \"q4\": 200, \"q3_q1_ratio\": 500},\n        {\"meter_size\": \"DN125\", \"accuracy_class\": 2, \"q1\": 0.16, \"q2\": 0.256, \"q3\