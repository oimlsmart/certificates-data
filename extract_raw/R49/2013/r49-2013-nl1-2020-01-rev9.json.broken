      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"revision\": \"9\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2563125\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2023-09-22\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    },\n    {\n      \"name\": \"ABB Engineering (Shanghai) Ltd.\",\n      \"address_lines\": [\"No. 4528, Kangxin Highway, Pudong New District\", \"Shanghai, 201319\", \"P.R. China\"]\n    },\n    {\n      \"name\": \"ABB Inc.\",\n      \"address_lines\": [\"125 E. County Line Road\", \"Warminster, PA 18974\", \"United States of America\"]\n    },\n    {\n      \"name\": \"ABB India Limited\",\n      \"address_lines\": [\"Plot No. 5 & 6, 2nd Phase, Peenya Industrial Area\", \"Bengaluru - 560058, Karnataka\", \"India\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW4XY.Z\", \"AquaMaster4 FET4*\"],\n    \"module_designation\": null,\n    \"description\": \"An electromagnetic water meter. X = 1 for standard, 3 for advanced or 5 for premium (mobile Comms - MC) variant; Y = 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z = R (reduced bore), V (virtual full bore) or F (full bore).\"\n  },\n  \"model_family\": {\n    \"