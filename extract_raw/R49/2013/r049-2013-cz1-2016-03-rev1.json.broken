      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-CZ-16.03\",\n    \"scheme\": \"B\",\n    \"page_total\": 10,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2017-06-28\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31,\", \"638 00 Brno, CZ\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Arkon Flow Systems, s.r.o.\",\n      \"address_lines\": [\"Berkova 534/92, 612 00 Brno\", \"Czech Republic\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Arkon Flow Systems, s.r.o.\",\n      \"address_lines\": [\"Berkova 534/92, 612 00 Brno\", \"Czech Republic\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MAGB1\"],\n    \"module_designation\": null,\n    \"description\": \"The water meter type MAGB1 is electromagnetic water meter. There are two modifications: compact and remote version. The water meters type MAGB1 are intended for metering cold potable water and hot water, based on an inductive principle, PTFE and hard rubber lining, with straight inlet (5 times the diameter) and outlet (3 times the diameter) length, without flow conditioner and there are equipped with an electronic calculating/indicating device. The maximum cable length for remote version is 6 meters. The display shows the measurements in cubic meter volume (positive, negative, total and auxiliary) and cubic meter per hour flow rate. The meter is not designed to measure reverse flow. The meter does not require any extra-mechanical housing or adjustments. The meter is intended for mount to the connecting any pipework with the flow axis in the horizontal and vertical (from bottom to top and from top to bottom) plane and with the indicating device positioned at the top and at the side. The meter is equipped with the electronic indicating device. The display is a digital type, and can show up to 9 digits. The normal resolution mode is used during normal operation. The water meter displays in the normal resolution mode up to 000000.001 m³/h flow rate and 000.001 m³ volume on the digital display. The water meter displays the volume resolution of 0.001 L on the digital display in the high resolution mode which would be used during the calibration process. This mode is set up by factory tool (software had to be attached). The water meters type MAGB1 can be equipped by frequency output which can be used for remote reading or by RS 485 (with maximum cable length 3 m).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"MAGB1\",\n    \"models\": [\n      {\"model_id\": \"DN25 R160\"},\n      {\"model_id\": \"DN25 R100\"},\n      {\"model_id\": \"DN25 R50\"},\n      {\"model_id\": \"DN32 R160\"},\n      {\"model_id\": \"DN32 R100\"},\n      {\"model_id\": \"DN32 R50\"},\n      {\"model_id\": \"DN40 R160\"},\n      {\"model_id\": \"DN40 R100\"},\n      {\"model_id\": \"DN40 R50\"},\n      {\"model_id\": \"DN50 R160\"},\n      {\"model_id\": \"DN50 R100\"},\n      {\"model_id\": \"DN50 R50\"},\n      {\"model_id\": \"DN65 R160\"},\n      {\"model_id\": \"DN65 R100\"},\n      {\"model_id\": \"DN65 R50\"},\n      {\"model_id\": \"DN80 R160\"},\n      {\"model_id\": \"DN80 R100\"},\n      {\"model_id\": \"DN80 R50\"},\n      {\"model_id\": \"DN100 R160\"},\n      {\"model_id\": \"DN100 R100\"},\n      {\"model_id\": \"DN100 R50\"},\n      {\"model_id\": \"DN125 R160\"},\n      {\"model_id\": \"DN125 R100\"},\n      {\"model_id\": \"DN125 R50\"},\n      {\"model_id\": \"DN150 R160\"},\n      {\"model_id\": \"DN150 R100\"},\n      {\"model_id\": \"DN150 R50\"},\n      {\"model_id\": \"DN200 R160\"},\n      {\"model_id\": \"DN200 R100\"},\n      {\"model_id\": \"DN200 R50\"},\n      {\"model_id\": \"DN250 R160\"},\n      {\"model_id\": \"DN250 R100\"},\n      {\"model_id\": \"DN250 R50\"},\n      {\"model_id\": \"DN300 R160\"},\n      {\"model_id\": \"DN300 R100\"},\n      {\"model_id\": \"DN300 R50\"}\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"accuracy_class\": {\"value\": 2, \"unit_symbol\": null, \"unit_id\": null},\n      \"ratio_q2_over_q1\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\": null},\n      \"ratio_q4_over_q3\": {\"value\": 1.25, \"unit_symbol\": null, \"unit_id\": null},\n      \"maximum_permissible_error_lower_zone\": {\"value\": {\"min\": -5, \"max\": 5}, \"unit_symbol\": \"%\", \"unit_id\": null},\n      \"temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null},\n      \"water_pressure_class\": {\"value\": \"MAP 10\", \"unit_symbol\": null, \"unit_id\": null},\n      \"pressure_loss_class\": {\"value\": \"ΔP 10\", \"unit_symbol\": null, \"unit_id\": null},\n      \"flow_profile_sensitivity_classes\": {\"value\": \"U5 D3\", \"unit_symbol\": null, \"unit_id\": null},\n      \"orientation_limitation\": {\"value\": \"any\", \"unit_symbol\": null, \"unit_id\": null},\n      \"connection_type\": {\"value\": \"flange\", \"unit_symbol\": null, \"unit_id\": null},\n      \"climatic_environment_class\": {\"value\": \"B\", \"unit_symbol\": null, \"unit_id\": null},\n      \"battery_voltage\": {\"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"minimum_battery_life\": {\"value\": 5, \"unit_symbol\": \"years\", \"unit_id\": null},\n      \"low_flow_cutoff\": {\"value\": 1, \"unit_symbol\": \"%\", \"unit_id\": null},\n      \"low_flow_cutoff_reference\": {\"value\": \"nominal flowrate\", \"unit_symbol\": null, \"unit_id\": null},\n      \"display_max_digits\": {\"value\": 9, \"unit_symbol\": null, \"unit_id\": null},\n      \"rs485_max_cable_length\": {\"value\": 3, \"unit_symbol\": \"m\", \"unit_id\": null}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"overload_flowrate_q4\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"DN25 R160\", \"value\": 20}, {\"model\": \"DN25 R1