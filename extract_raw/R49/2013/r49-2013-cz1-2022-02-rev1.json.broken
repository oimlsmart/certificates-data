      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-2022.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 15,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2022-09-13\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ISOIL INDUSTRIA SPA\",\n      \"address_lines\": [\"Via F.lli Gracchi, 27\", \"Cinisello Balsamo\", \"20 099 Italy\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Hemina SPA\",\n      \"address_lines\": [\"Via Piemonte 1\", \"Montagnana – PD\", \"350 44 Italy\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MS2500 / MV110\", \"MS2500 / MV145\"],\n    \"module_designation\": \"MS2500 / MV110 HV; MS2500 / MV110 LV; MS2500 / MV110 LLV; MS2500 / MV145 HV + lit. battery; MS2500 / MV145 LLV + alk. battery; MS2500 / MV145 LLV + lit. battery\",\n    \"description\": \"Electromagnetic water meter with electronic indicating device, designed to measure, memorise and display the volume of water passing through the measurement transducer at metering conditions. Consists of the sensor MS2500 and the converter MV110 or MV145, in compact set-up or separate version with connecting cable. The sensor has a steel body with connecting flanges, one pair of excitation coils and electrodes, and is available with PTFE liner (DN25-DN350, water up to 90 °C), polypropylene liner (DN25-DN150, 50 °C), Rilsan liner (DN50-DN350, 50 °C) or ebonite liner (DN200-DN350, 50 °C). The converter comprises an LCD display showing volume and flow, impulse and current outputs, and non-legally relevant communication via RS485 or USB mini-B. Sealing by security seals and installation seals as described in Figures 1-4 of the certificate.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"DN25\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN32\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN40\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN50\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN65\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN80\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN100\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN125\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN150\", \"attributes\": {\"converters\": [\"MV110\", \"MV145\"]}},\n      {\"model_id\": \"DN200\", \"attributes\": {\"converters\": [\"MV110\"]}},\n      {\"model_id\": \"DN250\", \"attributes\": {\"converters\": [\"MV110\"]}},\n      {\"model_id\": \"DN300\", \"attributes\": {\"converters\": [\"MV110\"]}},\n      {\"model_id\": \"DN350\", \"attributes\": {\"converters\": [\"MV110\"]}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"sensor (measurement transducer)\",\n      \"type_designations\": [\"MS2500\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"construction\": \"steel body with connecting flanges, one pair of excitation coils, electrodes and connection to the converter\",\n        \"liner_options\": [\n          {\"material\": \"PTFE\", \"nominal_diameters\": \"DN25-DN350\", \"max_water_temperature\": {\"value\": 90, \"unit_symbol\": \"°C\"}},\n          {\"material\": \"Polypropylene\", \"nominal_diameters\": \"DN25-DN150\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\"}},\n          {\"material\": \"Rilsan\", \"nominal_diameters\": \"DN50-DN350\", \"max_water_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\"}