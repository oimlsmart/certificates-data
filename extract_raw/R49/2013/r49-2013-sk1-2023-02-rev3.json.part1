      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-SK1-23.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 13,\n    \"member_state\": \"Slovakia\",\n    \"date_issued\": \"2025-01-28\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Slovak Legal Metrology (SLM)\",\n    \"address_lines\": [\n      \"Geologická 9966/1,\",\n      \"821 06 Bratislava-Podunajské Biskupice, Slovakia\",\n      \"Product Certification Body\",\n      \"Hviezdoslavova 31\",\n      \"974 01 Banská Bystrica, Slovakia\"\n    ],\n    \"person_responsible\": \"Ing. Dušan Šmigura, PhD.\",\n    \"person_title\": \"Director of PCB\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"UAB „Axioma Metering“\",\n      \"address_lines\": [\n        \"Veterinaru str. 52, Biruliskes,\",\n        \"LT-54469 Kaunas region,\",\n        \"Lithuania\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"UAB „Axioma Metering“\",\n      \"address_lines\": [\n        \"Veterinaru str. 52, Biruliskes,\",\n        \"LT-54469 Kaunas region,\",\n        \"Lithuania\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\n      \"Qalcosonic W1\"\n    ],\n    \"module_designation\": \"Ultrasonic water meters with electronic indication device\",\n    \"description\": \"Compact ultrasonic water meter with electronic indication device designed to measure, memorise and display the volume of clean water passing through the measurement transducer at metering conditions; intended for residential use and non-resettable measurements between two constant partners. Measurement is based on the ultrasonic bidirectional transit-time principle. Essential parts: flow sensor (plastic cylindrical brass body with inlet and outlet connected to the plastic calculator housing; inner plastic element with two mirrors — four mirrors for DN40 — forming the sound path; two ultrasonic transducers — four for DN40) and calculator with directly mounted indication device (LCD with 9-digit upper line for volume, indication range 999999.999 m³, and 5-digit bottom line for current flow rate in m³/h), powered by non-replaceable lithium batteries with 16-year life (AA/A23/C/D battery configurations depending on DN and design). Non-essential parts: antenna and optional non-return valve. Can be installed in horizontal and vertical positions; not designed to measure reverse flow. Produced in design A (all DNs) and design B (DN15 and DN20 only); the difference lies solely in the external appearance, the measurement section is identical.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"Qalcosonic W1\",\n    \"models\": [\n      {\"model_id\": \"DN15\", \"attributes\": {\"designs\": [\"A\", \"B\"]}},\n      {\"model_id\": \"DN20\", \"attributes\": {\"designs\": [\"A\", \"B\"]}},\n      {\"model_id\": \"DN25\", \"attributes\": {\"designs\": [\"A\"]}},\n      {\"model_id\": \"DN32\", \"attributes\": {\"designs\": [\"A\"]}},\n      {\"model_id\": \"DN40\", \"attributes\": {\"designs\": [\"A\"]}}\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"battery_life\": {\"value\": 16, \"unit_symbol\": \"years\", \"unit_id\": null, \"footnote_markers\": []},\n      \"volume_indication_range\": {\"value\": 999999.999, \"unit_symbol\": \"m³\", \"unit_id\": null, \"footnote_markers\": []},\n      \"installation_positions\": {\"value\": \"horizontal and vertical\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"number_of_sound_path_mirrors\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"DN15\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN20\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN25\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN32\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN40\", \"value\": 4, \"footnote_markers\": []}\n        ]\n      },\n      {\n        \"attribute\": \"number_of_ultrasonic_transducers\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"DN15\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN20\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN25\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN32\", \"value\": 2, \"footnote_markers\": []},\n          {\"model\": \"DN40\", \"value\": 4, \"footnote_markers\": []}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"design_availability\",\n        \"axis\": \"design\",\n        \"values\": [\n          {\"condition\": \"design A\", \"value\": \"all nominal sizes (DN15, DN20, DN25, DN32, DN40)\"},\n          {\"condition\": \"design B\", \"value\": \"DN15 and DN20 only\"}\n        ]\n      }\n    ]\n  },\n  \"recommendation\": {\n    \"id\": \"R49\",\n    \"edition\": 2013,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [2]\n  },\n  \"test_reports\": [\n    {\n      \"id\": \"2025/ER006/SK1\",\n      \"date\": \"2025-01-28\",\n      \"pages\": 17,\n      \"role\": \"type_evaluation_report\"\n    },\n    {\n      \"id\": \"AXIOMA_Qalcosonic W1_00\",\n      \"date\": \"2023-01-13\",\n      \"pages\": 114,\n      \"role\": \"documentation_file\"\n    },\n    {\n      \"id\": \"AXIOMA_Qalcosonic W1_03\",\n      \"date\": \"2025-01-28\",\n      \"pages\": 51,\n      \"role\": \"documentation_file\"\n    }\n  ],\n  \"revision_history\": [\n    {\n      \"revision\": \"0\",\n      \"date\": \"2023-01-13\",\n      \"changes\": \"Certificate first issued\"\n    },\n    {\n      \"revision\": \"1\",\n      \"date\": \"2023-05-25\",\n      \"changes\": \"Point 2.4 Software specification – supplemented specification for all DNs separately\"\n    },\n    {\n      \"revision\": \"2\",\n      \"date\": \"2024-05-31\",\n      \"changes\": \"Issued updated Evaluation Report No: 2022/ER010/SK1 Rev. 1\"\n    },\n    {\n      \"revision\": \"3\",\n      \"date\": \"2025-01-28\",\n      \"changes\": \"Add design B (DN15 and DN20); changed address of the issuing authority SLM on the EU-type examination certificate\"\n    }\n  ]\n}"
    }
  ],
