      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2254799\",\n    \"page_total\": 9,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2020-12-24\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\n      \"Thijssseweg 11\",\n      \"2629 JA Delft\",\n      \"The Netherlands\"\n    ],\n    \"person_responsible\": \"M. Boudewijns\",\n    \"person_title\": \"Certification Board\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    },\n    {\n      \"name\": \"ABB Engineering (Shanghai) Ltd.\",\n      \"address_lines\": [\n        \"No. 4528, Kangxin Highway\",\n        \"Pudong New District\",\n        \"Shanghai, 201319\",\n        \"P.R. China\"\n      ]\n    },\n    {\n      \"name\": \"ABB Inc.\",\n      \"address_lines\": [\n        \"125 E. County Line Road\",\n        \"Warminster, PA 18974\",\n        \"United States of America\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\n      \"AquaMaster4 FEW4XY.Z\",\n      \"AquaMaster4 FET4*\"\n    ],\n    \"module_designation\": null,\n    \"description\": \"Electromagnetic water meter (AquaMaster4 family). X is 1 or 3 (standard or enhanced), Y is 1, 2, 8 or 9 (integral/remote version, optionally sensor only) and Z is R (reduced bore), V (virtual full bore) or F (full bore). The meter comprises a flow sensor and a flow transmitter.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\"model_id\": \"DN40\", \"label\": \"AquaMaster4 DN40\", \"attributes\": {\"meter_size_dn\": 40}},\n      {\"model_id\": \"DN50\", \"label\": \"AquaMaster4 DN50\", \"attributes\": {\"meter_size_dn\": 50}},\n      {\"model_id\": \"DN65\", \"label\": \"AquaMaster4 DN65\", \"attributes\": {\"meter_size_dn\": 65}},\n      {\"model_id\": \"DN80\", \"label\": \"AquaMaster4 DN80\", \"attributes\": {\"meter_size_dn\": 80}},\n      {\"model_id\": \"DN100\", \"label\": \"AquaMaster4 DN100\", \"attributes\": {\"meter_size_dn\": 100}},\n      {\"model_id\": \"DN125\", \"label\": \"AquaMaster4 DN125\", \"attributes\": {\"meter_size_dn\": 125}},\n      {\"model_id\": \"DN150\", \"label\": \"AquaMaster4 DN150\", \"attributes\": {\"meter_size_dn\": 150}},\n      {\"model_id\": \"DN200\", \"label\": \"AquaMaster4 DN200\", \"attributes\": {\"meter_size_dn\": 200}},\n      {\"model_id\": \"DN250\", \"label\": \"AquaMaster4 DN250\", \"attributes\": {\"meter_size_dn\": 250}},\n      {\"model_id\": \"DN300\", \"label\": \"AquaMaster4 DN300\", \"attributes\": {\"meter_size_dn\": 300}},\n      {\"model_id\": \"DN350\", \"label\": \"AquaMaster4 DN350\", \"attributes\": {\"meter_size_dn\": 350}},\n      {\"model_id\": \"DN400\", \"label\": \"AquaMaster4 DN400\", \"attributes\": {\"meter_size_dn\": 400}},\n      {\"model_id\": \"DN450\", \"label\": \"AquaMaster4 DN450\", \"attributes\": {\"meter_size_dn\": 450}},\n      {\"model_id\": \"DN500\", \"label\": \"AquaMaster4 DN500\", \"attributes\": {\"meter_size_dn\": 500}},\n      {\"model_id\": \"DN600\", \"label\": \"AquaMaster4 DN600\", \"attributes\": {\"meter_size_dn\": 600}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow sensor\",\n      \"type_designations\": [],\n      \"characteristics\": {}\n    },\n    {\n      \"role\": \"flow transmitter\",\n      \"type_designations\": [],\n      \"characteristics\": {}\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"electromagnetic_environment\": {\"value\": \"E1\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"water_temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_pressure_bar\": {\"value\": 16, \"unit_symbol\": \"bar\", \"unit_id\": null, \"footnote_markers\": []},\n      \"orientation\": {\"value\": \"All positions (horizontal, vertical or diagonal)\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"reverse_flow\": {\"value\": \"The sensor is intended to measure reverse flow\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_voltage_ac_mains\": {\"value\": {\"min\": 85, \"max\": 240}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_voltage_dc_renewable\": {\"value\": {\"min\": 6, \"max\": 32}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"battery_voltage\": {\"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"battery_operating_voltage_range\": {\"value\": {\"min\": 2.9, \"max\": 3.6}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"software_version_1\": {\"value\": \"03.00.03\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"software_checksum_1\": {\"value\": \"B26AFE6B\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"software_version_2\": {\"value\": \"03.00.04\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"software_checksum_2\": {\"value\": \"6E98963A\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"checking_facility\": {\"value\": \"Type P (permanent) automatic checking facility\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [],\n    \"config_level\": [\n      {\n        \"attribute\": \"environmental_class\",\n        \"axis\": \"sub_assembly\",\n        \"values\": [\n          {\"condition\": \"flow transmitter\", \"value\": \"B (installed in buildings)\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"flow sensor\", \"value\": \"O (installed outdoors)\", \"unit_symbol\": null, \"footnote_markers\": []}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_range_ambient\",\n        \"axis\": \"sub_assembly\",\n        \"values\": [\n          {\"condition\": \"flow transmitter\", \"value\": {\"min\": 5, \"max\": 55}, \"unit_symbol\": \"°C\", \"footnote_markers\": []},\n          {\"condition\": \"flow sensor\", \"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"footnote_markers\": []}\n        ]\n      },\n      {\n        \"attribute\": \"flow_profile_sensitivity_class\",\n        \"axis\": \"bore_type_meter_size\",\n        \"values\": [\n          {\"condition\": \"all sizes except full bore sizes DN250 and larger\", \"value\": \"U0 and D0 (0 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"full bore sizes DN250 and larger\", \"value\": \"U3 and D0 (3 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null, \"footnote_markers\": []}\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss_class\",\n        \"axis\": \"bore_type_meter_size\",\n        \"values\": [\n          {\"condition\": \"reduced bore, DN40 and DN50\", \"value\": \"Δp 40 (0.40 bar)\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"reduced bore, sizes larger than DN50\", \"value\": \"Δp 63 (0.63 bar)\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"virtual or full bore, DN40 and DN50\", \"value\": \"Δp 10 (0.10 bar)\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"virtual or full bore, DN65 to DN200\", \"value\": \"Δp 16 (0.16 bar)\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"virtual or full bore, DN250 and larger\", \"value\": \"Δp 10 (0.10 bar)\", \"unit_symbol\": null, \"footnote_markers\": []}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"General characteristics of the family of instruments - Reduced bore, AC mains powered (Table 2)\",\n      \"columns\": [\"meter_size\", \"accuracy_class\", \"q1_minimum\", \"q2_transitional\", \"q3_permanent\", \"q4_overload\", \"ratio_q3_q1\"],\n      \"column_units\": [null, null, \"m³/h\", \"m³/h\", \"m³/h\", \"m³/h\", null],\n      \"description\": \"Q1 and Q2 are minimum values (Q2/Q1 = 1.6); Q3 and Q4 are maximum values (Q4/Q3 = 1.25); Q3 and ratio Q3/Q1 selected from paragraph 4.1 of OIML R49-1:2013; ratio Q3/Q1 is at least 40.\",\n      \"rows\": [\n        {\"meter_size\": \"DN40\", \"accuracy_class\": \"1\", \"q1_minimum\": 0.05, \"q2_transitional\": 0.08, \"q3_permanent\": 25, \"q4_overload\": 31.25, \"ratio_q3_q1\": 500},\n        {\"meter_size\": \"DN40\", \"accuracy_class\": \"2\", \"q1_minimum\": 0.025, \"q2_transitional\": 0.04, \"q3_permanent\": 25, \"q4_overload\": 31.25, \"ratio_q3_q1\": 1000},\n        {\"meter_size\": \"DN50\", \"accuracy_class\": \"1\", \"q1_minimum\": 0.08, \"q2_t