      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2563125\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2023-09-22\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"person_title\": \"Certification Board\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW4XY.Z\", \"AquaMaster4 FET4XY.Z\"],\n    \"module_designation\": null,\n    \"description\": \"An electromagnetic water meter\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\"model_id\": \"AquaMaster4 FEW41Y.Z\", \"label\": \"standard (X=1)\"},\n      {\"model_id\": \"AquaMaster4 FEW43Y.Z\", \"label\": \"advanced (X=3)\"},\n      {\"model_id\": \"AquaMaster4 FEW45Y.Z\", \"label\": \"premium with mobile Comms MC (X=5)\"}\n    ]\n  },\n  \"components\": [\n    {\"role\": \"flow sensor\", \"type_designations\": [], \"characteristics\": {}},\n    {\"role\": \"flow transmitter\", \"type_designations\": [], \"characteristics\": {}}\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic\"},\n      \"accuracy_class\": {\"value\": \"1 and 2\"},\n      \"environmental_class\": {\"value\": \"O (installed outdoors)\"},\n      \"mechanical_class\": {\"value\": \"M1\"},\n      \"temperature_range_ambient\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"water_temperature_class\": {\"value\": \"T50\"},\n      \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_pressure_map\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null, \"footnote_markers\": []},\n      \"orientation\": {\"value\": \"All positions (horizontal, vertical, or diagonal)\"},\n      \"reverse_flow\": {\"value\": \"The sensor is intended to measure reverse flow\"},\n      \"checking_facilities\": {\"value\": \"Type P (permanent) automatic checking facility\"},\n      \"ac_mains_supply_voltage\": {\"value\": {\"min\": 95, \"max\": 240}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"ac_mains_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null, \"footnote_markers\": []},\n      \"dc_supply_voltage_renewable_energy\": {\"value\": {\"min\": 6, \"max\": 32}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"replaceable_battery_cell_voltage\": {\"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"replaceable_battery_operating_range\": {\"value\": {\"min\": 2.9, \"max\": 3.6}, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"electromagnetic_environment\",\n        \"values\": [\n          {\"model\": \"AquaMaster4 FEW41Y.Z\", \"value\": \"E2\"},\n          {\"model\": \"AquaMaster4 FEW43Y.Z\", \"value\": \"E2\"},\n          {\"model\": \"AquaMaster4 FEW45Y.Z\", \"value\": \"E1 (with external antenna cable) / E2 (without external antenna cable)\"}\n        ]\n      },\n      {\n        \"attribute\": \"replaceable_battery_cell_count\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"AquaMaster4 FEW41Y.Z\", \"value\": 2},\n          {\"model\": \"AquaMaster4 FEW43Y.Z\", \"value\": 2},\n          {\"model\": \"AquaMaster4 FEW45Y.Z\", \"value\": 6}\n        ]\n      },\n      {\n        \"attribute\": \"replaceable_batteries_included_with_external_power_supply\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"AquaMaster4 FEW41Y.Z\", \"value\": null},\n          {\"model\": \"AquaMaster4 FEW43Y.Z\", \"value\": null},\n          {\"model\": \"AquaMaster4 FEW45Y.Z\", \"value\": 4}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"flow_profile_sensitivity_class\",\n        \"axis\": \"full bore size\",\n        \"values\": [\n          {\"condition\": \"smaller than DN250\", \"value\": \"U0 (0 x DN upstream) and D0 (0 x DN downstream)\"},\n          {\"condition\": \"DN250 and larger\", \"value\": \"U3 (3 x DN upstream) and D0 (0 x DN downstream)\"}\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss_class\",\n        \"axis\": \"bore type and nominal size\",\n        \"values\": [\n          {\"condition\": \"reduced bore, DN40 and DN50 (class Δp 40)\", \"value\": {\"min\": null, \"max\": 0.40}, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"reduced bore, larger than DN50 (class Δp 63)\", \"value\": {\"min\": null, \"max\": 0.63}, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"(virtual) full bore, DN40 and DN50 (class Δp 10)\", \"value\": {\"min\": null, \"max\": 0.10}, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"(virtual) full bore, DN65 to DN200 (class Δp 16)\", \"value\": {\"min\": null, \"max\": 0.16}, \"unit_symbol\": \"bar\"},\n          {\"condition\": \"(virtual) full bore, DN250 and larger (class Δp 10)\", \"value\": {\"min\": null, \"max\": 0.10}, \"unit_symbol\": \"bar\"}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Software identification for AquaMaster4 FEW41Y.Z and AquaMaster4 FEW43Y.Z\",\n      \"columns\": [\"software_part_code\", \"software_part_description\", \"software_version\", \"crc_checksum\", \"remarks\"],\n      \"rows\": [\n        {\"software_part_code\": \"3KXF208402U0113\", \"software_part_description\": \"Full functionality\", \"software_version\": \"03.00.03\", \"crc_checksum\": \"B26AFE6B\", \"remarks\": null},\n        {\"software_part_code\": \"3KXF208402U0113\", \"software_part_description\": \"Full functionality\", \"software_version\": \"03.00.04\", \"crc_checksum\": \"6E98963A\", \"remarks\": null},\n        {\"software_part_code\": \"3KXF208402U0113\", \"software_part_description\": \"Full functionality\", \"software_version\": \"03.02.00\", \"crc_checksum\": \"E12E5C04\", \"remarks\": null},\n        {\"software_part_code\": \"3KXF208402U0113\", \"software_part_description\": \"Full functionality\", \"software_version\": \"03.03.02\", \"crc_checksum\": \"D4D1E40B\", \"remarks\": \"HMI display bug fixes. Low flow output bug fix.\"},\n        {\"software_part_code\": \"3KXF208402U0113\", \"software_part_description\": \"Full functionality\", \"software_version\": \"03.03.03\", \"crc_checksum\": \"CEEF45F1\", \"remarks\": \"Modbus communication bug fix.\"},\n        {\"software_part_code\": \"3KXF208402U0113\", \"software_part_description\": \"Full functionality\", \"software_version\": \"03.03.06\", \"crc_checksum\": \"DAC51328\", \"remarks\": null},\n        {\"software_part_code\": \"3KXF208402U0113\", \"software_part_description\": \"Full functionality\", \"software_version\": \"03.04.00\", \"crc_checksum\": \"277BA336\", \"remarks\": null},\n        {\"software_part_code\": \"3KXF208402U0313\", \"software_part_description\": \"Sensus / Logger / Pressure / VKL sensor updater\", \"software_version\": \"02.00.02\", \"crc_checksum\": \"84EBD1C8\", \"remarks\": null},\n        {\"software_part_code\": \"3KXF208402U0513\", \"software_part_description\": \"Modbus / Pressure / VKL sensor updater\", \"software_version\": \"02.00.01\", \"crc_checksum\": \"C28EAA16\", \"remarks\": null}\n      ],\n      \"description\": null,\n      \"footnotes\": []\n    }\n  ],\n  \"recommendation\": {\n    \"id\": \"R49\",\n    \"edition\": 2013,\n    \"amendment\": null,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [\"1\", \"2\"]\n  },\n  \"test_reports\": [\n    {\"id\": \"NMi-2254799-01\", \"date\": \"2020-08-14\", \"pages\": 235, \"role\": \"type_evaluation_report\"},\n    {\"id\": \"NMi-2254799-03\", \"date\": \"2020-09-30\", \"pages\": 44, \"role\": \"test_report\"},\n    {\"id\": \"NMi-2254799-04\", \"date\": \"2020-12-24\", \"pages\": 180, \"role\": \"test_report\"},\n    {\"id\": \"NMi-2564429-01\", \"date\": \"2021-08-02\", \"pages\": 26, \"role\": \"test_report\"},\n    {\"id\": \"NMi-2496280-01\", \"date\": \"2021-08-26\", \"pages\": 29, \"role\": \"test_report\"},\n    {\"id\": \"NMi-2496280-02\", \"date\": \"2021-11-23\", \"pages\": 25, \"role\": \"test_report\"},\n    {\"id\": \"NMi-2563125-01\", \"date\": \"2023-09-22\", \"pages\": 94, \"role\": \"test_report\"},\n    {\"id\": \"T11851-7\", \"date\": null, \"pages\": null, \"role\": \"documentation_file\"}\n  ],\n  \"revision_history\": [\n    {\"revision\": \"9\", \"date\": \"2023-09-22\"}\n  ],\n  \"footnotes\": [\n    {\n      \"marker\": \"*\",\n      \"text\": \"With X being 1 for standard or 3 for advanced or 5 for premium (mobile Comms - MC) variant; Y being 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z being R (reduced bore), V (virtual full bore) or F (full bore).\"\n    }\n  ]\n}"
