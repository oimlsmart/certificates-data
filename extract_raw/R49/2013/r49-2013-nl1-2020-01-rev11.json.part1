      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3891281\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2025-01-27\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\n      \"Thijsseweg 11\",\n      \"2629 JA Delft\",\n      \"The Netherlands\"\n    ],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\n      \"AquaMaster4 FEW4XY.Z\",\n      \"FET4*\",\n      \"FEW41Y.Z\",\n      \"FEW43Y.Z\",\n      \"FEW45Y.Z\"\n    ],\n    \"module_designation\": null,\n    \"description\": \"An electromagnetic water meter. X = 1 (standard), 3 (advanced) or 5 (premium, mobile Comms - MC) variant; Y = 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z = R (reduced bore), V (virtual full bore) or F (full bore).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\n        \"model_id\": \"FEW41Y.Z\",\n        \"label\": \"standard variant (X=1)\"\n      },\n      {\n        \"model_id\": \"FEW43Y.Z\",\n        \"label\": \"advanced variant (X=3)\"\n      },\n      {\n        \"model_id\": \"FEW45Y.Z\",\n        \"label\": \"premium variant with mobile comms (X=5)\"\n      }\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow transmitter\",\n      \"type_designations\": [\n        \"FEW41Y.Z\",\n        \"FEW43Y.Z\",\n        \"FEW45Y.Z\"\n      ],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {}\n    },\n    {\n      \"role\": \"flow sensor\",\n      \"type_designations\": [\n        \"FET4*\"\n      ],\n      \"alternatives\": null,\n      \"characteristics\": {}\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\n        \"value\": \"Electromagnetic\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"accuracy_class\": {\n        \"value\": \"1 and 2\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"environmental_class\": {\n        \"value\": \"O (installed outdoors)\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"mechanical_class\": {\n        \"value\": \"M1\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"temperature_range_ambient\": {\n        \"value\": {\n          \"min\": -25,\n          \"max\": 55\n        },\n        \"unit_symbol\": \"°C\",\n        \"unit_id\": \"u:degree_Celsius\"\n      },\n      \"water_temperature_class\": {\n        \"value\": \"T50\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"water_temperature_range\": {\n        \"value\": {\n          \"min\": 0.1,\n          \"max\": 50\n        },\n        \"unit_symbol\": \"°C\",\n        \"unit_id\": \"u:degree_Celsius\"\n      },\n      \"maximum_admissible_pressure\": {\n        \"value\": 1.6,\n        \"unit_symbol\": \"MPa\",\n        \"unit_id\": null\n      },\n      \"orientation\": {\n        \"value\": \"all positions (horizontal, vertical, or diagonal)\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"reverse_flow\": {\n        \"value\": \"the sensor is intended to measure reverse flow\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"checking_facilities\": {\n        \"value\": \"Type P (permanent) automatic checking facility\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"power_supply_type\": {\n        \"value\": \"AC mains, renewable energy (DC powered), or replaceable battery\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"power_supply_voltage_ac\": {\n        \"value\": {\n          \"min\": 95,\n          \"max\": 240\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"power_supply_frequency\": {\n        \"value\": {\n          \"min\": 50,\n          \"max\": 60\n        },\n        \"unit_symbol\": \"Hz\",\n        \"unit_id\": null\n      },\n      \"power_supply_voltage_dc\": {\n        \"value\": {\n          \"min\": 6,\n          \"max\": 32\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"battery_voltage\": {\n        \"value\": 3.6,\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"battery_operating_voltage_range\": {\n        \"value\": {\n          \"min\": 2.9,\n          \"max\": 3.6\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      }\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"electromagnetic_environment\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\n            \"model\": \"FEW41Y.Z\",\n            \"value\": \"E2\"\n          },\n          {\n            \"model\": \"FEW43Y.Z\",\n            \"value\": \"E2\"\n          },\n          {\n            \"model\": \"FEW45Y.Z (with external antenna cable)\",\n            \"value\": \"E1\"\n          },\n          {\n            \"model\": \"FEW45Y.Z (without external antenna cable)\",\n            \"value\": \"E2\"\n          }\n        ]\n      },\n      {\n        \"attribute\": \"replaceable_battery_count\",\n 