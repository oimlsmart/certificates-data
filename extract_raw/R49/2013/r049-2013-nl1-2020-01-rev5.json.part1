      "text": "```json\n{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"2496280\",\n    \"page_total\": 11,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2021-11-23\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW4XY.Z\", \"FET4\"],\n    \"description\": \"Electromagnetic water meter. Wildcard type designations: X = 1 or 3 (standard or advanced); Y = 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z = R (reduced bore), V (virtual full bore) or F (full bore). The ambient temperature range applies to both flow sensor and flow transmitter.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\"model_id\": \"DN40\"},\n      {\"model_id\": \"DN50\"},\n      {\"model_id\": \"DN65\"},\n      {\"model_id\": \"DN80\"},\n      {\"model_id\": \"DN100\"},\n      {\"model_id\": \"DN125\"},\n      {\"model_id\": \"DN150\"},\n      {\"model_id\": \"DN200\"},\n      {\"model_id\": \"DN250\"},\n      {\"model_id\": \"DN300\"},\n      {\"model_id\": \"DN350\"},\n      {\"model_id\": \"DN400\"},\n      {\"model_id\": \"DN450\"},\n      {\"model_id\": \"DN500\"},\n      {\"