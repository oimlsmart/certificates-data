      "text": "```json\n{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-SK1-26.08\",\n    \"scheme\": \"A\",\n    \"page_total\": 10,\n    \"member_state\": \"Slovakia\",\n    \"date_issued\": \"2026-08-31\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Slovak Legal Metrology (SLM)\",\n    \"address_lines\": [\n      \"Geologická 9966/1, 821 06 Bratislava-Podunajské Biskupice, Slovakia\",\n      \"Product Certification Body: Hviedzoslavova 31, 974 01 Banská Bystrica, Slovakia\"\n    ],\n    \"person_responsible\": \"Dušan Šmigura\",\n    \"person_title\": \"Director of PCB\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Hangzhou Laison Technology Co., Ltd.\",\n      \"address_lines\": [\n        \"No. 525 Xixi Road\",\n        \"310000 Hangzhou\",\n        \"Zhejiang\",\n        \"China\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Hangzhou Laison Technology Co., Ltd.\",\n      \"address_lines\": [\n        \"No. 525 Xixi Road\",\n        \"310000 Hangzhou\",\n        \"Zhejiang\",\n        \"China\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"LXCZ\"],\n    \"module_designation\": \"Ultrasonic water meters with electronic indication device\",\n    \"description\": \"Residential compact ultrasonic water meter (family DN15, DN20, DN25) with electronic indication device, using the ultrasonic bidirectional transit-time principle. Measures, memorizes, and displays the volume of water passing through the measurement transducers; intended for clean water volume measurement in residential use. Flow measured by double-pulse system with positive/negative pulses depending on flow direction. Installation: horizontal position with display top, or vertical position with flow up; not designed to measure reverse flow. Essential parts: plastic cylindrical water meter body connected with plastic calculator housing, inner plastic elements (pipe support-down and pipe support-up); flow sensor with two reflection sheets in centre of the cylindrical plastic body and two ultrasonic transducers at upstream/downstream of the measurement channel; calculator and indication device in plastic housing mounted directly on flow sensor with two PCB boards (metering PCB, main PCB) and electronic scrolling LCD with 9 digits. Non-essential parts: filter, control valve, strainer, wireless interfaces (IR, Bluetooth, WM-Bus, LoRa, LoRaWAN, NB-IoT Standard, GPRS, Cat.1, Sigfox).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"LXCZ\",\n    \"models\": [\n      {\"model_id\": \"DN15\"},\n      {\"model_id\": \"DN20\"},\n      {\"model_id\": \"DN25\"}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"calculator_and_indication_device\",\n      \"type_designations\": [],\n      \"characteristics\": {\n        \"display\": {\"value\": \"electronic scrolling LCD, 9 digits\", \"unit_symbol\": null, \"unit_id\": null},\n        \"battery_type\": {\"value\": \"replaceable lithium\", \"unit_symbol\": null, \"unit_id\": null},\n        \"battery_voltage_max\": {\"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null},\n        \"battery_capacity\": {\"value\": 19, \"unit_symbol\": \"Ah\", \"unit_id\": null},\n        \"battery_lifetime\": {\"value\": 10, \"unit_symbol\": \"years\", \"unit_id\": null}\n      }\n    },\n    {\n      \"role\": \"legal_software\",\n      \"type_designations\": [\"LS456802\"],\n      \"characteristics\": {\n        \"checksum\": {\"value\": \"759d413A\", \"unit_symbol\": null, \"unit_id\": null},\n        \"remarks\": {\"value\": \"Plastic body\", \"unit_symbol\": null, \"unit_id\": null}\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"body_material\": {\"value\": \"plastic\", \"unit_symbol\": null, \"unit_id\": null},\n      \"ratio_q3_over_q1\": {\"value\": 400, \"unit_symbol\": null, \"unit_id\": null},\n      \"ratio_q2_over_q1\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\":