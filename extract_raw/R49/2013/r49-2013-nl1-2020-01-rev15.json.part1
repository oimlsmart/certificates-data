s (MC) transmitter variant (X=5)\"}\n    ]\n  },\n  \"components\": [\n    {\"role\": \"flow sensor\", \"type_designations\": [\"FET4\"], \"characteristics\": {}},\n    {\"role\": \"flow transmitter\", \"type_designations\": [\"FEW41Y.Z\", \"FEW43Y.Z\", \"FEW45Y.Z\"], \"characteristics\": {}}\n  ],\n  ...\n}\n\nHmm, components characteristics {} — maybe omit. Keep minimal: role + type_designations.\n\ncharacteristics:\n\n\"type_level\": {\n  \"measuring_principle\": {\"value\": \"Electromagnetic\", \"unit_symbol\": null, \"unit_id\": null},\n  \"environmental_class\": {\"value\": \"O (installed outdoors)\", \"unit_symbol\": null, \"unit_id\": null},\n  \"mechanical_class\": {\"value\": \"M1\", \"unit_symbol\": null, \"unit_id\": null},\n  \"ambient_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n  \"water_temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null},\n  \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n  \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null},\n  \"orientation\": {\"value\": \"All positions (horizontal, vertical, or diagonal)\", \"unit_symbol\": null, \"unit_id\": null},\n  \"reverse_flow\": {\"value\": \"sensor intended to measure reverse flow\", \"unit_symbol\": null, \"unit_id\": null},\n  \"checking_facilities\": {\"value\": \"Type P (permanent) automatic checking facility\", \"unit_symbol\": null, \"unit_id\": null},\n  \"power_supply_options\": {\"value\": \"AC mains; renewable energy (DC powered); replaceable battery\", \"unit_symbol\": null, \"unit_id\": null},\n  \"power_supply_voltage_ac_mains\": {\"value\": {\"min\": 95, \"max\": 240}, \"unit_symbol\": \"V\", \"unit_id\": null},\n  \"power_supply_frequency\": {\"value\": {\"min\": 50, \"max\": 60}, \"unit_symbol\": \"Hz\", \"unit_id\": null},\n  \"power_supply_voltage_dc_renewable\": {\"value\": {\"min\": 6, \"max\": 32}, \"unit_symbol\": \"V\", \"unit_id\": null},\n  \"replaceable_battery_operating_voltage_range\": {\"value\": {\"min\": 2.9, \"max\": 3.6}, \"unit_symbol\": \"V\", \"unit_id\": null}\n}\n\n\"model_level\": [\n  {\n    \"attribute\": \"replaceable_battery_configuration\",\n    \"unit_symbol\": null, \"unit_id\": null,\n    \"values\": [\n      {\"model\": \"FEW41Y.Z\", \"value\": \"2 x 3.6 V\"},\n      {\"model\": \"FEW43Y.Z\", \"value\": \"2 x 3.6 V\"},\n      {\"model\": \"FEW45Y.Z\", \"value\": \"6 x 3.6 V\"}\n    ]\n  },\n  {\n    \"attribute\": \"batteries_included_with_external_power_supply\",\n    \"unit_symbol\": null, \"unit_id\": null,\n    \"values\": [\n      {\"model\": \"FEW45Y.Z\", \"value\": \"4 x 3.6 V\"}\n    ]\n  },\n  {\n    \"attribute\": \"software_identification_reference\",\n    \"unit_symbol\": null, \"unit_id\": null,\n    \"values\": [\n      {\"model\": \"FEW41Y.Z\", \"value\": \"see table 3\"},\n      {\"model\": \"FEW43Y.Z\", \"value\": \"see table 3\"},\n      {\"model\": \"FEW45Y.Z\", \"value\": \"see table 4\"}\n    ]\n  }\n]\n\n\"config_level\": [\n  {\n    \"attribute\": \"electromagnetic_environment\",\n    \"axis\": \"transmitter_type_and_antenna_configuration\",\n    \"values\": [\n      {\"condition\": \"FEW41Y.Z or FEW43Y.Z\", \"value\": \"E2\", \"unit_symbol\": null, \"unit_id\": null},\n      {\"condition\": \"FEW45Y.Z without external antenna cable\", \"value\": \"E2\", \"unit_symbol\": null, \"unit_id\": null},\n      {\"condition\": \"FEW45Y.Z with external antenna cable\", \"value\": \"E1\", \"unit_symbol\": null, \"unit_id\": null}\n    ]\n  },\n  {\n    \"attribute\": \"flow_profile_sensitivity_class\",\n    \"axis\": \"nominal_size\",\n    \"values\": [\n      {\"condition\": \"smaller than DN250\", \"value\": \"U0 and D0 (0 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null, \"unit_id\": null},\n      {\"condition\": \"DN250 and larger\", \"value\": \"U3 and D0 (3 x DN upstream and 0 x DN downstream)\", \"unit_symbol\": null, \"unit_id\": null}\n    ]\n  },\n  {\n    \"attribute\": \"pressure_loss_class\",\n    \"axis\": \"bore_type_and_nominal_size\",\n    \"values\": [\n      {\"condition\": \"reduced bore, DN40 and DN50\", \"value\": \"Δp 40\", ...},\n      {\"condition\": \"reduced bore, larger than DN50\", \"value\": \"Δp 63\", ...},\n      {\"condition\": \"virtual or full bore, DN40 and DN50\", \"value\": \"Δp 10\", ...},\n      {\"condition\": \"virtual or full bore, DN65 to DN200\", \"value\": \"Δp 16\", ...},\n      {\"condition\": \"virtual or full bore, DN250 and larger\", \"value\": \"Δp 10\", ...}\n    ]\n  },\n  {\n    \"attribute\": \"maximum_pressure_loss\",\n    \"axis\": \"bore_type_and_nominal_size\",\n    \"values\": [\n      {\"condition\": \"reduced bore, DN40 and DN50\", \"value\": 0.4, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      {\"condition\": \"reduced bore, larger than DN50\", \"value\": 0.63, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      {\"condition\": \"virtual or full bore, DN40 and DN50\", \"value\": 0.1, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      {\"condition\": \"virtual or full bore, DN65 to DN200\", \"value\": 0.16, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      {\"condition\": \"virtual or full bore, DN250 and larger\", \"value\": 0.1, \"unit_symbol\": \"bar\", \"unit_id\": null}\n    ]\n  }\n]\n\nrecommendation: {\"id\": \"R49-1\", \"edition\": 2013, \"scheme\": \"A\", \"accuracy_classes\": [1, 2]}\n\ntest_reports: as above plus documentation_file T11851-11.\n\nrevision_history: [{\"revision\": \"15\", \"date\": \"2026-02-16\"}]\n\nfootnotes: [{\"marker\": \"*\", \"text\": \"...\"}] — text combining the three wildcard lines: \"With X being 1 for standard or 3 for advanced or 5 for premium (mobile Comms - MC) variant; Y being 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z being R (reduced bore), V (virtual full bore) or F (full bore).\"\n\nAlso sho