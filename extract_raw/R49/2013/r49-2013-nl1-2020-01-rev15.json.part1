      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"4076767\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2026-02-16\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\n      \"Thijsseweg 11\",\n      \"2629 JA Delft\",\n      \"The Netherlands\"\n    ],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"person_title\": \"Certification Board\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\n        \"Oldends Lane\",\n        \"GL10 3TA Stonehouse\",\n        \"United Kingdom\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\n      \"AquaMaster4 FEW4XY.Z\",\n      \"FET4\"\n    ],\n    \"module_designation\": null,\n    \"description\": \"Electromagnetic water meter AquaMaster4. Wildcards: X = 1 (standard), 3 (advanced) or 5 (premium, mobile Comms - MC) variant; Y = 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z = R (reduced bore), V (virtual full bore) or F (full bore).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\n        \"model_id\": \"FEW41Y.Z\",\n        \"label\": \"AquaMaster4 with standard transmitter variant (X=1)\"\n      },\n      {\n        \"model_id\": \"FEW43Y.Z\",\n        \"label\": \"AquaMaster4 with advanced transmitter variant (X=3)\"\n      },\n      {\n        \"model_id\": \"FEW45Y.Z\",\n        \"label\": \"AquaMaster4 with premium mobile Comms (MC) transmitter variant (X=5)\"\n      }\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow sensor\",\n      \"type_designations\": [\n        \"FET4\"\n      ]\n    },\n    {\n      \"role\": \"flow transmitter\",\n      \"type_designations\": [\n        \"FEW41Y.Z\",\n        \"FEW43Y.Z\",\n        \"FEW45Y.Z\"\n      ]\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\n        \"value\": \"Electromagnetic\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"environmental_class\": {\n        \"value\": \"O (installed outdoors)\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"mechanical_class\": {\n        \"value\": \"M1\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"ambient_temperature_range\": {\n        \"value\": {\n          \"min\": -25,\n          \"max\": 55\n        },\n        \"unit_symbol\": \"°C\",\n        \"unit_id\": null\n      },\n      \"water_temperature_class\": {\n        \"value\": \"T50\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"water_temperature_range\": {\n        \"value\": {\n          \"min\": 0.1,\n          \"max\": 50\n        },\n        \"unit_symbol\": \"°C\",\n        \"unit_id\": null\n      },\n      \"maximum_admissible_pressure\": {\n        \"value\": 1.6,\n        \"unit_symbol\": \"MPa\",\n        \"unit_id\": null\n      },\n      \"orientation\": {\n        \"value\": \"All positions (horizontal, vertical, or diagonal)\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"reverse_flow\": {\n        \"value\": \"sensor intended to measure reverse flow\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"checking_facilities\": {\n        \"value\": \"Type P (permanent) automatic checking facility\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"power_supply_options\": {\n        \"value\": \"AC mains; renewable energy (DC powered); replaceable battery\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"power_supply_voltage_ac_mains\": {\n        \"value\": {\n          \"min\": 95,\n          \"max\": 240\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"power_supply_frequency\": {\n        \"value\": {\n          \"min\": 50,\n          \"max\": 60\n        },\n        \"unit_symbol\": \"Hz\",\n        \"unit_id\": null\n      },\n      \"power_supply_voltage_dc_renewable\": {\n        \"value\": {\n          \"min\": 6,\n          \"max\": 32\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"replaceable_battery_operating_voltage_range\": {\n        \"value\": {\n          \"min\": 2.9,\n          \"max\": 3.6\n        },\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      }\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"replaceable_battery_configuration\",\n        \"unit_symbol\": null,\n        \"unit_id\": null,\n        \"values\": [\n          {\n            \"model\": \"FEW41Y.Z\",\n            \"value\": \"2 x 3.6 V\"\n          },\n          {\n            \"model\": \"FEW43Y.Z\",\n            \"value\": \"2 x 3.6 V\"\n          },\n          {\n            \"model\": \"FEW45Y.Z\",\n            \"value\": \"6 x 3.6 V\"\n          }\n        ]\n      },\n      {\n        \"attribute\": \"batteries_included_with_external_power_supply\",\n        \"unit_symbol\": null,\n        \"unit_id\": null,\n        \"values\": [\n          {\n            \"model\": \"FEW45Y.Z\",\n            \"value\": \"4 x 3.6 V\"\n          }\n        ]\n      },\n      {\n        \"attribute\": \"software_identification_reference\",\n        \"unit_symbol\": null,\n        \"unit_id\": null,\n        \"values\": [\n          {\n            \"model\": \"FEW41Y.Z\",\n            \"value\": \"see table 3\"\n          },\n          {\n            \"model\": \"FEW43Y.Z\",\n            \"value\": \"see table 3\"\n          },\n          {\n            \"model\": \"FEW45Y.Z\",\n            \"value\": \"see table 4\"\n          }\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"electromagnetic_environment\",\n        \"axis\": \"transmitter_type_and_antenna_configuration\",\n        \"values\": [\n          {\n            \"condition\": \"FEW41Y.Z or FEW43Y.Z\",\n            \"value\": \"E2\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"FEW45Y.Z without external antenna cable\",\n            \"value\": \"E2\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"FEW45Y.Z with external antenna cable\",\n            \"value\": \"E1\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          }\n        ]\n      },\n      {\n        \"attribute\": \"flow_profile_sensitivity_class\",\n        \"axis\": \"nominal_size\",\n        \"values\": [\n          {\n            \"condition\": \"smaller than DN250\",\n            \"value\": \"U0 and D0 (0 x DN upstream and 0 x DN downstream)\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"DN250 and larger\",\n            \"value\": \"U3 and D0 (3 x DN upstream and 0 x DN downstream)\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          }\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss_class\",\n        \"axis\": \"bore_type_and_nominal_size\",\n        \"values\": [\n          {\n            \"condition\": \"reduced bore, DN40 and DN50\",\n            \"value\": \"Δp 40\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"reduced bore, larger than DN50\",\n            \"value\": \"Δp 63\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"virtual or full bore, DN40 and DN50\",\n            \"value\": \"Δp 10\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"virtual or full bore, DN65 to DN200\",\n            \"value\": \"Δp 16\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"virtual or full bore, DN250 and larger\",\n            \"value\": \"Δp 10\",\n            \"unit_symbol\": null,\n            \"unit_id\": null\n          }\n        ]\n      },\n      {\n        \"attribute\": \"maximum_pressure_loss\",\n        \"axis\": \"bore_type_and_nominal_size\",\n        \"values\": [\n          {\n            \"condition\": \"reduced bore, DN40 and DN50\",\n            \"value\": 0.4,\n            \"unit_symbol\": \"bar\",\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"reduced bore, larger than DN50\",\n            \"value\": 0.63,\n            \"unit_symbol\": \"bar\",\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"virtual or full bore, DN40 and DN50\",\n            \"value\": 0.1,\n            \"unit_symbol\": \"bar\",\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"virtual or full bore, DN65 to DN200\",\n            \"value\": 0.16,\n            \"unit_symbol\": \"bar\",\n            \"unit_id\": null\n          },\n          {\n            \"condition\": \"virtual or full bore, DN250 and larger\",\n            \"value\": 0.1,\n            \"unit_symbol\": \"bar\",\n            \"unit_id\": null\n          }\n        ]\n      }\n    ]\n  },\n  \"recommendation\": {\n    \"id\": \"R49-1\",\n    \"edition\": 2013,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [1, 2]\n  },\n  \"test_reports\": [\n    {\n      \"id\": \"NMi-2254799-01\",\n      \"date\": \"2020-08-14\",\n      \"pages\": 235,\n      \"role\": \"type_evaluation_report\"\n    },\n    {\n      \"id\": \"NMi-2254799-03\",\n      \"date\": \"2020-09-30\",\n      \"pages\": 44,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"NMi-2254799-04\",\n      \"date\": \"2020-12-24\",\n      \"pages\": 180,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"NMi-2564429-01\",\n      \"date\": \"2021-08-02\",\n      \"pages\": 26,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"NMi-2496280-01\",\n      \"date\": \"2021-08-26\",\n      \"pages\": 29,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"NMi-2496280-02\",\n      \"date\": \"2021-11-23\",\n      \"pages\": 25,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"NMi-2563125-01\",\n      \"date\": \"2023-09-22\",\n      \"pages\": 94,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"T11851-11\",\n      \"role\": \"documentation_file\"\n    }\n  ],\n  \"revision_history\": [\n    {\n      \"revision\": \"15\",\n      \"date\": \"2026-02-16\"\n    }\n  ],\n  \"footnotes\": [\n    {\n      \"marker\": \"*\",\n      \"text\": \"With X being 1 for standard or 3 for advanced or 5 for premium (mobile Comms - MC) variant; Y being 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z being R (reduced bore), V (virtual full bore) or F (full bore).\"\n    }\n  ]\n}"
