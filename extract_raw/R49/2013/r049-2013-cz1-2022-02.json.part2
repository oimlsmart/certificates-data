      "type": "text",
      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-2022.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 16,\n    \"oiml_issuer_id\": \"CZ1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Český metrologický institut\"\n  },\n  \"manufacturers\": [\n    {\n      \"name\": \"Hemina SPA\",\n      \"address_lines\": [\"Via Piemonte 2\", \"Montagnana\", \"350 44 Italy\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MS2500\", \"MV110\"],\n    \"description\": \"Electromagnetic water meters types MS2500 / MV110\"\n  },\n  \"model_family\": {\n    \"family_name\": \"MS2500 / MV110\",\n    \"models\": [\n      {\"model_id\": \"DN25-R250\"},\n      {\"model_id\": \"DN25-R400\"},\n      {\"model_id\": \"DN32-R250\"},\n      {\"model_id\": \"DN32-R400\"},\n      {\"model_id\": \"DN40-R250\"},\n      {\"model_id\": \"DN40-R400\"}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"power supply module\",\n      \"type_designations\": [\"MS2500 / MV110 HV\", \"MS2500 / MV110 LV\", \"MS2500 / MV110 LLV\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {}\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"ratio_q2_q1\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\": null},\n      \"ratio_q4_q3\": {\"value\": 1.25, \"unit_symbol\": null, \"unit_id\": null},\n      \"measuring_principle\": {\"value\": \"Electromagnetic water meter\", \"unit_symbol\": null, \"unit_id\": null},\n      \"water_pressure_class\": {\"value\": \"MAP16\", \"unit_symbol\": null, \"unit_id\": null},\n      \"pressure_loss_class\": {\"value\": \"Δp40\", \"unit_symbol\": null, \"unit_id\": null},\n      \"reverse_flow\": {\"value\": \"designed to measure\", \"unit_symbol\": null, \"unit_id\": null},\n      \"environmental_class\": {\"value\": \"O\", \"unit_symbol\": null, \"unit_id\": null},\n      \"environmental_class_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n      \"electromagnetic_environment\": {\"value\": \"E1, E2\", \"unit_symbol\": null, \"unit_id\": null},\n      \"mechanical_class\": {\"value\": \"B, O\", \"unit_symbol\": null, \"unit_id\": null},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null},\n      \"orientation_limitation\": {\"value\": \"any\", \"unit_symbol\": null, \"unit_id\": null},\n      \"indicating_range\": {\"value\": 99999, \"unit_symbol\": \"m³\", \"unit_id\": null},\n      \"resolution_of_indicating_device\": {\"value\": 0.0001, \"unit_symbol\": \"m³\", \"unit_id\": null},\n      \"eut_testing_category\": {\"value\": \"Electromagnetic water meter\", \"unit_symbol\": null, \"unit_id\": null},\n      \"eut_testing_case\": {\"value\": \"Case D\", \"unit_symbol\": null, \"unit_id\": null},\n      \"connection_type\": {\"value\": \"Flanged\", \"unit_symbol\": null, \"unit_id\": null},\n      \"minimum_straight_length_of_inlet_pipe\": {\"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null},\n      \"minimum_straight_length_of_outlet_pipe\": {\"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null},\n      \"flow_profile_sensitivity_class\": {\"value\": \"U0D0\", \"unit_symbol\": null, \"unit_id\": null},\n      \"flow_conditioner\": {\"value\": \"No\", \"unit_symbol\": null, \"unit_id\": null},\n      \"orientation\": {\"value\": \"any\", \"unit_symbol\": null, \"unit_id\": null},\n      \"length\": {\"value\": 200, \"unit_symbol\": \"mm\", \"unit_id\": null},\n      \"software_version\": {\"value\": \"V.1.04.0005.0004\", \"unit_symbol\": null, \"unit_id\": null},\n      \"crc_checksum\": {\"value\": \"9BA34F3B\", \"unit_symbol\": null, \"unit_id\": null},\n      \"cut_off\": {\"value\": 0.2, \"unit_symbol\": \"%\", \"unit_id\": null},\n      \"detection_empty_pipe\": {\"value\": \"on\", \"unit_symbol\": null, \"unit_id\": null}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"nominal_diameter\",\n        \"unit_symbol\": \"mm\",\n        \"values\": [\n          {\"model\": \"DN25-R250\", \"value\": 25},\n          {\"model\": \"DN25-R400\", \"value\": 25},\n          {\"model\": \"DN32-R250\", \"value\": 32},\n          {\"model\": \"DN32-R400\", \"value\": 32},\n          {\"model\": \"DN40-R250\", \"value\": 40},\n          {\"model\": \"DN40-R400\", \"value\": 40}\n        ]\n      },\n      {\n        \"attribute\": \"q1\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"DN25-R250\", \"value\": 0.064},\n          {\"model\": \"DN25-R400\", \"value\": 0.040},\n          {\"model\": \"DN32-R250\", \"value\": 0.100},\n          {\"model\": \"DN32-R400\", \"value\": 0.062},\n          {\"model\": \"DN40-R250\", \"value\": 0.160},\n          {\"model\": \"DN40-R400\", \"value\": 0.100}\n        ]\n      },\n      {\n        \"attribute\": \"q2\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"DN25-R250\", \"value\": 0.102},\n          {\"model\": \"DN25-R400\", \"value\": 0.064},\n          {\"model\": \"DN32-R250\", \"value\": 0.160},\n          {\"model\": \"DN32-R400\", \"value\": 0.100},\n          {\"model\": \"DN40-R250\", \"value\": 0.256},\n          {\"model\": \"DN40-R400\", \"value\": 0.160}\n        ]\n      },\n      {\n        \"attribute\": \"q3\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"DN25-R250\", \"value\": 16.00},\n          {\"model\": \"DN25-R400\", \"value\": 16.00},\n          {\"model\": \"DN32-R250\", \"value\": 25.00},\n          {\"model\": \"DN32-R400\", \"value\": 25.00},\n          {\"model\": \"DN40-R250\", \"value\": 40.00},\n          {\"model\": \"DN40-R400\", \"value\": 40.00}\n        ]\n      },\n      {\n        \"attribute\": \"q4\",\n        \"unit_symbol\": \"m³/h\",\n        \"values\": [\n          {\"model\": \"DN25-R250\", \"value\": 20.00},\n          {\"model\": \"DN25-R400\", \"value\": 20.00},\n          {\"model\": \"DN32-R250\", \"value\": 31.25},\n          {\"model\": \"DN32-R400\", \"value\": 31.25},\n          {\"model\": \"DN40-R250\", \"value\": 50.00},\n          {\"model\": \"DN40-R400\", \"value\": 50.00}\n        ]\n      },\n      {\n        \"attribute\": \"ratio_q3_q1\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"DN25-R250\", \"value\": 250},\n          {\"model\": \"DN25-R400\", \"value\": 400},\n          {\"model\": \"DN32-R250\", \"value\": 250},\n          {\"model\": \"DN32-R400\", \"value\": 400},\n          {\"model\": \"DN40-R250\", \"value\": 250},\n          {\"model\": \"DN40-R400\", \"value\": 400}\n        ]\n      },\n      {\n        \"attribute\": \"accuracy_class\",\n        \"unit_symbol\": null,\n        \"values\": [\n          {\"model\": \"DN25-R250\", \"value\": 1},\n          {\"model\": \"DN25-R400\", \"value\": 2},\n          {\"model\": \"DN32-R250\", \"value\": 1},\n          {\"model\": \"DN32-R400\", \"value\": 2},\n          {\"model\": \"DN40-R250\", \"value\": 1},\n          {\"model\": \"DN40-R400\", \"value\": 2}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"module_designation\",\n        \"axis\": \"power_supply_module\",\n        \"values\": [\n          {\"condition\": \"HV\", \"value\": \"MS2500 / MV110 HV\"},\n          {\"condition\": \"LV\", \"value\": \"MS2500 / MV110 LV\"},\n          {\"condition\": \"LLV\", \"value\": \"MS2500 / MV110 LLV\"}\n        ]\n      },\n      {\n        \"attribute\": \"power_supply_voltage\",\n        \"axis\": \"power_supply_module\",\n        \"unit_symbol\": \"V\",\n        \"values\": [\n          {\"condition\": \"HV\", \"value\": {\"min\": 100, \"max\": 240}},\n          {\"condition\": \"LV\", \"value\": {\"min\": 24, \"max\": 36}},\n          {\"condition\": \"LLV\", \"value\": {\"min\": 10, \"max\": 48}}\n        ]\n      },\n      {\n        \"attribute\": \"power_supply_type\",\n        \"axis\": \"power_supply_module\",\n        \"values\": [\n          {\"condition\": \"HV\", \"value\": \"AC\"},\n          {\"condition\": \"LV\", \"value\": \"AC/DC\"},\n          {\"condition\": \"LLV\", \"value\": \"DC\"}\n        ]\n      },\n      {\n        \"attribute\": \"power_supply_frequency\",\n        \"axis\": \"power_supply_module\",\n        \"unit_symbol\": \"Hz\",\n        \"values\": [\n          {\"condition\": \"HV\", \"value\": {\"min\": 45, \"max\": 66}},\n          {\"condition\": \"LV\", \"value\": {\"min\": 45, \"max\": 66}}\n        ]\n      },\n      {\n        \"attribute\": \"internal_backup_source_voltage\",\n        \"axis\": \"power_supply_module\",\n        \"unit_symbol\": \"V\",\n        \"values\": [\n          {\"condition\": \"HV\", \"value\": 3.7},\n          {\"condition\": \"LV\", \"value\": 3.7}\n        ]\n      },\n      {\n        \"attribute\": \"internal_backup_battery_capacity\",\n        \"axis\": \"power_supply_module\",\n        \"unit_symbol\": \"mAh\",\n        \"values\": [\n          {\"condition\": \"HV\", \"value\": 5200},\n          {\"condition\": \"LV\", \"value\": 5200}\n        ]\n      },\n      {\n        \"attribute\": \"internal_backup_type\",\n        \"axis\": \"power_supply_module\",\n        \"values\": [\n          {\"condition\": \"HV\", \"value\": \"Battery\"},\n          {\"condition\": \"LV\", \"value\": \"Battery\"}\n        ]\n      },\n      {\n        \"attribute\": \"mpe_lower_flowrate_zone\",\n        \"axis\": \"accuracy_class\",\n        \"unit_symbol\": \"%\",\n        \"values\": [\n          {\"condition\": \"class 1\", \"value\": 3},\n          {\"condition\": \"class 2\", \"value\": 5}\n        ]\n      },\n      {\n        \"attribute\": \"mpe_upper_flowrate_zone\",\n        \"axis\": \"accuracy_class × water_temperature\",\n        \"unit_symbol\": \"%\",\n        \"values\": [\n          {\"condition\": \"class 1, water temperature ≤ 30 °C\", \"value\": 1},\n          {\"condition\": \"class 2, water temperature ≤ 30 °C\", \"value\": 2},\n          {\"condition\": \"class 1, water temperature > 30 °C\", \"value\": 2},\n          {\"condition\": \"class 2, water temperature > 30 °C\", \"value\": 3}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_class\",\n        \"axis\": \"liner_material\",\n        \"values\": [\n          {\"condition\": \"PTFE\", \"value\": \"T90, T50, T30\"},\n          {\"condition\": \"Rilsan\", \"value\": \"T50, T30 (from DN50)\"},\n          {\"condition\": \"Ebonite\", \"value\": \"T50, T30 (from DN200)\"},\n          {\"condition\": \"polypropylene\", \"value\": \"T50, T30\"}\n        ]\n      },\n      {\n        \"attribute\": \"maximum_admissible_temperature\",\n        \"axis\": \"liner_material\",\n        \"unit_symbol\": \"°C\",\n        \"values\": [\n          {\"condition\": \"PTFE\", \"value\": 90},\n          {\"condition\": \"polypropylene\", \"value\": 50},\n          {\"condition\": \"Rilsan\", \"value\": 50},\n          {\"condition\": \"Ebonite\", \"value\": 50}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Flow characteristics by nominal diameter and metrological class\",\n      \"columns\": [\"nominal_diameter\", \"q1\", \"q2\", \"q3\", \"q4\", \"ratio_q3_q1\", \"accuracy_class\"],\n      \"column_units\": [\"mm\", \"m³/h\", \"m³/h\", \"m³/h\", \"m³/h\", null, null],\n      \"rows\": [\n        {\"nominal_diameter\": 25, \"q1\": 0.064, \"q2\": 0.102, \"q3\": 16.00, \"q4\": 20.00, \"ratio_q3_q1\": 250, \"accuracy_class\": 1},\n        {\"nominal_diameter\": 25, \"q1\": 0.040, \"q2\": 0.064, \"q3\": 16.00, \"q4\": 20.00, \"ratio_q3_q1\": 400, \"accuracy_class\": 2},\n        {\"nominal_diameter\": 32, \"q1\": 0.100, \"q2\": 0.160, \"q3\": 25.00, \"q4\": 31.25, \"ratio_q3_q1\": 250, \"accuracy_class\": 1},\n        {\"nominal_diameter\": 32, \"q1\": 0.062, \"q2\": 0.100, \"q3\": 25.00, \"q4\": 31.25, \"ratio_q3_q1\": 400, \"accuracy_class\": 2},\n        {\"nominal_diameter\": 40, \"q1\": 0.160, \"q2\": 0.256, \"q3\": 40.00, \"q4\": 50.00, \"ratio_q3_q1\": 250, \"accuracy_class\": 1},\n        {\"nominal_diameter\": 40, \"q1\": 0.100, \"q2\": 0.160, \"q3\": 40.00, \"q4\": 50.00, \"ratio_q3_q1\": 400, \"accuracy_class\": 2}\n      ],\n      \"description\": \"Basic technical data of water meters types MS2500 / MV110; each nominal diameter is available in two variants (Q3/Q1 = 250, class 1 and Q3/Q1 = 400, class 2). Common to all: Q2/Q1 = 1.6, Q4/Q3 = 1.25, pressure loss class Δp40, water pressure class MAP16, indicating range 99 999 m³, resolution 0.000 1 m³.\",\n      \"footnotes\": []\n    },\n    {\n      \"name\": \"Power supply modules\",\n      \"columns\": [\"module\", \"power_supply_type\", \"power_supply_voltage\", \"power_supply_frequency\", \"internal_backup_source\"],\n      \"column_units\": [null, null, \"V\", \"Hz\", null],\n      \"rows\": [\n        {\"module\": \"MS2500 / MV110 HV\", \"power_supply_type\": \"AC\", \"power_supply_voltage\": \"100 – 240\", \"power_supply_frequency\": \"45 – 66\", \"internal_backup_source\": \"3.7 V DC; 5200 mAh; Battery\"},\n        {\"module\": \"MS2500 / MV110 LV\", \"power_supply_type\": \"AC/DC\", \"power_supply_voltage\": \"24 – 36\", \"power_supply_frequency\": \"45 – 66\", \"internal_backup_source\": \"3.7 V DC; 5200 mAh; Battery\"},\n        {\"module\": \"MS2500 / MV110 LLV\", \"power_supply_type\": \"DC\", \"power_supply_voltage\": \"10 – 48\", \"power_supply_frequency\": null, \"internal_backup_source\": null}\n      ],\n      \"description\": \"Designation of the power supply module, applicable to all nominal diameters. Minimum battery life time is not specified ('-').\",\n      \"footnotes\": []\n    }\n  ],\n  \"recommendation\": {\n    \"id\": \"R49\",\n    \"edition\": 2013,\n    \"accuracy_classes\": [1, 2]\n  }\n}"
