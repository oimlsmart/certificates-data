      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-CZ-16.02\",\n    \"scheme\": \"B\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2016-05-26\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"CZ\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Itron\",\n      \"address_lines\": [\"11 bvd Pasteur\", \"67500 Haguenau\", \"France\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Itron\",\n      \"address_lines\": [\"11 bvd Pasteur\", \"67500 Haguenau\", \"France\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"ISOFLO\", \"Woltex (WE)\", \"TU1M20\", \"TU1M25\", \"TU1 40F\", \"Aquadis+ P1\", \"Aquadis+ P111\", \"P290+\"],\n    \"module_designation\": null,\n    \"description\": \"Combination water meter type ISOFLO for metering cold potable water based on mechanical principles. Comprises the primary (main) meter (Woltman type Woltex WE with mechanical dry-dial register), the secondary (by-pass) meter (single jet TU1M20, TU1M25, TU1 40F or rotary piston Aquadis+ P1, Aquadis+ P111, P290+ with mechanical dry-dial register) and a changeover valve. Equipped with two indicating devices (primary and secondary), mechanical dry dial with pointers and rollers, displaying volume in m³ and flow rate in m³/h. Not designed to measure reverse flow. Intended for horizontal pipework with the indicating device positioned on top. Changeover zone: Qmin(main) < Zc < 1.2 x Qn(secondary). Markings: unit of measurement (m³), numerical value Q3 in m³/h and ratio Q3/Q1, OIML certificate of conformity number, manufacturer name/trademark, year of manufacture, serial number, flow direction arrow, maximum admissible pressure (MAP10 or MAP16), letter H, temperature class T30, pressure loss class, installation sensitivity class.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"ISOFLO\",\n    \"models\": [\n      {\"model_id\": \"DN50-TU1M20-1600\", \"label\": \"ISOFLO DN50, Woltex (WE50) + TU1M20 DN20, Q3/Q1 1600\", \"attributes\": {\"primary_meter\": \"Woltex (WE50)\", \"secondary_meter\": \"TU1M20 DN20\"}},\n      {\"model_id\": \"DN50-AquadisP1-2500\", \"label\": \"ISOFLO DN50, Woltex (WE50) + Aquadis+ P1 DN20, Q3/Q1 2500\", \"attributes\": {\"primary_meter\": \"Woltex (WE50)\", \"secondary_meter\": \"Aquadis+ P1 DN20\"}},\n      {\"model_id\": \"DN50-AquadisP1-4000\", \"label\": \"ISOFLO DN50, Woltex (WE50) + Aquadis+ P1 DN20, Q3/Q1 4000\", \"attributes\": {\"primary_meter\": \"Woltex (WE50)\", \"secondary_meter\": \"Aquadis+ P1 DN20\"}},\n      {\"model_id\": \"DN65-TU1M20-4000\", \"label\": \"ISOFLO DN65, Woltex (WE65) + TU1M20 DN20, Q3/Q1 4000\", \"attributes\": {\"primary_meter\": \"Woltex (WE65)\", \"secondary_meter\": \"TU1M20 DN20\"}},\n      {\"model_id\": \"DN65-AquadisP1-4000\", \"label\": \"ISOFLO DN65, Woltex (WE65) + Aquadis+ P1 DN20, Q3/Q1 4000\", \"attributes\": {\"primary_meter\": \"Woltex (WE65)\", \"secondary_meter\": \"Aquadis+ P1 DN20\"}},\n      {\"model_id\": \"DN65-AquadisP1-6300\", \"label\": \"ISOFLO DN65, Woltex (WE65) + Aquadis+ P1 DN20, Q3/Q1 6300\", \"attributes\": {\"primary_meter\": \"Woltex (WE65)\", \"secondary_meter\": \"Aquadis+ P1 DN20\"}},\n      {\"model_id\": \"DN80-TU1M20-6300\", \"label\": \"ISOFLO DN80, Woltex (WE100) + TU1M20 DN20, Q3/Q1 6300\", \"attributes\": {\"primary_meter\": \"Woltex (WE100)\", \"secondary_meter\": \"TU1M20 DN20\"}},\n      {\"model_id\": \"DN80-AquadisP1-10000\", \"label\": \"ISOFLO DN80, Woltex (WE100) + Aquadis+ P1 DN20, Q3/Q1 10000\", \"attributes\": {\"primary_meter\": \"Woltex (WE100)\", \"secondary_meter\": \"Aquadis+ P1 DN20\"}},\n      {\"model_id\": \"DN80-AquadisP1-16000\", \"label\": \"ISOFLO DN80, Woltex (WE100) + Aquadis+ P1 DN20, Q3/Q1 16000\", \"attributes\": {\"primary_meter\": \"Woltex (WE100