      "text": "```json\n{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-24.06\",\n    \"scheme\": \"A\",\n    \"page_total\": 7,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2024-11-11\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"JANZ - Contagem e Gestao de Fluídos, S.A.\",\n      \"address_lines\": [\"Avenida Infante D. Henrique, 288\", \"1950-421 Lisboa\", \"PT\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"JANZ - Contagem e Gestao de Fluídos, S.A.\",\n      \"address_lines\": [\"Avenida Infante D. Henrique, 288\", \"1950-421 Lisboa\", \"PT\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"Smartio\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Ultrasonic water meter with dry dial, designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consists of a cast brass body with connecting screw threads, one pair of ultrasonic transducers and an electronic indicating device formed by an LCD display showing volume and flow. Volume resolution of 0.00001 m³ on the digital display; no buttons. Legally non-relevant communication via NFC sensor connected on the register. Software separation between legally relevant and non-legally relevant parts; CRC and SW version of the legally relevant part displayed in the auto-rounding menu on the LCD. Indicates each volume every two minutes, separately for reverse and forward flow; the permanently shown delivered volume is the difference between the two. Can be equipped by an impulse module which is not part of this certificate. Powered by 3.6 V battery. Shall be installed to operate in any position.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"Smartio\",\n    \"models\": [\n      {\n        \"model_id\": \"Smartio DN15\",\n        \"attributes\": {\n          \"available_q3\": [1.6, 2.5]\n        }\n      },\n      {\n        \"model_id\": \"Smartio DN20\",\n        \"attributes\": {\n          \"available_q3\": [2.5, 4.0]\n        }\n      }\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": { \"value\": \"ultrasonic\" },\n      \"accuracy_class\": { \"value\": 2 },\n      \"maximum_permissible_error_lower_flowrate_zone\": { \"value\": { \"min\": -5, \"max\": 5 }, \"unit_symbol\": \"%\", \"unit_id\": null },\n      \"maximum_permissible_error_upper_flowrate_zone\": { \"value\": { \"min\": -2, \"max\": 2 }, \"unit_symbol\": \"%\", \"unit_id\": null },\n      \"temperature_class\": { \"value\": \"T50\" },\n      \"water_pressure_class\": { \"value\": \"MAP 16\" },\n      \"maximum_admissible_temperature\": { \"value\": 50, \"unit_symbol\": \"°C\", \"unit_id\": null },\n      \"maximum_admissible_pressure\": { \"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null },\n      \"orientation_limitation\": { \"value\": \"any\" },\n      \"q2_q1_ratio\": { \"value\": 1.6 },\n      \"q3_q4_ratio\": { \"value\": 1.25 },\n      \"indicating_range_testing_mode\": { \"value\": 9999, \"unit_symbol\": \"m³\", \"unit_id\": null },\n      \"indicating_range_user_mode\": { \"value\": 999999, \"unit_symbol\": \"m³\", \"unit_id\": null },\n      \"resolution_of_indicating_device_testing_mode\": { \"value\": 0.00001, \"unit_symbol\": \"m³\", \"unit_id\": null },\n      \"resolution_of_indicating_device_user_mode\": { \"value\": 0.001, \"unit_symbol\": \"m³\", \"unit_id\": null },\n      \"resolution_of_device_for_rapid_testing\": { \"value\": 100, \"unit_symbol\": \"pulse/dm³\", \"unit_id\": null },\n      \"resolution_of_indicating_device_for_rapid_testing\": { \"value\": 0.000001, \"unit_symbol\": \"m³\", \"unit_id\": null },\n      \"eut_testing_category\": { \"value\": \"Ultrasonic water meters, Coriolis water meters, fluidic water meters\" },\n      \"eut_testing_case\": { \"value\": \"B\" },\n      \"minimum_straight_length_inlet_pipe\": { \"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null },\n      \"minimum_straight_length_outlet_pipe\": { \"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null },\n      \"flow_profile_sensitivity_class\": { \"value\": \"U0D0\" },\n      \"flow_conditioner_required\": { \"value\": \"No\" },\n      \"reverse_flow\": { \"value\": \"Designed to measure\" },\n      \"mechanical_environment_class\": { \"value\": \"B, O\" },\n      \"length\": { \"value\": { \"min\": 105, \"max\": null }, \"unit_symbol\": \"mm\", \"unit_id\": null },\n      \"battery_voltage\": { \"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null }\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"nominal_diameter\",\n        \"unit_symbol\": \"mm\",\n        \"values\": [\n          { \"model\": \"Smartio DN15\", \"value\": 15 },\n          { \"model\": \"Smartio DN20\", \"value\": 20 }\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"q3_q1_ratio\",\n        \"axis\": \"nominal_diameter_and_q3\",\n        \"values\": [\n          { \"condition\": \"DN15, Q3=1.6 m³/h\", \"value\": { \"min\": null, \"max\": 630 } },\n          { \"condition\": \"DN15, Q3=2.5 m³/h\", \"value\": { \"min\": null, \"max\": 1000 } },\n          { \"condition\": \"DN20, Q3=2.5 m³/h\", \"value\": { \"min\": null, \"max\": 630 } },\n          { \"condition\": \"DN20, Q3=4 m³/h\", \"value\": { \"min\": null, \"max\": 1000 } }\n        ]\n      },\n      {\n        \"attribute\": \"pressure_loss_class\",\n        \"axis\": \"q3\",\n        \"values\": [\n          { \"condition\": \"Q3=1.6 m³/h\", \"value\": \"Δp10\" },\n          { \"condition\": \"Q3=2.5 m³/h\", \"value\": \"Δp16\" },\n          { \"condition\": \"Q3=4.0 m³/h\", \"value\": \"Δp25\" }\n        ]\n      },\n      {\n        \"attribute\": \"connection_type\",\n        \"axis\": \"nominal_diameter\",\n        \"values\": [\n          { \"condition\": \"DN15\", \"value\": \"NPSM or G type ¾\\\", 7/8\\\", 1\\\"\" },\n          { \"condition\": \"DN20\", \"value\": \"NPSM or G type 7/8\\\", 1\\\", 1 1/4\\\"\" }\n        ]\n      }\n    ]\n  },\n  \"recommendation\": {\n    \"id\": \"R49\",\n    \"edition\": 2013,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [2]\n  },\n  \"test_reports\": [\n    {\n      \"id\": \"0511-ER-V109-23\",\n      \"date\": \"2024-11-11\",\n      \"pages\": 25,\n      \"role\": \"type_evaluation_report\"\n    },\n    {\n      \"id\": \"6015-PT-P5013-24\",\n      \"pages\": 201,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"0511-UL-V109-23\",\n      \"role\": \"documentation_file\"\n    }\n  ],\n  \"revision_history\": [\n    {\n      \"revision\": \"-\",\n      \"date\": \"2024-11-11\",\n      \"changes\": \"Issuing certificate\"\n    }\n  ]\n}\n```"
