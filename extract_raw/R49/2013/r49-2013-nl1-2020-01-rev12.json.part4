      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3903947\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\"\n  },\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane, GL10 3TA Stonehouse, United Kingdom (UK)\"]\n    },\n    {\n      \"name\": \"ABB Engineering (Shanghai) Ltd.\",\n      \"address_lines\": [\"No. 4528, Kangxin Highway, Pudong New District, Shanghai, 201319, P.R. China\"]\n    },\n    {\n      \"name\": \"ABB Inc.\",\n      \"address_lines\": [\"125 E. County Line Road, Warminster, PA 18974, United States of America (USA)\"]\n    },\n    {\n      \"name\": \"ABB India Limited\",\n      \"address_lines\": [\"Plot No. 5 & 6, 2nd Phase, Peenya Industrial Area, Bengaluru – 560058, Karnataka India\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW45Y.Z\"]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Table 9 – General characteristics of the indicating device\",\n      \"description\": \"Reduced bore – AC mains powered\",\n      \"columns\": [\"meter_size\", \"indicating_range_maximum\", \"indicating_range_minimum\", \"verification_scale_interval_maximum\"],\n      \"column_units\": [\"mm\", \"m³\", \"m³\", \"m³\"],\n      \"rows\": [\n        {\"meter_size\": \"DN40, DN50, DN65\", \"indicating_range_maximum\": 9999999, \"indicating_range_minimum\": 99999, \"verification_scale_interval_maximum\": 0.0001},\n        {\"meter_size\": \"DN80\", \"indicating_range_maximum\": 9999999, \"indicating_range_minimum\": 999999, \"verification_scale_interval_maximum\": 0.0001},\n        {\"meter_size\": \"DN100, DN125, DN150, DN200\", \"indicating_range_maximum\": 9999999, \"indicating_range_minimum\": 999999, \"verification_scale_interval_maximum\": 0.001},\n        {\"meter_s