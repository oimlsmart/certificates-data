      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-24.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 10,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2026-03-11\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\n      \"Okružní 31\",\n      \"638 00 Brno\",\n      \"Czech Republic\"\n    ],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"GWF AG\",\n      \"address_lines\": [\n        \"Obergrundstrasse 119\",\n        \"CH-6005 Luzern\",\n        \"Switzerland\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"GWF AG\",\n      \"address_lines\": [\n        \"Obergrundstrasse 119\",\n        \"CH-6005 Luzern\",\n        \"Switzerland\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"sonico NANO\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Ultrasonic water meter, dry dial, designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consists of a cast brass body with connecting screw threads, one pair of ultrasonic transducers and an electronic indicating device formed by an LCD display showing volume and flow. Volume resolution of 0.00001 m³ on the digital display. Without buttons; legally non-relevant communication possible via NFC sensor connected on the register. Software separation between legally relevant and non-legally relevant parts; CRC and SW version of the legally relevant part displayed in the auto-rounding menu on the LCD display. Displays the indication of each volume every two minutes — separately delivered volume for reverse flow and separately delivered volume for forward flow; the permanently shown delivered volume is the difference between the two. Can be equipped by an impulse module which is not part of this certificate. Can be assembled with an internal NB-IoT communication module, not certified itself but with no influence on metrological parameters. Powered by mains battery 3.6 V. Shall be installed to operate in any positions. Sizes DN25 to DN40 added at Revision 2; ratio for water meter DN25 extended from R630 to R1000 at Revision 3.\"\n  },\n  \"components\": [\n    {\n      \"role\": \"communication module (internal)\",\n      \"type_designations\": [\"NB-IoT\"],\n      \"characteristics\": {\n        \"certification_status\": {\n          \"value\": \"not certified itself; no influence on metrological parameters of the water meters\",\n          \"unit_symbol\": null,\n          \"unit_id\": null\n        }\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"volume_resolution\": {\n        \"value\": 0.00001,\n        \"unit_symbol\": \"m³\",\n        \"unit_id\": null\n      },\n      \"battery_voltage\": {\n        \"value\": 3.6,\n        \"unit_symbol\": \"V\",\n        \"unit_id\": null\n      },\n      \"indication_update_interval\": {\n        \"value\": 2,\n        \"unit_symbol\": \"min\",\n        \"unit_id\": null\n      },\n      \"mechanical_environment_class\": {\n        \"value\": \"B, O\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      },\n      \"electromagnetic_environment_class\": {\n        \"value\": \"E2\",\n        \"unit_symbol\": null,\n        \"unit_id\": null\n      }\n    }\n  },\n  \"recommendation\": {\n    \"id\": \"R49\",\n    \"edition\": 2013,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [\"2\"]\n  },\n  \"test_reports\": [\n    {\n      \"id\": \"0511-ER-V124-25\",\n      \"date\": \"2026-03-11\",\n      \"pages\": 39,\n      \"role\": \"type_evaluation_report\"\n    },\n    {\n      \"id\": \"6015-PT-P0022-25\",\n      \"pages\": 74,\n      \"role\": \"test_report\"\n    },\n    {\n      \"id\": \"6011-PT-SW011-25\",\n      \"pages\": 7,\n      \"role\": \"test_report\"\