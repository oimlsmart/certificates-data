      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3903947\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2025-04-07\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW4XY.Z\", \"AquaMaster4 FET4*\"],\n    \"description\": \"An electromagnetic water meter. Type designation wildcards: X being 1 for standard or 3 for advanced or 5 for premium (mobile Comms - MC) variant; Y being 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z being R (reduced bore), V (virtual full bore) or F (full bore).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\n        \"model_id\": \"FEW41Y.Z\",\n        \"label\": \"AquaMaster4 FEW41Y.Z\",\n        \"attributes\": {\"variant\": \"standard (X=1)\"}\n      },\n      {\n        \"model_id\": \"FEW43Y.Z\",\n        \"label\": \"AquaMaster4 FEW43Y.Z\",\n        \"attributes\": {\"variant\": \"advanced (X=3)\"}\n      },\n      {\n        \"model_id\": \"FEW45Y.Z\",\n        \"label\": \"AquaMaster4 FEW45Y.Z\",\n        \"attributes\": {\"variant\": \"premium, mobile Comms - MC (X=5)\"}\n   