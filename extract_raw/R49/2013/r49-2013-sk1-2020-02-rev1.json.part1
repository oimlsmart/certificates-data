      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-SK1-20.02 Rev. 1\",\n    \"scheme\": \"A\",\n    \"page_total\": 10,\n    \"member_state\": \"Slovakia\",\n    \"date_issued\": \"2025-11-06\",\n    \"oiml_issuer_id\": \"SK1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Slovak Legal Metrology (SLM)\",\n    \"address_lines\": [\n      \"Geologická 9966/1\",\n      \"821 06 Bratislava-Podunajské Biskupice\",\n      \"Slovakia\",\n      \"Product Certification Body\",\n      \"Hviedzoslavova 31\",\n      \"974 01 Banská Bystrica\",\n      \"Slovakia\"\n    ],\n    \"person_responsible\": \"Dušan Šmigura\",\n    \"person_title\": \"Director of PCB\",\n    \"oiml_issuer_id\": \"SK1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Ningbo Aimei Meter Manufacture Co., Ltd.\",\n      \"address_lines\": [\n        \"68, West Town Road, Shangtian Town, Fenghua\",\n        \"Zhejiang, China 3155\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Ningbo Aimei Meter Manufacture Co., Ltd.\",\n      \"address_lines\": [\n        \"68, West Town Road, Shangtian Town, Fenghua\",\n        \"Zhejiang, China 3155\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"UWM\"],\n    \"module_designation\": \"Ultrasonic water meter intended for the metering of cold potable water\",\n    \"description\": \"Compact ultrasonic water meter type UWM with electronic indication device, designed to measure, memorise and display the volume of clean water passing through the measurement transducer at metering conditions; intended for residential, commercial and light industrial use. Measurement is based on the ultrasonic bidirectional transit-time principle. Can be installed in all positions and is not designed to measure reverse flow. Essential parts: flow sensor (cylindrical brass body or plastic body with inlet and outlet threaded connections, inner plastic element with two mirrors/sound path, two ultrasonic sensors on top of the body) and calculator and indication device (plastic housing directly mounted on the flow sensor, main PCB with LCD display and optical sensor, non-replaceable lithium batteries with end-of-life indicator). Optional non-essential parts: non-return valve; communication interfaces: optical infrared, RF, LoRaWAN, wM-Bus, OMS, Sigfox, NB-IoT, M-Bus, and Pulse.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"UWM\",\n    \"models\": [\n      {\"model_id\": \"DN15\"},\n      {\"model_id\": \"DN20\"}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow_sensor\",\n      \"characteristics\": {\n        \"body\": \"cylindrical brass body or plastic body (alternatives) with inlet and outlet threaded connections\",\n        \"measurement_element\": \"inner plastic element with two mirrors (sound path) placed in the cylindrical body\",\n        \"sensors\": \"two ultrasonic sensors placed on the upside of the cylindrical body\"\n      }\n    },\n    {\n      \"role\": \"calculator_and_indication_device\",\n      \"characteristics\": {\n        \"housing\": \"plastic housing of the calculator with indication device directly mounted on the flow sensor\",\n        \"electronics\": \"main PCB board with LCD display and optical sensor\",\n        \"display\": \"electronic LCD non-permanent (automatic scrolling) display with 10 digits; sub-multiples of a cubic meter indicated by the comma and top and bottom lines\",\n        \"power_source\": \"non-replaceable lithium batteries with end-of-life indicator activated based on pre-calculated power consumption\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"ultrasonic bidirectional transit-time\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"installation_positions\": {\"value\": \"all positions\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"display_digits\": {\"value\": 10, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_indication_range\": {\"value\": 99999.99999, \"unit_symbol\": \"m³\", \"unit_id\": null, \"footnote_markers\": []},\n      \"display_duration_of_measured_volume\": {\"value\": 10, \"unit_symbol\": \"s\", \"unit_id\": null, \"footnote_markers\": []},\n      \"communication_interfaces\": {\"value\": \"optical infrared, RF, LoRaWAN, wM-Bus, OMS, Sigfox, NB-IoT, M-Bus, Pulse\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"config_level\": [\n      {\n        \"attribute\": \"number_of_batteries\",\n        \"axis\": \"battery_option\",\n        \"values\": [\n          {\"condition\": \"two or three non-replaceable lithium batteries (Umax 3.7 V, lifetime up to 16 years)\", \"value\": {\"min\": 2, \"max\": 3}},\n          {\"condition\": \"one non-replaceable lithium battery (Umax 3.6 V, lifetime up to 10 years)\", \"value\": 1}\n        ]\n      },\n      {\n        \"attribute\": \"battery_max_voltage\",\n        \"axis\": \"battery_option\",\n        \"values\": [\n          {\"condition\": \"two or three batteries\", \"value\": 3.7, \"unit_symbol\": \"V\"},\n          {\"condition\": \"one battery\", \"value\": 3.6, \"unit_symbol\": \"V\"}\n        ]\n      },\n      {\n        \"attribute\": \"battery_lifetime_max\",\n        \"axis\": \"battery_option\",\n        \"values\": [\n          {\"condition\": \"two or three batteries\", \"value\": 16, \"unit_symbol\": \"years\"},\n          {\"condition\": \"one battery\", \"value\": 10, \"unit_symbol\": \"years\"}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_class\",\n        \"axis\": \"body_material_and_size\",\n        \"values\": [\n          {\"condition\": \"brass body\", \"value\": \"T70\"},\n          {\"condition\": \"plastic body, DN15 and DN20\", \"value\": \"T30, T50\"}\n        ]\n      }\n    ]\n  },\n  \"recommendation\": {\n    \"id\": \"R49\",\n    \"edition\": 2013,\n    \"scheme\": \"A\",\n    \"accuracy_classes\": [\"2\"]\n  },\n  \"test_reports\": [\n    {\n      \"id\": \"2025/ER010/SK1\",\n      \"date\": \"2025-11-06\",\n      \"pages\": 19,\n      \"role\": \"type_evaluation_report\"\n    },\n    {\n      \"id\": \"Ningbo Aimei_UWM_01\",\n      \"date\": \"2025-11-06\",\n      \"pages\": 76,\n      \"role\": \"documentation_file\"\n    }\n  ],\n  \"revision_history\": [\n    {\n      \"revision\": \"0\",\n      \"date\": \"2020-07-17\",\n      \"changes\": \"Certificate first issued\"\n    },\n    {\n      \"revision\": \"1\",\n      \"date\": \"2025-11-06\",\n      \"changes\": \"Add: ratio to R800; temperature class T70 for brass body; checksum 25667; options of trademarks (6 pcs); plastic body for DN15 and DN20 with temperature class T30 and T50. Changes: one pc battery to 2 or 3 pcs batteries; address of OIML Issuing Authority SLM; formal the year \\\"2020\\\" to \\\"20\\\" in the Certificate number\"\n    }\n  ]\n}"
