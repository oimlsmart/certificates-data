      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-SK1-20.02\",\n    \"scheme\": \"A\",\n    \"page_total\": 10,\n    \"member_state\": \"Slovakia\",\n    \"oiml_issuer_id\": \"SK1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Slovak Legal Metrology\",\n    \"oiml_issuer_id\": \"SK1\"\n  },\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"UWM\", \"UWM-Cr3\"],\n    \"description\": \"Ultrasonic water meter type UWM (meter photo in Fig. 1 marked 'Ultrasonic Water Meter Model UWM-Cr3'), battery powered, calculator and indicating device housed in a plastic housing; body of brass or plastic. Protected against unauthorised manipulation and opening by a wire seal securing the connection between upper and lower part of the plastic housing of the calculator and indication device (lead seal or plastic seal variants, Fig. 3). Marked data per section 4 (manufacturer, type, m³, year/serial number, Q3 and ratio Q3/Q1, flow direction arrow, MAP, temperature class, pressure loss class, replacement date, environmental and electromagnetic class, national approval sign). Manufacturer may use trademarks: AIMEI, ASM, A/S/M ®, A/S/M ® AIMEI, Ⓢ ®, Ⓢ ® AIMEI.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"UWM\",\n    \"models\": [\n      {\n        \"model_id\": \"R200\",\n        \"attributes\": {\n          \"nominal_diameter\": {\"value\": 20, \"unit_symbol\": \"mm\"},\n          \"permanent_flowrate_q3\": {\"value\": 4, \"unit_symbol\": \"m³/h\"}\n        }\n      },\n      {\n        \"model_id\": \"R250\",\n        \"attributes\": {\n          \"nominal_diameter\": {\"value\": 20, \"unit_symbol\": \"mm\"},\n          \"permanent_flowrate_q3\": {\"value\": 4, \"unit_symbol\": \"m³/h\"}\n        }\n      },\n      {\n        \"model_id\": \"R315\",\n        \"attributes\": {\n          \"nominal_diameter\": {\"value\": 20, \"unit_symbol\": \"mm\"},\n          \"permanent_flowrate_q3\": {\"value\": 4, \"unit_symbol\": \"m³/h\"}\n        }\n      },\n      {\n        \"model_id\": \"R400\",\n        \"attributes\": {\n          \"nominal_diameter\": {\"value\": 20, \"unit_symbol\": \"mm\"},\n          \"permanent_flowrate_q3\": {\"value\": 4, \"unit_symbol\": \"m³/h\"}\n        }\n      }\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"software_and_checksum\": {\"value\": \"13 22681\", \"unit_symbol\": null},\n      \"nominal_diameter\": {\"value\": 20, \"unit_symbol\": \"mm\"},\n      \"body_material\": {\"value\": \"brass / plastic\"},\n      \"permanent_flowrate_q3\": {\"value\": 4, \"unit_symbol\": \"m³/h\"},\n      \"overload_flowrate_q4\": {\"value\": 5, \"unit_symbol\": \"m³/h\"},\n      \"ratio_q2_q1\": {\"value\": 1.6, \"unit_symbol\": null},\n      \"connection_thread\": {\"value\": \"G 1 B\"},\n      \"construction_length\": {\"value\": {\"min\": 110, \"max\": 190}, \"unit_symbol\": \"mm\"},\n      \"pressure_loss\": {\"value\": 0.63, \"unit_symbol\": \"bar\"},\n      \"pressure_loss_class\": {\"value\": \"Δp63\"},\n      \"battery\": {\"value\": \"1 pc li-battery\"},\n      \"battery_supply_voltage\": {\"value\": {\"min\": 3, \"max\": 3.6}, \"unit_symbol\": \"V\"},\n      \"battery_life_time\": {\"value\": {\"min\": null, \"max\": 10}, \"unit_symbol\": \"years\"},\n      \"installation_orientation\": {\"value\": \"All positions\"},\n      \"maximum_admissible_pressure_map\": {\"value\": 16, \"unit_symbol\": \"bar\"},\n      \"maximum_permissible_error_lower_flowrates_range_q1_to_q2\": {\"value\": {\"min\": -5, \"max\": 5}, \"unit_symbol\": \"%\"},\n      \"calculator_capacity\": {\"value\": 99999.99999, \"unit_symbol\": \"m³\"},\n      \"scale_interval\": {\"value\": 0.00001, \"unit_symbol\": \"m³\"},\n      \"accuracy_class\": {\"value\": 2, \"unit_symbol\": null},\n      \"mechanical_class\": {\"value\": \"M1\"},\n      \"climatic_class\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\"},\n      \"climatic_and_mechanical_environmental_conditions_class\": {\"value\": \"B / O (fixed meters installed in a building / outdoors)\"},\n      \"flow_profile_sensitivity_class\": {\"value\": \"U0 D0\"}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"minimum_flowrate_q1\",\n        \"unit_symbol\": \"l/h\",\n        \"values\": [\n          {\"model\": \"R200\", \"value\": 20},\n          {\"model\": \"R250\", \"value\": 16},\n          {\"model\": \"R315\", \"value\": 12.7},\n          {\"model\": \"R400\", \"value\": 10}\n        ]\n      },\n      {\n        \"attribute\": \"transitional_flowrate_q2\",\n        \"unit_symbol\": \"l/h\",\n        \"values\": [\n          {\"model\": \"R200\", \"value\": 32},\n          {\"model\": \"R250\", \"value\": 25.6},\n          {\"model\": \"R315\", \"value\": 20.32},\n          {\"model\": \"R400\", \"value\": 16}\n        ]\n      },\n      {\n        \"attribute\": \"ratio_q3_q1\",\n        \"unit_symbol\": \"R\",\n        \"values\": [\n          {\"model\": \"R200\", \"value\": 200},\n          {\"model\": \"R250\", \"value\": 250},\n          {\"model\": \"R315\", \"value\": 315},\n          {\"model\": \"R400\", \"value\": 400}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"water_temperature_range\",\n        \"axis\": \"temperature_class / body_material\",\n        \"values\": [\n          {\"condition\": \"T30, brass and plastic body\", \"value\": {\"min\": 0.1, \"max\": 30}, \"unit_symbol\": \"°C\"},\n          {\"condition\": \"T50, brass and plastic body\", \"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\"},\n          {\"condition\": \"T70, brass body\", \"value\": {\"min\": 0.1, \"max\": 70}, \"unit_symbol\": \"°C\"}\n        ]\n      },\n      {\n        \"attribute\": \"temperature_class\",\n        \"axis\": \"body_material\",\n        \"values\": [\n          {\"condition\": \"brass and plastic body\", \"value\": \"T30, T50\"},\n          {\"condition\": \"brass body\", \"value\": \"T70\"}\n        ]\n      },\n      {\n        \"attribute\": \"electromagnetic_class\",\n        \"axis\": \"body_material\",\n        \"values\": [\n          {\"condition\": \"brass body\", \"value\": \"E1\"},\n          {\"condition\": \"plastic body\", \"value\": \"E1, E2\"}\n        ]\n      },\n      {\n        \"attribute\": \"maximum_permissible_error_upper_flowrates_range_q2_to_q4\",\n        \"axis\": \"water_temperature\",\n        \"values\": [\n          {\"condition\": \"ϑ ≤ 30 °C\", \"value\": {\"min\": -2, \"max\": 2}, \"unit_symbol\": \"%\"},\n          {\"condition\": \"ϑ > 30 °C\", \"value\": {\"min\": -3, \"max\": 3}, \"unit_symbol\": \"%\"}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Technical and metrological data UWM DN20, Q3 = 4 m³ — flow characteristics by ratio Q3/Q1\",\n      \"columns\": [\"ratio_q3_q1\", \"q3\", \"q4\", \"q1\", \"q2\", \"q2_over_q1\"],\n      \"column_units\": [\"R\", \"m³/h\", \"m³/h\", \"l/h\", \"l/h\", null],\n      \"rows\": [\n        {\"ratio_q3_q1\": 200, \"q3\": 4, \"q4\": 5, \"q1\": 20, \"q2\": 32, \"q2_over_q1\": 1.6},\n        {\"ratio_q3_q1\": 250, \"q3\": 4, \"q4\": 5, \"q1\": 16, \"q2\": 25.6, \"q2_over_q1\": 1.6},\n        {\"ratio_q3_q1\": 315, \"q3\": 4, \"q4\": 5, \"q1\": 12.7, \"q2\": 20.32, \"q2_over_q1\": 1.6},\n        {\"ratio_q3_q1\": 400, \"q3\": 4, \"q4\": 5, \"q1\": 10, \"q2\": 16, \"q2_over_q1\": 1.6}\n      ],\n      \"description\": \"Water meter type UWM, DN20, Q3 = 4 m³/h, software and checksum 13 22681; decimal commas converted to decimal points.\",\n      \"footnotes\": []\n    },\n    {\n      \"name\": \"Basic dimensions of the water meter UWM (Fig. 2)\",\n      \"columns\": [\"dn_size\", \"length_l\", \"height_h\", \"width_w\", \"connection_thread_a\"],\n      \"column_units\": [null, \"mm\", \"mm\", \"mm\", null],\n      \"rows\": [\n        {\"dn_size\": \"DN15\", \"length_l\": {\"min\": 110, \"max\": 190}, \"height_h\":