      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3903947\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2025-04-07\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V. (OIML Issuing Authority NL1)\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"ABB Limited\",\n      \"address_lines\": [\"Oldends Lane\", \"GL10 3TA Stonehouse\", \"United Kingdom\"]\n    },\n    {\n      \"name\": \"ABB Engineering (Shanghai) Ltd.\",\n      \"address_lines\": [\"No. 4528, Kangxin Highway\", \"Pudong New District, Shanghai\", \"201319\", \"P.R. China\"]\n    },\n    {\n      \"name\": \"ABB Inc.\",\n      \"address_lines\": [\"125 E. County Line Road\", \"Warminster, PA 18974\", \"United States of America (USA)\"]\n    },\n    {\n      \"name\": \"ABB India Limited\",\n      \"address_lines\": [\"Plot No. 5 & 6, 2nd Phase, Peenya Industrial Area\", \"Bengaluru - 560058\", \"Karnataka\", \"India\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW4XY.Z\", \"FET4\", \"FEW41Y.Z\", \"FEW43Y.Z\", \"FEW45Y.Z\"],\n    \"module_designation\": null,\n    \"description\": \"Electromagnetic water meter AquaMaster4, consisting of flow transmitter types FEW4XY.Z and flow sensor type FET4. X = 1 (standard), 3 (advanced) or 5 (premium, mobile Comms - MC) variant; Y = 1, 2, 8 or 9 (integral/remote version, optionally sensor only); Z = R (reduced bore), V (virtual full bore) or F (full bore).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\n        \"model_id\": \"FEW41Y.Z\",\n        \"label\": \"AquaMaster4 transmitter, standard variant\",\n        \"attributes\": {\"x_code\": \"1\", \"x_variant\": \"standard\"}\n      },\n      {\n        \"model_id\": \"FEW43Y.Z\",\n        \"label\": \"AquaMaster4 transmitter, advanced variant\",\n        \"attributes\": {\"x_code\": \"3\", \"x_variant\": \"advanced\"}\n      },\n      {\n        \"model_id\": \"FEW45Y.Z\",\n        \"label\": \"AquaMaster4 transmitter, premium variant (mobile Comms - MC)\",\n        \"attributes\": {\"x_code\": \"5\", \"x_variant\": \"premium (mobile Comms - MC)\"}\n      },\n      {\n        \"model_id\": \"FET4\",\n        \"label\": \"AquaMaster4 flow sensor\",\n        \"attributes\": {\n          \"y_options\": \"1, 2, 8 or 9 (integral/remote version, optionally sensor only)\",\n          \"z_options\": \"R (reduced bore), V (virtual full bore) or F (full bore)\"\n        }\n      }\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow sensor (measuring sensor)\",\n      \"type_designations\": [\"FET4\"],\n      \"alternatives\": null,\n      \"characteristics\": {\n        \"bore_options\": \"R (reduced bore), V (virtual full bore), F (full bore)\",\n        \"reverse_flow\": \"sensor is intended to measure reverse flow\"\n      }\n    },\n    {\n      \"role\": \"flow transmitter (calculating and indicating device)\",\n      \"type_designations\": [\"FEW41Y.Z\", \"FEW43Y.Z\", \"FEW45Y.Z\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {}\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"Electromagnetic\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"accuracy_class\": {\"value\": \"1 and 2\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"environmental_class\": {\"value\": \"O (installed outdoors)\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"electromagnetic_environment\": {\"value\": \"E2\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"mechanical_class\": {\"value\": \"M1\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"ambient_temperature_range\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"water_temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null, \"footnote_markers\": []},\n      \"orientation\": {\"value\": \"All positions (horizontal, vertical, or diagonal)\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"reverse_flow\": {\"value\": \"The sensor is intended to measure reverse flow\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"checking_facility\": {\"value\": \"Type P (permanent) automatic checking facility\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []}\n    },\n    \"model_level\": [],\n    \"config_level\": [\n      {\n        \"attribute\": \"electromagnetic_environment\",\n        \"axis\": \"transmitter type / antenna configuration\",\n        \"values\": [\n          {\"condition\": \"FEW41Y.Z or FEW43Y.Z\", \"value\": \"E2\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"FEW45Y.Z with external antenna cable\", \"value\": \"E1\", \"unit_symbol\": null, \"footnote_markers\": []},\n          {\"condition\": \"FEW45Y.Z without external antenna cable\", \"