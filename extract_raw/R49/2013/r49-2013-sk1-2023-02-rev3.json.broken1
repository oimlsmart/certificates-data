oftware\": \"2.02 (CD00)\"}},\n      {\"model_id\": \"DN40_Q3=25_R250\", \"attributes\": {\"designs\": [\"A\"], \"software\": \"2.02 (CD00)\"}},\n      {\"model_id\": \"DN40_Q3=25_R400\", \"attributes\": {\"designs\": [\"A\"], \"software\": \"2.02 (CD00)\"}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow sensor (measurement transducer)\",\n      \"type_designations\": [],\n      \"characteristics\": {\n        \"body\": \"plastic cylindrical brass body with inlet and outlet, firmly connected with the plastic housing for the calculator\",\n        \"sound_path\": \"inner plastic element with two mirrors (four mirrors for DN40)\",\n        \"ultrasonic_transducers\": \"two ultrasonic transducers (four for DN40) placed on the upside of the cylindrical plastic body\"\n      }\n    },\n    {\n      \"role\": \"calculator and indication device\",\n      \"type_designations\": [],\n      \"characteristics\": {\n        \"housing\": \"plastic housing with indication device directly mounted on the flow sensor\",\n        \"electronics\": \"three PCBs and one PCB with calculator\",\n        \"display\": \"electronic LCD with 2 lines: upper line 9 digits with indication range 999999.999 m³; bottom line 5 digits to display the current flow rate in m³/h\",\n        \"batteries\": \"non-replaceable lithium batteries, life 16 years\",\n        \"battery_configuration\": \"DN15/DN20/DN25/DN32: two internal AA batteries; DN15/DN20 B design: one C size + one A23; DN40: one D size battery (+ one A23)\"\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"accuracy_class\": {\"value\": 2, \"unit_symbol\": null, \"unit_id\": null},\n      \"mechanical_class\": {\"value\": \"M1\", \"unit_symbol\": null, \"unit_id\": null},\n      \"climatic_class\": {\"value\": {\"min\": -15, \"max\": 70}, \"unit_symbol\": \"°C\", \"unit_id\": \"u:degree_Celsius\"},\n      \"electromagnetic_class\": {\"value\": \"E2\", \"unit_symbol\": null, \"unit_id\": null},