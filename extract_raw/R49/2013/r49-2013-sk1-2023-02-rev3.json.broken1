      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-SK1-23.02 Rev. 3\",\n    \"scheme\": \"A\",\n    \"page_total\": 13,\n    \"member_state\": \"Slovakia\",\n    \"date_issued\": \"2025-01-28\",\n    \"oiml_issuer_id\": \"SK1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Slovak Legal Metrology (SLM)\",\n    \"address_lines\": [\n      \"Geologická 9966/1, 821 06 Bratislava-Podunajské Biskupice, Slovakia\",\n      \"Product Certification Body, Hviezdoslavova 31, 974 01 Banská Bystrica, Slovakia\"\n    ],\n    \"person_responsible\": \"Ing. Dušan Šmigura, PhD.\",\n    \"person_title\": \"Director of PCB\",\n    \"oiml_issuer_id\": \"SK1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"UAB „Axioma Metering“\",\n      \"address_lines\": [\n        \"Veterinaru str. 52, Biruliskes, LT-54469 Kaunas region, Lithuania\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"UAB „Axioma Metering“\",\n      \"address_lines\": [\n        \"Veterinaru str. 52, Biruliskes, LT-54469 Kaunas region, Lithuania\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"Qalcosonic W1\"],\n    \"module_designation\": \"Ultrasonic water meters with electronic indication device\",\n    \"description\": \"Compact ultrasonic water meter with electronic indication device, designed to measure, memorise and display the volume of clean water passing through the measurement transducer at metering conditions (residential use, non-resettable measurements). Measurement is based on the ultrasonic bidirectional transit-time principle. The meter can be installed in horizontal and vertical positions and is not designed to measure reverse flow. Produced in A design (all DNs) and design B (DN15 and DN20 only); the difference lies solely in the external appearance, the measurement section being identical. Non-essential parts: antenna; non-return valve (optional).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"QALCOSONIC W1\",\n    \"models\": [\n      {\"model_id\": \"DN15_Q3=1.6_R80\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=1.6_R160\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=1.6_R250\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=1.6_R315\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=1.6_R400\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=2.5_R80\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=2.5_R160\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=2.5_R250\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=2.5_R400\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN15_Q3=2.5_R800\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN20_Q3=2.5_R80\", \"attributes\": {\"designs\": [\"A\", \"B\"], \"software\": {\"design_A\": \"1.03 (C983)\", \"design_B\": \"1.03 (F897)\"}}},\n      {\"model_id\": \"DN20_Q3=2.5_R160\", \"attributes\": {\"designs\": [\"A\"