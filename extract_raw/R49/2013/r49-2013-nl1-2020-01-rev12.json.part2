      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-NL1-20.01\",\n    \"revision\": \"12\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3903947\",\n    \"page_total\": 13,\n    \"member_state\": \"The Netherlands\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"AquaMaster4 FEW45Y.Z\"],\n    \"description\": \"Family of water meters, reduced bore, meter sizes DN40 to DN600, accuracy classes 1 and 2, AC mains powered or battery / renewable energy powered.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"AquaMaster4\",\n    \"models\": [\n      {\"model_id\": \"DN40-AC-1\", \"label\": \"Reduced bore DN40, accuracy class 1, AC mains powered\"},\n      {\"model_id\": \"DN40-AC-2\", \"label\": \"Reduced bore DN40, accuracy class 2, AC mains powered\"},\n      {\"model_id\": \"DN50-AC-1\", \"label\": \"Reduced bore DN50, accuracy class 1, AC mains powered\"},\n      {\"model_id\": \"DN50-AC-2\", \"label\": \"Reduced bore DN50, accuracy class 2, AC mains powered\"},\n      {\"model_id\": \"DN65-AC-1+2\", \"label\": \"Reduced bore DN65, accuracy classes 1 & 2, AC mains powered\"},\n      {\"model_id\": \"DN80-AC-1+2\", \"label\": \"Reduced bore DN80, accuracy classes 1 & 2, AC mains powered\"},\n      {\"model_id\": \"DN100-AC-1\", \"label\": \"Reduced bore DN100, accuracy class 1, AC mains powered\"},\n      {\"model_id\": \"DN100-AC-2\", \"label\": \"Reduced bore DN100, accuracy class 2, AC mains powered\"},\n      {\"model_id\": \"DN125-AC-1\", \"label\": \"Reduced bore DN125, accuracy class 1, AC mains powered\"},\n      {\"model_id\": \"DN125-AC-2\", \"label\": \"Reduced bore DN125, accuracy class 2, AC mains powered\"},\n      {\"model_id\": \"DN150-AC-1+2\", \"label\": \"Reduced bore DN150, accuracy classes 1 & 2, AC mains powered\"},\n      {\"model_id\": \"DN200-A