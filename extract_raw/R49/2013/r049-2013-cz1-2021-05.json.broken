      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2013-A-CZ1-2021.05\",\n    \"scheme\": \"A\",\n    \"page_total\": 6,\n    \"member_state\": \"Czech Republic\",\n    \"date_issued\": \"2021-10-15\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Czech Metrology Institute\",\n    \"address_lines\": [\"Okružní 31\", \"638 00 Brno\", \"Czech Republic\"],\n    \"person_responsible\": \"Jan Kalandra\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"APATOR POWOGAZ S.A.\",\n      \"address_lines\": [\"ul. Klemensa Janickiego 23/25\", \"60-542 Poznań\", \"Poland\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"APATOR POWOGAZ S.A.\",\n      \"address_lines\": [\"ul. Klemensa Janickiego 23/25\", \"60-542 Poznań\", \"Poland\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"ULTRIMIS (UL)\", \"UL 2.5\", \"UL 4\", \"UL 6.3\", \"UL 10\", \"UL 16\", \"UL 25\"],\n    \"module_designation\": \"Not applicable\",\n    \"description\": \"Ultrasonic water meter designed to measure, memorise and display the volume at metering conditions of water passing through the measurement transducer. Consists of a brass or composite body with connecting screw threads, one pair of ultrasonic transducers and an electronic indicating device formed by an LCD display showing volume and flow. Two indication modes: normal resolution mode and high resolution mode (used during calibration) with a displayed volume resolution of 0.00001 m³. No buttons; adjustment and reading/setting of metrological data is realised electronically using NFC, access secured by password. Legally non-relevant communication is possible by radio module with frequency 433 MHz, 434 MHz or 868 MHz; the radio module is not part of this certificate. Separation of software; SW versions and CRCs are displayed on the LCD in the auto-rounding menu. The meters are installed to operate in arbitrary orientation and are not designed to measure reverse flow. Sealed by embedding the clamp-on cover to the meter body; equipped with electronic tamper detection shown on the LCD display.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"ULTRIMIS (UL)\",\n    \"models\": [\n      {\"model_id\": \"UL 2.5\", \"label\": \"ULTRIMIS (UL) 2.5, DN 15/20\", \"attributes\": {}},\n      {\"model_id\": \"UL 4\", \"label\": \"ULTRIMIS (UL) 4, DN 20\", \"attributes\": {}},\n      {\"model_id\": \"UL 6.3\", \"label\": \"ULTRIMIS (UL) 6.3, DN 25\", \"attributes\": {}},\n      {\"model_id\": \"UL 10\", \"label\": \"ULTRIMIS (UL) 10, DN 25/32\", \"attributes\": {}},\n      {\"model_id\": \"UL 16 (Q3=10)\", \"label\": \"ULTRIMIS (UL) 16, DN 40, Q3=10 m³/h\", \"attributes\": {}},\n      {\"model_id\": \"UL 16 (Q3=16)\", \"label\": \"ULTRIMIS (UL) 16, DN 40, Q3=16 m³/h\", \"attributes\": {}},\n      {\"model_id\": \"UL 25\", \"label\": \"ULTRIMIS (UL) 25, DN 50\", \"attributes\": {}}\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"measuring_principle\": {\"value\": \"ultrasonic\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"accuracy_class\": {\"value\": 2, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"q2_over_q1\": {\"value\": 1.6, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"q3_over_q4\": {\"value\": 1.25, \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"mpe_lower_flowrate_zone\": {\"value\": {\"min\": -5, \"max\": 5}, \"unit_symbol\": \"%\", \"unit_id\": null, \"footnote_markers\": []},\n      \"temperature_class\": {\"value\": \"T30, T50\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"water_pressure_class\": {\"value\": \"MAP 10, MAP 16\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"environmental_class\": {\"value\": \"B or O\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"electromagnetic_environment_class\": {\"value\": \"E1, E2\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"maximum_admissible_temperature\": {\"value\": 50, \"unit_symbol\": \"°C\", \"unit_id\": \"u:degree_Celsius\", \"footnote_markers\": []},\n      \"maximum_admissible_pressure\": {\"value\": 1.6, \"unit_symbol\": \"MPa\", \"unit_id\": null, \"footnote_markers\": []},\n      \"orientation_limitation\": {\"value\": \"any\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"indicating_range\": {\"value\": 999999, \"unit_symbol\": \"m³\", \"unit_id\": null, \"footnote_markers\": []},\n      \"indicating_device_resolution\": {\"value\": 0.001, \"unit_symbol\": \"m³\", \"unit_id\": null, \"footnote_markers\": []},\n      \"rapid_test_device_resolution\": {\"value\": 0.00001, \"unit_symbol\": \"m³\", \"unit_id\": null, \"footnote_markers\": []},\n      \"eut_test_category\": {\"value\": \"Ultrasonic water meters\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"eut_test_case\": {\"value\": \"B\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"minimum_straight_length_inlet_pipe\": {\"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null, \"footnote_markers\": []},\n      \"minimum_straight_length_outlet_pipe\": {\"value\": 0, \"unit_symbol\": \"mm\", \"unit_id\": null, \"footnote_markers\": []},\n      \"installation_sensitivity_class\": {\"value\": \"U0D0\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"flow_conditioner_required\": {\"value\": \"No\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"power_supply_type\": {\"value\": \"non-replaceable battery\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": []},\n      \"u_max\": {\"value\": 3.6, \"unit_symbol\": \"V\", \"unit_id\": null, \"footnote_markers\": []},\n      \"u_min\": {\"value\": 1.9, \"unit_symbol\": \"V\", \"unit_id\":