      "text": "{\n  \"certificate\": {\n    \"number\": \"R49/2024-A-SK1-26.01\",\n    \"scheme\": \"A\",\n    \"page_total\": 7,\n    \"member_state\": \"Slovakia\",\n    \"date_issued\": \"2026-09-10\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"Slovak Legal Metrology (SLM)\",\n    \"address_lines\": [\n      \"Geologická 9966/1\",\n      \"821 06 Bratislava-Podunajské Biskupice\",\n      \"Slovakia\"\n    ],\n    \"person_responsible\": \"Ing. Dušan Šmigura, PhD.\",\n    \"person_title\": \"Director of PCB\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Shenzhen Kaifa Technology (Chengdu) Co., Ltd.\",\n      \"address_lines\": [\n        \"No. 99 Tianquan Road\",\n        \"Hi-Tech Development Zone\",\n        \"Chengdu, Sichuan\",\n        \"P.R. China\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Shenzhen Kaifa Technology (Chengdu) Co., Ltd.\",\n      \"address_lines\": [\n        \"No. 99 Tianquan Road\",\n        \"Hi-Tech Development Zone\",\n        \"Chengdu, Sichuan\",\n        \"P.R. China\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Water meter\",\n    \"type_designations\": [\"MA408\"],\n    \"module_designation\": \"Ultrasonic water meters with electronic indication device\",\n    \"description\": \"Residential compact ultrasonic water meter with electronic indication device that measures, memorizes and displays the volume of water passing through the measurement transducers at metering conditions; intended for clean water in residential use. Based on the ultrasonic bidirectional transit-time principle (difference in time-of-flight of ultrasonic pulses downstream vs upstream). Can be installed in horizontal and vertical positions; not designed to measure reverse flow. Non-essential parts: strainer, optical communication port, one communication battery.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"MA408\",\n    \"models\": [\n      {\"model_id\": \"MA408 (DN15)\", \"label\": \"MA408 (DN15)\", \"attributes\": {\"nominal_diameter\": \"DN15\"}},\n      {\"model_id\": \"MA408 (DN20)\", \"label\": \"MA408 (DN20)\", \"attributes\": {\"nominal_diameter\": \"DN20\"}},\n      {\"model_id\": \"MA408 (DN25)\", \"label\": \"MA408 (DN25)\", \"attributes\": {\"nominal_diameter\": \"DN25\"}}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"flow sensor (essential part)\",\n      \"type_designations\": [],\n      \"characteristics\": {\n        \"description\": {\"value\": \"Brass cylindrical body with inlet/outlet, inner plastic measuring supports (pipe support-down/up), two reflection sheets in the pipe centre, and two ultrasonic transducers (upstream and downstream)\"},\n        \"measurement_principle\": {\"value\": \"ultrasonic bidirectional transit-time\", \"unit_symbol\": null, \"unit_id\": null}\n      }\n    },\n    {\n      \"role\": \"calculator and indication device (essential part)\",\n      \"type_designations\": [],\n      \"characteristics\": {\n        \"description\": {\"value\": \"Plastic housing mounted directly on the flow sensor; one PCB (main + measurement board combined); electronic scrolling LCD with 9 digits (range 999999.999 m³); one non-replaceable lithium battery (lifetime 18 years)\"}\n      }\n    },\n    {\"role\": \"strainer (non-essential part)\", \"type_designations\": []},\n    {\"role\": \"optical communication port (non-essential part)\", \"type_designations\": []},\n    {\"role\": \"communication battery (non-essential part)\", \"type_designations\": []}\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"measurement_principle\": {\"value\": \"ultrasonic bidirectional transit-time\", \"unit_symbol\": null, \"unit_id\": null},\n      \"water_temperature_range\": {\"value\": {\"min\": 0.1, \"max\": 50}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n      \"temperature_class\": {\"value\": \"T50\", \"unit_symbol\": null, \"unit_id\": null},\n      \"installation_orientation\": {\"value\": \"H/V\", \"unit_symbol\": null, \"unit_id\": null},\n      \"maximum_admissible_pressure_map\": {\"value\": 16, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      \"maximum_pressure_loss\": {\"value\": 0.4, \"unit_symbol\": \"bar\", \"unit_id\": null},\n      \"pressure_loss_class\": {\"value\": \"Δp 40\", \"unit_symbol\": null, \"unit_id\": null},\n      \"accuracy_class\": {\"value\": 2, \"unit_symbol\": null, \"unit_id\": null},\n      \"mechanical_environmental_class\": {\"value\": \"M1\", \"unit_symbol\": null, \"unit_id\": null},\n      \"climatic_class\": {\"value\": {\"min\": -25, \"max\": 55}, \"unit_symbol\": \"°C\", \"unit_id\": null},\n      \"electromagnetic_environmental_class\": {\"value\": \"E1/E2\", \"unit_symbol\": null, \"unit_id\": null},\n      \"climatic_mechanical_environmental_class\": {\"value\": \"B/O\", \"unit_symbol\": null, \"unit_id\": null},\n      \"flow_profile_sensitivity_class\": {\"value\": \"U0D0\", \"unit_symbol\": null, \"unit_id\": null},\n      \"battery_type\": {\"value\": \"non-replaceable lithium battery\", \"unit_symbol\": null, \"unit_id\": null},\n      \"battery_maximum_voltage\": {\"value\": 3.7, \"unit_symbol\": \"V\", \"unit_id\": null},\n      \"battery_lifetime\": {\"value\": 18, \"unit_symbol\": \"years\", \"unit_id\": null},\n      \"display_digit_count\": {\"value\": 9, \"unit_symbol\": null, \"unit_id\": null},\n      \"legal_software_version\": {\"value\": \"V000101\", \"unit_symbol\": null, \"unit_id\": null},\n      \"legal_software_checksum\": {\"value\": \"C93395DB\", \"unit_symbol\": null, \"unit_id\": null}\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"nominal_diameter\",\n        \"unit_symbol\": \"mm\",\n        \"values\": [\n          {\"model\": \"MA408 (DN15)\", \"value\": \"DN15\"},\n          {\"model\": \"MA408 (DN20)\", \"value\": \"DN20\"},\n          {\"model\": \"MA408 (DN25)\", \"value\": \"DN25\"}\n        ]\n      },\n      {\n        \"attribute\": \"permanent_flowrate_q