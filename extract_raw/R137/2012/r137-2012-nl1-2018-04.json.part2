\"value\": 12.5},\n          {\"model\": \"G250-V2.32\", \"value\": 20},\n          {\"model\": \"G160-V2.41\", \"value\": 12.5},\n          {\"model\": \"G250-V2.41\", \"value\": 20},\n          {\"model\": \"G250-V2.9\", \"value\": 20},\n          {\"model\": \"G400-V2.9\", \"value\": 32},\n          {\"model\": \"G250-V3.96\", \"value\": 20},\n          {\"model\": \"G400-V3.96\", \"value\": 32},\n          {\"model\": \"G650-V3.96\", \"value\": 32},\n          {\"model\": \"G400-V6.34\", \"value\": 32},\n          {\"model\": \"G650-V6.34\", \"value\": 32},\n          {\"model\": \"G650-V10.3\", \"value\": 50},\n          {\"model\": \"G1000-V10.3\", \"value\": 80}\n        ]\n      },\n      {\n        \"attribute\": \"diameter\",\n        \"unit_symbol\": \"mm\",\n        \"values\": [\n          {\"model\": \"G40-V0.5\", \"value\": \"50 or 80\"},\n          {\"model\": \"G65-V0.5\", \"value\": \"50 or 80\"},\n          {\"model\": \"G65-V0.78\", \"value\": \"50 or 80\"},\n          {\"model\": \"G100-V0.78\", \"value\": \"80 or 100\"},\n          {\"model\": \"G100-V1.22\", \"value\": \"80 or 100\"},\n          {\"model\": \"G160-V1.22\", \"value\": \"80 or 100\"},\n          {\"model\": \"G160-V1.98\", \"value\": \"80 or 100\"},\n          {\"model\": \"G250-V1.98\", \"value\": \"80 or 100 or 150\"},\n          {\"model\": \"G100-V1.46\", \"value\": \"80 or 100\"},\n          {\"model\": \"G160-V1.46\", \"value\": \"80 or 100\"},\n          {\"model\": \"G160-V2.32\", \"value\": \"80 or 100\"},\n          {\"model\": \"G250-V2.32\", \"value\": \"80 or 100 or 150\"},\n          {\"model\": \"G160-V2.41\", \"value\": \"80 or 100\"},\n          {\"model\": \"G250-V2.41\", \"value\": \"80 or 100\"},\n          {\"model\": \"G250-V2.9\", \"value\": \"80 or 100 or 150\"},\n          {\"model\": \"G400-V2.9\", \"value\": \"100 or 150\"},\n          {\"model\": \"G250-V3.96\", \"value\": \"100 or 150\"},\n          {\"model\": \"G400-V3.96\", \"value\": \"100 or 150\"},\n          {\"model\": \"G650-V3.96\", \"value\": \"150 or 200\"},\n          {\"model\": \"G400-V6.34\", \"value\": \"150 or 200\"},\n          {\"model\": \"G650-V6.34\", \"value\": \"150 or 200\"},\n          {\"model\": \"G650-V10.3\", \"value\": \"150 or 200\"},\n          {\"model\": \"G1000-V10.3\", \"value\": \"150 or 200\"}\n        ]\n      }\n    ],\n    \"config_level\": [\n      {\n        \"attribute\": \"maximum_pressure_pmax\",\n        \"axis\": \"pressure_variant\",\n        \"values\": [\n          {\"condition\": \"low pressure variant\", \"value\": 21, \"unit_symbol\": \"bar\", \"footnote_markers\": [\"**\"]},\n          {\"condition\": \"high pressure variant\", \"value\": 101, \"unit_symbol\": \"bar\", \"footnote_markers\": [\"**\"]}\n        ]\n      }\n    ]\n  },\n  \"matrix_tables\": [\n    {\n      \"name\": \"Table 2 Continued, FMG-Dual (table header: FMR-Dual)\",\n      \"description\": \"Flow characteristics of the FMR-Dual rotary meter variants. Model identity is the combination of cyclic volume and G-value. Some G-values were printed without the 'G' prefix in the source table (rows for V = 2.41 and V = 3.96 and V = 6.34); they have been normalized to G-values consistent with the column definition.\",\n      \"columns\": [\"cyclic_volume\", \"g_value\", \"qmax\", \"minimum_qmin\", \"qt\", \"maximum_pmax\", \"diameter\", \"accuracy_class\"],\n      \"column_units\": [\"dm³\", null, \"m³/h\", \"m³/h\", \"m³/h\", \"bar\", \"mm\", null],\n      \"rows\": [\n        {\"cyclic_volume\": 0.5, \"g_value\": \"G40\", \"qmax\": 65, \"minimum_qmin\": 0.4, \"qt\": 3.2, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"50 or 80\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 0.5, \"g_value\": \"G65\", \"qmax\": 100, \"minimum_qmin\": 0.65, \"qt\": 5, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"50 or 80\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 0.78, \"g_value\": \"G65\", \"qmax\": 100, \"minimum_qmin\": 0.65, \"qt\": 5, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"50 or 80\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 0.78, \"g_value\": \"G100\", \"qmax\": 160, \"minimum_qmin\": 1, \"qt\": 8, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 1.22, \"g_value\": \"G100\", \"qmax\": 160, \"minimum_qmin\": 1, \"qt\": 8, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 1.22, \"g_value\": \"G160\", \"qmax\": 250, \"minimum_qmin\": 1.6, \"qt\": 12.5, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 1.98, \"g_value\": \"G160\", \"qmax\": 250, \"minimum_qmin\": 1.6, \"qt\": 12.5, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 1.98, \"g_value\": \"G250\", \"qmax\": 400, \"minimum_qmin\": 2.5, \"qt\": 20, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100 or 150\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 1.46, \"g_value\": \"G100\", \"qmax\": 160, \"minimum_qmin\": 1, \"qt\": 8, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 1.46, \"g_value\": \"G160\", \"qmax\": 250, \"minimum_qmin\": 1.6, \"qt\": 12.5, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 2.32, \"g_value\": \"G160\", \"qmax\": 250, \"minimum_qmin\": 2.5, \"qt\": 12.5, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 2.32, \"g_value\": \"G250\", \"qmax\": 400, \"minimum_qmin\": 4, \"qt\": 20, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100 or 150\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 2.41, \"g_value\": \"G160\", \"qmax\": 250, \"minimum_qmin\": 1, \"qt\": 12.5, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 2.41, \"g_value\": \"G250\", \"qmax\": 400, \"minimum_qmin\": 2.5, \"qt\": 20, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 2.9, \"g_value\": \"G250\", \"qmax\": 400, \"minimum_qmin\": 2.5, \"qt\": 20, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"80 or 100 or 150\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 2.9, \"g_value\": \"G400\", \"qmax\": 650, \"minimum_qmin\": 4, \"qt\": 32, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"100 or 150\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 3.96, \"g_value\": \"G250\", \"qmax\": 400, \"minimum_qmin\": 2.5, \"qt\": 20, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"100 or 150\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 3.96, \"g_value\": \"G400\", \"qmax\": 650, \"minimum_qmin\": 4, \"qt\": 32, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"100 or 150\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 3.96, \"g_value\": \"G650\", \"qmax\": 1000, \"minimum_qmin\": 4, \"qt\": 32, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"150 or 200\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 6.34, \"g_value\": \"G400\", \"qmax\": 650, \"minimum_qmin\": 4, \"qt\": 32, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"150 or 200\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 6.34, \"g_value\": \"G650\", \"qmax\": 1000, \"minimum_qmin\": 6.5, \"qt\": 50, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"150 or 200\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 10.3, \"g_value\": \"G650\", \"qmax\": 1000, \"minimum_qmin\": 6.5, \"qt\": 50, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"150 or 200\", \"accuracy_class\": \"1.0 or 1.5\"},\n        {\"cyclic_volume\": 10.3, \"g_value\": \"G1000\", \"qmax\": 1600, \"minimum_qmin\": 10, \"qt\": 80, \"maximum_pmax\": \"21 / 101\", \"diameter\": \"150 or 200\", \"accuracy_class\": \"1.0 or 1.5\"}\n      ],\n      \"footnotes\": [\n        {\"marker\": \"*\", \"applies_to\": \"cyclic_volume\", \"text\": \"On the name plate of the rotary meter the cyclic volume can be given in two possible formats: (1) with two digits behind the comma as stated in table 2 and 3, or (2) with a number containing 6 significant digits. In this case a HF pulse value can be accurately derived from the spinning rotors with an optical sensor.\"},\n        {\"marker\": \"**\", \"applies_to\": \"maximum_pmax\", \"text\": \"The FMR-Dual can be delivered as a low pressure (Pmax = 21 bar) or a high pressure (Pmax = 101 bar) variant.\"}\n      ]\n    },\n    {\n      \"name\": \"Table 3 Register\",\n      \"description\": \"Minimum number of drums and control element value of the register (mechanical index), per meter size.\",\n      \"columns\": [\"meter_size\", \"minimum_drums_before_the_comma\", \"minimum_drums_behind_the_comma\", \"control_element\"],\n      \"column_units\": [null, null, null, \"m³\"],\n      \"rows\": [\n        {\"meter_size\": \"G6\", \"minimum_drums_before_the_comma\": 5, \"minimum_drums_behind_the_comma\": 3, \"control_element\": 0.0002},\n        {\"meter_size\": \"G10 – G65\", \"minimum_drums_before_the_comma\": 6, \"minimum_drums_behind_the_comma\": 2, \"control_element\": 0.002},\n        {\"meter_size\": \"G100 – G650\", \"minimum_drums_before_the_comma\": 7, \"minimum_drums_behind_the_comma\": 1, \"control_element\": 0.02}\n      ],\n      \"footnotes\": []\n    }\n  ],\n  \"recommendation\": {\n    \"id\": \"R137\",\n    \"edition\": 2012,\n    \"scheme\": \"B\",\n    \"accuracy_classes\": [1.0, 1.5]\n  },\n  \"footnotes\": [\n    {\n      \"marker\": \"*\",\n      \"text\": \"On the name plate of the rotary meter the cyclic volume can be given in two possible formats: 1. with two digits behind the comma as stated in table 2 and 3, or 2. with a number containing 6 significant digits. In this case a HF pulse value can be accurately derived from the spinning rotors with an optical sensor.\"\n    },\n    {\n      \"marker\": \"**\",\n      \"text\": \"The FMR-Dual can be delivered as a low pressure (Pmax = 21 bar) or a high pressure (Pmax = 101 bar) variant.\"\n    }\n  ]\n}"
    }
  ],
