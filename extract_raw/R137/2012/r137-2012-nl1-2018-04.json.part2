      "text": "{\n  \"certificate\": {\n    \"number\": \"R 137/2012-B-NL1-18.04\",\n    \"scheme\": \"B\",\n    \"project_number\": \"1901860\",\n    \"page_total\": 5,\n    \"member_state\": \"The Netherlands\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"certified_type\": {\n    \"category\": \"Gas meter\",\n    \"type_designations\": [\"FMR-Dual\", \"FMG-Dual\"],\n    \"description\": \"Rotary displacement gas meter family. This fragment contains Table 2 (continued) with the FMR-Dual flow characteristics, Table 3 with register requirements, a note that the mechanical index (with reed contact, Wiegand or encoder) is an interchangeable component, and a note that specific installation conditions are not applicable for this rotary meter.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"G40-V0.5\"},\n      {\"model_id\": \"G65-V0.5\"},\n      {\"model_id\": \"G65-V0.78\"},\n      {\"model_id\": \"G100-V0.78\"},\n      {\"model_id\": \"G100-V1.22\"},\n      {\"model_id\": \"G160-V1.22\"},\n      {\"model_id\": \"G160-V1.98\"},\n      {\"model_id\": \"G250-V1.98\"},\n      {\"model_id\": \"G100-V1.46\"},\n      {\"model_id\": \"G160-V1.46\"},\n      {\"model_id\": \"G160-V2.32\"},\n      {\"model_id\": \"G250-V2.32\"},\n      {\"model_id\": \"G160-V2.41\"},\n      {\"model_id\": \"G250-V2.41\"},\n      {\"model_id\": \"G250-V2.9\"},\n      {\"model_id\": \"G400-V2.9\"},\n      {\"model_id\": \"G250-V3.96\"},\n      {\"model_id\": \"G400-V3.96\"},\n      {\"model_id\": \"G650-V3.96\"},\n      {\"model_id\": \"G400-V6.34\"},\n      {\"model_id\": \"G650-V6.34\"},\n      {\"model_id\": \"G650-V10.3\"},\n      {\"model_id\": \"G1000-V10.3\"}\n    ]\n  },\n  \"components\": [\n    {\n      \"role\": \"interchangeable component\",\n      \"type_designations\": [\"mechanical index\"],\n      \"alternatives\": \"OR\",\n      \"characteristics\": {\n        \"equipped_with\": [\"reed contact\", \"Wiegand\", \"encoder\"]\n      }\n    }\n  ],\n  \"characteristics\": {\n    \"type_level\": {\n      \"installation_conditions\": {\n        \"value\": \"not applicable\",\n        \"unit_symbol\": null,\n        \"unit_id\": null,\n        \"footnote_markers\": []\n      }\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"cyclic_volume\",\n        \"unit_symbol\": \"dm³\",\n        \"values\": [\n          {\"model\": \"G40-V0.5\", \"value\": 0.5, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G65-V0.5\", \"value\": 0.5, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G65-V0.78\", \"value\": 0.78, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G100-V0.78\", \"value\": 0.78, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G100-V1.22\", \"value\": 1.22, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G160-V1.22\", \"value\": 1.22, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G160-V1.98\", \"value\": 1.98, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G250-V1.98\", \"value\": 1.98, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G100-V1.46\", \"value\": 1.46, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G160-V1.46\", \"value\": 1.46, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G160-V2.32\", \"value\": 2.32, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G250-V2.32\", \"value\": 2.32, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G160-V2.41\", \"value\": 2.41, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G250-V2.41\", \"value\": 2.41, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G250-V2.9\", \"value\": 2.9, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G400-V2.9\", \"value\": 2.9, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G250-V3.96\", \"value\": 3.96, \"footnote_markers\": [\"*\"]},\n          {\"model\": \"G400-V3.96