      "text": "{\n  \"certificate\": {\n    \"number\": \"R137/2012-A-NL1-20.07\",\n    \"scheme\": \"A\",\n    \"project_number\": \"3684021\",\n    \"page_total\": 6,\n    \"member_state\": \"The Netherlands\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\"\n  },\n  \"certified_type\": {\n    \"category\": \"Gas meter\",\n    \"type_designations\": [\"Q.Sonic max\", \"Q.Sonic max6\"],\n    \"description\": \"Families of ultrasonic gas meters for bi-directional flow measurement: Q.Sonic max (Table 3, sizes 4-36 in / DN100-DN900) and Q.Sonic max6 (Table 4, sizes 3-36 in / DN80-DN900). Corresponding flow rates: Q = V · (1/4) · π · ID² · 3600 = 900 · π · ID² · V, with Q = flow rate, V = velocity, ID = inner diameter. During conformity assessment it is sufficient to verify a bi-directional meter only in one direction.\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"Q.Sonic max DN100\", \"attributes\": {\"diameter_size_inch\": 4, \"diameter_size_dn\": 100}},\n      {\"model_id\": \"Q.Sonic max DN150\", \"attributes\": {\"diameter_size_inch\": 6, \"diameter_size_dn\": 150}},\n      {\"model_id\": \"Q.Sonic max DN200\", \"attributes\": {\"diameter_size_inch\": 8, \"diameter_size_dn\": 200}},\n      {\"model_id\": \"Q.Sonic max DN250\", \"attributes\": {\"diameter_size_inch\": 10, \"diameter_size_dn\": 250}},\n      {\"model_id\": \"Q.Sonic max DN300\", \"attributes\": {\"diameter_size_inch\": 12, \"diameter_size_dn\": 300}},\n      {\"model_id\": \"Q.Sonic max DN350\", \"attributes\": {\"diameter_size_inch\": 14, \"diameter_size_dn\": 350}},\n      {\"model_id\": \"Q.Sonic max DN400\", \"attributes\": {\"diameter_size_inch\": 16, \"diameter_size_dn\": 400}},\n      {\"model_id\": \"Q.Sonic max DN450\", \"attributes\": {\"diameter_size_inch\": 18, \"diameter_size_dn\": 450}},\n      {\"model_id\": \"Q.Sonic max DN500\", \"attributes\": {\"diameter_size_inch\": 20, \"diameter_size_dn\": 500}},\n      {\"model_id\": \"Q.Sonic max DN550\", \"attributes\": {\"diameter_size_inch\": 22, \"diameter_size_dn\": 550}},\n      {\"model_id\": \"Q.Sonic max DN600\", \"attributes\": {\"diameter_size_inch\": 24, \"diameter_size_dn\": 600}},\n      {\"model_id\": \"Q.Sonic max DN650\", \"attributes\": {\"diameter_size_inch\": 26, \"diameter_size_dn\": 650}},\n      {\"model_id\": \"Q.Sonic max DN750\", \"attributes\": {\"diameter_size_inch\": 30, \"diameter_size_dn\": 750}},\n      {\"model_id\": \"Q.Sonic max DN900\", \"attributes\": {\"diameter_size_inch\": 36, \"diameter_size_dn\": 900}},\n      {\"model_id\": \"Q.Sonic max6 DN80\", \"attributes\": {\"diameter_size_inch\": 3, \"diameter_size_dn\": 80}},\n      {\"model_id\": \"Q.Sonic max6 DN100\", \"attributes\": {\"diameter_size_inch\": 4, \"diameter_size_dn\": 100}},\n      {\"model_id\": \"Q.Sonic max6 DN150\", \"attributes\": {\"diameter_size_inch\": 6, \"diameter_size_dn\": 150}},\n      {\"model_id\": \"Q.Sonic max6 DN200\", \"attributes\": {\"diameter_size_inch\": 8, \"diameter_size_dn\": 200}},\n      {\"model_id\": \"Q.Sonic max6 DN250\", \"attributes\": {\"diameter_size_inch\": 10, \"diameter_size_dn\": 250}},\n      {\"model_id\": \"Q.Sonic max6 DN300\", \"attributes\": {\"diameter_size_inch\": 12, \"diameter_size_dn\": 300}},\n      {\"model_id\": \"Q.Sonic max6 DN350\", \"attributes\": {\"diameter_size_inch\": 14, \"diameter_size_dn\": 350}},\n      {\"model_id\": \"Q.Sonic max6 DN400\", \"attributes\": {\"diameter_size_inch\": 16, \"diameter_size_dn\": 400}},\n      {\"model_id\": \"Q.Sonic max6 DN450\", \"attributes\": {\"diameter_size_inch\": 18, \"diameter_size_dn\": 450}},\n      {\"model_id\": \"Q.Sonic max6 DN500\", \"attributes\": {\"diameter_size_inch\": 20, \"diameter_size_dn\": 500}},\n      {\"model_id\": \"Q.Sonic max6 DN550\", \"attributes\": {\"diameter_size_inch\": 22, \"diameter_size_dn\": 550}},\n      {\"model_id\": \"Q.Sonic max6 DN600\", \"attributes\": {\"diameter_size_inch\": 24, \"diameter_size_dn