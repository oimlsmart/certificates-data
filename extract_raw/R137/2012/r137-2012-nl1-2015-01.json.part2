"name\": \"Table 3: Essential characteristics FMR-Dual\",\n      \"columns\": [\"cyclic_volume_v\", \"g_value\", \"qmax\", \"qmin\", \"qt\", \"maximum_pressure_pmax\", \"diameter_d\", \"basic_transfer_relationship_revolutions\", \"basic_transfer_relationship_per_m3\", \"accuracy_class\"],\n      \"column_units\": [\"dm³\", null, \"m³/h\", \"m³/h\", \"m³/h\", \"bar\", \"mm\", null, \"m^-3\", null],\n      \"rows\": [\n        { \"cyclic_volume_v\": 2.41, \"g_value\": 160, \"qmax\": 250, \"qmin\": 1, \"qt\": 12.5, \"maximum_pressure_pmax\": 21, \"diameter_d\": \"80 or 100\", \"basic_transfer_relationship_revolutions\": 414.462, \"basic_transfer_relationship_per_m3\": 1, \"accuracy_class\": \"1.0 or 1.5\" },\n        { \"cyclic_volume_v\": 2.41, \"g_value\": 250, \"qmax\": 400, \"qmin\": 2.5, \"qt\": 20, \"maximum_pressure_pmax\": 21, \"diameter_d\": \"80 or 100\", \"basic_transfer_relationship_revolutions\": 414.462, \"basic_transfer_relationship_per_m3\": 1, \"accuracy_class\": \"1.0 or 1.5\" },\n        { \"cyclic_volume_v\": 3.96, \"g_value\": 250, \"qmax\": 400, \"qmin\": 2.5, \"qt\": 20, \"maximum_pressure_pmax\": 21, \"diameter_d\": \"100 or 150\", \"basic_transfer_relationship_revolutions\": 252.282, \"basic_transfer_relationship_per_m3\": 1, \"accuracy_class\": \"1.0 or 1.5\" },\n        { \"cyclic_volume_v\": 3.96, \"g_value\": 400, \"qmax\": 650, \"qmin\": 4, \"qt\": 32, \"maximum_pressure_pmax\": 21, \"diameter_d\": \"100 or 150\", \"basic_transfer_relationship_revolutions\": 252.282, \"basic_transfer_relationship_per_m3\": 1, \"accuracy_class\": \"1.0 or 1.5\" },\n        { \"cyclic_volume_v\": 3.96, \"g_value\": 650, \"qmax\": 1000, \"qmin\": 4, \"qt\": 32, \"maximum_pressure_pmax\": 12, \"diameter_d\": \"150 or 200\", \"basic_transfer_relationship_revolutions\": 252.282, \"basic_transfer_relationship_per_m3\": 1, \"accuracy_class\": \"1.0 or 1.5\" },\n        { \"cyclic_volume_v\": 6.34, \"g_value\": 400, \"qmax\": 650, \"qmin\": 4, \"qt\": 32, \"maximum_pressure_pmax\": 21, \"diameter_d\": \"150 or 200\", \"basic_transfer_relationship_revolutions\": 157.676, \"basic_transfer_relationship_per_m3\": 1, \"accuracy_class\": \"1.0 or 1.5\" },\n        { \"cyclic_volume_v\": 6.34, \"g_value\": 650, \"qmax\": 1000, \"qmin\": 6.5, \"qt\": 50, \"maximum_pressure_pmax\": 21, \"diameter_d\": \"150 or 200\", \"basic_transfer_relationship_revolutions\": 157.676, \"basic_transfer_relationship_per_m3\": 1, \"accuracy_class\": \"1.0 or 1.5\" }\n      ],\n      \"description\": \"Essential characteristics per FMR-Dual variant; the cyclic volume column uses rowspan, so its value applies to consecutive G-value rows. 'maximum ρmax' in the source is rendered as maximum_pressure_pmax (unit bar). Decimal commas converted to points.\",\n      \"footnotes\": [\n        {\n          \"marker\": \"*\",\n          \"text\": \"On the name plate of the rotary meter the cyclic volume can be given in two possible formats: 1. with two digits behind the comma as stated in table 2 and 3, or 2. with a number containing 6 significant digits. In this case a HF pulse value can be accurately derived from the spinning rotors with an optical sensor.\"\n        }\n      ]\n    },\n    {\n      \"name\": \"Minimum number of drums by meter size\",\n      \"columns\": [\"meter_size\", \"min_drums_before_the_comma\", \"min_drums_after_the_comma\", \"control_element\"],\n      \"column_units\": [null, null, null, \"m³\"],\n      \"rows\": [\n        { \"meter_size\": \"G6\", \"min_drums_before_the_comma\": 5, \"min_drums_after_the_comma\": 3, \"control_element\": 0.0002 },\n        { \"meter_size\": \"G10 – G65\", \"min_drums_before_the_comma\": 6, \"min_drums_after_the_comma\": 2, \"control_element\": 0.002 },\n        { \"meter_size\": \"G100 – G650\", \"min_drums_before_the_comma\": 7, \"min_drums_after_the_comma\": 1, \"control_element\": 0.02 }\n      ],\n      \"description\": \"Minimum number of drums and control element per meter size. The header of the second drum column is empty in the source; named 'min_drums_after_the_comma' by inference from the 'before the comma' header. Decimal commas converted to points.\",\n      \"footnotes\": []\n    }\n  ],\n  \"recommendation\": {\n    \"id\": \"R137\",\n    \"edition\": 2012,\n    \"accuracy_classes\": [1.0, 1.5]\n  },\n  \"footnotes\": [\n    {\n      \"marker\": \"*\",\n      \"text\": \"On the name plate of the rotary meter the cyclic volume can be given in two possible formats: 1. with two digits behind the comma as stated in table 2 and 3, or 2. with a number containing 6 significant digits. In this case a HF pulse value can be accurately derived from the spinning rotors with an optical sensor.\"\n    }\n  ]\n}\n```"
