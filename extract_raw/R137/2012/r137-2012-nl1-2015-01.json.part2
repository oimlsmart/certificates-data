      "text": "```json\n{\n  \"certificate\": {\n    \"number\": \"R137/2012-NL1-15.01\",\n    \"project_number\": \"14200712\",\n    \"page_total\": 4,\n    \"member_state\": \"The Netherlands\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi\"\n  },\n  \"certified_type\": {\n    \"category\": \"Gas meter\",\n    \"type_designations\": [\"FMR-Dual\"],\n    \"description\": \"Rotary meter; Table 3 gives the essential characteristics of the FMR-Dual type variants.\"\n  },\n  \"model_family\": {\n    \"family_name\": \"FMR-Dual\",\n    \"models\": [\n      { \"model_id\": \"V2.41dm3-G160\", \"label\": \"G160, V=2.41 dm³\" },\n      { \"model_id\": \"V2.41dm3-G250\", \"label\": \"G250, V=2.41 dm³\" },\n      { \"model_id\": \"V3.96dm3-G250\", \"label\": \"G250, V=3.96 dm³\" },\n      { \"model_id\": \"V3.96dm3-G400\", \"label\": \"G400, V=3.96 dm³\" },\n      { \"model_id\": \"V3.96dm3-G650\", \"label\": \"G650, V=3.96 dm³\" },\n      { \"model_id\": \"V6.34dm3-G400\", \"label\": \"G400, V=6.34 dm³\" },\n      { \"model_id\": \"V6.34dm3-G650\", \"label\": \"G650, V=6.34 dm³\" }\n    ]\n  },\n  \"characteristics\": {\n    \"type_level\": {\n      \"specific_installation_conditions\": { \"value\": \"not applicable\", \"unit_symbol\": null, \"unit_id\": null, \"footnote_markers\": [] }\n    },\n    \"model_level\": [\n      {\n        \"attribute\": \"cyclic_volume_v\",\n        \"unit_symbol\": \"dm³\",\n        \"values\": [\n          { \"model\": \"V2.41dm3-G160\", \"value\": 2.41, \"unit_symbol\": \"dm³\", \"unit_id\": null, \"footnote_markers\": [\"*\"] },\n          { \"model\": \"V2.41dm3-G250\", \"value\": 2.41, \"unit_symbol\": \"dm³\", \"unit_id\": null, \"footnote_markers\": [\"*\"] },\n          { \"model\": \"V3.96dm3-G250\", \"value\": 3.96, \"unit_symbol\": \"dm³\", \"unit_id\": null, \"footnote_markers\": [\"*\"] },\n          { \"model\": \"V3.96dm3-G400\", \"value\": 3.96, \"unit_symbol\": \"dm³\", \"unit_id\": null, \"footnote_markers\": [\"*\"]