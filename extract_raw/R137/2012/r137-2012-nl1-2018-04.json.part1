100], [1.0,1.5]}\n43. {3.96, G250, 400, 2.5, 20, 101, [100,150], [1.0,1.5]}\n44. {3.96, G400, 650, 4, 32, 101, [100,150], [1.0,1.5]}\n45. {3.96, G650, 1000, 4, 32, 12, [150,200], [1.0,1.5]}\n46. {5.15, G250, 400, 2.5, 20, 101, [100,150], [1.0,1.5]}\n47. {5.15, G400, 650, 2.5, 32, 101, [100,150], [1.0,1.5]}\n48. {5.15, G650, 1000, 6.25, 50, 12, [100,150], [1.0,1.5]}\n\nWait row 44: Qmin for G400 at 3.96: \"4\" — from table: `<tr><td>G400</td><td>650</td><td>4</td><td>32</td><td>101</td><td>100 or 150</td><td>1,0 or 1,5</td></tr>`. Yes qmin=4, qt=32. Row 45 G650: 1000, 4, 32, 12, 150 or 200. Row 47: G400 at 5.15: 650, 2.5, 32 — qmin=2.5. Yes.\n\nRow 42: G400 at 3.17: 650, 2.5, 32, 12, 80 or 100. Yes.\n\nNow model_level entries. For qmax:\n\nvalues: \nV0.25-G6: 10\nV0.25-G10: 16\nV0.25-G16: 25\nV0.25-G25: 40\nV0.39-G10: 16\nV0.39-G16: 25\nV0.39-G25: 40\nV0.39-G40: 65\nV0.61-G16: 25\nV0.61-G25: 40\nV0.61-G40: 65\nV0.61-G65: 100\nV0.73-G16: 25\nV0.73-G25: 40\nV0.73-G40: 65\nV0.73-G65: 100\nV0.73-G100: 160\nV0.85-G25: 40\nV0.85-G40: 65\nV0.85-G65: 100\nV0.85-G100: 160\nV0.99-G25: 40\nV0.99-G40: 65\nV0.99-G65: 100\nV0.99-G100: 160\nV1.16-G40: 65\nV1.16-G65: 100\nV1.16-G100: 160\nV1.16-G160: 250\nV1.45-G65: 100\nV1.45-G100: 160\nV1.45-G160: 250\nV1.81-G65: 100\nV1.81-G100: 160\nV1.81-G160: 250\nV1.81-G250: 400\nV1.98-G100: 160\nV1.98-G160: 250\nV1.98-G250: 400\nV3.17-G160: 250\nV3.17-G250: 400\nV3.17-G400: 650\nV3.96-G250: 400\nV3.96-G400: 650\nV3.96-G650: 1000\nV5.15-G250: 400\nV5.15-G400: 650\nV5.15-G650: 1000\n\nqmin:\nV0.25-G6: 0.25\nV0.25-G10: 0.25\nV0.25-G16: 0.25\nV0.25-G25: 0.25\nV0.39-G10: 0.25\nV0.39-G16: 0.25\nV0.39-G25: 0.25\nV0.39-G40: 0.25\nV0.61-G16: 0.25\nV0.61-G25: 0.25\nV0.61-G40: 0.25\nV0.61-G65: 0.25\nV0.73-G16: 0.2\nV0.73-G25: 0.2\nV0.73-G40: 0.2\nV0.73-G65: 0.2\nV0.73-G100: 0.4\nV0.85-G25: 1\nV0.85-G40: 1\nV0.85-G65: 1\nV0.85-G100: 1\nV0.99-G25: 1\nV0.99-G40: 1\nV0.99-G65: 1\nV0.99-G100: 1\nV1.16-G40: 0.4\nV1.16-G65: 0.4\nV1.16-G100: 0.4\nV1.16-G160: 0.65\nV1.45-G65: 0.6\nV1.45-G100: 0.6\nV1.45-G160: 0.6\nV1.81-G65: 0.6\nV1.81-G100: 0.6\nV1.81-G160: 0.6\nV1.81-G250: 1\nV1.98-G100: 1\nV1.98-G160: 1\nV1.98-G250: 2.5\nV3.17-G160: 1.6\nV3.17-G250: 1.6\nV3.17-G400: 2.5\nV3.96-G250: 2.5\nV3.96-G400: 4\nV3.96-G650: 4\nV5.15-G250: 2.5\nV5.15-G400: 2.5\nV5.15-G650: 6.25\n\nqt:\n0.5, 0.8, 1.25, 2,\n0.8, 1.25, 2, 3.2,\n1.25, 2, 3.2, 5,\n1.25, 2, 3.2, 5, 8,\n2, 3.2, 5, 8,\n2, 3.2, 5, 8,\n3.2, 5, 8, 12.5,\n5, 8, 12.5,\n5, 8, 12.5, 20,\n8, 12.5, 20,\n12.5, 20, 32,\n20, 32, 32,\n20, 32, 50\n\nmodel_ids in order: as listed above.\n\nFootnotes: {\"marker\": \"*\", \"text\": \"See remark on next page.\"}\n\nAlso should I record accuracy_classes on recommendation: [1.0, 1.5].\n\nThe fragment mentions \"R 137-1 (2012) 'Gas meters'\". So recommendation id \"R137-1\", edition 2012. Hmm — canonical example \"R60\". With the -1 part... R 137-1 is the actual part designation. I'll keep \"R137-1\".\n\nDo I include \"name\": \"Gas meters\"? Schema doesn't have a name field for recommendation. Omit.\n\nTest report dates: 30 January 2015 → 2015-01-30; 29 September 2016 → 2016-09-29; 26 April 2018 → 2018-04-26.\n\nDocumentation: \"Documentation folder no. T10372-8\" — include as test_reports entry {id: \"T10372-8\", role: \"documentation_file\"}. The text says \"The construction of the measuring instrument is recorded in the Documentation folder no. T10372-8.\"\n\nNow — one concern: propagating blank volume cells. Let me double-check rows 17, 21, 29, 36, 39, 42, 45, 48 again against the markdown:\n\nRow 17: `<tr><td></td><td>G100</td><td>160</td><td>0,4</td><td>8</td><td>12</td><td>50 or 80</td><td>1,0 or 1,5</td></tr>` — after 0,73 rowspan=4 (G16, G25, G40, G65). So blank → 0.73. But wait — is it possible this G100 belongs to a new sub-block where volume is intentionally blank because it's the same physical meter but low-pressure variant? Either way volume = 0.73 continuation. Hmm, but actually, hmm: 0.73 dm³ G100 with pmax 12 bar vs 0.85/0.99 dm³ G100 with 101 bar. Let me sanity check with actual FMR data: Flow Meter Group FMR rotary piston meters... I recall FMR G100 has ~0.73 dm³? Not sure. The table's own logic: G100 appears at 0.73(blank), 0.85(blank), 0.99, 1.16, 1.45, 1.81, 1.98. The blank ones at pmax=12. It seems the table grouped by volume with high-pressure (101 bar) variants in rowspan groups and added low-pressure (12 bar) G100/G160/G250/G400/G650 rows after each group where applicable. The blank = same volume as the group above. I'm fairly confident. I'll propagate and note in description.\n\nActually — alternative reading: maybe the blank cell rows are a separate \"low pressure\" family block and the volume genuinely continues. Same conclusion.\n\nOne more check on row 29: `<tr><td></td><td>G160</td><td>250</td><td>0,65</td><td>12,5</td><td>12</td><td>50 or 80</td><td>1,0 or 1,5</td></tr>` after 1,16 rowspan=3 (G40, G65, G100). Blank → 1.16. Good.\n\nRow 36: after 1,81 rowspan=3 (G65, G100, G160): G250, 400, 1, 20, 12, 80 or 100 → volume 1.81.\nRow 39: after 1,98 rowspan=2 (G100, G160): G250, 400, 2.5, 20, 12 → 1.98.\nRow 42: after 3,17 rowspan=2 (G160, G250): G400, 650, 2.5, 32, 12 → 3.17.\nRow 45: after 3,96 rowspan=2 (G250, G400): G650, 1000, 4, 32, 12, 150 or 200 → 3.96.\nRow 48: after 5,15 rowspan=2 (G250, G400): G650, 1000, 6.25, 50, 12, 100 or 150 → 5.15.\n\nGood.\n\nNow compose the final JSON. It'll be long but fine.\n\nAlso should models[] include attributes? I'll add minimal attributes to each model? No — skip to keep size sane. Actually, hmm, the instruction says models[]: one entry per variant with model_id, label, attributes{}. I'll include label \"FMR\" only.\n\nLet me also decide on \"page_total\": 5 (Page 1 of 5).\n\nCertificate number: keep exactly \"R 137/2012-B-NL1-18.04\".\n\nScheme: \"B\".\n\nFinal JSON structure:\n\n{\n  \"certificate\": {...},\n  \"issuing_authority\": {...},\n  \"applicants\": [...],\n  \"manufacturers\": [...],\n  \"certified_type\": {...},\n  \"model_family\": {...},\n  \"characteristics\": {\n    \"type_level\": {...},\n    \"model_level\": [...]\n  },\n  \"matrix_tables\": [...],\n  \"recommendation\": {...},\n  \"test_reports\": [...],\n  \"footnotes\": [...]\n}\n\nWrite it out. Use m³/h with the ³ character. dm³ too.\n\nOne more consideration on qmin attribute name: column header \"minimum Qmin\" → canonical \"qmin\". Fine.\n\nLet me write out model_level carefully.\n\nqmax values array (48):\n[\n {\"model\":\"V0.25-G6\",\"value\":10},\n {\"model\":\"V0.25-G10\",\"value\":16},\n {\"model\":\"V0.25-G16\",\"value\":25},\n {\"model\":\"V0.25-G25\",\"value\":40},\n {\"model\":\"V0.39-G10\",\"value\":16},\n {\"model\":\"V0.39-G16\",\"value\":25},\n {\"model\":\"V0.39-G25\",\"value\":40},\n {\"model\":\"V0.39-G40\",\"value\":65},\n {\"model\":\"V0.61-G16\",\"value\":25},\n {\"model\":\"V0.61-G25\",\"value\":40},\n {\"model\":\"V0.61-G40\",\"value\":65},\n {\"model\":\"V0.61-G65\",\"value\":100},\n {\"model\":\"V0.73-G16\",\"value\":25},\n {\"model\":\"V0.73-G25\",\"value\":40},\n {\"model\":\"V0.73-G40\",\"value\":65},\n {\"model\":\"V0.73-G65\",\"value\":100},\n {\"model\":\"V0.73-G100\",\"value\":160},\n {\"model\":\"V0.85-G25\",\"value\":40},\n {\"model\":\"V0.85-G40\",\"value\":65},\n {\"model\":\"V0.85-G65\",\"value\":100},\n {\"model\":\"V0.85-G100\",\"value\":160},\n {\"model\":\"V0.99-G25\",\"value\":40},\n {\"model\":\"V0.99-G40\",\"value\":65},\n {\"model\":\"V0.99-G65\",\"value\":100},\n {\"model\":\"V0.99-G100\",\"value\":160},\n {\"model\":\"V1.16-G40\",\"value\":65},\n {\"model\":\"V1.16-G65\",\"value\":100},\n {\"model\":\"V1.16-G100\",\"value\":160},\n {\"model\":\"V1.16-G160\",\"value\":250},\n {\"model\":\"V1.45-G65\",\"value\":100},\n {\"model\":\"V1.45-G100\",\"value\":160},\n {\"model\":\"V1.45-G160\",\"value\":250},\n {\"model\":\"V1.81-G65\",\"value\":100},\n {\"model\":\"V1.81-G100\",\"value\":160},\n {\"model\":\"V1.81-G160\",\"value\":250},\n {\"model\":\"V1.81-G250\",\"value\":400},\n {\"model\":\"V1.98-G100\",\"value\":160},\n {\"model\":\"V1.98-G160\",\"value\":250},\n {\"model\":\"V1.98-G250\",\"value\":400},\n {\"model\":\"V3.17-G160\",\"value\":250},\n {\"model\":\"V3.17-G250\",\"value\":400},\n {\"model\":\"V3.17-G400\",\"value\":650},\n {\"model\":\"V3.96-G250\",\"value\":400},\n {\"model\":\"V3.96-G400\",\"value\":650},\n {\"model\":\"V3.96-G650\",\"value\":1000},\n {\"model\":\"V5.15-G250\",\"value\":400},\n {\"model\":\"V5.15-G400\",\"value\":650},\n {\"model\":\"V5.15-G650\",\"value\":1000}\n]\n\nSame model order for qmin and qt.\n\nOK, write final answer.",
