      "text": "{\n  \"certificate\": {\n    \"number\": \"R137/2012-B-NL1-18.05\",\n    \"scheme\": \"B\",\n    \"project_number\": \"1901860\",\n    \"page_total\": 5,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2018-09-24\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\n      \"Hugo de Grootplein 1\",\n      \"3314 EG Dordrecht\",\n      \"the Netherlands\"\n    ],\n    \"person_responsible\": \"C. Oosterman\",\n    \"person_title\": \"Head Certification Board\",\n    \"phone\": \"+31 78 6332332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Flow Meter Group B.V.\",\n      \"address_lines\": [\n        \"Innovatieweg 32\",\n        \"7007 CD Doetinchem\",\n        \"The Netherlands\"\n      ]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Flow Meter Group B.V.\",\n      \"address_lines\": [\n        \"Innovatieweg 32\",\n        \"7007 CD Doetinchem\",\n        \"The Netherlands\"\n      ]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Gas meter\",\n    \"type_designations\": [\"FMT-L\", \"FMT-S\", \"FMT-Lx\", \"FMT-Dc\"],\n    \"description\": \"Turbine gas meter\"\n  },\n  \"model_family\": {\n    \"family_name\": null,\n    \"models\": [\n      {\"model_id\": \"FMT-Lx/FMT-Dc DN50/80 G100\"},\n      {\"model_id\": \"FMT-Lx/FMT-Dc DN50/80 G160\"},\n      {\"model_id\": \"FMT-Lx/FMT-Dc DN50/80 G250\"},\n      {\"model_id\": \"FMT-L/FMT-S/FMT-Lx/FMT-Dc DN80/80 G100\"},\n      {\"model_id\": \"FMT-L/FMT-S/FMT-Lx/FMT-Dc DN80/80 G160\"},\n      {\"model_id\": \"FMT-L/FMT-S/FMT-Lx/FMT-Dc DN80/80 G250\"},\n      {\"model_id\": \"FMT-Lx/FMT-Dc DN80/100 G160\"},\n      {\"model_id\": \"FMT-Lx/FMT-Dc DN80/100 G250\"},\n      {\"model_id\": \"FMT-Lx/FMT-Dc DN80/100 G400\"},\n      {\"model_id\": \"FMT-Lx/FMT-Dc DN100/80 G100\"},\n 