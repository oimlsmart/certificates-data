      "text": "{\n  \"certificate\": {\n    \"number\": \"R137/2012-NL1-14.03\",\n    \"scheme\": \"A\",\n    \"project_number\": \"SO15202424\",\n    \"page_total\": 5,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2015-07-31\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V.\",\n    \"address_lines\": [\"Hugo de Grootplein 1\", \"3314 EG Dordrecht\", \"the Netherlands\"],\n    \"person_responsible\": \"C. Oosterman\",\n    \"person_title\": \"Head Certification Board\",\n    \"phone\": \"+31 78 6332332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Flow Meter Group B.V.\",\n      \"address_lines\": [\"Meniststraat 5c\", \"7091 ZZ Dinxperlo\", \"The Netherlands\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Flow Meter Group B.V.\",\n      \"address_lines\": [\"Meniststraat 5c\", \"7091 ZZ Dinxperlo\", \"The Netherlands\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Gas meter\",\n    \"type_designations\": [\"FMT-L\", \"FMT-S\", \"FMT-Lx\", \"FMT-Dc\"],\n    \"description\": \"Turbine gas meter\"\n  },\n  \"model_family\": {\n    \"family_name\": \"FMT\",\n    \"models\": [\n      {\"model_id\": \"DN50/80-G100\", \"label\": \"FMT-Lx or FMT-Dc, DN body 50, DN cartridge 80, G 100\", \"attributes\": {\"type\": [\"FMT-Lx\", \"FMT-Dc\"], \"dn_body_mm\": 50, \"dn_cartridge_mm\": 80, \"g_value\": 100}},\n      {\"model_id\": \"DN50/80-G160\", \"label\": \"FMT-Lx or FMT-Dc, DN body 50, DN cartridge 80, G 160\", \"attributes\": {\"type\": [\"FMT-Lx\", \"FMT-Dc\"], \"dn_body_mm\": 50, \"dn_cartridge_mm\": 80, \"g_value\": 160}},\n      {\"model_id\": \"DN50/80-G250\", \"label\": \"FMT-Lx or FMT-Dc, DN body 50, DN cartridge 80, G 250\", \"attributes\": {\"type\": [\"FMT-Lx\", \"FMT-Dc\"], \"dn_body_mm\": 50, \"dn_cartridge_mm\": 80, \"g_value\": 250}},\n      {\