      "text": "{\n  \"certificate\": {\n    \"number\": \"R137/2012-A-NL1-20.07\",\n    \"scheme\": \"A\",\n    \"project_number\": \"4031533\",\n    \"page_total\": 6,\n    \"member_state\": \"The Netherlands\",\n    \"date_issued\": \"2025-12-15\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"issuing_authority\": {\n    \"name\": \"NMi Certin B.V., OIML Issuing Authority NL1\",\n    \"address_lines\": [\"Thijsseweg 11\", \"2629 JA Delft\", \"The Netherlands\"],\n    \"person_responsible\": \"M.Ph.D. Schmidt\",\n    \"phone\": \"+31 88 636 2332\",\n    \"email\": \"certin@nmi.nl\",\n    \"website\": \"www.nmi.nl\",\n    \"oiml_issuer_id\": \"NL1\"\n  },\n  \"applicants\": [\n    {\n      \"name\": \"Elster GmbH\",\n      \"address_lines\": [\"Steinern Straße 19-21\", \"55252 Mainz-Kastel\", \"Germany\"]\n    }\n  ],\n  \"manufacturers\": [\n    {\n      \"name\": \"Elster GmbH\",\n      \"address_lines\": [\"Steinern Straße 19-21\", \"55252 Mainz-Kastel\", \"Germany\"]\n    }\n  ],\n  \"certified_type\": {\n    \"category\": \"Gas meter\",\n    \"type_designations\": [\"Q.Sonic max\", \"Q.Sonic max6\"],\n    \"description\": \"Ultrasonic gas meter, manufacturers mark: Elster, destined for the measurement of gas volume. The ultrasonic transducers and the electronics can be replaced with units of the same type without recalibration (diagnostic check required after exchange).\"\n  },\n  \"model_family\": {\n    \"family_name\": \"Q.Sonic\",\n    \"models\": [\n      {\"model_id\": \"Q.Sonic max DN100\", \"label\": \"Q.Sonic max, DN100 (4 in)\", \"attributes\": {\"accuracy_class\": {\"value\": \"0.5; 1.0\", \"unit_symbol\": null, \"unit_id\": null}, \"path_configuration\": {\"value\": \"6 direct paths and 2 reflection swirl paths\", \"unit_symbol\": null, \"unit_id\": null}}},\n      {\"model_id\": \"Q.Sonic max DN150\", \"label\": \"Q.Sonic max, DN150 (6 in)\", \"attributes\": {\"accuracy_class\": {\"value\": \"0.5; 1.0\", \"unit_symbol\": null, \"unit_id\": null}, \"p