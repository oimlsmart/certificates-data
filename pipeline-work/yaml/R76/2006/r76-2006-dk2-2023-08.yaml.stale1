certified_type:
  category: Indicator
  type_designations:
  - APM-II
  - W75II
  description: >-
    Electronic weighing type for non-automatic weighing instruments; accuracy classes III and IIII; available
    as single-interval, multi-interval or multi-range; maximum capacity from 1 kg to 199950 kg; software
    identification CE033; RS232 communication interface.
