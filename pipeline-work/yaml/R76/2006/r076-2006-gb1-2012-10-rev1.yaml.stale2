certificate:
  number: R76/2006-GB1-12.10
  page_total: 3
certified_type:
  category: Indicator
  type_designations:
  - AFS
  - AFM
  - ABM
  - ATM
  - APS
  - VFS
  - VFM
  - VBM
  - VTM
  - VPS
  description: >-
    Family of non-automatic weighing instruments based on A-Series and V-Series digital indicators (AFS,
    AFM, ABM, ATM, APS, VFS, VFM, VBM, VTM, VPS) connected to a weighing platform; self-indicating, single
    or dual interval/range, mains or battery-powered, suitable for direct sales to the public.
