      value: single or dual interval/range
      unit_symbol:
      unit_id:
      footnote_markers: []
    intended_use:
      value: suitable for direct sales to the public
      unit_symbol:
      unit_id:
      footnote_markers: []
    devices:
      value: >-
        zero setting/tracking, subtractive tare balancing, stability of equilibrium determination, zero
        and net indicators, memory/totalisation, printing
      unit_symbol:
      unit_id:
      footnote_markers: []
